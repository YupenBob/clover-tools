    "src/lib/civil-date.ts",
    "src/lib/daily-calculations.ts",
    "src/lib/timer-clock.ts",
    "src/lib/daily-tool-i18n.ts",
    "src/scripts/daily-ui.ts",
    "src/scripts/scientific-calculator.ts",
    "src/scripts/timer-tools.ts",
    "src/scripts/bmi-calculator.ts",
    "src/scripts/finance-calculator.ts",
    "src/scripts/date-interval.ts",
    "src/scripts/age-calculator.ts",
    "src/lib/bead-pattern.ts",
    "src/lib/personality.ts",
    "src/lib/avatar.ts",
