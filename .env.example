# CloverTools 站点配置（本地开发可选）
# 唯一站点域名覆盖项；同步驱动 canonical、sitemap、robots 与构建检查
# 只支持 HTTP(S) origin，不含子路径、查询或凭据
PUBLIC_SITE_URL=https://clovertools.cn

# During review, only the AdSense ownership meta and ads.txt are published.
# Enable after site approval, placement review and regional consent configuration.
PUBLIC_ADS_ENABLED=false

# Optional real, monitored public contact address for private inquiries.
# Never put an invented address here; this is displayed on all contact pages.
# PUBLIC_CONTACT_EMAIL=

# 可选：Cloudflare Web Analytics 发布 token（不得使用服务端 API token）
# PUBLIC_CF_BEACON_TOKEN=

# 浏览器回归：Windows 默认 msedge；CI 使用 chromium
# PLAYWRIGHT_CHANNEL=msedge
# TEST_BASE_URL=http://localhost:4321
# TEST_TIMEOUT_MS=15000
# TEST_STARTUP_TIMEOUT_MS=60000

# 工具流水线可选：IP 风险工具的上游密钥。
# 生产请用 `npx wrangler pages secret put IPAPI_IS_KEY --project-name clovertools`；
# 这是服务端 Secret，不要加 PUBLIC_ 前缀，也不要提交到仓库。
# IPAPI_IS_KEY=

# 工具流水线：本地 Chromium 路径。未设置时流水线自动探测 .playwright-browsers。
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome
