# CloverTools 站点配置（本地开发可选）
# 唯一站点域名覆盖项；同步驱动 canonical、sitemap、robots 与构建检查
# 只支持 HTTP(S) origin，不含子路径、查询或凭据
PUBLIC_SITE_URL=https://clovertools.cn

# 可选：Cloudflare Web Analytics 发布 token（不得使用服务端 API token）
# PUBLIC_CF_BEACON_TOKEN=

# 浏览器回归：Windows 默认 msedge；CI 使用 chromium
# PLAYWRIGHT_CHANNEL=msedge
# TEST_BASE_URL=http://localhost:4321
# TEST_TIMEOUT_MS=15000
# TEST_STARTUP_TIMEOUT_MS=60000
