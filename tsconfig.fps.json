{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["astro/client"],
    "skipLibCheck": true
  },
  "include": ["src/scripts/fps/**/*.ts", "src/lib/fps-i18n.ts", "src/scripts/shared.ts"]
}
