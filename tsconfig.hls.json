{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["astro/client"],
    "skipLibCheck": true
  },
  "include": ["src/lib/hls/**/*.ts", "src/scripts/m3u8-downloader.ts", "src/scripts/hls-remux.worker.ts"]
}
