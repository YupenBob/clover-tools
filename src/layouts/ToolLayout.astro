---
import BaseLayout from './BaseLayout.astro';
import type { ToolCategory, ToolMeta } from '../lib/tools';
import { getToolHref } from '../lib/tools';
import { SITE } from '../lib/site';
import { TOOL_CONTENT } from '../lib/tool-content';

const APP_CATEGORY: Record<ToolCategory, string> = {
  dev: 'DeveloperApplication',
  daily: 'UtilitiesApplication',
  fun: 'GameApplication',
};

interface Props {
  category: ToolCategory;
  tool: ToolMeta;
  related: ToolMeta[];
  categoryName: string;
}

const { category, tool, related, categoryName } = Astro.props;
const url = SITE.url + getToolHref(category, tool.slug);
const categoryUrl = `${SITE.url}/tools/${category}/`;
const content = TOOL_CONTENT[tool.slug];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.description,
    applicationCategory: APP_CATEGORY[category],
    operatingSystem: 'Web',
    url,
    inLanguage: 'zh-CN',
    author: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      sameAs: [SITE.github],
    },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: categoryName, item: categoryUrl },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${tool.name} - ${SITE.name}`}
  description={tool.description}
  keywords={tool.keywords}
  canonical={url}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/"><i class="bi bi-house-door" aria-hidden="true"></i> 首页</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <a href={`/tools/${category}/`}>{categoryName}</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>{tool.name}</span>
  </nav>

  <header class="tool-hero">
    <h1>{tool.name}</h1>
    <p class="tool-hero-desc">{tool.description}</p>
  </header>

  <div class="tool-layout with-sidebar">
    <div>
      <slot />
    </div>
    <aside class="related-panel">
      <h2 class="panel-title"><i class="bi bi-collection" aria-hidden="true"></i> 相关工具</h2>
      <div class="related-list">
        {related.map((item) => (
          <a class="related-item" href={getToolHref(category, item.slug)}>
            <i class={`bi ${item.icon}`} aria-hidden="true"></i>
            <span>{item.name}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>

  {content && (
    <section class="tool-about" aria-labelledby="usage-heading">
      <h2 id="usage-heading" class="usage-title">
        <i class="bi bi-info-circle" aria-hidden="true"></i> 使用说明
      </h2>
      <p class="usage-intro">{content.usage}</p>
      <ul class="usage-features">
        {content.features.map((f) => (
          <li>
            <i class={`bi ${f.icon}`} aria-hidden="true"></i>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .tool-about {
    margin-top: var(--space-7);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm);
  }

  .usage-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-3);
    font-size: 17px;
    font-weight: 700;
  }

  .usage-title i {
    color: var(--primary-dark);
    font-size: 19px;
  }

  .usage-intro {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.85;
  }

  .usage-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .usage-features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .usage-features i {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--primary-dark);
    font-size: 15px;
  }

  @media (max-width: 560px) {
    .usage-features {
      grid-template-columns: 1fr;
    }
  }
</style>
