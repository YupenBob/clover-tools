---
import BaseLayout from './BaseLayout.astro';
import ToolGuide from '../components/ToolGuide.astro';
import AdUnit from '../components/AdUnit.astro';
import type { ToolCategory, ToolMeta } from '../lib/tools';
import { getToolHref } from '../lib/tools';
import { SITE } from '../lib/site';
import { caseForTool } from '../lib/use-cases';
import {
  DICT,
  getCategoryMeta,
  getToolContent,
  getRelated,
  langFromUrl,
  pathForLang,
  type Lang,
} from '../lib/i18n';
import { getGuidesForTool } from '../lib/guides';
import { toolWorkspace, type ToolWorkspace, type ToolLayoutMode } from '../lib/tool-presentation';
import '../styles/tool-workspace.css';

const APP_CATEGORY: Record<ToolCategory, string> = {
  dev: 'DeveloperApplication',
  daily: 'UtilitiesApplication',
  fun: 'GameApplication',
};

interface Props {
  category: ToolCategory;
  tool: ToolMeta;
  related: ToolMeta[];
  categoryName?: string;
  layout?: ToolLayoutMode;
  workspace?: ToolWorkspace;
}

const { category, tool, layout = 'wide', workspace = toolWorkspace(tool.slug) } = Astro.props;
const lang: Lang = langFromUrl(Astro.url.pathname);
const dict = DICT[lang];
const related = getRelated(category, tool.slug, lang);
const categoryMeta = getCategoryMeta(category, lang);
const categoryName = categoryMeta.name;
const url = SITE.url + pathForLang(getToolHref(category, tool.slug), lang);
const categoryUrl = SITE.url + pathForLang(`/tools/${category}/`, lang);
const homeUrl = SITE.url + pathForLang('/', lang);
const content = getToolContent(tool.slug, lang);
const detail = content?.detail;
const workedCase = lang === 'zh' ? caseForTool(tool.slug) : null;
const guides = getGuidesForTool(tool.slug);
const inLanguage =
  lang === 'en' ? 'en' : lang === 'tw' ? 'zh-Hant' : lang === 'ko' ? 'ko' : lang === 'ja' ? 'ja' : 'zh-CN';

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.description,
    applicationCategory: APP_CATEGORY[category],
    operatingSystem: 'Web',
    url,
    inLanguage,
    dateModified: SITE.updated,
    author: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      sameAs: [SITE.github],
    },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: dict.home, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: categoryName, item: categoryUrl },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${tool.name} - ${SITE.name}`}
  description={tool.description}
  keywords={tool.keywords}
  canonical={url}
  jsonLd={jsonLd}
  contentClass="tool-container"
>
 <article class="tool-page" data-tool={tool.slug} data-category={category} data-layout={layout} data-workspace={workspace}>
  <nav class="breadcrumb" aria-label={dict.breadcrumb}>
    <a href={pathForLang('/', lang)}>
      <i class="bi bi-house-door" aria-hidden="true"></i> {dict.home}
    </a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <a href={pathForLang(`/tools/${category}/`, lang)}>{categoryName}</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>{tool.name}</span>
  </nav>

  <slot name="hero">
    <header class="tool-hero">
      <div class="tool-emblem" aria-hidden="true"><i class={`bi ${tool.icon}`}></i></div>
      <div class="tool-heading">
        <p class="tool-eyebrow">{categoryName}<span aria-hidden="true">/</span>CloverTools</p>
        <h1>{tool.name}</h1>
        <p class="tool-hero-desc">{tool.description}</p>
      </div>
    </header>
  </slot>

  <div class:list={['tool-layout', { 'with-sidebar': layout === 'sidebar' }]}>
    <div class="tool-workspace">
      <slot />
    </div>
    <div class="tool-discovery">
      <aside class="related-panel">
        <h2 class="panel-title"><i class="bi bi-collection" aria-hidden="true"></i> {dict.related}</h2>
        <div class="related-list">
          {related.map((item) => (
            <a class="related-item" href={pathForLang(getToolHref(category, item.slug), lang)}>
              <i class={`bi ${item.icon}`} aria-hidden="true"></i>
              <span>{item.name}</span>
            </a>
          ))}
        </div>
      </aside>

      <AdUnit adSlot="tool_sidebar" format={layout === 'sidebar' ? 'rectangle' : 'horizontal'} />
    </div>
  </div>

  <AdUnit adSlot="tool_bottom" />

  {content && (
    <section class="tool-about" aria-labelledby="usage-heading">
      <h2 id="usage-heading" class="usage-title">
        <i class="bi bi-info-circle" aria-hidden="true"></i> {dict.usageTitle}
      </h2>
      <p class="usage-intro">{content.usage}</p>
      <ul class="usage-features">
        {content.features.map((f) => (
          <li>
            <i class={`bi ${f.icon}`} aria-hidden="true"></i>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {workedCase && <aside class="worked-case"><p>用一份实际导出结果核对操作</p><a href={`/examples/${workedCase.slug}/`}>{workedCase.title} <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><span>{workedCase.summary}</span></aside>}
  {detail && <ToolGuide detail={detail} guides={guides} toolName={tool.name} lang={lang} />}
 </article>
</BaseLayout>

<style>
  .worked-case{display:grid;gap:10px;padding:24px;margin-top:32px;border:1px solid var(--border-strong);border-radius:var(--radius-md);background:var(--primary-soft)}
  .worked-case p{margin:0;font-size:12px;color:var(--text-tertiary)}
  .worked-case a{color:var(--primary-dark);font-weight:700;font-size:18px;line-height:1.5}
  .worked-case span{font-size:13px;color:var(--text-secondary)}
  .tool-discovery {
    display: flex;
    flex-direction: column;
  }

  .tool-about {
    margin-top: var(--space-7);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .usage-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-3);
    font-size: 17px;
    font-weight: 700;
  }

  .usage-title i {
    color: var(--primary-dark);
    font-size: 19px;
  }

  .usage-intro {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.85;
  }

  .usage-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .usage-features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .usage-features i {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--primary-dark);
    font-size: 15px;
  }

  @media (max-width: 560px) {
    .usage-features {
      grid-template-columns: 1fr;
    }
  }
</style>
