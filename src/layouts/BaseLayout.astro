---
import '../styles/global.css';
import '../styles/vendor/bootstrap-icons.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';
import {
  HTML_LANG,
  OG_LOCALE,
  langFromUrl,
  pathForLang,
  siteForLang,
  stripLang,
  type Lang,
} from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ads?: boolean;
}

const {
  title,
  description,
  keywords,
  canonical = SITE.url + '/',
  ogImage = SITE.url + '/og-image.jpg',
  jsonLd,
  ads = true,
} = Astro.props;

const lang: Lang = langFromUrl(Astro.url.pathname);
const site = siteForLang(lang);
const resolvedTitle = title ?? `${SITE.name} - ${site.tagline}`;
const resolvedDescription = description ?? site.description;
const canonicalPath = stripLang(new URL(canonical).pathname);
const zhUrl = SITE.url + pathForLang(canonicalPath, 'zh');
const twUrl = SITE.url + pathForLang(canonicalPath, 'tw');
const enUrl = SITE.url + pathForLang(canonicalPath, 'en');
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const safeJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {keywords && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="zh-Hant" href={twUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    {ads && (
      <>
        <!-- Google AdSense -->
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2739960879713370"
          crossorigin="anonymous"
        ></script>
      </>
    )}

    <link rel="preload" as="image" href="/clover-logo.svg" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/bootstrap-icons.woff2?e34853135f9e39acf64315236852cd5a"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/clover-logo.svg" type="image/svg+xml" />

    <script is:inline>
      // 首次访问按浏览器语言自动切换到对应语言版本（记住选择，之后不再跳转）
      (function () {
        try {
          var saved = localStorage.getItem('clover-lang');
          if (saved) return;
          var nav = (navigator.language || navigator.userLanguage || '').toLowerCase();
          var target;
          if (nav.indexOf('zh') === 0) {
            target =
              nav.indexOf('hant') >= 0 ||
              nav.indexOf('tw') >= 0 ||
              nav.indexOf('hk') >= 0 ||
              nav.indexOf('mo') >= 0
                ? 'tw'
                : 'zh';
          } else {
            target = 'en';
          }
          var path = window.location.pathname;
          var current = path.indexOf('/en') === 0 ? 'en' : path.indexOf('/zh-hant') === 0 ? 'tw' : 'zh';
          if (target === current) {
            localStorage.setItem('clover-lang', target);
            return;
          }
          var base = path.replace(/^\/(en|zh-hant)(?=\/|$)/, '') || '/';
          var dest = target === 'en' ? '/en' + base : target === 'tw' ? '/zh-hant' + base : base;
          localStorage.setItem('clover-lang', target);
          window.location.replace(dest);
        } catch (e) {
          /* 忽略 localStorage 不可用等异常 */
        }
      })();
    </script>

    <script is:inline>
      (function () {
        var saved = localStorage.getItem('clover-theme');
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>

    {cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cfToken}"}`}
      ></script>
    )}

    {safeJsonLd && <script is:inline type="application/ld+json" set:html={safeJsonLd} />}
    <script>
      import '../scripts/shared';
    </script>
  </head>
  <body>
    <SiteHeader />
    <main class="page-body">
      <div class="container">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
  </body>
</html>
