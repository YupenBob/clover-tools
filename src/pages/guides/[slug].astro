---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../lib/guides';
import { getAllTools, getToolHref } from '../../lib/tools';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
if (!guide) throw new Error('Guide not found');

const toolEntry = getAllTools().find((tool) => tool.slug === guide.toolSlug);
if (!toolEntry) throw new Error(`Guide tool not found: ${guide.toolSlug}`);
const toolHref = getToolHref(toolEntry.category, toolEntry.slug);
const canonical = `${SITE.url}/guides/${guide.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    dateModified: guide.updated,
    datePublished: guide.published,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: canonical,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '实用指南', item: `${SITE.url}/guides/` },
      { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={`${guide.title} - ${SITE.name}`} description={guide.description} keywords={[guide.title, guide.category, 'CloverTools']} canonical={canonical} jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/"><i class="bi bi-house-door" aria-hidden="true"></i> 首页</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <a href="/guides/">实用指南</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>{guide.title}</span>
  </nav>

  <article class="guide-article">
    <header class="article-hero">
      <div class="article-meta"><span>{guide.category}</span><span>{guide.readingMinutes} 分钟阅读</span><time datetime={guide.updated}>更新于 {guide.updated}</time></div>
      <h1>{guide.title}</h1>
      <p>{guide.description}</p>
      <a class="article-tool-link" href={toolHref}><i class="bi bi-play-circle" aria-hidden="true"></i> 立即打开 {toolEntry.name} <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    </header>

    <div class="article-layout">
      <div class="article-content" set:html={guide.content}></div>
      <aside class="article-aside">
        <div class="aside-card">
          <p class="aside-label">本页重点</p>
          <p>先看示例，再把步骤带回工具。结果用于生产系统前，请结合项目文档和测试环境复核。</p>
        </div>
        <div class="aside-card aside-local">
          <i class="bi bi-shield-lock" aria-hidden="true"></i>
          <p>输入内容在浏览器本地处理。请勿把真实密码、令牌或个人敏感信息当作示例提交。</p>
        </div>
      </aside>
    </div>

    <section class="article-faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">常见问题</h2>
      {guide.faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </section>

    <section class="article-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">参考来源</h2>
      <ul>
        {guide.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></li>
        ))}
      </ul>
    </section>

    <footer class="article-footer">
      <a href={toolHref}><i class="bi bi-arrow-left" aria-hidden="true"></i> 返回工具</a>
      <a href="/guides/">浏览全部指南 <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-sources { margin-top: var(--space-6); padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); }
  .article-sources h2 { margin: 0 0 var(--space-3); font-size: 18px; }
  .article-sources ul { margin: 0; padding-left: 20px; line-height: 1.8; }
  .article-sources a { color: var(--primary-dark); overflow-wrap: anywhere; }
  .guide-article { max-width: 1000px; margin: 0 auto var(--space-8); }
  .article-hero { padding: clamp(28px, 6vw, 56px); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--primary-soft), transparent 52%), var(--bg-elevated); box-shadow: var(--shadow-sm); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 13px; color: var(--text-tertiary); font-size: 12px; }
  .article-meta span:first-child { color: var(--primary-dark); font-weight: 700; }
  .article-hero h1 { max-width: 780px; margin: 18px 0 14px; font-size: clamp(30px, 5vw, 48px); letter-spacing: -.025em; line-height: 1.18; }
  .article-hero > p { max-width: 720px; margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.85; }
  .article-tool-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 25px; padding: 10px 14px; border-radius: var(--radius-full); background: var(--brand-ink); color: var(--bg-elevated); font-size: 13px; font-weight: 700; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 36px; margin-top: 42px; }
  .article-content { min-width: 0; color: var(--text-secondary); font-size: 15px; line-height: 1.9; }
  .article-content :global(h2) { margin: 34px 0 10px; color: var(--text); font-size: 22px; line-height: 1.35; }
  .article-content :global(p) { margin: 0 0 16px; }
  .article-content :global(ol), .article-content :global(ul) { display: grid; gap: 8px; margin: 0 0 18px; padding-left: 24px; }
  .article-content :global(li)::marker { color: var(--primary-dark); font-weight: 700; }
  .article-content :global(code) { padding: 2px 5px; border-radius: 5px; background: var(--bg-secondary); color: var(--brand-ink); font: 0.9em var(--font-mono); }
  .article-aside { display: grid; align-content: start; gap: 14px; }
  .aside-card { padding: 17px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); }
  .aside-card p { margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
  .aside-card .aside-label { margin-bottom: 8px; color: var(--text); font-weight: 700; }
  .aside-local { display: flex; gap: 9px; background: var(--bg-secondary); }
  .aside-local i { flex-shrink: 0; color: var(--primary-dark); }
  .article-faq { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--border-strong); }
  .article-faq h2 { margin: 0 0 14px; font-size: 22px; }
  .article-faq details { padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .article-faq summary { cursor: pointer; color: var(--text); font-weight: 600; }
  .article-faq details p { margin: 10px 0 0; color: var(--text-secondary); font-size: 14px; line-height: 1.75; }
  .article-footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px dashed var(--border-strong); font-size: 13px; }
  .article-footer a { color: var(--primary-dark); }
  @media (max-width: 780px) { .article-layout { grid-template-columns: 1fr; gap: 18px; margin-top: 30px; } .article-aside { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .article-aside { grid-template-columns: 1fr; } .article-footer { flex-direction: column; } }
</style>
