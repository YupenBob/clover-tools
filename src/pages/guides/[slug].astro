---
import GuideArticle from '../../components/GuideArticle.astro';
import { GUIDES } from '../../lib/guides';
import { getAllTools, getToolHref } from '../../lib/tools';
import { GUIDE_LABELS } from '../../lib/guide-labels';
import { guideAlternates, guideLanguageLinks } from '../../lib/guides-i18n';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
if (!guide) throw new Error('Guide not found');

const toolEntry = getAllTools().find((tool) => tool.slug === guide.toolSlug);
if (!toolEntry) throw new Error(`Guide tool not found: ${guide.toolSlug}`);
const toolHref = getToolHref(toolEntry.category, toolEntry.slug);
const languageLinks = guideLanguageLinks(guide.slug);
const alternates = guideAlternates(guide.slug);
---

<GuideArticle
  guide={guide}
  lang="zh"
  toolHref={toolHref}
  toolName={toolEntry.name}
  labels={GUIDE_LABELS.zh}
  languageLinks={languageLinks}
  alternates={alternates}
  indexable={true}
/>
