---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../lib/guides';
import { getAllTools, getToolHref } from '../../lib/tools';
import { SITE } from '../../lib/site';

const guideJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `实用指南 - ${SITE.name}`,
  description: '围绕开发、日常和数据处理场景整理的在线工具使用指南。',
  url: `${SITE.url}/guides/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: GUIDES.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: `${SITE.url}/guides/${guide.slug}/`,
    })),
  },
};

function toolLink(slug: string) {
  const found = getAllTools().find((tool) => tool.slug === slug);
  if (!found) throw new Error(`Guide tool not found: ${slug}`);
  return getToolHref(found.category, found.slug);
}
---

<BaseLayout
  title={`实用指南 - ${SITE.name}`}
  description="围绕开发、日常和数据处理场景整理的在线工具使用指南，包含输入示例、排错步骤、适用边界与参考来源，读完可直接回到工具操作。"
  keywords={['在线工具教程', '开发工具指南', 'JSON教程', '时间戳教程']}
  canonical={`${SITE.url}/guides/`}
  jsonLd={guideJsonLd}
>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/"><i class="bi bi-house-door" aria-hidden="true"></i> 首页</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>实用指南</span>
  </nav>

  <header class="guides-hero">
    <p class="guides-kicker">CloverTools / KNOWLEDGE BASE</p>
    <h1>把工具用明白</h1>
    <p>从一个具体问题出发，解释输入、结果、限制和排错路径。每篇指南都对应一个可以立即使用的工具。</p>
    <div class="guides-meta"><span>{GUIDES.length} 篇已校对指南</span><span>最后更新 2026-08-27</span></div>
  </header>

  <section class="guide-list" aria-label="指南列表">
    {GUIDES.map((guide, index) => (
      <article class="guide-card">
        <div class="guide-card-number">{String(index + 1).padStart(2, '0')}</div>
        <div class="guide-card-body">
          <div class="guide-card-topline"><span>{guide.category}</span><span>{guide.readingMinutes} 分钟阅读</span></div>
          <h2><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h2>
          <p>{guide.description}</p>
          <div class="guide-card-actions">
            <a class="guide-read" href={`/guides/${guide.slug}/`}>阅读指南 <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            <a class="guide-tool" href={toolLink(guide.toolSlug)}>打开工具 <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .guides-hero { position: relative; overflow: hidden; margin: 12px 0 var(--space-7); padding: clamp(28px, 6vw, 58px); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: linear-gradient(115deg, var(--brand-ink), #5e4e2c 54%, var(--primary-dark)); color: #fffaf0; box-shadow: var(--shadow-lg); }
  .guides-hero::after { position: absolute; right: -80px; bottom: -120px; width: 320px; height: 320px; border: 1px solid rgba(255,255,255,.22); border-radius: 50%; box-shadow: 0 0 0 34px rgba(255,255,255,.04), 0 0 0 68px rgba(255,255,255,.03); content: ''; }
  .guides-kicker { position: relative; z-index: 1; margin: 0 0 12px; color: var(--primary-light); font: 11px/1.4 var(--font-mono); letter-spacing: .16em; }
  .guides-hero h1 { position: relative; z-index: 1; margin: 0 0 14px; font-size: clamp(32px, 7vw, 58px); letter-spacing: -.03em; line-height: 1.08; }
  .guides-hero > p:not(.guides-kicker) { position: relative; z-index: 1; max-width: 620px; margin: 0; color: rgba(255,250,240,.82); font-size: 16px; line-height: 1.85; }
  .guides-meta { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 18px; margin-top: 28px; color: var(--primary-light); font-size: 12px; }
  .guide-list { display: grid; gap: 16px; margin-bottom: var(--space-8); }
  .guide-card { display: grid; grid-template-columns: 62px minmax(0, 1fr); gap: 18px; padding: 22px 24px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease; }
  .guide-card:hover { border-color: var(--primary-light); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .guide-card-number { align-self: start; color: var(--primary-dark); font: 700 22px/1 var(--font-mono); }
  .guide-card-topline { display: flex; flex-wrap: wrap; gap: 12px; color: var(--text-tertiary); font-size: 12px; }
  .guide-card-topline span:first-child { color: var(--primary-dark); font-weight: 700; }
  .guide-card h2 { margin: 9px 0 8px; font-size: 21px; line-height: 1.35; }
  .guide-card h2 a { color: var(--text); }
  .guide-card p { max-width: 760px; margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.75; }
  .guide-card-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 16px; font-size: 13px; }
  .guide-read, .guide-tool { display: inline-flex; align-items: center; gap: 6px; }
  .guide-read { color: var(--primary-dark); font-weight: 700; }
  .guide-tool { color: var(--text-tertiary); }
  @media (max-width: 560px) { .guide-card { grid-template-columns: 1fr; gap: 8px; padding: 18px; } .guide-card-number { font-size: 16px; } }
</style>
