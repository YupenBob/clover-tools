---
// @shared-tool-ui: five routes share the image compression workspace.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ImageCompress from '../../../../components/ImageCompress.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const lang = 'en' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'image-compress', lang);
const related = getRelated(category, tool.slug, lang);
---
<ToolLayout category={category} tool={tool} related={related} layout="wide" workspace="split">
  <ImageCompress lang={lang} />
</ToolLayout>
