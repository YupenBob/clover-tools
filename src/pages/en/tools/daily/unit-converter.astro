---
// @shared-tool-ui: localized routes share task-specific presentation and interaction.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import UnitConverter from '../../../../components/UnitConverter.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';
const lang = 'en' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'unit-converter', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <UnitConverter lang={lang} />
</ToolLayout>
