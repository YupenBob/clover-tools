---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'lunar-converter', 'en')!;
const related = getRelated(category, 'lunar-converter', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <div class="tool-layout">
    <ToolPanel title="Solar → Lunar" icon="bi-arrow-down">
      <div class="field">
        <label class="field-label" for="lcSolar">Solar date</label>
        <input class="input" id="lcSolar" type="date" />
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" id="lcToLunar" type="button"><i class="bi bi-moon-stars"></i> To Lunar</button>
        <button class="btn btn-ghost" id="lcSolarToday" type="button"><i class="bi bi-calendar-check"></i> Today</button>
      </div>
      <div class="status-msg" id="lcLunarStatus" role="status" aria-live="polite"></div>
      <div class="lc-result" id="lcLunarResult"></div>
    </ToolPanel>

    <ToolPanel title="Lunar → Solar" icon="bi-arrow-up">
      <div class="row">
        <div class="field">
          <label class="field-label" for="lcYear">Lunar year</label>
          <select class="select" id="lcYear"></select>
        </div>
        <div class="field">
          <label class="field-label" for="lcMonth">Lunar month</label>
          <select class="select" id="lcMonth"></select>
        </div>
        <div class="field">
          <label class="field-label" for="lcDay">Lunar day</label>
          <select class="select" id="lcDay"></select>
        </div>
      </div>
      <div class="row mt-3">
        <div class="field">
          <label class="field-label" for="lcLeap"><input type="checkbox" id="lcLeap" /> Leap month</label>
        </div>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" id="lcToSolar" type="button"><i class="bi bi-sun"></i> To Solar</button>
        <button class="btn btn-ghost" id="lcTodayLunar" type="button"><i class="bi bi-calendar-check"></i> Today</button>
      </div>
      <div class="status-msg" id="lcSolarStatus" role="status" aria-live="polite"></div>
      <div class="lc-result" id="lcSolarResult"></div>
    </ToolPanel>
  </div>
</ToolLayout>

<style>
  .lc-result {
    min-height: 90px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    font-size: 15px;
    line-height: 1.9;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';
  import { Solar, Lunar } from 'lunar-javascript';

  const CHINESE_DAYS = ['初一', '初二', '初三', '初四', '初五', '初六', '初七', '初八', '初九', '初十',
    '十一', '十二', '十三', '十四', '十五', '十六', '十七', '十八', '十九', '二十',
    '廿一', '廿二', '廿三', '廿四', '廿五', '廿六', '廿七', '廿八', '廿九', '三十'];

  const yearSel = byId<HTMLSelectElement>('lcYear');
  const monthSel = byId<HTMLSelectElement>('lcMonth');
  const daySel = byId<HTMLSelectElement>('lcDay');
  const now = new Date();

  for (let y = 1900; y <= 2100; y++) yearSel.add(new Option(String(y), String(y)));
  for (let m = 1; m <= 12; m++) monthSel.add(new Option(`Month ${m}`, String(m)));
  for (let d = 1; d <= 30; d++) daySel.add(new Option(CHINESE_DAYS[d - 1], String(d)));
  yearSel.value = String(now.getFullYear());

  function setTodaySolar() {
    byId<HTMLInputElement>('lcSolar').value =
      `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    convertToLunar();
  }

  function setTodayLunar() {
    const lunar = Solar.fromDate(now).getLunar();
    const isLeap = lunar.getMonth() < 0;
    yearSel.value = String(lunar.getYear());
    monthSel.value = String(Math.abs(lunar.getMonth()));
    daySel.value = String(lunar.getDay());
    byId<HTMLInputElement>('lcLeap').checked = isLeap;
    convertToSolar();
  }

  function convertToLunar() {
    hideStatus('lcLunarStatus');
    const val = byId<HTMLInputElement>('lcSolar').value;
    if (!val) {
      showStatus('lcLunarStatus', 'error', 'Please select a solar date');
      return;
    }
    const [y, m, d] = val.split('-').map(Number);
    const lunar = Solar.fromYmd(y, m, d).getLunar();
    byId<HTMLElement>('lcLunarResult').innerHTML =
      `<div>Lunar: ${lunar.getYearInChinese()}年 ${lunar.getMonthInChinese()}月${lunar.getDayInChinese()}</div>` +
      `<div>Ganzhi: ${lunar.getYearInGanZhi()}年 · ${lunar.getMonthInGanZhi()}月 · ${lunar.getDayInGanZhi()}日</div>` +
      `<div>Zodiac: ${lunar.getYearShengXiao()}${lunar.getMonth() < 0 ? ' · Leap month' : ''}</div>` +
      (lunar.getJieQi() ? `<div>Solar term: ${lunar.getJieQi()}</div>` : '');
    showStatus('lcLunarStatus', 'success', 'Conversion complete');
  }

  function convertToSolar() {
    hideStatus('lcSolarStatus');
    const y = Number(yearSel.value);
    const m = Number(monthSel.value);
    const d = Number(daySel.value);
    const leap = byId<HTMLInputElement>('lcLeap').checked;
    try {
      // In this library, leap months are represented by a negative month, e.g. -6 means leap sixth month
      const solar = Lunar.fromYmd(y, leap ? -m : m, d).getSolar();
      byId<HTMLElement>('lcSolarResult').textContent =
        `Solar: ${solar.toYmd()} (${['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][solar.getWeek()]})`;
      showStatus('lcSolarStatus', 'success', 'Conversion complete');
    } catch {
      showStatus('lcSolarStatus', 'error', 'This lunar date does not exist. Please check if "Leap month" is selected.');
    }
  }

  byId<HTMLButtonElement>('lcToLunar').addEventListener('click', convertToLunar);
  byId<HTMLButtonElement>('lcToSolar').addEventListener('click', convertToSolar);
  byId<HTMLButtonElement>('lcSolarToday').addEventListener('click', setTodaySolar);
  byId<HTMLButtonElement>('lcTodayLunar').addEventListener('click', setTodayLunar);
  setTodaySolar();
  setTodayLunar();
</script>