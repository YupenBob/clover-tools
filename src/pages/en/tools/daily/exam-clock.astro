---
// @shared-tool-ui: five thin routes share the exam clock workspace.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ExamClock from '../../../../components/ExamClock.astro';
import { getToolMeta } from '../../../../lib/i18n';
const lang = 'en' as const;
const category = 'daily' as const;
const baseTool = getToolMeta(category, 'exam-clock', lang);
const tool = baseTool;
const related = ['timer', 'world-clock', 'calendar'].map(slug => getToolMeta(category, slug, lang));
---
<ToolLayout category={category} tool={tool} related={related} layout="wide" workspace="canvas">
  <ExamClock lang={lang} />
</ToolLayout>
