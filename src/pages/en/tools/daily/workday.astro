---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'workday', 'en')!;
const related = getRelated(category, 'workday', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Date Range" icon="bi-briefcase">
    <div class="row">
      <div class="field">
        <label class="field-label" for="wdStart">Start Date</label>
        <input class="input" id="wdStart" type="date" />
      </div>
      <div class="field">
        <label class="field-label" for="wdEnd">End Date</label>
        <input class="input" id="wdEnd" type="date" />
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="wdBtn" type="button"><i class="bi bi-briefcase"></i> Calculate Workdays</button>
    </div>
    <div class="status-msg" id="wdStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">Automatically excludes weekends and identifies makeup workdays based on State Council holiday arrangements (working on holidays counts as workdays).</p>
  </ToolPanel>

  <ToolPanel title="Result" icon="bi-clipboard-data">
    <div class="lc-result" id="wdResult"></div>
  </ToolPanel>
</ToolLayout>

<style>
  .lc-result {
    min-height: 90px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    font-size: 15px;
    line-height: 1.9;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';
  import { HolidayUtil } from 'lunar-javascript';

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function calc() {
    hideStatus('wdStatus');
    const s = byId<HTMLInputElement>('wdStart').value;
    const e = byId<HTMLInputElement>('wdEnd').value;
    if (!s || !e) {
      showStatus('wdStatus', 'error', 'Please select a date range.');
      return;
    }
    const start = new Date(s + 'T00:00:00Z');
    const end = new Date(e + 'T00:00:00Z');
    if (end < start) {
      showStatus('wdStatus', 'error', 'End date cannot be earlier than start date.');
      return;
    }
    if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime()) || (end.getTime() - start.getTime()) / 86400000 > 36600) {
      showStatus('wdStatus', 'error', 'Choose a valid range of no more than 100 years.'); return;
    }
    const missingYears: number[] = [];
    for (let year = start.getUTCFullYear(); year <= end.getUTCFullYear(); year++) {
      if (!HolidayUtil.getHolidays(year).length) missingYears.push(year);
    }
    let workdays = 0;
    let holidays = 0;
    let makeups = 0;
    const cursor = new Date(start);
    while (cursor <= end) {
      const ymd = `${cursor.getUTCFullYear()}-${pad(cursor.getUTCMonth() + 1)}-${pad(cursor.getUTCDate())}`;
      const h = HolidayUtil.getHoliday(ymd);
      const weekend = cursor.getUTCDay() === 0 || cursor.getUTCDay() === 6;
      if (h) {
        if (h.isWork()) { workdays++; makeups++; }
        else { holidays++; }
      } else if (!weekend) {
        workdays++;
      } else { holidays++; }
      cursor.setUTCDate(cursor.getUTCDate() + 1);
    }
    const totalDays = Math.round((end.getTime() - start.getTime()) / 86400000) + 1;
    byId<HTMLElement>('wdResult').innerHTML =
      `<div>Workdays: <b>${workdays}</b> days (including ${makeups} makeup workdays)</div>` +
      `<div>Rest days (weekends and known holidays): ${holidays} days</div>` +
      `<div>Total days in range: ${totalDays} days</div>`;
    if (missingYears.length) showStatus('wdStatus', 'info', 'Holiday data is missing for these years; only weekday rules apply. Check official schedules: ' + missingYears.join(', '));
    else showStatus('wdStatus', 'success', 'Calculation complete.');
  }

  byId<HTMLButtonElement>('wdBtn').addEventListener('click', calc);
  const now = new Date();
  byId<HTMLInputElement>('wdStart').value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const end = new Date(now);
  end.setMonth(end.getMonth() + 1);
  byId<HTMLInputElement>('wdEnd').value = `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}`;
</script>