---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'symmetric-encrypt', 'en')!;
const related = getRelated(category, 'symmetric-encrypt', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Encryption / Decryption Config" icon="bi-lock">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="encSample" type="button"><i class="bi bi-magic"></i> Sample</button>
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="encAlgo">Algorithm</label>
        <select class="select" id="encAlgo">
          <option value="AES" selected>AES</option>
          <option value="DES">DES</option>
          <option value="RC4">RC4</option>
          <option value="Rabbit">Rabbit</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="encMode">Mode</label>
        <select class="select" id="encMode">
          <option value="CBC" selected>CBC</option>
          <option value="ECB">ECB</option>
          <option value="CFB">CFB</option>
          <option value="OFB">OFB</option>
          <option value="CTR">CTR</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="encOut">Output Format</label>
        <select class="select" id="encOut">
          <option value="base64" selected>Base64</option>
          <option value="hex">Hex</option>
        </select>
      </div>
    </div>
    <div class="field mt-3">
      <label class="field-label" for="encKey">Key</label>
      <input class="input mono" id="encKey" type="text" placeholder="Enter key" spellcheck="false" />
    </div>
    <div class="field">
      <label class="field-label" for="encIv">IV (CBC/CFB/OFB/CTR modes, hexadecimal)</label>
      <input class="input mono" id="encIv" type="text" placeholder="Leave blank to auto-generate" spellcheck="false" />
    </div>
    <div class="field">
      <label class="field-label" for="encInput">Plaintext / Ciphertext</label>
      <textarea class="textarea" id="encInput" spellcheck="false" placeholder="Enter plaintext to encrypt, or ciphertext to decrypt"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="encBtn" type="button"><i class="bi bi-lock"></i> Encrypt</button>
      <button class="btn btn-secondary" id="decBtn" type="button"><i class="bi bi-unlock"></i> Decrypt</button>
    </div>
    <div class="status-msg" id="encStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Output Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="encCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="encOutput" readonly spellcheck="false" placeholder="Result will be displayed here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample } from '../../../../scripts/toolkit';
  import CryptoJS from 'crypto-js';

  // Fixed salt + EvpKDF derived key: ensures both base64 and hex outputs can be decrypted back
  const KEY_SALT = CryptoJS.enc.Hex.parse('636c6f766572746f6f6c73');

  function deriveKey(key: string): CryptoJS.lib.WordArray {
    return CryptoJS.EvpKDF(key, KEY_SALT, {
      keySize: 256 / 32,
      iterations: 1,
      hasher: CryptoJS.algo.MD5,
    });
  }

  function options() {
    const algo = byId<HTMLSelectElement>('encAlgo').value;
    const modeName = byId<HTMLSelectElement>('encMode').value;
    const ivHex = byId<HTMLInputElement>('encIv').value.trim();
    const opts: CryptoJS.lib.CipherCfg = {};
    if (algo !== 'RC4' && algo !== 'Rabbit') {
      const modes: Record<string, typeof CryptoJS.mode.CBC> = {
        CBC: CryptoJS.mode.CBC,
        ECB: CryptoJS.mode.ECB,
        CFB: CryptoJS.mode.CFB,
        OFB: CryptoJS.mode.OFB,
        CTR: CryptoJS.mode.CTR,
      };
      opts.mode = modes[modeName];
      if (modeName !== 'ECB') {
        if (!ivHex) throw new Error('This mode requires a hexadecimal IV.');
        opts.iv = CryptoJS.enc.Hex.parse(ivHex);
      }
    } else if (ivHex) {
      opts.iv = CryptoJS.enc.Hex.parse(ivHex);
    }
    return { algo, opts };
  }

  function encrypt() {
    hideStatus('encStatus');
    const key = byId<HTMLInputElement>('encKey').value;
    const msg = byId<HTMLTextAreaElement>('encInput').value;
    if (!key || !msg) {
      showStatus('encStatus', 'error', 'Please enter a key and content.');
      return;
    }
    try {
      const { algo, opts } = options();
      const cipher = (CryptoJS as unknown as Record<string, { encrypt: (m: string, k: CryptoJS.lib.WordArray, o: CryptoJS.lib.CipherCfg) => CryptoJS.lib.CipherParams }>)[algo].encrypt(msg, deriveKey(key), opts);
      const out = byId<HTMLSelectElement>('encOut').value === 'hex'
        ? cipher.ciphertext.toString(CryptoJS.enc.Hex)
        : cipher.ciphertext.toString(CryptoJS.enc.Base64);
      byId<HTMLTextAreaElement>('encOutput').value = out;
      showStatus('encStatus', 'success', 'Encryption complete');
    } catch (e) {
      showStatus('encStatus', 'error', `Encryption failed: ${(e as Error).message}`);
    }
  }

  function decrypt() {
    hideStatus('encStatus');
    const key = byId<HTMLInputElement>('encKey').value;
    const ct = byId<HTMLTextAreaElement>('encInput').value.trim();
    if (!key || !ct) {
      showStatus('encStatus', 'error', 'Please enter a key and content.');
      return;
    }
    try {
      const { algo, opts } = options();
      const parsed = /^[0-9a-fA-F]+$/.test(ct)
        ? CryptoJS.enc.Hex.parse(ct)
        : CryptoJS.enc.Base64.parse(ct);
      const decrypted = (CryptoJS as unknown as Record<string, { decrypt: (c: CryptoJS.lib.CipherParams, k: CryptoJS.lib.WordArray, o: CryptoJS.lib.CipherCfg) => CryptoJS.lib.WordArray }>)[algo].decrypt(
        CryptoJS.lib.CipherParams.create({ ciphertext: parsed }),
        deriveKey(key),
        opts,
      );
      const text = decrypted.toString(CryptoJS.enc.Utf8);
      if (!text) throw new Error('Decryption result is empty. Check the key, IV, or mode.');
      byId<HTMLTextAreaElement>('encOutput').value = text;
      showStatus('encStatus', 'success', 'Decryption complete');
    } catch (e) {
      showStatus('encStatus', 'error', `Decryption failed: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('encBtn').addEventListener('click', encrypt);
  byId<HTMLButtonElement>('decBtn').addEventListener('click', decrypt);
  bindSample('encSample', 'encKey', 'clover-secret');
  bindCopyBtn('encCopy', () => byId<HTMLTextAreaElement>('encOutput').value);
</script>