---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'base-converter', 'en')!;
const related = getRelated(category, 'base-converter', 'en', 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Number Conversion" icon="bi-123">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="bcSample" type="button"><i class="bi bi-magic"></i> Sample</button>
      <button class="btn btn-ghost btn-sm" id="bcClear" type="button"><i class="bi bi-x-circle"></i> Clear</button>
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="bcValue">Value</label>
        <input class="input mono" id="bcValue" type="text" placeholder="Enter a number to convert" spellcheck="false" />
      </div>
      <div class="field">
        <label class="field-label" for="bcFrom">Source base</label>
        <select class="select" id="bcFrom">
          <option value="2">Binary</option>
          <option value="8">Octal</option>
          <option value="10" selected>Decimal</option>
          <option value="16">Hexadecimal</option>
          <option value="32">Base-32</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="bcTo">Target base</label>
        <select class="select" id="bcTo">
          <option value="2">Binary</option>
          <option value="8">Octal</option>
          <option value="10">Decimal</option>
          <option value="16" selected>Hexadecimal</option>
          <option value="32">Base-32</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="bcBtn" type="button"><i class="bi bi-arrow-repeat"></i> Convert</button>
    </div>
    <div class="status-msg" id="bcStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Conversion Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="bcCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="bcOutput" readonly spellcheck="false" placeholder="Result will appear here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz';

  function convert() {
    hideStatus('bcStatus');
    const raw = byId<HTMLInputElement>('bcValue').value.trim();
    const from = Number(byId<HTMLSelectElement>('bcFrom').value);
    const to = Number(byId<HTMLSelectElement>('bcTo').value);
    if (!raw) {
      showStatus('bcStatus', 'error', 'Please enter a value.');
      return;
    }
    const neg = raw.startsWith('-');
    const digits = (neg ? raw.slice(1) : raw).toLowerCase();
    try {
      let value = BigInt(0);
      for (const ch of digits) {
        const d = DIGITS.indexOf(ch);
        if (d === -1 || d >= from) throw new Error(`Character "${ch}" is not a valid base-${from} digit`);
        value = value * BigInt(from) + BigInt(d);
      }
      if (value === BigInt(0)) {
        byId<HTMLTextAreaElement>('bcOutput').value = '0';
      } else {
        let out = '';
        let v = value;
        while (v > BigInt(0)) {
          out = DIGITS[Number(v % BigInt(to))] + out;
          v /= BigInt(to);
        }
        byId<HTMLTextAreaElement>('bcOutput').value = (neg ? '-' : '') + out;
      }
      showStatus('bcStatus', 'success', 'Conversion complete (supports arbitrary-precision integers).');
    } catch (e) {
      showStatus('bcStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('bcBtn').addEventListener('click', convert);
  bindSample('bcSample', 'bcValue', '255');
  bindClear('bcClear', ['bcValue'], ['bcOutput'], 'bcStatus');
  bindCopyBtn('bcCopy', () => byId<HTMLTextAreaElement>('bcOutput').value);
</script>