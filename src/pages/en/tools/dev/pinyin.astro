---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'pinyin', 'en')!;
const related = getRelated(category, 'pinyin', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Input Chinese" icon="bi-translate">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pySample" type="button"><i class="bi bi-magic"></i> Sample</button>
      <button class="btn btn-ghost btn-sm" id="pyClear" type="button"><i class="bi bi-x-circle"></i> Clear</button>
    </div>
    <textarea class="textarea" id="pyInput" spellcheck="false" placeholder="Enter Chinese, e.g. 开发者工具箱"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="pyMode">Output Mode</label>
        <select class="select" id="pyMode">
          <option value="tone" selected>Full pinyin (with tones)</option>
          <option value="plain">Full pinyin (no tones)</option>
          <option value="first">Initials</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="pySep">Separator</label>
        <select class="select" id="pySep">
          <option value="" selected>None</option>
          <option value=" ">Space</option>
          <option value="-">Hyphen</option>
          <option value="_">Underscore</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="pyBtn" type="button"><i class="bi bi-translate"></i> Convert</button>
    </div>
    <div class="status-msg" id="pyStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Conversion Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pyCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="pyOutput" readonly spellcheck="false" placeholder="Pinyin result will appear here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  async function convert() {
    hideStatus('pyStatus');
    const src = byId<HTMLTextAreaElement>('pyInput').value;
    const mode = byId<HTMLSelectElement>('pyMode').value;
    const sep = byId<HTMLSelectElement>('pySep').value;
    if (!src) {
      showStatus('pyStatus', 'error', 'Please enter Chinese');
      return;
    }
    try {
      const { pinyin } = await import('pinyin-pro');
      const opts = mode === 'tone'
        ? { toneType: 'symbol' as const, type: 'array' as const }
        : mode === 'plain'
          ? { toneType: 'none' as const, type: 'array' as const }
          : { toneType: 'none' as const, pattern: 'first' as const, type: 'array' as const };
      const arr = pinyin(src, opts) as string[];
      byId<HTMLTextAreaElement>('pyOutput').value = arr.join(sep);
      showStatus('pyStatus', 'success', 'Conversion complete');
    } catch (e) {
      showStatus('pyStatus', 'error', `Conversion failed: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('pyBtn').addEventListener('click', convert);
  bindSample('pySample', 'pyInput', '开发者工具箱，打开即用');
  bindClear('pyClear', ['pyInput'], ['pyOutput'], 'pyStatus');
  bindCopyBtn('pyCopy', () => byId<HTMLTextAreaElement>('pyOutput').value);
</script>