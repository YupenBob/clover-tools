---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'js-formatter', 'en')!;
const related = getRelated(category, 'js-formatter', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JavaScript Input" icon="bi-filetype-js">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsSample" type="button"><i class="bi bi-magic"></i> Sample</button>
      <button class="btn btn-ghost btn-sm" id="jsClear" type="button"><i class="bi bi-x-circle"></i> Clear</button>
    </div>
    <textarea class="textarea" id="jsInput" spellcheck="false" placeholder="Paste JavaScript code"></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" id="jsFmt" type="button"><i class="bi bi-braces"></i> Format</button>
      <button class="btn btn-secondary" id="jsMin" type="button"><i class="bi bi-arrows-collapse"></i> Minify</button>
    </div>
    <div class="status-msg" id="jsStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Output Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="jsOutput" readonly spellcheck="false" placeholder="Result will appear here"></textarea>
    <div class="input-stats"><span id="jsStats">0 characters</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('jsInput');
  const output = byId<HTMLTextAreaElement>('jsOutput');

  async function runFormat() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'Please enter JavaScript code.');
      return;
    }
    try {
      showStatus('jsStatus', 'info', 'Loading formatter engine (about 1MB on first run)...');
      const prettier = await import('prettier/standalone');
      const babelPlugin = await import('prettier/plugins/babel');
      const estreePlugin = await import('prettier/plugins/estree');
      showStatus('jsStatus', 'info', 'Formatting...');
      output.value = await prettier.format(input.value, {
        parser: 'babel',
        plugins: [babelPlugin, estreePlugin] as never,
        semi: true,
        singleQuote: true,
        tabWidth: 2,
        printWidth: 100,
      });
      setStats('jsStats', `${output.value.length} characters`);
      showStatus('jsStatus', 'success', 'Formatting complete');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `Parsing failed: ${(e as Error).message}`);
    }
  }

  async function runMinify() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'Please enter JavaScript code.');
      return;
    }
    try {
      showStatus('jsStatus', 'info', 'Loading minifier...');
      const { minify: terserMinify } = await import('terser');
      showStatus('jsStatus', 'info', 'Minifying...');
      const result = await terserMinify(input.value, { mangle: true, compress: true });
      output.value = result.code || '';
      setStats('jsStats', `${output.value.length} characters`);
      showStatus('jsStatus', 'success', 'Minification complete');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `Minification failed: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('jsFmt').addEventListener('click', runFormat);
  byId<HTMLButtonElement>('jsMin').addEventListener('click', runMinify);
  bindSample('jsSample', 'jsInput', 'const tools=["json","base64"];function greet(name){return "Hello "+name} console.log(greet("Clover"));');
  bindClear('jsClear', ['jsInput'], ['jsOutput'], 'jsStatus');
  bindCopyBtn('jsCopy', () => output.value);
  setStats('jsStats', '0 characters');
</script>