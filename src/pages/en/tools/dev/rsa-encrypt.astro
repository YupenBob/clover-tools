---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'rsa-encrypt', 'en')!;
const related = getRelated(category, 'rsa-encrypt', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Key & Operations" icon="bi-key">
    <div class="btn-row">
      <button class="btn btn-primary" id="rsaGen" type="button"><i class="bi bi-key"></i> Generate Key Pair (2048)</button>
    </div>
    <div class="field mt-3">
      <label class="field-label" for="rsaPub">Public Key (PEM)</label>
      <textarea class="textarea" id="rsaPub" spellcheck="false" placeholder="Used by the encrypting party"></textarea>
    </div>
    <div class="field">
      <label class="field-label" for="rsaPriv">Private Key (PEM)</label>
      <textarea class="textarea" id="rsaPriv" spellcheck="false" placeholder="Used by the decrypting party, kept only on this device"></textarea>
    </div>
    <div class="field">
      <label class="field-label" for="rsaInput">Plaintext / Ciphertext (Base64)</label>
      <textarea class="textarea" id="rsaInput" spellcheck="false" placeholder="Enter plaintext to encrypt, or Base64 ciphertext to decrypt"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-secondary" id="rsaEnc" type="button"><i class="bi bi-lock"></i> Encrypt</button>
      <button class="btn btn-secondary" id="rsaDec" type="button"><i class="bi bi-unlock"></i> Decrypt</button>
    </div>
    <div class="status-msg" id="rsaStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">Based on the Web Crypto API (RSA-OAEP / SHA-256). Keys never leave the browser. The length of a single encrypted message is limited by the key size.</p>
  </ToolPanel>

  <ToolPanel title="Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rsaCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="rsaOutput" readonly spellcheck="false" placeholder="Result will appear here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  function ab2b64(buf: ArrayBuffer): string {
    const bytes = new Uint8Array(buf);
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  }

  function pem2buf(pem: string): ArrayBuffer {
    const b64 = pem.replace(/-----BEGIN [^-]+-----|-----END [^-]+-----/g, '').replace(/\s+/g, '');
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }

  function buf2pem(buf: ArrayBuffer, label: string): string {
    const b64 = ab2b64(buf).match(/.{1,64}/g)!.join('\n');
    return `-----BEGIN ${label}-----\n${b64}\n-----END ${label}-----`;
  }

  async function generate() {
    hideStatus('rsaStatus');
    try {
      const pair = await crypto.subtle.generateKey(
        { name: 'RSA-OAEP', modulusLength: 2048, publicExponent: new Uint8Array([1, 0, 1]), hash: 'SHA-256' },
        true,
        ['encrypt', 'decrypt'],
      );
      const pub = await crypto.subtle.exportKey('spki', pair.publicKey);
      const priv = await crypto.subtle.exportKey('pkcs8', pair.privateKey);
      byId<HTMLTextAreaElement>('rsaPub').value = buf2pem(pub, 'PUBLIC KEY');
      byId<HTMLTextAreaElement>('rsaPriv').value = buf2pem(priv, 'PRIVATE KEY');
      showStatus('rsaStatus', 'success', 'Key pair generated');
    } catch (e) {
      showStatus('rsaStatus', 'error', `Generation failed: ${(e as Error).message}`);
    }
  }

  async function encrypt() {
    hideStatus('rsaStatus');
    const pubPem = byId<HTMLTextAreaElement>('rsaPub').value.trim();
    const msg = byId<HTMLTextAreaElement>('rsaInput').value;
    if (!pubPem || !msg) {
      showStatus('rsaStatus', 'error', 'Please fill in the public key and plaintext');
      return;
    }
    try {
      const key = await crypto.subtle.importKey('spki', pem2buf(pubPem), { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['encrypt']);
      const enc = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, key, new TextEncoder().encode(msg));
      byId<HTMLTextAreaElement>('rsaOutput').value = ab2b64(enc);
      showStatus('rsaStatus', 'success', 'Encryption complete');
    } catch (e) {
      showStatus('rsaStatus', 'error', `Encryption failed: ${(e as Error).message}`);
    }
  }

  async function decrypt() {
    hideStatus('rsaStatus');
    const privPem = byId<HTMLTextAreaElement>('rsaPriv').value.trim();
    const ct = byId<HTMLTextAreaElement>('rsaInput').value.trim();
    if (!privPem || !ct) {
      showStatus('rsaStatus', 'error', 'Please fill in the private key and ciphertext');
      return;
    }
    try {
      const key = await crypto.subtle.importKey('pkcs8', pem2buf(privPem), { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['decrypt']);
      const dec = await crypto.subtle.decrypt({ name: 'RSA-OAEP' }, key, pem2buf(`-----BEGIN CT-----\n${ct}\n-----END CT-----`));
      byId<HTMLTextAreaElement>('rsaOutput').value = new TextDecoder().decode(dec);
      showStatus('rsaStatus', 'success', 'Decryption complete');
    } catch (e) {
      showStatus('rsaStatus', 'error', `Decryption failed: key mismatch or corrupted ciphertext`);
    }
  }

  byId<HTMLButtonElement>('rsaGen').addEventListener('click', generate);
  byId<HTMLButtonElement>('rsaEnc').addEventListener('click', encrypt);
  byId<HTMLButtonElement>('rsaDec').addEventListener('click', decrypt);
  bindCopyBtn('rsaCopy', () => byId<HTMLTextAreaElement>('rsaOutput').value);
</script>