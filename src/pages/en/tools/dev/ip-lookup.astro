---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'ip-lookup', 'en')!;
const related = getRelated(category, 'ip-lookup', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="My IP" icon="bi-globe2">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ipSelfCopy" type="button">
        <i class="bi bi-clipboard" aria-hidden="true"></i> Copy
      </button>
      <button class="btn btn-ghost btn-sm" id="ipSelfRefresh" type="button">
        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
      </button>
    </div>
    <div class="ip-hero">
      <span class="ip-hero-label">Current public IP</span>
      <span class="ip-hero-value mono" id="ipSelfValue">--</span>
      <span class="ip-hero-sub mono" id="ipSelfMeta"></span>
    </div>
    <div class="status-msg" id="ipSelfStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="IP Address Lookup" icon="bi-hash">
    <div class="row">
      <div class="field field-grow">
        <label class="field-label" for="ipInput">IP address or domain</label>
        <input class="input mono" id="ipInput" type="text" placeholder="8.8.8.8 · 2001:4860:4860::8888 · example.com" spellcheck="false" autocomplete="off" />
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="ipQuery" type="button">
        <i class="bi bi-search" aria-hidden="true"></i> Resolve and Lookup
      </button>
      <button class="btn btn-ghost" id="ipPaste" type="button">
        <i class="bi bi-clipboard" aria-hidden="true"></i> Paste
      </button>
      <button class="btn btn-ghost" id="ipSample" type="button">
        <i class="bi bi-magic" aria-hidden="true"></i> Sample
      </button>
      <button class="btn btn-ghost" id="ipClear" type="button">
        <i class="bi bi-x-circle" aria-hidden="true"></i> Clear
      </button>
    </div>
    <p class="field-hint">Address resolution is done entirely in your browser. After you enter a valid address, geolocation is looked up automatically, or you can click the button anytime.</p>
    <div class="status-msg" id="ipParseStatus" role="status" aria-live="polite"></div>
    <div class="ip-empty" id="ipParseEmpty">Enter an IP or domain to resolve it automatically (computed locally, no network required)</div>
    <div id="ipParseWrap" hidden>
      <div class="ip-summary" id="ipSummary"></div>
      <div class="ip-section">
        <h3 class="ip-section-title">Address Info</h3>
        <div class="ip-kv" id="ipParseTable"></div>
      </div>
      <div class="ip-section" id="ipSubnetWrap" hidden>
        <h3 class="ip-section-title">
          Subnet Info
          <span class="ip-prefix-wrap">
            <select class="select select-inline" id="ipPrefix" aria-label="Subnet prefix"></select>
          </span>
        </h3>
        <div class="ip-kv" id="ipSubnetTable"></div>
      </div>
    </div>
  </ToolPanel>

  <ToolPanel title="Geolocation Info" icon="bi-globe-americas">
    <div class="status-msg" id="ipGeoStatus" role="status" aria-live="polite"></div>
    <div class="ip-empty" id="ipGeoEmpty">After lookup, country, ISP, coordinates and other geolocation details are shown (online lookup)</div>
    <div id="ipGeoWrap" hidden>
      <div class="ip-kv" id="ipGeoTable"></div>
      <div class="ip-geo-foot">
        <a class="link-btn" id="ipMapLink" href="#" target="_blank" rel="noopener noreferrer" hidden>
          <i class="bi bi-link-45deg" aria-hidden="true"></i> View on map
        </a>
        <span class="field-hint" id="ipGeoSource"></span>
      </div>
    </div>
  </ToolPanel>
</ToolLayout>
<style is:global>
  /* 面板之间的空隙 */
  .tool-card-panel + .tool-card-panel {
    margin-top: var(--space-4);
  }

  /* ── 本机 IP Hero ── */
  .ip-hero {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(ellipse 80% 130% at 90% -20%, rgba(var(--primary-rgb), 0.12), transparent 55%),
      var(--bg-secondary);
  }

  .ip-hero-label {
    font-size: 12.5px;
    color: var(--text-tertiary);
  }

  .ip-hero-value {
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 700;
    color: var(--text);
    word-break: break-all;
    letter-spacing: 0.5px;
  }

  .ip-hero-sub {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* ── 通用 ── */
  .field-grow {
    flex: 3 1 320px !important;
  }

  .ip-empty {
    padding: var(--space-5) 0;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 13.5px;
  }

  .ip-section {
    margin-top: var(--space-4);
  }

  .ip-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-2);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .select-inline {
    width: auto;
    height: 32px;
    padding: 0 8px;
    font-size: 13px;
  }

  .ip-prefix-wrap {
    display: inline-flex;
    margin-left: auto;
  }

  /* ── 摘要徽章 ── */
  .ip-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .ip-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 11px;
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ip-badge-public {
    background: var(--success-soft);
    color: var(--success);
  }

  .ip-badge-private,
  .ip-badge-cgnat {
    background: var(--warning-soft);
    color: var(--warning);
  }

  .ip-badge-loopback,
  .ip-badge-linklocal,
  .ip-badge-ula,
  .ip-badge-6to4,
  .ip-badge-nat64 {
    background: var(--info-soft);
    color: var(--info);
  }

  .ip-badge-reserved,
  .ip-badge-documentation,
  .ip-badge-benchmark,
  .ip-badge-unspecified {
    background: var(--bg-tertiary);
    color: var(--text-tertiary);
  }

  .ip-badge-multicast {
    background: rgba(147, 90, 220, 0.14);
    color: #8b5fd6;
  }

  .ip-badge-broadcast {
    background: var(--error-soft);
    color: var(--error);
  }

  .ip-summary-value {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    word-break: break-all;
    min-width: 0;
  }

  .ip-summary-note {
    color: var(--text-tertiary);
    font-size: 12.5px;
  }

  /* ── 键值行 ── */
  .ip-kv {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .ip-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .ip-row:last-child {
    border-bottom: none;
  }

  .ip-k {
    flex: 0 0 118px;
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .ip-v {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text);
    word-break: break-all;
  }

  .ip-v .flag {
    font-family: var(--font-sans);
    margin-right: 6px;
  }

  .ip-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: 0 0 26px;
    margin-left: 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-tertiary);
    font-size: 12px;
    cursor: pointer;
    vertical-align: middle;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .ip-copy:hover {
    border-color: var(--primary);
    color: var(--primary-dark);
    background: var(--primary-soft);
  }

  .ip-copy.success {
    border-color: var(--success);
    color: var(--success);
    background: var(--success-soft);
  }

  /* ── 域名解析结果 chips ── */
  .ip-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ip-chip {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12.5px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .ip-chip:hover {
    border-color: var(--primary);
    color: var(--primary-dark);
    background: var(--primary-soft);
  }

  /* ── 归属地脚注 ── */
  .ip-geo-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  @media (max-width: 640px) {
    .ip-row {
      flex-wrap: wrap;
      gap: 4px 8px;
    }

    .ip-k {
      flex-basis: 100%;
    }

    .ip-v {
      flex-basis: calc(100% - 34px);
    }

    .ip-hero-value {
      font-size: 21px;
    }
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';

  /* ═══════════ IP 解析引擎（纯本地） ═══════════ */

  type V4Range = {
    prefix: number;
    len: number;
    label: string;
    kind: string;
    note: string;
    rfc: string;
    range: string;
  };

  const V4_RANGES: V4Range[] = [
    { prefix: 0x00000000, len: 8, label: 'This network (0.0.0.0/8)', kind: 'reserved', note: 'Represents “this host on this network”', rfc: 'RFC 791', range: '0.0.0.0/8' },
    { prefix: 0x0a000000, len: 8, label: 'Private address (10.0.0.0/8)', kind: 'private', note: 'Addresses dedicated to local area networks', rfc: 'RFC 1918', range: '10.0.0.0/8' },
    { prefix: 0x64400000, len: 10, label: 'Carrier-grade NAT (100.64.0.0/10)', kind: 'cgnat', note: 'CGNAT shared address space', rfc: 'RFC 6598', range: '100.64.0.0/10' },
    { prefix: 0x7f000000, len: 8, label: 'Loopback address (127.0.0.0/8)', kind: 'loopback', note: 'Local loopback test address', rfc: 'RFC 1122', range: '127.0.0.0/8' },
    { prefix: 0xa9fe0000, len: 16, label: 'Link-local (169.254.0.0/16)', kind: 'linklocal', note: 'Auto-configured link-local address', rfc: 'RFC 3927', range: '169.254.0.0/16' },
    { prefix: 0xac100000, len: 12, label: 'Private address (172.16.0.0/12)', kind: 'private', note: 'Addresses dedicated to local area networks', rfc: 'RFC 1918', range: '172.16.0.0/12' },
    { prefix: 0xc0000000, len: 24, label: 'IETF protocol assignment (192.0.0.0/24)', kind: 'reserved', note: 'IANA protocol special purpose', rfc: 'RFC 6890', range: '192.0.0.0/24' },
    { prefix: 0xc0000200, len: 24, label: 'Documentation example (192.0.2.0/24)', kind: 'documentation', note: 'TEST-NET-1, documentation example address', rfc: 'RFC 5737', range: '192.0.2.0/24' },
    { prefix: 0xc0586300, len: 24, label: '6to4 relay (192.88.99.0/24)', kind: 'reserved', note: '6to4 relay anycast (deprecated)', rfc: 'RFC 7526', range: '192.88.99.0/24' },
    { prefix: 0xc0a80000, len: 16, label: 'Private address (192.168.0.0/16)', kind: 'private', note: 'Addresses dedicated to local area networks', rfc: 'RFC 1918', range: '192.168.0.0/16' },
    { prefix: 0xc6120000, len: 15, label: 'Benchmark testing (198.18.0.0/15)', kind: 'benchmark', note: 'Network device benchmark test address', rfc: 'RFC 2544', range: '198.18.0.0/15' },
    { prefix: 0xc6336400, len: 24, label: 'Documentation example (198.51.100.0/24)', kind: 'documentation', note: 'TEST-NET-2, documentation example address', rfc: 'RFC 5737', range: '198.51.100.0/24' },
    { prefix: 0xcb007100, len: 24, label: 'Documentation example (203.0.113.0/24)', kind: 'documentation', note: 'TEST-NET-3, documentation example address', rfc: 'RFC 5737', range: '203.0.113.0/24' },
    { prefix: 0xe0000000, len: 4, label: 'Multicast address (224.0.0.0/4)', kind: 'multicast', note: 'Class D multicast address', rfc: 'RFC 5771', range: '224.0.0.0/4' },
    { prefix: 0xf0000000, len: 4, label: 'Reserved address (240.0.0.0/4)', kind: 'reserved', note: 'Class E reserved address', rfc: 'RFC 1112', range: '240.0.0.0/4' },
  ];

  type V6Range = {
    pre: bigint;
    len: number;
    label: string;
    kind: string;
    note: string;
    rfc: string;
    range: string;
  };

  const S128 = 1n << 128n;
  const V6_RANGES: V6Range[] = [
    { pre: 0n, len: 128, label: 'Unspecified address (::/128)', kind: 'unspecified', note: 'Indicates a missing or unknown address', rfc: 'RFC 4291', range: '::/128' },
    { pre: 1n, len: 128, label: 'Loopback address (::1/128)', kind: 'loopback', note: 'Local loopback test address', rfc: 'RFC 4291', range: '::1/128' },
    { pre: 0xffffn << 32n, len: 96, label: 'IPv4-mapped address (::ffff:0:0/96)', kind: 'reserved', note: 'Used to represent IPv4 addresses in IPv6', rfc: 'RFC 4291', range: '::ffff:0:0/96' },
    { pre: 0x0064ff9bn << 96n, len: 96, label: 'NAT64 prefix (64:ff9b::/96)', kind: 'nat64', note: 'NAT64 translation address', rfc: 'RFC 6052', range: '64:ff9b::/96' },
    { pre: 0x20010db8n << 96n, len: 32, label: 'Documentation example (2001:db8::/32)', kind: 'documentation', note: 'Documentation and example address', rfc: 'RFC 3849', range: '2001:db8::/32' },
    { pre: 0x2001n << 112n, len: 23, label: 'IETF protocol assignment (2001::/23)', kind: 'reserved', note: 'IANA protocol special purpose', rfc: 'RFC 2928', range: '2001::/23' },
    { pre: 0x0100n << 112n, len: 64, label: 'Deprecated address (100::/64)', kind: 'reserved', note: 'Deprecated prefix', rfc: 'RFC 6666', range: '100::/64' },
    { pre: 0x2002n << 112n, len: 16, label: '6to4 address (2002::/16)', kind: '6to4', note: '6to4 automatic tunnel address', rfc: 'RFC 3056', range: '2002::/16' },
    { pre: 0xfc00n << 112n, len: 7, label: 'Unique local address (fc00::/7)', kind: 'ula', note: 'ULA local unique address', rfc: 'RFC 4193', range: 'fc00::/7' },
    { pre: 0xfe80n << 112n, len: 10, label: 'Link-local (fe80::/10)', kind: 'linklocal', note: 'Auto-configured address on the same link', rfc: 'RFC 4291', range: 'fe80::/10' },
    { pre: 0xff00n << 112n, len: 8, label: 'Multicast address (ff00::/8)', kind: 'multicast', note: 'IPv6 multicast address', rfc: 'RFC 4291', range: 'ff00::/8' },
  ];

  interface IpAnalysis {
    raw: string;
    version: 4 | 6;
    normalized: string;
    v4?: { octets: number[]; int: number; decimal: string; hex: string; binary: string; mapped6: string };
    v6?: { groups: string[]; expanded: string; compressed: string; embeddedV4?: string };
    cls: V4Range | V6Range;
    subnet?: { cidr: string; network: string; broadcast: string; start: string; end: string; usable: string; total: string };
    defaultPrefix: number;
  }

  function parseIpv4(input: string): number[] | null {
    const parts = input.split('.');
    if (parts.length !== 4) return null;
    const octets = parts.map((p) => {
      if (!/^\d{1,3}$/.test(p) || /^0\d/.test(p)) return NaN;
      return Number(p);
    });
    if (octets.some((o) => Number.isNaN(o) || o > 255)) return null;
    return octets;
  }

  function ipv4ToInt(octets: number[]): number {
    return ((octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3]) >>> 0;
  }

  function intToIpv4(n: number): string {
    return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
  }

  function parseIpv6(input: string): { groups: string[]; tailV4: number[] | null } | null {
    let s = input.toLowerCase().trim().split('%')[0];
    if (!s.includes(':')) return null;
    let tailV4: number[] | null = null;

    if (s.includes('.')) {
      const m = s.match(/^(.+):([0-9.]+)$/);
      if (!m) return null;
      const v4 = parseIpv4(m[2]);
      if (!v4) return null;
      tailV4 = v4;
      const hi = ((v4[0] << 8) | v4[1]).toString(16).padStart(4, '0');
      const lo = ((v4[2] << 8) | v4[3]).toString(16).padStart(4, '0');
      s = `${m[1]}:${hi}:${lo}`;
    }

    if (!/^[0-9a-f:]+$/.test(s)) return null;
    if (s.split('::').length > 2) return null;

    let groups: string[];
    if (s.includes('::')) {
      const [left, right] = s.split('::');
      const l = left ? left.split(':') : [];
      const r = right ? right.split(':') : [];
      const missing = 8 - l.length - r.length;
      if (missing <= 0) return null;
      groups = [...l, ...Array(missing).fill('0'), ...r];
    } else {
      groups = s.split(':');
      if (groups.length !== 8) return null;
    }
    if (groups.length !== 8) return null;
    for (const g of groups) if (!/^[0-9a-f]{1,4}$/.test(g)) return null;
    return { groups, tailV4 };
  }

  function ipv6ToBigint(groups: string[]): bigint {
    return BigInt('0x' + groups.join(''));
  }

  function expandIpv6(groups: string[]): string {
    return groups.map((g) => g.padStart(4, '0')).join(':');
  }

  function compressIpv6(groups: string[]): string {
    let bestStart = -1;
    let bestLen = 0;
    let curStart = -1;
    let curLen = 0;
    groups.forEach((g, i) => {
      if (g === '0000') {
        if (curStart === -1) curStart = i;
        curLen++;
        if (curLen > bestLen) {
          bestLen = curLen;
          bestStart = curStart;
        }
      } else {
        curStart = -1;
        curLen = 0;
      }
    });
    const norm = groups.map((g) => g.replace(/^0+(?=[0-9a-f])/, ''));
    if (bestLen < 2) return norm.join(':');
    const head = norm.slice(0, bestStart).join(':');
    const tail = norm.slice(bestStart + bestLen).join(':');
    return `${head}::${tail}`;
  }

  function groupsV4Pair(groups: string[], a: number, b: number): string {
    const o1 = parseInt(groups[a], 16) >> 8;
    const o2 = parseInt(groups[a], 16) & 255;
    const o3 = parseInt(groups[b], 16) >> 8;
    const o4 = parseInt(groups[b], 16) & 255;
    return `${o1}.${o2}.${o3}.${o4}`;
  }

  function embeddedV4(groups: string[]): string | null {
    const isZero = (i: number) => groups[i] === '0000';
    if (isZero(0) && isZero(1) && isZero(2) && isZero(3) && isZero(4) && groups[5] === 'ffff') {
      return groupsV4Pair(groups, 6, 7);
    }
    if (groups[0] === '2002') return groupsV4Pair(groups, 1, 2);
    if (groups[0] === '0064' && groups[1] === 'ff9b' && isZero(2) && isZero(3) && isZero(4) && isZero(5)) {
      return groupsV4Pair(groups, 6, 7);
    }
    return null;
  }

  function classifyV4(int: number): V4Range {
    if (int === 0xffffffff) {
      return { prefix: 0xffffffff, len: 32, label: 'Limited broadcast (255.255.255.255)', kind: 'broadcast', note: 'Limited broadcast address, local subnet only', rfc: 'RFC 919', range: '255.255.255.255/32' };
    }
    for (const r of V4_RANGES) {
      const mask = r.len === 0 ? 0 : (0xffffffff << (32 - r.len)) >>> 0;
      if (((int & mask) >>> 0) === r.prefix) return r;
    }
    return { prefix: 0, len: 0, label: 'Public IPv4', kind: 'public', note: 'Globally routable public address', rfc: 'IANA global unicast address space', range: '0.0.0.0/0' };
  }

  function classifyV6(big: bigint): V6Range {
    for (const r of V6_RANGES) {
      const mask = S128 - (1n << (128n - BigInt(r.len)));
      if ((big & mask) === r.pre) return r;
    }
    return { pre: 0n, len: 0, label: 'Public IPv6 (global unicast)', kind: 'public', note: 'Globally routable IPv6 address', rfc: 'IANA global unicast address space', range: '2000::/3' };
  }

  function subnetV4(int: number, prefix: number) {
    const mask = prefix === 0 ? 0 : (0xffffffff << (32 - prefix)) >>> 0;
    const network = (int & mask) >>> 0;
    const broadcast = (int | ~mask) >>> 0;
    const total = Math.pow(2, 32 - prefix);
    const usable = prefix >= 31 ? total : total - 2;
    return {
      cidr: `${intToIpv4(network)}/${prefix}`,
      network: intToIpv4(network),
      broadcast: intToIpv4(broadcast),
      start: intToIpv4((network + 1) >>> 0),
      end: intToIpv4((broadcast - 1) >>> 0),
      usable: usable.toLocaleString('zh-CN'),
      total: total.toLocaleString('zh-CN'),
    };
  }

  function analyzeIp(raw: string): IpAnalysis | null {
    const input = raw.trim();
    const v4 = parseIpv4(input);
    if (v4) {
      const int = ipv4ToInt(v4);
      const cls = classifyV4(int);
      const defaultPrefix = cls.len > 0 ? cls.len : 24;
      return {
        raw: input,
        version: 4,
        normalized: input,
        v4: {
          octets: v4,
          int,
          decimal: String(int),
          hex: '0x' + int.toString(16).padStart(8, '0'),
          binary: v4.map((o) => o.toString(2).padStart(8, '0')).join('.'),
          mapped6: `::ffff:${input}`,
        },
        cls,
        subnet: subnetV4(int, defaultPrefix),
        defaultPrefix,
      };
    }
    const v6 = parseIpv6(input);
    if (v6) {
      const groups = v6.groups.map((g) => g.padStart(4, '0'));
      const big = ipv6ToBigint(groups);
      const cls = classifyV6(big);
      return {
        raw: input,
        version: 6,
        normalized: compressIpv6(groups),
        v6: {
          groups,
          expanded: expandIpv6(groups),
          compressed: compressIpv6(groups),
          embeddedV4: embeddedV4(groups) || (v6.tailV4 ? v6.tailV4.join('.') : undefined),
        },
        cls,
        defaultPrefix: 64,
      };
    }
    return null;
  }

  /* ═══════════ 在线归属地 ═══════════ */

  interface GeoInfo {
    ip: string | null;
    version?: number;
    country: string | null;
    countryCode: string | null;
    flag: string;
    region: string | null;
    city: string | null;
    postal: string | null;
    continent: string | null;
    timezone: string | null;
    utcOffset: string | null;
    asn: string | null;
    org: string | null;
    isp: string | null;
    lat: number | null;
    lon: number | null;
    source: string;
  }

  function flagEmoji(cc: string): string {
    if (!/^[A-Za-z]{2}$/.test(cc)) return '';
    return String.fromCodePoint(...[...cc.toUpperCase()].map((c) => 127397 + c.charCodeAt(0)));
  }

  function num(v: unknown): number | null {
    if (typeof v === 'number') return Number.isFinite(v) ? v : null;
    if (typeof v === 'string' && v !== '' && Number.isFinite(Number(v))) return Number(v);
    return null;
  }

  function normalizeGeo(raw: Record<string, unknown>, source: string): GeoInfo | null {
    if (!raw || typeof raw !== 'object') return null;
    const conn = (raw.connection || {}) as Record<string, unknown>;
    const flagObj = raw.flag as Record<string, unknown> | undefined;
    const cc = (raw.country_code || raw.countryCode || null) as string | null;
    const asnRaw = raw.asn ?? conn.asn ?? null;
    const asn = asnRaw !== null && asnRaw !== undefined && asnRaw !== '' ? (String(asnRaw).startsWith('AS') ? String(asnRaw) : `AS${String(asnRaw)}`) : null;
    return {
      ip: (raw.ip as string) || null,
      version: raw.version as number | undefined,
      country: (raw.country_name || raw.country || null) as string | null,
      countryCode: cc,
      flag: flagObj?.emoji ? String(flagObj.emoji) : cc ? flagEmoji(cc) : '',
      region: (raw.region || null) as string | null,
      city: (raw.city || null) as string | null,
      postal: (raw.postal || null) as string | null,
      continent: (raw.continent_code || raw.continent || null) as string | null,
      timezone: (raw.timezone || null) as string | null,
      utcOffset: (raw.utc_offset || raw.offset || null) as string | null,
      asn,
      org: (raw.org || conn.org || null) as string | null,
      isp: (conn.isp || null) as string | null,
      lat: num(raw.latitude),
      lon: num(raw.longitude),
      source,
    };
  }

  async function fetchJson(url: string, ms = 8000): Promise<Record<string, unknown>> {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), ms);
    try {
      const res = await fetch(url, { signal: ctrl.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return (await res.json()) as Record<string, unknown>;
    } finally {
      clearTimeout(timer);
    }
  }

  const SOURCE_NAME: Record<string, string> = {
    cloudflare: 'Cloudflare Edge',
    ipapi: 'ipapi.co',
    ipwhois: 'ipwho.is',
  };

  async function lookupOnline(ip: string, viaWorker: boolean): Promise<GeoInfo | null> {
    const urls: string[] = [];
    const sources: string[] = [];
    if (viaWorker) {
      urls.push(`/api/ip?ip=${encodeURIComponent(ip)}`);
      sources.push('cloudflare');
    }

    for (let i = 0; i < urls.length; i++) {
      try {
        const raw = await fetchJson(urls[i]);
        if (raw.error || raw.success === false) continue;
        const geo = normalizeGeo(raw, SOURCE_NAME[sources[i]]);
        if (geo && geo.country) return geo;
      } catch {
        /* try next */
      }
    }
    return null;
  }

  async function lookupSelf(): Promise<GeoInfo | null> {
    const urls = ['/api/ip'];
    const sources = ['cloudflare'];
    for (let i = 0; i < urls.length; i++) {
      try {
        const raw = await fetchJson(urls[i]);
        if (raw.error || raw.success === false) continue;
        const geo = normalizeGeo(raw, SOURCE_NAME[sources[i]]);
        if (geo && geo.ip && geo.ip !== 'unknown') return geo;
      } catch {
        /* try next */
      }
    }
    return null;
  }

  async function resolveDomain(name: string): Promise<string[]> {
    const out: string[] = [];
    const providers = [
      (n: string, t: number) => `https://dns.alidns.com/resolve?name=${encodeURIComponent(n)}&type=${t}`,
      (n: string, t: number) => `https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(n)}&type=${t}`,
    ];
    for (const type of [1, 28]) {
      for (const build of providers) {
        try {
          const res = await fetch(build(name, type), { headers: { accept: 'application/dns-json' } });
          if (!res.ok) continue;
          const data = (await res.json()) as { Answer?: Array<{ type: number; data: string }> };
          const found = (data.Answer || []).filter((a) => a.type === type && a.data).map((a) => a.data);
          if (found.length) {
            out.push(...found);
            break;
          }
        } catch {
          /* try next provider */
        }
      }
    }
    return out;
  }

  /* ═══════════ UI 渲染 ═══════════ */

  const $ = <T extends HTMLElement>(id: string): T => byId<T>(id);

  function esc(v: unknown): string {
    return String(v ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function kvRow(label: string, value: string, copyText?: string): string {
    const copy = copyText
      ? `<button class="ip-copy" type="button" data-copy="${esc(copyText)}" title="Copy"><i class="bi bi-clipboard" aria-hidden="true"></i></button>`
      : '';
    return `<div class="ip-row"><span class="ip-k">${esc(label)}</span><span class="ip-v">${value}${copy}</span></div>`;
  }

  function badgeHtml(cls: { kind: string; label: string }): string {
    return `<span class="ip-badge ip-badge-${esc(cls.kind)}">${esc(cls.label)}</span>`;
  }

  function renderParse(a: IpAnalysis, note?: string): void {
    $<HTMLElement>('ipParseEmpty').hidden = true;
    $<HTMLElement>('ipParseWrap').hidden = false;

    const cls = a.cls as V4Range & V6Range;
    $<HTMLElement>('ipSummary').innerHTML =
      `${badgeHtml(cls)}<span class="ip-summary-value">${esc(a.normalized)}</span>` +
      (note ? `<span class="ip-summary-note">${esc(note)}</span>` : '');

    const rows: string[] = [];
    rows.push(kvRow('Address Type', a.version === 4 ? 'IPv4' : 'IPv6', a.version === 4 ? 'IPv4' : 'IPv6'));
    rows.push(kvRow('Address Class', `${esc(cls.label)} (${esc(cls.range)})`));
    if (cls.note) rows.push(kvRow('Note', esc(cls.note)));
    if (cls.rfc) rows.push(kvRow('Reference Standard', esc(cls.rfc), cls.rfc));

    if (a.v4) {
      rows.push(kvRow('Decimal', esc(a.v4.decimal), a.v4.decimal));
      rows.push(kvRow('Hexadecimal', esc(a.v4.hex), a.v4.hex));
      rows.push(kvRow('Binary', esc(a.v4.binary), a.v4.binary));
      rows.push(kvRow('IPv6 Mapped', esc(a.v4.mapped6), a.v4.mapped6));
    }
    if (a.v6) {
      rows.push(kvRow('Expanded Form', esc(a.v6.expanded), a.v6.expanded));
      rows.push(kvRow('Compressed Form', esc(a.v6.compressed), a.v6.compressed));
      if (a.v6.embeddedV4) rows.push(kvRow('Embedded IPv4', esc(a.v6.embeddedV4), a.v6.embeddedV4));
    }
    $<HTMLElement>('ipParseTable').innerHTML = rows.join('');

    if (a.version === 4 && a.subnet) {
      renderSubnet(a);
    } else {
      $<HTMLElement>('ipSubnetWrap').hidden = true;
    }
  }

  function renderSubnet(a: IpAnalysis): void {
    const sel = $<HTMLSelectElement>('ipPrefix');
    sel.innerHTML = '';
    const options = a.cls.len > 0 ? [a.cls.len] : [8, 16, 24, 28, 30, 31, 32];
    for (const p of options) {
      const opt = document.createElement('option');
      opt.value = String(p);
      opt.textContent = `/${p}`;
      if (p === a.defaultPrefix) opt.selected = true;
      sel.appendChild(opt);
    }
    $<HTMLElement>('ipSubnetWrap').hidden = false;
    applySubnet(a);
  }

  function applySubnet(a: IpAnalysis): void {
    if (!a.v4 || !a.subnet) return;
    const prefix = Number($<HTMLSelectElement>('ipPrefix').value);
    const s = subnetV4(a.v4.int, prefix);
    const rows = [
      kvRow('Subnet CIDR', esc(s.cidr), s.cidr),
      kvRow('Network Address', esc(s.network), s.network),
      kvRow('Broadcast Address', esc(s.broadcast), s.broadcast),
    ];
    if (prefix <= 30) {
      rows.push(kvRow('Usable Range', `${esc(s.start)} – ${esc(s.end)}`, `${s.start}-${s.end}`));
    }
    rows.push(kvRow('Address Count', prefix >= 31 ? `${s.usable} usable` : `Total ${s.total}, usable ${s.usable}`));
    $<HTMLElement>('ipSubnetTable').innerHTML = rows.join('');
  }

  function clearParse(): void {
    $<HTMLElement>('ipParseEmpty').hidden = false;
    $<HTMLElement>('ipParseWrap').hidden = true;
    $<HTMLElement>('ipSummary').innerHTML = '';
    $<HTMLElement>('ipParseTable').innerHTML = '';
    $<HTMLElement>('ipSubnetTable').innerHTML = '';
    $<HTMLElement>('ipSubnetWrap').hidden = true;
    hideStatus('ipParseStatus');
  }

  function renderGeo(geo: GeoInfo): void {
    $<HTMLElement>('ipGeoEmpty').hidden = true;
    $<HTMLElement>('ipGeoWrap').hidden = false;
    const rows: string[] = [];
    const country = [
      geo.flag ? `<span class="flag">${esc(geo.flag)}</span>` : '',
      geo.country ? esc(geo.country) : '',
      geo.countryCode ? `<span class="muted">(${esc(geo.countryCode)})</span>` : '',
    ].join(' ');
    if (country.trim()) rows.push(kvRow('Country/Region', country.trim(), geo.country || ''));
    if (geo.continent) rows.push(kvRow('Continent', esc(geo.continent), geo.continent));
    if (geo.region) rows.push(kvRow('Province/State', esc(geo.region), geo.region));
    if (geo.city) rows.push(kvRow('City', esc(geo.city), geo.city));
    if (geo.postal) rows.push(kvRow('Postal Code', esc(geo.postal), geo.postal));
    if (geo.timezone) {
      rows.push(kvRow('Time Zone', `${esc(geo.timezone)}${geo.utcOffset ? ` <span class="muted">(UTC${esc(geo.utcOffset)})</span>` : ''}`, geo.timezone));
    }
    if (geo.asn) rows.push(kvRow('ASN', esc(geo.asn), geo.asn));
    if (geo.org) rows.push(kvRow('Organization', esc(geo.org), geo.org));
    if (geo.isp && geo.isp !== geo.org) rows.push(kvRow('ISP', esc(geo.isp), geo.isp));
    if (geo.lat !== null && geo.lon !== null) {
      const latLon = `${geo.lat.toFixed(4)}, ${geo.lon.toFixed(4)}`;
      rows.push(kvRow('Coordinates', esc(latLon), latLon));
    }
    $<HTMLElement>('ipGeoTable').innerHTML = rows.join('') || '<div class="ip-row"><span class="ip-k">Location</span><span class="ip-v">Address resolved, no geolocation data</span></div>';

    const mapLink = $<HTMLAnchorElement>('ipMapLink');
    if (geo.lat !== null && geo.lon !== null) {
      mapLink.href = `https://www.openstreetmap.org/?mlat=${geo.lat}&mlon=${geo.lon}#map=10/${geo.lat}/${geo.lon}`;
      mapLink.hidden = false;
    } else {
      mapLink.hidden = true;
    }
    $<HTMLElement>('ipGeoSource').textContent = `Data source: ${geo.source}`;
  }

  function clearGeo(): void {
    $<HTMLElement>('ipGeoEmpty').hidden = false;
    $<HTMLElement>('ipGeoWrap').hidden = true;
    $<HTMLElement>('ipGeoTable').innerHTML = '';
    $<HTMLAnchorElement>('ipMapLink').hidden = true;
    hideStatus('ipGeoStatus');
  }

  /* ═══════════ 主流程 ═══════════ */

  let onlineSeq = 0;
  let lastAutoKey = '';

  function handleParseResult(info: IpAnalysis | null, note?: string): void {
    if (info) {
      renderParse(info, note);
      hideStatus('ipParseStatus');
    } else {
      clearParse();
    }
  }

  async function doOnline(ip: string): Promise<void> {
    const seq = ++onlineSeq;
    hideStatus('ipGeoStatus');
    $<HTMLElement>('ipGeoEmpty').textContent = 'Querying location…';
    $<HTMLElement>('ipGeoEmpty').hidden = false;
    $<HTMLElement>('ipGeoWrap').hidden = true;
    const geo = await lookupOnline(ip, true);
    if (seq !== onlineSeq) return;
    if (geo) {
      renderGeo(geo);
      showStatus('ipGeoStatus', 'success', `Query complete: ${geo.ip}`);
    } else {
      $<HTMLElement>('ipGeoEmpty').textContent = 'Location lookup failed. Please check your network connection and try again.';
      $<HTMLElement>('ipGeoEmpty').hidden = false;
      showStatus('ipGeoStatus', 'error', 'Query failed: all data sources unavailable');
    }
  }

  async function runQuery(immediate = false): Promise<void> {
    const raw = $<HTMLInputElement>('ipInput').value.trim();
    if (!raw) {
      showStatus('ipParseStatus', 'error', 'Please enter an IP address or domain name');
      return;
    }

    const info = analyzeIp(raw);
    if (info) {
      handleParseResult(info);
      if (immediate) await doOnline(info.normalized);
      return;
    }

    const domain = /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/i.test(raw) ? raw.toLowerCase() : null;
    if (!domain) {
      clearParse();
      showStatus('ipParseStatus', 'error', 'Unrecognized: please enter a valid IP address (IPv4/IPv6) or domain name');
      return;
    }

    $<HTMLElement>('ipParseEmpty').hidden = false;
    $<HTMLElement>('ipParseEmpty').textContent = `Resolving domain ${domain}…`;
    showStatus('ipParseStatus', 'info', 'Resolving domain via DNS-over-HTTPS…');
    const ips = await resolveDomain(domain);
    if (ips.length === 0) {
      $<HTMLElement>('ipParseEmpty').textContent = 'Domain resolution failed. Please check that the domain is correct.';
      showStatus('ipParseStatus', 'error', `Unable to resolve ${domain}`);
      return;
    }

    const first = analyzeIp(ips[0]);
    const chips = ips.map((ip) => `<button class="ip-chip" type="button" data-ip="${esc(ip)}">${esc(ip)}</button>`).join('');
    $<HTMLElement>('ipParseEmpty').hidden = true;
    if (first) handleParseResult(first, `${domain} resolved to ${ips.length} address(es)`);
    $<HTMLElement>('ipSummary').insertAdjacentHTML('beforeend', `<div class="ip-chips">${chips}</div>`);
    if (immediate) await doOnline(first ? first.normalized : ips[0]);
  }

  function scheduleAuto(): void {
    const raw = $<HTMLInputElement>('ipInput').value.trim();
    if (!raw) {
      lastAutoKey = '';
      clearParse();
      return;
    }
    const info = analyzeIp(raw);
    if (info) {
      handleParseResult(info);
      if (info.normalized !== lastAutoKey) {
        lastAutoKey = info.normalized;
        setTimeout(() => {
          const cur = analyzeIp($<HTMLInputElement>('ipInput').value.trim());
          if (cur && cur.normalized === info.normalized) void doOnline(info.normalized);
        }, 900);
      }
      return;
    }
    if (/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/i.test(raw)) {
      const name = raw.toLowerCase();
      if (name !== lastAutoKey) {
        lastAutoKey = name;
        $<HTMLElement>('ipParseEmpty').hidden = false;
        $<HTMLElement>('ipParseEmpty').textContent = `Domain detected, resolving…`;
        void resolveDomain(name).then((ips) => {
          if ($<HTMLInputElement>('ipInput').value.trim().toLowerCase() !== name) return;
          if (ips.length === 0) {
            $<HTMLElement>('ipParseEmpty').textContent = 'Domain resolution failed';
            return;
          }
          const first = analyzeIp(ips[0]);
          $<HTMLElement>('ipParseEmpty').hidden = true;
          if (first) {
            handleParseResult(first, `${name} resolved to ${ips.length} address(es)`);
            $<HTMLElement>('ipSummary').insertAdjacentHTML(
              'beforeend',
              `<div class="ip-chips">${ips.map((ip) => `<button class="ip-chip" type="button" data-ip="${esc(ip)}">${esc(ip)}</button>`).join('')}</div>`,
            );
          }
          void doOnline(ips[0]);
        });
      }
      return;
    }
    lastAutoKey = '';
    clearParse();
    showStatus('ipParseStatus', 'error', 'Unrecognized: please enter a valid IP address (IPv4/IPv6) or domain name');
  }

  let inputTimer: ReturnType<typeof setTimeout> | null = null;
  $<HTMLInputElement>('ipInput').addEventListener('input', () => {
    hideStatus('ipParseStatus');
    if (inputTimer) clearTimeout(inputTimer);
    inputTimer = setTimeout(scheduleAuto, 250);
  });
  $<HTMLInputElement>('ipInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      void runQuery(true);
    }
  });

  $<HTMLButtonElement>('ipQuery').addEventListener('click', () => void runQuery(true));

  $<HTMLButtonElement>('ipPaste').addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (!text) {
        showStatus('ipParseStatus', 'info', 'Clipboard is empty');
        return;
      }
      $<HTMLInputElement>('ipInput').value = text.trim().split(/\s+/)[0];
      $<HTMLInputElement>('ipInput').dispatchEvent(new Event('input'));
      void runQuery(true);
    } catch {
      showStatus('ipParseStatus', 'error', 'Unable to read clipboard. Please paste manually');
    }
  });

  const SAMPLES = [
    '8.8.8.8',
    '114.114.114.114',
    '2001:4860:4860::8888',
    '223.5.5.5',
    '192.168.1.100',
    '127.0.0.1',
    '2606:4700:4700::1111',
    'example.com',
    '::1',
  ];
  let sampleIdx = -1;
  $<HTMLButtonElement>('ipSample').addEventListener('click', () => {
    sampleIdx = (sampleIdx + 1) % SAMPLES.length;
    $<HTMLInputElement>('ipInput').value = SAMPLES[sampleIdx];
    $<HTMLInputElement>('ipInput').dispatchEvent(new Event('input'));
    void runQuery(true);
  });

  $<HTMLButtonElement>('ipClear').addEventListener('click', () => {
    $<HTMLInputElement>('ipInput').value = '';
    lastAutoKey = '';
    onlineSeq++;
    clearParse();
    clearGeo();
  });

  $<HTMLSelectElement>('ipPrefix').addEventListener('change', () => {
    const raw = $<HTMLInputElement>('ipInput').value.trim();
    const info = analyzeIp(raw);
    if (info) applySubnet(info);
  });

  // 复制按钮事件委托（hero + kv 行 + chips）
  document.addEventListener('click', (e) => {
    const copyBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (copyBtn) {
      void window.CT.copy(copyBtn.dataset.copy || '', copyBtn);
      return;
    }
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.ip-chip');
    if (chip && chip.dataset.ip) {
      $<HTMLInputElement>('ipInput').value = chip.dataset.ip;
      $<HTMLInputElement>('ipInput').dispatchEvent(new Event('input'));
      void runQuery(true);
    }
  });

  $<HTMLButtonElement>('ipSelfCopy').addEventListener('click', () => {
    const ip = $<HTMLElement>('ipSelfValue').textContent?.trim() || '';
    if (!ip || ip === '--') {
      showStatus('ipSelfStatus', 'error', 'No local IP available to copy');
      return;
    }
    void window.CT.copy(ip, $<HTMLButtonElement>('ipSelfCopy'));
  });

  async function refreshSelf(): Promise<void> {
    hideStatus('ipSelfStatus');
    $<HTMLElement>('ipSelfValue').textContent = 'Querying…';
    $<HTMLElement>('ipSelfMeta').textContent = '';
    const geo = await lookupSelf();
    if (!geo || !geo.ip) {
      $<HTMLElement>('ipSelfValue').textContent = '--';
      showStatus('ipSelfStatus', 'error', 'Local IP lookup failed. Please check your network connection');
      return;
    }
    $<HTMLElement>('ipSelfValue').textContent = geo.ip;
    const meta = [geo.city, geo.country, geo.org, geo.asn].filter(Boolean).join(' · ');
    $<HTMLElement>('ipSelfMeta').textContent = meta;
    showStatus('ipSelfStatus', 'success', `Obtained local machine IP (${geo.source})`);
    if (geo.country) renderGeo(geo);
  }

  $<HTMLButtonElement>('ipSelfRefresh').addEventListener('click', () => void refreshSelf());

  /* ── Initialization ── */
  void refreshSelf();
</script>