---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'password-strength', 'en')!;
const related = getRelated(category, 'password-strength', 'en', 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Enter password" icon="bi-shield-exclamation">
    <div class="field">
      <label class="field-label" for="psInput">Password</label>
      <input class="input" id="psInput" type="password" placeholder="Enter the password to check" autocomplete="off" />
    </div>
    <div class="strength-bars" id="psBars">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </div>
    <div class="strength-label" id="psLabel">Waiting for input</div>
    <div class="status-msg" id="psStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Check details" icon="bi-list-check">
    <ul class="check-list" id="psChecks"></ul>
    <div class="input-stats"><span id="psDetail">Combined assessment of length, character mix, and common weak passwords</span></div>
  </ToolPanel>
</ToolLayout>

<style>
  .strength-bars {
    display: flex;
    gap: 6px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--bg-tertiary);
    transition: background-color 0.2s ease;
  }

  .bar.filled {
    background: var(--bar-color, var(--warning));
  }

  .strength-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .check-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .check-list li.ok {
    color: var(--success);
  }

  .check-list li.bad {
    color: var(--error);
  }
</style>

<script>
  import { byId } from '../../../../scripts/toolkit';

  const input = byId<HTMLInputElement>('psInput');
  const bars = byId<HTMLElement>('psBars').children;
  const label = byId<HTMLElement>('psLabel');
  const checks = byId<HTMLUListElement>('psChecks');
  const detail = byId<HTMLElement>('psDetail');

  const COMMON = ['123456', 'password', '12345678', 'qwerty', 'abc123', '111111', '123123', 'admin', 'letmein', '000000', '666666', '88888888', 'iloveyou'];

  function analyze(pw: string) {
    const len = pw.length;
    const hasLower = /[a-z]/.test(pw);
    const hasUpper = /[A-Z]/.test(pw);
    const hasDigit = /\d/.test(pw);
    const hasSymbol = /[^A-Za-z0-9]/.test(pw);
    const isCommon = COMMON.includes(pw.toLowerCase());
    const sequential = /(012|123|234|345|456|567|678|789|890|abc|bcd|cde|def|efg|fgh|ghi|hij|ijk|jkl|klm|lmn|mno|nop|opq|pqr|qrs|rst|stu|tuv|uvw|vwx|wxy|xyz)/i.test(pw);

    const results = [
      { ok: len >= 8, text: len >= 8 ? 'At least 8 characters' : `Too short (currently ${len} characters)` },
      { ok: hasLower && hasUpper, text: hasLower && hasUpper ? 'Contains upper and lowercase letters' : 'Missing mixed upper/lowercase letters' },
      { ok: hasDigit, text: hasDigit ? 'Contains numbers' : 'Missing numbers' },
      { ok: hasSymbol, text: hasSymbol ? 'Contains special symbols' : 'Missing special symbols' },
      { ok: !isCommon, text: isCommon ? 'Matches a common weak password, strongly recommended to change' : 'No common weak password matched' },
      { ok: !sequential, text: sequential ? 'Contains sequential/consecutive characters' : 'No sequential characters' },
    ];

    let score = 0;
    score += Math.min(len / 4, 2);
    if (hasLower && hasUpper) score += 1;
    if (hasDigit) score += 0.5;
    if (hasSymbol) score += 1;
    if (isCommon) score -= 2;
    if (sequential) score -= 0.5;
    score = Math.max(0, Math.min(4, Math.round(score)));
    return { score, results };
  }

  function update() {
    const pw = input.value;
    if (!pw) {
      label.textContent = 'Waiting for input';
      detail.textContent = 'Combined assessment of length, character mix, and common weak passwords';
      checks.innerHTML = '';
      Array.from(bars).forEach((b) => b.classList.remove('filled'));
      return;
    }
    const { score, results } = analyze(pw);
    const meta = [
      { color: 'var(--error)', text: 'Very weak' },
      { color: 'var(--error)', text: 'Weak' },
      { color: 'var(--warning)', text: 'Medium' },
      { color: 'var(--success)', text: 'Strong' },
      { color: 'var(--success)', text: 'Very strong' },
    ][score];
    Array.from(bars).forEach((bar, i) => {
      bar.classList.toggle('filled', i < score);
      (bar as HTMLElement).style.setProperty('--bar-color', meta.color);
    });
    label.textContent = `${meta.text} (${score}/4)`;
    label.style.color = meta.color;
    checks.innerHTML = results.map((r) => `<li class="${r.ok ? 'ok' : 'bad'}"><i class="bi ${r.ok ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>${r.text}</li>`).join('');
    const entropy = pw.length * Math.log2(94);
    detail.textContent = `Estimated entropy ~${entropy.toFixed(0)} bits; offline cracking time under ideal conditions: ${entropy > 60 ? 'extremely long (over centuries)' : entropy > 40 ? 'days to months' : 'seconds to hours'}`;
  }

  input.addEventListener('input', update);
  update();
</script>