---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'regex-tester', 'en')!;
const related = getRelated(category, 'regex-tester', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Regular Expression" icon="bi-asterisk">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="reSample" type="button"><i class="bi bi-magic"></i> Sample</button>
    </div>
    <div class="field">
      <input class="input mono" id="rePattern" type="text" placeholder="e.g. \b\w+@\w+\.\w+\b" spellcheck="false" />
    </div>
    <div class="re-flags">
      <label class="flag-chip"><input type="checkbox" id="flagG" checked /> g global</label>
      <label class="flag-chip"><input type="checkbox" id="flagI" /> i ignore case</label>
      <label class="flag-chip"><input type="checkbox" id="flagM" /> m multi-line</label>
      <label class="flag-chip"><input type="checkbox" id="flagS" /> s dot matches newline</label>
      <label class="flag-chip"><input type="checkbox" id="flagU" /> u Unicode</label>
    </div>
    <div class="field mt-3">
      <label class="field-label" for="reText">Test text</label>
      <textarea class="textarea" id="reText" spellcheck="false" placeholder="Enter text to match"></textarea>
    </div>
    <div class="status-msg" id="reStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Match Highlight" icon="bi-eye">
    <div class="regex-view" id="reView"></div>
  </ToolPanel>

  <ToolPanel title="Match Results" icon="bi-list-ol" className="mt-4">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="reCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="reOutput" readonly spellcheck="false" placeholder="Matches and capture groups will appear here"></textarea>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .re-flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .flag-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    cursor: pointer;
  }

  .regex-view {
    min-height: 140px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    white-space: pre-wrap;
    word-break: break-all;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.7;
  }

  .regex-view mark {
    background: var(--primary);
    color: #fff;
    border-radius: 3px;
    padding: 0 2px;
  }
</style>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  const patternEl = byId<HTMLInputElement>('rePattern');
  const textEl = byId<HTMLTextAreaElement>('reText');
  const view = byId<HTMLElement>('reView');
  const output = byId<HTMLTextAreaElement>('reOutput');

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function flags(): string {
    let f = '';
    for (const id of ['flagG', 'flagI', 'flagM', 'flagS', 'flagU']) {
      if (byId<HTMLInputElement>(id).checked) f += id.slice(4).toLowerCase();
    }
    return f;
  }

  function run() {
    hideStatus('reStatus');
    const pattern = patternEl.value;
    const text = textEl.value;
    if (!pattern) {
      showStatus('reStatus', 'error', 'Please enter a regular expression');
      return;
    }
    let regex: RegExp;
    try {
      regex = new RegExp(pattern, flags());
    } catch (e) {
      showStatus('reStatus', 'error', `Regex syntax error: ${(e as Error).message}`);
      view.textContent = '';
      output.value = '';
      return;
    }

    const matches: string[] = [];
    const lines: string[] = [];
    const useGlobal = flags().includes('g');
    let count = 0;

    if (useGlobal) {
      regex.lastIndex = 0;
      let m: RegExpExecArray | null;
      let html = '';
      let last = 0;
      while ((m = regex.exec(text)) !== null) {
        count++;
        html += escapeHtml(text.slice(last, m.index)) + '<mark>' + escapeHtml(m[0]) + '</mark>';
        lines.push(`[${count}] Position ${m.index}: ${JSON.stringify(m[0])}`);
        if (m.length > 1) {
          for (let g = 1; g < m.length; g++) {
            lines.push(`   Group ${g}: ${JSON.stringify(m[g])}`);
          }
        }
        last = m.index + m[0].length;
        if (m[0].length === 0) regex.lastIndex++;
        if (count > 5000) {
          lines.push('(Too many matches, truncated)');
          break;
        }
      }
      html += escapeHtml(text.slice(last));
      view.innerHTML = html || escapeHtml(text);
    } else {
      const m = regex.exec(text);
      if (m) {
        count = 1;
        view.innerHTML =
          escapeHtml(text.slice(0, m.index)) + '<mark>' + escapeHtml(m[0]) + '</mark>' +
          escapeHtml(text.slice(m.index + m[0].length));
        lines.push(`Match position ${m.index}: ${JSON.stringify(m[0])}`);
        for (let g = 1; g < m.length; g++) lines.push(`Group ${g}: ${JSON.stringify(m[g])}`);
      } else {
        view.textContent = text;
      }
    }

    output.value = lines.join('\n');
    showStatus('reStatus', count ? 'success' : 'info', count ? `Found ${count} match${count === 1 ? '' : 'es'}` : 'No matches found');
  }

  patternEl.addEventListener('input', run);
  textEl.addEventListener('input', run);
  document.querySelectorAll<HTMLInputElement>('.flag-chip input').forEach((el) => el.addEventListener('change', run));
  byId<HTMLButtonElement>('reSample').addEventListener('click', () => {
    patternEl.value = '\\b\\w+@\\w+\\.\\w+\\b';
    textEl.value = 'Contact york@example.com or admin@tools.cn for support, backup email dev@clover.io';
    run();
  });
  bindCopyBtn('reCopy', () => output.value);
</script>