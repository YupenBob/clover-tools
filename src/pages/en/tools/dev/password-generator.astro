---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'password-generator', 'en')!;
const related = getRelated(category, 'password-generator', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Generation Settings" icon="bi-dice-5">
    <div class="field">
      <label class="field-label" for="pgLength">Password length: <span id="pgLenLabel">16</span></label>
      <input class="input" id="pgLength" type="range" min="6" max="64" value="16" />
    </div>
    <div class="pg-options">
      <label class="flag-chip"><input type="checkbox" id="pgUpper" checked /> Uppercase letters</label>
      <label class="flag-chip"><input type="checkbox" id="pgLower" checked /> Lowercase letters</label>
      <label class="flag-chip"><input type="checkbox" id="pgDigits" checked /> Numbers</label>
      <label class="flag-chip"><input type="checkbox" id="pgSymbols" /> Special symbols</label>
      <label class="flag-chip"><input type="checkbox" id="pgAmbiguous" /> Exclude ambiguous characters</label>
    </div>
    <div class="field mt-3">
      <label class="field-label" for="pgCount">Password count</label>
      <select class="select" id="pgCount">
        <option value="1" selected>1 password</option>
        <option value="5">5 passwords</option>
        <option value="10">10 passwords</option>
      </select>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="pgBtn" type="button"><i class="bi bi-dice-5"></i> Generate Passwords</button>
    </div>
    <div class="status-msg" id="pgStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Generated Results" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pgCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="pgOutput" readonly spellcheck="false" placeholder="Click generate to display passwords"></textarea>
  </ToolPanel>
</ToolLayout>

<style>
  .pg-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .flag-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    cursor: pointer;
  }
</style>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  const lenSlider = byId<HTMLInputElement>('pgLength');
  const lenLabel = byId<HTMLElement>('pgLenLabel');
  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const DIGITS = '0123456789';
  const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';
  const AMBIGUOUS = 'O0Il1|`\'"';

  function randomInt(max: number): number {
    const buf = new Uint32Array(1);
    crypto.getRandomValues(buf);
    return buf[0] % max;
  }

  function generate(): void {
    hideStatus('pgStatus');
    const length = Number(lenSlider.value);
    const count = Number(byId<HTMLSelectElement>('pgCount').value);
    const sets: string[] = [];
    if (byId<HTMLInputElement>('pgUpper').checked) sets.push(UPPER);
    if (byId<HTMLInputElement>('pgLower').checked) sets.push(LOWER);
    if (byId<HTMLInputElement>('pgDigits').checked) sets.push(DIGITS);
    if (byId<HTMLInputElement>('pgSymbols').checked) sets.push(SYMBOLS);
    if (sets.length === 0) {
      showStatus('pgStatus', 'error', 'Select at least one character type');
      return;
    }
    const excludeAmbiguous = byId<HTMLInputElement>('pgAmbiguous').checked;
    const pool = sets.join('').split('').filter((c) => !excludeAmbiguous || !AMBIGUOUS.includes(c));
    if (pool.length === 0) {
      showStatus('pgStatus', 'error', 'Character pool is empty. Adjust options.');
      return;
    }
    const lines: string[] = [];
    for (let n = 0; n < count; n++) {
      const chars: string[] = [];
      // Ensure at least one character from each set
      const flatSets = sets.join('');
      const available = flatSets.split('').filter((c) => !excludeAmbiguous || !AMBIGUOUS.includes(c));
      for (const set of sets) {
        const candidates = set.split('').filter((c) => !excludeAmbiguous || !AMBIGUOUS.includes(c));
        if (candidates.length) chars.push(candidates[randomInt(candidates.length)]);
      }
      while (chars.length < length) chars.push(available[randomInt(available.length)]);
      for (let i = chars.length - 1; i > 0; i--) {
        const j = randomInt(i + 1);
        [chars[i], chars[j]] = [chars[j], chars[i]];
      }
      lines.push(chars.slice(0, length).join(''));
    }
    byId<HTMLTextAreaElement>('pgOutput').value = lines.join('\n');
    showStatus('pgStatus', 'success', `Generated ${count} passwords`);
  }

  lenSlider.addEventListener('input', () => {
    lenLabel.textContent = lenSlider.value;
  });
  byId<HTMLButtonElement>('pgBtn').addEventListener('click', generate);
  bindCopyBtn('pgCopy', () => byId<HTMLTextAreaElement>('pgOutput').value);
</script>