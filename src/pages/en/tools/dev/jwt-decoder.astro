---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jwt-decoder', 'en')!;
const related = getRelated(category, 'jwt-decoder', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JWT Token" icon="bi-file-lock">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jwtSample" type="button"><i class="bi bi-magic"></i> Sample</button>
      <button class="btn btn-ghost btn-sm" id="jwtClear" type="button"><i class="bi bi-x-circle"></i> Clear</button>
    </div>
    <textarea class="textarea" id="jwtInput" spellcheck="false" placeholder="Paste JWT (header.payload.signature)"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jwtSecret">Signature secret (optional, for HS256 verification)</label>
      <input class="input mono" id="jwtSecret" type="text" placeholder="Verified locally only, never leaves your browser" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jwtBtn" type="button"><i class="bi bi-file-lock"></i> Decode</button>
      <button class="btn btn-secondary" id="jwtVerify" type="button"><i class="bi bi-shield-check"></i> Verify HS256 signature</button>
    </div>
    <div class="status-msg" id="jwtStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Decoded Result" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jwtCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="jwtOutput" readonly spellcheck="false" placeholder="Header and Payload will be shown here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';
  import CryptoJS from 'crypto-js';

  function b64urlToJson(s: string): unknown {
    let b64 = s.replace(/-/g, '+').replace(/_/g, '/');
    while (b64.length % 4 !== 0) b64 += '=';
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return JSON.parse(new TextDecoder().decode(bytes));
  }

  function parseToken(token: string): { header: unknown; payload: unknown; raw: string[] } | null {
    const parts = token.split('.');
    if (parts.length !== 3) return null;
    return { header: b64urlToJson(parts[0]), payload: b64urlToJson(parts[1]), raw: parts };
  }

  function describe(payload: Record<string, unknown>): string[] {
    const lines: string[] = [];
    if (payload.exp) {
      const exp = new Date(Number(payload.exp) * 1000);
      const diff = exp.getTime() - Date.now();
      lines.push(`Expires: ${exp.toLocaleString('en-GB', { hour12: false })} (${diff > 0 ? `remaining ${Math.floor(diff / 60000)} min` : 'expired'})`);
    }
    if (payload.iat) {
      lines.push(`Issued at: ${new Date(Number(payload.iat) * 1000).toLocaleString('en-GB', { hour12: false })}`);
    }
    if (payload.sub !== undefined) lines.push(`Subject (sub): ${payload.sub}`);
    if (payload.iss !== undefined) lines.push(`Issuer (iss): ${payload.iss}`);
    return lines;
  }

  function decode() {
    hideStatus('jwtStatus');
    const token = byId<HTMLTextAreaElement>('jwtInput').value.trim();
    if (!token) {
      showStatus('jwtStatus', 'error', 'Please enter a JWT');
      return;
    }
    try {
      const parsed = parseToken(token);
      if (!parsed) {
        showStatus('jwtStatus', 'error', 'Invalid JWT format: expected header.payload.signature');
        return;
      }
      const payload = parsed.payload as Record<string, unknown>;
      const sections = [
        '═══ Header ═══',
        JSON.stringify(parsed.header, null, 2),
        '',
        '═══ Payload ═══',
        JSON.stringify(parsed.payload, null, 2),
      ];
      const extra = describe(payload);
      if (extra.length) sections.push('', '═══ Summary ═══', ...extra);
      byId<HTMLTextAreaElement>('jwtOutput').value = sections.join('\n');
      showStatus('jwtStatus', 'success', 'Decoded successfully');
    } catch (e) {
      byId<HTMLTextAreaElement>('jwtOutput').value = '';
      showStatus('jwtStatus', 'error', `Decode failed: ${(e as Error).message}`);
    }
  }

  function verify() {
    hideStatus('jwtStatus');
    const token = byId<HTMLTextAreaElement>('jwtInput').value.trim();
    const secret = byId<HTMLInputElement>('jwtSecret').value;
    if (!token || !secret) {
      showStatus('jwtStatus', 'error', 'Please enter the JWT and signature secret');
      return;
    }
    try {
      const parsed = parseToken(token);
      if (!parsed) throw new Error('Invalid JWT format');
      const header = parsed.header as Record<string, string>;
      if ((header.alg || '').toUpperCase() !== 'HS256') {
        showStatus('jwtStatus', 'info', `This tool only supports HS256 verification (this token uses ${header.alg})`);
        return;
      }
      const signing = `${parsed.raw[0]}.${parsed.raw[1]}`;
      const expected = CryptoJS.HmacSHA256(signing, secret)
        .toString(CryptoJS.enc.Base64)
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=+$/, '');
      const ok = expected === parsed.raw[2];
      showStatus('jwtStatus', ok ? 'success' : 'error', ok ? 'Signature valid' : 'Signature invalid: secret mismatch or token has been tampered with');
    } catch (e) {
      showStatus('jwtStatus', 'error', `Verification failed: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('jwtBtn').addEventListener('click', decode);
  byId<HTMLButtonElement>('jwtVerify').addEventListener('click', verify);
  bindSample('jwtSample', 'jwtInput', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbG92ZXIiLCJpYXQiOjE3ODUwMDAwMDAsImV4cCI6MTgxNjUzNjAwMH0.QW5FeGFtcGxlU2lnbmF0dXJl');
  bindClear('jwtClear', ['jwtInput'], ['jwtOutput'], 'jwtStatus');
  bindCopyBtn('jwtCopy', () => byId<HTMLTextAreaElement>('jwtOutput').value);
</script>