---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'markdown', 'en')!;
const related = getRelated(category, 'markdown', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Markdown Online Editor" icon="bi-markdown">
    <div slot="actions">
      <div class="md-views" role="group" aria-label="View switch">
        <button class="md-view active" data-view="split" type="button" title="Split view"><i class="bi bi-columns-gap"></i> Split</button>
        <button class="md-view" data-view="edit" type="button" title="Edit"><i class="bi bi-pencil-square"></i> Edit</button>
        <button class="md-view" data-view="preview" type="button" title="Preview"><i class="bi bi-eye"></i> Preview</button>
      </div>
    </div>

    <div class="md-toolbar" role="toolbar" aria-label="Format toolbar">
      <button class="md-tbtn" data-cmd="h1" type="button" title="Heading 1">H1</button>
      <button class="md-tbtn" data-cmd="h2" type="button" title="Heading 2">H2</button>
      <button class="md-tbtn" data-cmd="h3" type="button" title="Heading 3">H3</button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="bold" type="button" title="Bold (Ctrl+B)"><i class="bi bi-type-bold"></i></button>
      <button class="md-tbtn" data-cmd="italic" type="button" title="Italic (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
      <button class="md-tbtn" data-cmd="strike" type="button" title="Strikethrough (Ctrl+U)"><i class="bi bi-type-strikethrough"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="code" type="button" title="Inline code (Ctrl+Shift+C)"><i class="bi bi-code-slash"></i></button>
      <button class="md-tbtn" data-cmd="codeblock" type="button" title="Code block (Ctrl+Shift+K)"><i class="bi bi-code-square"></i></button>
      <button class="md-tbtn" data-cmd="quote" type="button" title="Quote (Ctrl+Shift+Q)"><i class="bi bi-quote"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="ul" type="button" title="Unordered list"><i class="bi bi-list-ul"></i></button>
      <button class="md-tbtn" data-cmd="ol" type="button" title="Ordered list"><i class="bi bi-list-ol"></i></button>
      <button class="md-tbtn" data-cmd="task" type="button" title="Task list"><i class="bi bi-check2-square"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="link" type="button" title="Link (Ctrl+K)"><i class="bi bi-link-45deg"></i></button>
      <button class="md-tbtn" data-cmd="image" type="button" title="Image"><i class="bi bi-image"></i></button>
      <button class="md-tbtn" data-cmd="table" type="button" title="Table"><i class="bi bi-table"></i></button>
      <button class="md-tbtn" data-cmd="hr" type="button" title="Horizontal rule"><i class="bi bi-hr"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="toc" type="button" title="Table of contents"><i class="bi bi-list-check"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="undo" type="button" title="Undo (Ctrl+Z)"><i class="bi bi-arrow-counterclockwise"></i></button>
      <button class="md-tbtn" data-cmd="redo" type="button" title="Redo (Ctrl+Y / Ctrl+Shift+Z)"><i class="bi bi-arrow-clockwise"></i></button>
      <span class="md-sep"></span>
      <button class="md-tbtn" data-cmd="fullscreen" type="button" title="Fullscreen"><i class="bi bi-arrows-fullscreen"></i></button>
      <button class="md-tbtn" data-cmd="help" type="button" title="Help"><i class="bi bi-question-circle"></i></button>
      <button class="md-tbtn" data-cmd="draft" type="button" title="Clear draft (Ctrl+Shift+Del)"><i class="bi bi-eraser"></i></button>
    </div>

    <nav class="md-toc" id="mdToc" hidden aria-label="Table of contents"></nav>

    <div class="md-findbar" id="mdFindBar" hidden>
      <input class="input md-find-input" id="mdFind" type="text" placeholder="Find…" autocomplete="off" />
      <button class="md-tbtn" id="mdFindPrev" type="button" title="Previous (Shift+Enter)"><i class="bi bi-arrow-up"></i></button>
      <button class="md-tbtn" id="mdFindNext" type="button" title="Next (Enter)"><i class="bi bi-arrow-down"></i></button>
      <span class="md-find-count" id="mdFindCount">0 matches</span>
      <input class="input md-find-input" id="mdReplace" type="text" placeholder="Replace with…" autocomplete="off" />
      <button class="md-tbtn" id="mdReplaceOne" type="button" title="Replace (Ctrl+Enter)"><i class="bi bi-arrow-repeat"></i></button>
      <button class="md-tbtn" id="mdReplaceAll" type="button" title="Replace all"><i class="bi bi-list-check"></i></button>
      <button class="md-tbtn" id="mdFindCase" type="button" title="Match case"><i class="bi bi-fonts"></i></button>
      <button class="md-tbtn" id="mdFindClose" type="button" title="Close (Esc)"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="md-body split" id="mdBody">
      <div class="md-editor">
        <div class="md-lines" id="mdLines" aria-hidden="true"></div>
        <textarea class="md-source" id="mdSource" spellcheck="false" placeholder="Start writing Markdown…"></textarea>
      </div>
      <div class="md-preview" id="mdPreview"></div>
    </div>

    <div class="md-statusbar">
      <span id="mdStats">0 characters · 0 words · 0 lines</span>
      <span id="mdReading">About 0 min read</span>
      <span id="mdTime">Writing 00:00</span>
      <span class="md-target">
        <label for="mdTarget">Goal</label>
        <input class="input md-target-input" id="mdTarget" type="number" min="0" step="100" placeholder="None" />
      </span>
    </div>

    <div class="md-export">
      <button class="btn btn-ghost btn-sm" id="mdOpen" type="button"><i class="bi bi-folder2-open"></i> Open .md</button>
      <button class="btn btn-ghost btn-sm" id="mdCopyMd" type="button"><i class="bi bi-clipboard"></i> Copy source</button>
      <button class="btn btn-ghost btn-sm" id="mdCopyHtml" type="button"><i class="bi bi-clipboard-check"></i> Copy HTML</button>
      <button class="btn btn-ghost btn-sm" id="mdCopyRich" type="button"><i class="bi bi-fonts"></i> Copy rich text</button>
      <button class="btn btn-ghost btn-sm" id="mdDownloadMd" type="button"><i class="bi bi-filetype-md"></i> Download .md</button>
      <button class="btn btn-ghost btn-sm" id="mdDownloadHtml" type="button"><i class="bi bi-filetype-html"></i> Download .html</button>
      <input type="file" id="mdOpenFile" accept=".md,.markdown,.txt,text/markdown,text/plain" hidden />
    </div>

    <div class="status-msg" id="mdStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <div class="md-modal" id="mdModal" hidden>
    <div class="md-modal-card">
      <div class="md-modal-head">
        <h3><i class="bi bi-question-circle" aria-hidden="true"></i> Markdown Cheat Sheet</h3>
        <button class="icon-btn" id="mdModalClose" type="button" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
      </div>
      <div class="md-modal-body">
        <h4>Common Syntax</h4>
        <table>
          <thead><tr><th>Result</th><th>Syntax</th></tr></thead>
          <tbody>
            <tr><td>Headings</td><td><code># Heading 1</code> · <code>## Heading 2</code> · <code>### Heading 3</code></td></tr>
            <tr><td>Bold / Italic / Strikethrough</td><td><code>**bold**</code> · <code>*italic*</code> · <code>~~strikethrough~~</code></td></tr>
            <tr><td>Inline code / Code block</td><td><code>`code`</code> · <code>```js</code> code <code>```</code></td></tr>
            <tr><td>Quote / List / Task</td><td><code>&gt; quote</code> · <code>- item</code> · <code>- [ ] task</code></td></tr>
            <tr><td>Link / Image</td><td><code>[text](url)</code> · <code>![alt](image)</code></td></tr>
            <tr><td>Table</td><td><code>| Col 1 | Col 2 |</code> plus a separator row</td></tr>
          </tbody>
        </table>
        <h4>Keyboard Shortcuts</h4>
        <table>
          <thead><tr><th>Keys</th><th>Action</th></tr></thead>
          <tbody>
            <tr><td><kbd>Ctrl+B</kbd> / <kbd>Ctrl+I</kbd> / <kbd>Ctrl+U</kbd></td><td>Bold / Italic / Strikethrough</td></tr>
            <tr><td><kbd>Ctrl+K</kbd> / <kbd>Ctrl+Shift+C</kbd> / <kbd>Ctrl+Shift+K</kbd></td><td>Link / Inline code / Code block</td></tr>
            <tr><td><kbd>Ctrl+Shift+Q</kbd></td><td>Quote</td></tr>
            <tr><td><kbd>Tab</kbd> / <kbd>Shift+Tab</kbd></td><td>Indent / Outdent (multiple lines)</td></tr>
            <tr><td><kbd>Ctrl+1</kbd> / <kbd>Ctrl+2</kbd> / <kbd>Ctrl+3</kbd></td><td>Heading 1 / 2 / 3</td></tr>
            <tr><td><kbd>Ctrl+Z</kbd> / <kbd>Ctrl+Y</kbd> / <kbd>Ctrl+Shift+Z</kbd></td><td>Undo / Redo</td></tr>
            <tr><td><kbd>Ctrl+Enter</kbd></td><td>Switch to preview</td></tr>
            <tr><td><kbd>Ctrl+Shift+Del</kbd></td><td>Clear draft</td></tr>
          </tbody>
        </table>
        <p class="field-hint">Paste or drag images into the editor to insert them as Base64 automatically. Content is auto-saved as a draft and stays only on this device.</p>
      </div>
    </div>
  </div>
</ToolLayout>

<style>
  .md-views {
    display: inline-flex;
    gap: 4px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
  }

  .md-view {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
    padding: 0 12px;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-secondary);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .md-view.active {
    background: var(--bg-elevated);
    color: var(--primary-dark);
    box-shadow: var(--shadow-xs);
  }

  .md-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    margin-bottom: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .md-tbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 7px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .md-tbtn:hover {
    background: var(--bg-elevated);
    color: var(--primary-dark);
  }

  .md-tbtn:active {
    transform: scale(0.94);
  }

  .md-tbtn.active {
    background: var(--bg-elevated);
    color: var(--primary-dark);
    box-shadow: var(--shadow-xs);
  }

  .md-sep {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: var(--border);
  }

  .md-toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 260px;
    overflow-y: auto;
    margin-bottom: var(--space-3);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    font-size: 13.5px;
  }

  .md-toc[hidden] {
    display: none;
  }

  .md-toc a {
    display: block;
    padding: 5px 10px;
    border-radius: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .md-toc a:hover {
    background: var(--bg-elevated);
    color: var(--primary-dark);
  }

  .md-toc a.active {
    background: var(--primary-soft);
    color: var(--primary-dark);
    font-weight: 600;
  }

  .md-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .md-body.split {
    grid-template-columns: 1fr 1fr;
  }

  .md-body.edit .md-preview {
    display: none;
  }

  .md-body.preview .md-editor {
    display: none;
  }

  .md-editor {
    position: relative;
    min-width: 0;
  }

  .md-lines {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 480px;
    padding: var(--space-4) 10px var(--space-4) 12px;
    border: 1px solid var(--border-strong);
    border-right: none;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    background: var(--bg-secondary);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    text-align: right;
    overflow: hidden;
    white-space: pre;
    user-select: none;
    -webkit-user-select: none;
  }

  .md-lines span {
    display: block;
    color: inherit;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .md-lines span.md-line-active {
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    color: var(--primary);
    font-weight: 700;
    border-radius: 4px 0 0 4px;
    box-shadow: inset 2px 0 0 var(--primary);
  }

  .md-source {
    width: 100%;
    min-height: 480px;
    max-height: 72vh;
    overflow-y: auto;
    padding: var(--space-4) var(--space-4) var(--space-4) calc(44px + var(--space-4));
    border: 1px solid var(--border-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    resize: vertical;
    tab-size: 2;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .md-source:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: var(--ring);
  }

  .md-statusbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
    padding: 0 2px;
    color: var(--text-tertiary);
    font-size: 12.5px;
  }

  .md-export {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* ── 查找 / 替换 ── */
  .md-findbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: var(--space-3);
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .md-findbar[hidden] {
    display: none;
  }

  .md-find-input {
    flex: 1 1 140px;
    min-width: 0;
  }

  .md-find-count {
    color: var(--text-tertiary);
    font-size: 12.5px;
    white-space: nowrap;
  }

  /* ── 字数目标 ── */
  .md-target {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .md-target label {
    color: var(--text-tertiary);
    font-size: 12.5px;
  }

  .md-target-input {
    width: 84px;
    height: 30px;
    padding: 0 8px;
    font-size: 13px;
  }

  /* ── 预览代码块复制按钮 ── */
  .md-preview pre {
    position: relative;
  }

  .code-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .md-preview pre:hover .code-copy-btn,
  .code-copy-btn:focus-visible {
    opacity: 1;
  }

  .code-copy-btn:hover {
    color: var(--primary-dark);
  }

  /* ── 全屏 ── */
  .tool-card-panel:fullscreen {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--bg);
    overflow: auto;
  }

  .tool-card-panel:fullscreen .md-body {
    flex: 1;
    min-height: 0;
  }

  .tool-card-panel:fullscreen .md-source,
  .tool-card-panel:fullscreen .md-preview {
    min-height: 100%;
    max-height: none;
  }

  /* ── 帮助弹窗 ── */
  .md-modal {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
  }

  .md-modal[hidden] {
    display: none;
  }

  .md-modal-card {
    width: 100%;
    max-width: 640px;
    max-height: 84vh;
    overflow-y: auto;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .md-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .md-modal-head h3 {
    margin: 0;
    font-size: 17px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .md-modal-head h3 i {
    color: var(--primary-dark);
  }

  .md-modal-body {
    padding: var(--space-5);
  }

  .md-modal-body h4 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: 14px;
  }

  .md-modal-body h4:first-child {
    margin-top: 0;
  }

  .md-modal-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .md-modal-body th,
  .md-modal-body td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .md-modal-body th {
    color: var(--text-tertiary);
    font-weight: 500;
    white-space: nowrap;
  }

  .md-modal-body code,
  .md-modal-body kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .md-body.split {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* 预览区内容为动态渲染，样式需全局生效 */
  .md-preview {
    min-height: 480px;
    max-height: 72vh;
    overflow-y: auto;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    line-height: 1.75;
    overflow-wrap: break-word;
  }

  .md-preview:empty::before {
      content: 'Preview: type on the left, rendered automatically';
    color: var(--text-tertiary);
  }

  .md-preview h1,
  .md-preview h2,
  .md-preview h3,
  .md-preview h4 {
    margin: 1.1em 0 0.5em;
    line-height: 1.3;
  }

  .md-preview h1 {
    font-size: 1.7em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--border);
  }

  .md-preview h2 {
    font-size: 1.4em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--border);
  }

  .md-preview p {
    margin: 0.7em 0;
  }

  .md-preview a {
    color: var(--primary-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .md-preview code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--bg-tertiary);
  }

  .md-preview pre {
    margin: 0.9em 0;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    overflow-x: auto;
    color: var(--text);
  }

  .md-preview pre code {
    padding: 0;
    background: none;
    font-size: 0.86em;
  }

  .md-preview .hl-kw {
    color: var(--primary-dark);
    font-weight: 600;
  }

  .md-preview .hl-str {
    color: var(--success);
  }

  .md-preview .hl-cmt {
    color: var(--text-tertiary);
    font-style: italic;
  }

  .md-preview .hl-num {
    color: var(--info);
  }

  .md-preview .hl-fn {
    color: var(--info);
  }

  .md-preview .hl-tag {
    color: var(--primary-dark);
    font-weight: 600;
  }

  .md-preview .hl-attr {
    color: var(--info);
  }

  .md-preview .hl-prop {
    color: var(--info);
  }

  .md-preview blockquote {
    margin: 0.9em 0;
    padding: 2px 0 2px 14px;
    border-left: 3px solid var(--primary);
    color: var(--text-secondary);
  }

  .md-preview blockquote p {
    margin: 0.4em 0;
  }

  .md-preview ul,
  .md-preview ol {
    padding-left: 1.6em;
    margin: 0.6em 0;
  }

  .md-preview li {
    margin: 0.25em 0;
  }

  .md-preview li:has(> input[type='checkbox']) {
    list-style: none;
    margin-left: -1.4em;
  }

  .md-preview input[type='checkbox'] {
    margin-right: 8px;
