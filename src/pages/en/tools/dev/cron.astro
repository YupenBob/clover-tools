---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'cron', 'en')!;
const related = getRelated(category, 'cron', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Cron Expression" icon="bi-calendar2-week">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="cronSample" type="button"><i class="bi bi-magic"></i> Sample</button>
    </div>
    <div class="row">
      <div class="field" style="flex: 2">
        <label class="field-label" for="cronExpr">Expression</label>
        <input class="input mono" id="cronExpr" type="text" value="*/5 * * * *" spellcheck="false" />
      </div>
      <div class="field">
        <label class="field-label" for="cronCount">Preview Runs</label>
        <select class="select" id="cronCount">
          <option value="5">5 runs</option>
          <option value="10" selected>10 runs</option>
          <option value="20">20 runs</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="cronBtn" type="button"><i class="bi bi-calendar-event"></i> Preview Execution Times</button>
    </div>
    <div class="status-msg" id="cronStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">Supports 5-field (minute hour day month weekday), 6-field (second minute hour day month weekday) and 7-field (second minute hour day month weekday year) formats.</p>
  </ToolPanel>

  <ToolPanel title="Upcoming Executions" icon="bi-list-ol">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="cronCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="cronOutput" readonly spellcheck="false" placeholder="Execution times will appear here after previewing"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';
  import { Cron } from 'croner';

  function run() {
    hideStatus('cronStatus');
    const expr = byId<HTMLInputElement>('cronExpr').value.trim();
    const count = Number(byId<HTMLSelectElement>('cronCount').value);
    if (!expr) {
      showStatus('cronStatus', 'error', 'Please enter a Cron expression');
      return;
    }
    try {
      const job = new Cron(expr, { protect: true });
      const times: string[] = [];
      for (let i = 0; i < count; i++) {
        const next = job.nextRun();
        if (!next) break;
        times.push(next.toLocaleString('en-US', { timeZone: 'Asia/Shanghai', hour12: false }) +
          ` (${next.toISOString()})`);
      }
      if (times.length === 0) {
        showStatus('cronStatus', 'info', 'This expression has no run times to preview under the current configuration');
      }
      byId<HTMLTextAreaElement>('cronOutput').value = times.join('\n');
      showStatus('cronStatus', 'success', `Valid expression, generated ${times.length} execution times`);
    } catch (e) {
      byId<HTMLTextAreaElement>('cronOutput').value = '';
      showStatus('cronStatus', 'error', `Invalid expression: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('cronBtn').addEventListener('click', run);
  byId<HTMLButtonElement>('cronSample').addEventListener('click', () => {
    byId<HTMLInputElement>('cronExpr').value = '0 9 * * 1-5';
    run();
  });
  bindCopyBtn('cronCopy', () => byId<HTMLTextAreaElement>('cronOutput').value);
</script>