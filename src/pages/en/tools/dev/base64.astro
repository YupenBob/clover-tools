---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'base64', 'en')!;
const related = getRelated(category, 'base64', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Input" icon="bi-input-cursor">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="b64Sample" type="button"><i class="bi bi-magic"></i> Sample</button>
      <button class="btn btn-ghost btn-sm" id="b64Clear" type="button"><i class="bi bi-x-circle"></i> Clear</button>
    </div>
    <textarea class="textarea" id="b64Input" spellcheck="false" placeholder="Enter text to encode/decode"></textarea>
    <div class="input-stats"><span id="b64InStats">0 chars</span></div>
    <label class="field-label" for="urlSafe"><input type="checkbox" id="urlSafe" /> URL-safe mode (+/ replaced with -_)</label>
    <div class="btn-row">
      <button class="btn btn-primary" id="encodeBtn" type="button"><i class="bi bi-lock"></i> Encode</button>
      <button class="btn btn-secondary" id="decodeBtn" type="button"><i class="bi bi-unlock"></i> Decode</button>
    </div>
    <div class="status-msg" id="b64Status" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Output" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="b64Copy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="b64Output" readonly spellcheck="false" placeholder="Result will appear here"></textarea>
    <div class="input-stats"><span id="b64OutStats">0 chars</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('b64Input');
  const output = byId<HTMLTextAreaElement>('b64Output');

  function bytesToBinary(bytes: Uint8Array): string {
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return bin;
  }

  function encode(): void {
    hideStatus('b64Status');
    if (!input.value) {
      showStatus('b64Status', 'error', 'Please enter content to encode');
      return;
    }
    const bytes = new TextEncoder().encode(input.value);
    let b64 = btoa(bytesToBinary(bytes));
    if (byId<HTMLInputElement>('urlSafe').checked) {
      b64 = b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }
    output.value = b64;
    setStats('b64OutStats', `${output.value.length} chars · ${bytes.length} bytes`);
    showStatus('b64Status', 'success', 'Encoding complete');
  }

  function decode(): void {
    hideStatus('b64Status');
    const text = input.value.trim();
    if (!text) {
      showStatus('b64Status', 'error', 'Please enter Base64 content to decode');
      return;
    }
    try {
      let b64 = text;
      if (byId<HTMLInputElement>('urlSafe').checked) {
        b64 = b64.replace(/-/g, '+').replace(/_/g, '/');
        while (b64.length % 4 !== 0) b64 += '=';
      }
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      output.value = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
      setStats('b64OutStats', `${output.value.length} chars · ${bytes.length} bytes`);
      showStatus('b64Status', 'success', 'Decoding complete');
    } catch (e) {
      output.value = '';
      showStatus('b64Status', 'error', `Decode failed: content is not valid Base64 / UTF-8 (${(e as Error).message})`);
    }
  }

  byId<HTMLButtonElement>('encodeBtn').addEventListener('click', encode);
  byId<HTMLButtonElement>('decodeBtn').addEventListener('click', decode);
  bindSample('b64Sample', 'b64Input', 'CloverTools Developer Toolbox');
  bindClear('b64Clear', ['b64Input'], ['b64Output'], 'b64Status');
  bindCopyBtn('b64Copy', () => output.value);
  input.addEventListener('input', () => setStats('b64InStats', `${input.value.length} chars · ${new TextEncoder().encode(input.value).length} bytes`));
  setStats('b64InStats', '0 chars');
</script>