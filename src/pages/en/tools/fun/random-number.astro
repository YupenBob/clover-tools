---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'fun' as const;
const tool = getToolMeta(category, 'random-number', 'en')!;
const related = getRelated(category, 'random-number', 'en', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Random Number Settings" icon="bi-shuffle">
    <div class="row">
      <div class="field">
        <label class="field-label" for="rnMin">Minimum</label>
        <input class="input" id="rnMin" type="number" value="1" />
      </div>
      <div class="field">
        <label class="field-label" for="rnMax">Maximum</label>
        <input class="input" id="rnMax" type="number" value="100" />
      </div>
      <div class="field">
        <label class="field-label" for="rnCount">Count</label>
        <input class="input" id="rnCount" type="number" value="5" min="1" max="1000" />
      </div>
    </div>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="rnUnique"><input type="checkbox" id="rnUnique" checked /> No duplicates (range must be large enough)</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="rnBtn" type="button"><i class="bi bi-shuffle"></i> Generate Random Numbers</button>
    </div>
    <div class="status-msg" id="rnStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="Results" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rnCopy" type="button"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <textarea class="textarea" id="rnOutput" readonly spellcheck="false" placeholder="Results will appear here"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  import { generateRandomIntegers } from '../../../../lib/random-integers';

  function generate() {
    hideStatus('rnStatus');
    const min = Number(byId<HTMLInputElement>('rnMin').value);
    const max = Number(byId<HTMLInputElement>('rnMax').value);
    const count = Number(byId<HTMLInputElement>('rnCount').value);
    const unique = byId<HTMLInputElement>('rnUnique').checked;
    let values: number[];
    try { values = generateRandomIntegers(min, max, count, unique); }
    catch {
      byId<HTMLTextAreaElement>('rnOutput').value = '';
      showStatus('rnStatus', 'error', 'Use safe integers, a range of up to 4294967296 values and 1–1000 results. Unique results must fit in the range.');
      return;
    }
    byId<HTMLTextAreaElement>('rnOutput').value = values.join('\n');
    showStatus('rnStatus', 'success', `Generated ${count} random numbers`);
  }

  byId<HTMLButtonElement>('rnBtn').addEventListener('click', generate);
  bindCopyBtn('rnCopy', () => byId<HTMLTextAreaElement>('rnOutput').value);
</script>