---
// @shared-tool-ui: localized routes share the same visual canvas and interaction.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import PaletteGenerator from '../../../../components/PaletteGenerator.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';
const lang = 'en' as const;
const category = 'fun' as const;
const tool = getToolMeta(category, 'palette-generator', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <PaletteGenerator lang={lang} />
</ToolLayout>
