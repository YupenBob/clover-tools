---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { GUIDE_LABELS, categoryLabel } from '../../../lib/guide-labels';
import {
  GUIDE_LANGS,
  GUIDE_LANG_PREFIX,
  getGuideIndexLanguages,
  getGuidesForLang,
  guideIndexAlternates,
  guideIndexLanguageLinks,
  guideIndexPath,
  guidePath,
  type GuideLang,
} from '../../../lib/guides-i18n';
import { getAllTools } from '../../../lib/tools';
import { HTML_LANG, type Lang } from '../../../lib/i18n';
import { SITE } from '../../../lib/site';

export function getStaticPaths() {
  // 只有存在译文的语言才生成索引页，避免空列表页被收录。
  return getGuideIndexLanguages()
    .filter((guideLang) => guideLang !== 'zh')
    .map((guideLang) => ({
      params: { lang: GUIDE_LANG_PREFIX[guideLang].slice(1) },
      props: { guideLang },
    }));
}

const { guideLang } = Astro.props as { guideLang: GuideLang };
const lang = guideLang as Lang;
const labels = GUIDE_LABELS[lang];
const guides = getGuidesForLang(guideLang);
const latestUpdate = guides.reduce((latest, guide) => (guide.updated > latest ? guide.updated : latest), '');
const homeHref = `${GUIDE_LANG_PREFIX[guideLang]}/`;
const canonical = `${SITE.url}${guideIndexPath(guideLang)}`;
const languageLinks = guideIndexLanguageLinks().map((entry) => ({ locale: entry.locale as Lang, href: entry.href }));
const alternates = guideIndexAlternates().map((entry) => ({ locale: entry.locale as Lang, href: entry.href }));

const guideJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${labels.indexTitle} - ${SITE.name}`,
    description: labels.indexJsonLdDescription,
    url: canonical,
    inLanguage: HTML_LANG[lang],
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: guides.map((guide, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: guide.title,
        url: `${SITE.url}${guidePath(guide.slug, guideLang)}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: labels.breadcrumbHome, item: `${SITE.url}${homeHref}` },
      { '@type': 'ListItem', position: 2, name: labels.breadcrumbGuides, item: canonical },
    ],
  },
];

function toolHref(slug: string): string {
  const found = getAllTools().find((tool) => tool.slug === slug);
  if (!found) throw new Error(`Guide tool not found: ${slug}`);
  return `${GUIDE_LANG_PREFIX[guideLang]}/tools/${found.category}/${found.slug}/`;
}
---

<BaseLayout
  title={`${labels.indexTitle} - ${SITE.name}`}
  description={labels.indexDescription}
  keywords={labels.indexKeywords}
  canonical={canonical}
  jsonLd={guideJsonLd}
  indexable={true}
  languageLinks={languageLinks}
  alternates={alternates}
>
  <nav class="breadcrumb" aria-label={labels.breadcrumbAria}>
    <a href={homeHref}><Icon name="house-door" /> {labels.breadcrumbHome}</a>
    <Icon name="chevron-right" />
    <span>{labels.breadcrumbGuides}</span>
  </nav>

  <header class="guides-hero">
    <p class="guides-kicker">{labels.indexKicker}</p>
    <h1>{labels.indexHeading}</h1>
    <p>{labels.indexIntro}</p>
    <div class="guides-meta"><span>{labels.indexCount(guides.length)}</span>{latestUpdate && <span>{labels.indexUpdated(latestUpdate)}</span>}</div>
  </header>

  <section class="guide-list" aria-label={labels.indexListAria}>
    {guides.map((guide, index) => (
      <article class="guide-card">
        <div class="guide-card-number">{String(index + 1).padStart(2, '0')}</div>
        <div class="guide-card-body">
          <div class="guide-card-topline"><span>{categoryLabel(guide.category, lang)}</span><span>{guide.readingMinutes} {labels.minutesRead}</span></div>
          <h2><a href={guidePath(guide.slug, guideLang)}>{guide.title}</a></h2>
          <p>{guide.description}</p>
          <div class="guide-card-actions">
            <a class="guide-read" href={guidePath(guide.slug, guideLang)}>{labels.readGuide} <Icon name="arrow-up-right" /></a>
            <a class="guide-tool" href={toolHref(guide.toolSlug)}>{labels.openTool} <Icon name="arrow-right" /></a>
          </div>
        </div>
        {guide.image && <a class="guide-card-image" href={guidePath(guide.slug, guideLang)} tabindex="-1" aria-hidden="true"><img src={guide.image} alt="" width="240" height="160" loading="lazy" decoding="async" /></a>}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .guides-hero { position: relative; overflow: hidden; margin: 12px 0 var(--space-7); padding: clamp(28px, 6vw, 58px); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: linear-gradient(115deg, #29251d, #58482d 54%, #6f633e); color: #fffaf0; box-shadow: var(--shadow-lg); }
  .guides-hero::after { position: absolute; right: -80px; bottom: -120px; width: 320px; height: 320px; border: 1px solid rgba(255,255,255,.22); border-radius: 50%; box-shadow: 0 0 0 34px rgba(255,255,255,.04), 0 0 0 68px rgba(255,255,255,.03); content: ''; }
  .guides-kicker { position: relative; z-index: 1; margin: 0 0 12px; color: #e6c58b; font: 11px/1.4 var(--font-mono); letter-spacing: .16em; }
  .guides-hero h1 { position: relative; z-index: 1; margin: 0 0 14px; color: #fffaf0; font-size: clamp(32px, 7vw, 58px); letter-spacing: -.03em; line-height: 1.08; }
  .guides-hero > p:not(.guides-kicker) { position: relative; z-index: 1; max-width: 620px; margin: 0; color: rgba(255,250,240,.82); font-size: 16px; line-height: 1.85; }
  .guides-meta { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 18px; margin-top: 28px; color: #f0d9a5; font-size: 12px; }
  .guide-list { display: grid; gap: 16px; margin-bottom: var(--space-8); }
  .guide-card { display: grid; grid-template-columns: 62px minmax(0, 1fr); gap: 18px; padding: 22px 24px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease; }
  .guide-card:hover { border-color: var(--primary-light); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .guide-card-number { align-self: start; color: var(--primary-dark); font: 700 22px/1 var(--font-mono); }
  .guide-card:has(.guide-card-image) { grid-template-columns: 62px minmax(0, 1fr) 180px; }
  .guide-card-image { align-self: center; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .guide-card-image img { display: block; width: 100%; height: 120px; object-fit: contain; background: var(--bg-secondary); }
  .guide-card-topline { display: flex; flex-wrap: wrap; gap: 12px; color: var(--text-tertiary); font-size: 12px; }
  .guide-card-topline span:first-child { color: var(--primary-dark); font-weight: 700; }
  .guide-card h2 { margin: 9px 0 8px; font-size: 21px; line-height: 1.35; }
  .guide-card h2 a { color: var(--text); }
  .guide-card p { max-width: 760px; margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.75; }
  .guide-card-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 16px; font-size: 13px; }
  .guide-read, .guide-tool { display: inline-flex; align-items: center; gap: 6px; }
  .guide-read { color: var(--primary-dark); font-weight: 700; }
  .guide-tool { color: var(--text-tertiary); }
  @media (max-width: 780px) { .guide-card:has(.guide-card-image) { grid-template-columns: 40px minmax(0, 1fr); } .guide-card-image { grid-column: 2; max-width: 240px; } }
  @media (max-width: 560px) { .guide-card, .guide-card:has(.guide-card-image) { grid-template-columns: 1fr; gap: 8px; padding: 18px; } .guide-card-number { font-size: 16px; } .guide-card-image { grid-column: 1; max-width: none; } .guide-card-image img { height: 160px; } }
</style>
