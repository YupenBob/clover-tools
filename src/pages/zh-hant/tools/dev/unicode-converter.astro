---
import Icon from '../../../../components/Icon.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'unicode-converter', 'tw')!;
const related = getRelated(category, 'unicode-converter', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="輸入內容" icon="fonts" headingId="tool-input-heading">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="uc2Sample" type="button"><Icon name="magic" /> 示例</button>
      <button class="btn btn-ghost btn-sm" id="uc2Clear" type="button"><Icon name="x-circle" /> 清空</button>
    </div>
    <textarea class="textarea" id="uc2Input" spellcheck="false" placeholder={"輸入文本或 \\uXXXX 轉義內容"} aria-labelledby="tool-input-heading"></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" id="uc2Enc" type="button"><Icon name="code-slash" /> 轉 Unicode</button>
      <button class="btn btn-secondary" id="uc2Dec" type="button"><Icon name="code-slash" /> 還原文本</button>
      <button class="btn btn-ghost" id="uc2Char" type="button"><Icon name="info-circle" /> 逐字分析</button>
    </div>
    <div class="status-msg" id="uc2Status" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="結果" icon="box-arrow-in-down" headingId="tool-output-heading">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="uc2Copy" type="button"><Icon name="clipboard" /> 復制</button>
    </div>
    <textarea class="textarea" id="uc2Output" readonly spellcheck="false" placeholder="結果將顯示在這裏" aria-labelledby="tool-output-heading"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear, bindCtrlEnter } from '../../../../scripts/toolkit';

  function toUnicode(text: string): string {
    let out = '';
    for (const ch of text) {
      const code = ch.codePointAt(0)!;
      out += code > 0xffff ? `\\u{${code.toString(16).toUpperCase()}}` : `\\u${code.toString(16).toUpperCase().padStart(4, '0')}`;
    }
    return out;
  }

  function fromUnicode(text: string): string {
    return text.replace(/\\u\{([0-9a-fA-F]+)\}|\\u([0-9a-fA-F]{4})/g, (_m, p1, p2) => String.fromCodePoint(parseInt(p1 || p2, 16)));
  }

  function analyze(text: string): string {
    const lines: string[] = [];
    for (const ch of text) {
      const code = ch.codePointAt(0)!;
      lines.push(`${ch}\tU+${code.toString(16).toUpperCase().padStart(4, '0')}\t${code}\t${toUnicode(ch)}`);
    }
    return lines.join('\n');
  }

  function run(action: 'encode' | 'decode' | 'analyze') {
    hideStatus('uc2Status');
    const src = byId<HTMLTextAreaElement>('uc2Input').value;
    if (!src) {
      showStatus('uc2Status', 'error', '請輸入內容');
      return;
    }
    try {
      if (action === 'encode') {
        byId<HTMLTextAreaElement>('uc2Output').value = toUnicode(src);
        showStatus('uc2Status', 'success', '編碼完成');
      } else if (action === 'decode') {
        byId<HTMLTextAreaElement>('uc2Output').value = fromUnicode(src);
        showStatus('uc2Status', 'success', '解碼完成');
      } else {
        byId<HTMLTextAreaElement>('uc2Output').value = '字符\t碼點\t十進制\t轉義\n' + analyze(src);
        showStatus('uc2Status', 'success', '分析完成');
      }
    } catch (error) {
      byId<HTMLTextAreaElement>('uc2Output').value = '';
      showStatus('uc2Status', 'error', (error as Error).message);
    }
  }

  byId<HTMLButtonElement>('uc2Enc').addEventListener('click', () => run('encode'));
  byId<HTMLButtonElement>('uc2Dec').addEventListener('click', () => run('decode'));
  byId<HTMLButtonElement>('uc2Char').addEventListener('click', () => run('analyze'));
  bindSample('uc2Sample', 'uc2Input', '開發者工具箱 Clover Tools');
  bindClear('uc2Clear', ['uc2Input'], ['uc2Output'], 'uc2Status');
  bindCopyBtn('uc2Copy', () => byId<HTMLTextAreaElement>('uc2Output').value);
  bindCtrlEnter('uc2Input', () => byId<HTMLButtonElement>('uc2Enc').click());
</script>
