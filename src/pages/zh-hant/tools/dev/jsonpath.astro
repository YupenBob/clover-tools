---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jsonpath', 'tw')!;
const related = getRelated(category, 'jsonpath', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JSON 數據" icon="bi-braces">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpSample" type="button"><i class="bi bi-magic"></i> 示例</button>
    </div>
    <textarea class="textarea" id="jpJson" spellcheck="false" placeholder="粘貼 JSON 數據"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jpExpr">JSONPath 表達式</label>
      <input class="input mono" id="jpExpr" type="text" value="$..title" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jpBtn" type="button"><i class="bi bi-signpost-split"></i> 查詢</button>
    </div>
    <div class="status-msg" id="jpStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">支持 $.key、['key']、[0]、[*]、..遞歸、[?(@.key == value)] 過濾。</p>
  </ToolPanel>

  <ToolPanel title="查詢結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpCopy" type="button"><i class="bi bi-clipboard"></i> 復制</button>
    </div>
    <textarea class="textarea" id="jpOutput" readonly spellcheck="false" placeholder="匹配結果將顯示在這裏"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample } from '../../../../scripts/toolkit';

  const SAMPLE = {
    store: {
      book: [
        { category: 'reference', author: 'Nigel Rees', title: 'Sayings', price: 8.95 },
        { category: 'fiction', author: 'Evelyn Waugh', title: 'Sword', price: 12.99 },
        { category: 'fiction', author: 'Herman Melville', title: 'Moby Dick', price: 8.99 },
      ],
      bicycle: { color: 'red', price: 399 },
    },
    expensive: 10,
  };

  import { query } from '../../../../lib/jsonpath';

  function run() {
    hideStatus('jpStatus');
    byId<HTMLTextAreaElement>('jpOutput').value = '';
    const json = byId<HTMLTextAreaElement>('jpJson').value.trim();
    const expr = byId<HTMLInputElement>('jpExpr').value.trim();
    if (!json || !expr) {
      showStatus('jpStatus', 'error', '請填寫 JSON 數據與表達式');
      return;
    }
    let data: unknown;
    try {
      data = JSON.parse(json);
    } catch (e) {
      showStatus('jpStatus', 'error', `JSON 解析失敗：${(e as Error).message}`);
      return;
    }
    try {
      const matches = query(data, expr);
      byId<HTMLTextAreaElement>('jpOutput').value = matches.length
        ? matches.map((m) => JSON.stringify(m, null, 2)).join('\n---\n')
        : '（無匹配結果）';
      showStatus('jpStatus', 'success', `匹配 ${matches.length} 個結果`);
    } catch (e) {
      byId<HTMLTextAreaElement>('jpOutput').value = '';
      showStatus('jpStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('jpBtn').addEventListener('click', run);
  bindSample('jpSample', 'jpJson', JSON.stringify(SAMPLE, null, 2));
  bindCopyBtn('jpCopy', () => byId<HTMLTextAreaElement>('jpOutput').value);
</script>
