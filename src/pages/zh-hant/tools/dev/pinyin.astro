---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'pinyin', 'tw')!;
const related = getRelated(category, 'pinyin', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="輸入中文" icon="bi-translate">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pySample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="pyClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="pyInput" spellcheck="false" placeholder="輸入中文，如：開發者工具箱"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="pyMode">輸出模式</label>
        <select class="select" id="pyMode">
          <option value="tone" selected>全拼（帶聲調）</option>
          <option value="plain">全拼（無聲調）</option>
          <option value="first">首字母</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="pySep">分隔符</label>
        <select class="select" id="pySep">
          <option value="" selected>無</option>
          <option value=" ">空格</option>
          <option value="-">連字符</option>
          <option value="_">下劃線</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="pyBtn" type="button"><i class="bi bi-translate"></i> 轉換</button>
    </div>
    <div class="status-msg" id="pyStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="轉換結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pyCopy" type="button"><i class="bi bi-clipboard"></i> 復制</button>
    </div>
    <textarea class="textarea" id="pyOutput" readonly spellcheck="false" placeholder="拼音結果將顯示在這裏"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  async function convert() {
    hideStatus('pyStatus');
    const src = byId<HTMLTextAreaElement>('pyInput').value;
    const mode = byId<HTMLSelectElement>('pyMode').value;
    const sep = byId<HTMLSelectElement>('pySep').value;
    if (!src) {
      showStatus('pyStatus', 'error', '請輸入中文');
      return;
    }
    try {
      const { pinyin } = await import('pinyin-pro');
      const opts = mode === 'tone'
        ? { toneType: 'symbol' as const, type: 'array' as const }
        : mode === 'plain'
          ? { toneType: 'none' as const, type: 'array' as const }
          : { toneType: 'none' as const, pattern: 'first' as const, type: 'array' as const };
      const arr = pinyin(src, opts) as string[];
      byId<HTMLTextAreaElement>('pyOutput').value = arr.join(sep);
      showStatus('pyStatus', 'success', '轉換完成');
    } catch (e) {
      showStatus('pyStatus', 'error', `轉換失敗：${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('pyBtn').addEventListener('click', convert);
  bindSample('pySample', 'pyInput', '開發者工具箱，打開即用');
  bindClear('pyClear', ['pyInput'], ['pyOutput'], 'pyStatus');
  bindCopyBtn('pyCopy', () => byId<HTMLTextAreaElement>('pyOutput').value);
</script>
