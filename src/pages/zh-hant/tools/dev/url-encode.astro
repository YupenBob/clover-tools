---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'url-encode', 'tw')!;
const related = getRelated(category, 'url-encode', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="輸入 URL 或文本" icon="bi-link-45deg">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="urlSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="urlClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="urlInput" spellcheck="false" placeholder="例如 https://example.com/搜索?q=中文 內容"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="urlMode">轉換模式</label>
        <select class="select" id="urlMode">
          <option value="encodeComponent">編碼（encodeURIComponent）</option>
          <option value="encodeUri">編碼（encodeURI，保留 :/?#）</option>
          <option value="decodeComponent">解碼（decodeURIComponent）</option>
          <option value="decodeUri">解碼（decodeURI）</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="urlBtn" type="button"><i class="bi bi-arrow-repeat"></i> 轉換</button>
    </div>
    <div class="status-msg" id="urlStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="轉換結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="urlCopy" type="button"><i class="bi bi-clipboard"></i> 復制</button>
    </div>
    <textarea class="textarea" id="urlOutput" readonly spellcheck="false" placeholder="結果將顯示在這裏"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('urlInput');
  const output = byId<HTMLTextAreaElement>('urlOutput');

  function convert() {
    hideStatus('urlStatus');
    const src = input.value;
    if (!src) {
      showStatus('urlStatus', 'error', '請輸入要轉換的內容');
      return;
    }
    const mode = byId<HTMLSelectElement>('urlMode').value;
    try {
      switch (mode) {
        case 'encodeComponent': output.value = encodeURIComponent(src); break;
        case 'encodeUri': output.value = encodeURI(src); break;
        case 'decodeComponent': output.value = decodeURIComponent(src); break;
        case 'decodeUri': output.value = decodeURI(src); break;
      }
      showStatus('urlStatus', 'success', '轉換完成');
    } catch (e) {
      output.value = '';
      showStatus('urlStatus', 'error', `轉換失敗：${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('urlBtn').addEventListener('click', convert);
  bindSample('urlSample', 'urlInput', 'https://tools.example.com/search?q=CloverTools&lang=中文');
  bindClear('urlClear', ['urlInput'], ['urlOutput'], 'urlStatus');
  bindCopyBtn('urlCopy', () => output.value);
</script>
