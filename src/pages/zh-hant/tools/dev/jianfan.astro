---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jianfan', 'tw')!;
const related = getRelated(category, 'jianfan', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="輸入文本" icon="bi-input-cursor">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="jfClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="jfInput" spellcheck="false" placeholder="輸入簡體或繁體中文"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="jfMode">轉換方向</label>
        <select class="select" id="jfMode">
          <option value="s2t">簡體 → 繁體</option>
          <option value="t2s">繁體 → 簡體</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jfBtn" type="button"><i class="bi bi-arrow-repeat"></i> 轉換</button>
    </div>
    <div class="status-msg" id="jfStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="轉換結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfCopy" type="button"><i class="bi bi-clipboard"></i> 復制</button>
    </div>
    <textarea class="textarea" id="jfOutput" readonly spellcheck="false" placeholder="結果將顯示在這裏"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';
  import zh from 'chinese-s2t';

  const input = byId<HTMLTextAreaElement>('jfInput');
  const output = byId<HTMLTextAreaElement>('jfOutput');

  async function convert() {
    hideStatus('jfStatus');
    const src = input.value;
    if (!src) {
      showStatus('jfStatus', 'error', '請輸入文本');
      return;
    }
    const mode = byId<HTMLSelectElement>('jfMode').value;
    output.value = mode === 's2t' ? zh.s2t(src) : zh.t2s(src);
    showStatus('jfStatus', 'success', '轉換完成（本地即時轉換）');
  }

  byId<HTMLButtonElement>('jfBtn').addEventListener('click', convert);
  bindSample('jfSample', 'jfInput', '軟件開發工具，時間戳轉換，簡體繁體互轉');
  bindClear('jfClear', ['jfInput'], ['jfOutput'], 'jfStatus');
  bindCopyBtn('jfCopy', () => output.value);
</script>
