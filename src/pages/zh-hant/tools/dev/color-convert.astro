---
// @shared-tool-ui: localized routes share task-specific presentation and interaction.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ColorConverter from '../../../../components/ColorConverter.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';
const lang = 'tw' as const;
const category = 'dev' as const;
const tool = getToolMeta(category, 'color-convert', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <ColorConverter lang={lang} />
</ToolLayout>
