---
import Icon from '../../../../components/Icon.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'fun' as const;
const tool = getToolMeta(category, 'random-number', 'tw')!;
const related = getRelated(category, 'random-number', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="隨機數配置" icon="shuffle">
    <div class="row">
      <div class="field">
        <label class="field-label" for="rnMin">最小值</label>
        <input class="input" id="rnMin" type="number" value="1" />
      </div>
      <div class="field">
        <label class="field-label" for="rnMax">最大值</label>
        <input class="input" id="rnMax" type="number" value="100" />
      </div>
      <div class="field">
        <label class="field-label" for="rnCount">數量</label>
        <input class="input" id="rnCount" type="number" value="5" min="1" max="1000" />
      </div>
    </div>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="rnUnique"><input type="checkbox" id="rnUnique" checked /> 不重復（需範圍足夠）</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="rnBtn" type="button"><Icon name="shuffle" /> 生成隨機數</button>
    </div>
    <div class="status-msg" id="rnStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="生成結果" icon="box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rnCopy" type="button"><Icon name="clipboard" /> 復制</button>
    </div>
    <textarea class="textarea" id="rnOutput" readonly spellcheck="false" placeholder="結果將顯示在這裏"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  import { generateRandomIntegers } from '../../../../lib/random-integers';

  function generate() {
    hideStatus('rnStatus');
    const min = Number(byId<HTMLInputElement>('rnMin').value);
    const max = Number(byId<HTMLInputElement>('rnMax').value);
    const count = Number(byId<HTMLInputElement>('rnCount').value);
    const unique = byId<HTMLInputElement>('rnUnique').checked;
    let values: number[];
    try { values = generateRandomIntegers(min, max, count, unique); }
    catch {
      byId<HTMLTextAreaElement>('rnOutput').value = '';
      showStatus('rnStatus', 'error', '請輸入安全整數；範圍最多 4294967296 個值，數量 1–1000，不重複數量不能超過範圍。');
      return;
    }
    byId<HTMLTextAreaElement>('rnOutput').value = values.join('\n');
    showStatus('rnStatus', 'success', `已生成 ${count} 個隨機數`);
  }

  byId<HTMLButtonElement>('rnBtn').addEventListener('click', generate);
  bindCopyBtn('rnCopy', () => byId<HTMLTextAreaElement>('rnOutput').value);
</script>
