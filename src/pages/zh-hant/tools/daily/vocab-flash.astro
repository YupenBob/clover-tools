---
// @shared-tool-ui: the study surface is shared across localized routes.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import VocabFlash from '../../../../components/VocabFlash.astro';
import { VOCAB_TOTAL } from '../../../../lib/vocab-books';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const lang = 'tw' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'vocab-flash', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <header slot="hero" class="tool-hero vb-hero">
    <div class="vb-hero-copy">
      <p class="vb-hero-kicker">VOCABULARY SPRINT</p>
      <h1>{tool.name}</h1>
      <p class="tool-hero-desc">六本核心詞書，翻卡速刷。認識就過，不認識就收進錯詞，進度自動儲存在本機。</p>
    </div>
    <div class="vb-hero-badge" aria-hidden="true">
      <strong>{VOCAB_TOTAL}</strong>
      <span>核心詞 · 6 本詞書</span>
    </div>
  </header>
  <VocabFlash lang={lang} />
</ToolLayout>
