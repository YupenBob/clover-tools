---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'sensitive-check', 'tw')!;
const related = getRelated(category, 'sensitive-check', 'tw', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="待檢測文本" icon="bi-shield">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="scSample" type="button"><i class="bi bi-magic"></i> 示例</button>
    </div>
    <textarea class="textarea" id="scInput" spellcheck="false" placeholder="輸入要檢測的文本"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="scCustom">自定義敏感詞（每行一個，可選）</label>
      <textarea class="textarea" id="scCustom" spellcheck="false" placeholder="補充自定義詞庫"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="scBtn" type="button"><i class="bi bi-shield-check"></i> 檢測</button>
    </div>
    <div class="status-msg" id="scStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="檢測結果" icon="bi-list-check">
    <div class="regex-view" id="scView"></div>
    <div class="lc-result mt-3" id="scResult"></div>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .regex-view {
    min-height: 120px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    white-space: pre-wrap;
    word-break: break-all;
    font-size: 14px;
    line-height: 1.8;
  }

  .regex-view mark {
    background: var(--error-soft);
    color: var(--error);
    border-radius: 3px;
    padding: 0 2px;
    font-weight: 600;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';

  const BUILTIN = ['賭博', '博彩', '詐騙', '刷單', '色情', '暴力', '毒品', '毒品交易', '代開發票', '傳銷', '洗錢', '槍械', '私彩'];

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function run() {
    hideStatus('scStatus');
    const text = byId<HTMLTextAreaElement>('scInput').value;
    if (!text) {
      showStatus('scStatus', 'error', '請輸入待檢測文本');
      return;
    }
    const custom = byId<HTMLTextAreaElement>('scCustom').value
      .split('\n').map((s) => s.trim()).filter(Boolean);
    const words = [...new Set([...BUILTIN, ...custom])].sort((a, b) => b.length - a.length);
    const hits: Record<string, number> = {};
    let html = esc(text);
    for (const word of words) {
      const escaped = esc(word);
      const re = new RegExp(escaped.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
      const matches = text.match(new RegExp(word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g'));
      if (matches) hits[word] = matches.length;
      html = html.replace(re, (m) => `<mark>${m}</mark>`);
    }
    byId<HTMLElement>('scView').innerHTML = html || '（空）';
    const total = Object.values(hits).reduce((a, b) => a + b, 0);
    byId<HTMLElement>('scResult').innerHTML = total === 0
      ? '<div>未檢測到敏感詞</div>'
      : `<div>共命中 <b>${total}</b> 處，涉及 ${Object.keys(hits).length} 個詞：</div>` +
        Object.entries(hits).map(([w, n]) => `<div>${w} × ${n}</div>`).join('');
    showStatus('scStatus', total ? 'error' : 'success', total ? `發現 ${total} 處敏感內容` : '文本幹凈');
  }

  byId<HTMLButtonElement>('scBtn').addEventListener('click', run);
  byId<HTMLButtonElement>('scSample').addEventListener('click', () => {
    byId<HTMLTextAreaElement>('scInput').value = '歡迎聯系我了解刷單兼職，日入過千，穩賺不賠，絕不詐騙。';
  });
</script>
