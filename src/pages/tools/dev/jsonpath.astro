---
import Icon from '../../../components/Icon.astro';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'jsonpath')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="JSON 数据" icon="braces">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpSample" type="button"><Icon name="magic" /> 示例</button>
    </div>
    <textarea class="textarea" id="jpJson" spellcheck="false" placeholder="粘贴 JSON 数据"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jpExpr">JSONPath 表达式</label>
      <input class="input mono" id="jpExpr" type="text" value="$..title" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jpBtn" type="button"><Icon name="signpost-split" /> 查询</button>
    </div>
    <div class="status-msg" id="jpStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">支持 $.key、['key']、[0]、[*]、..递归、[?(@.key == value)] 过滤。</p>
  </ToolPanel>

  <ToolPanel title="查询结果" icon="box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpCopy" type="button"><Icon name="clipboard" /> 复制</button>
    </div>
    <textarea class="textarea" id="jpOutput" readonly spellcheck="false" placeholder="匹配结果将显示在这里"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample } from '../../../scripts/toolkit';

  const SAMPLE = {
    store: {
      book: [
        { category: 'reference', author: 'Nigel Rees', title: 'Sayings', price: 8.95 },
        { category: 'fiction', author: 'Evelyn Waugh', title: 'Sword', price: 12.99 },
        { category: 'fiction', author: 'Herman Melville', title: 'Moby Dick', price: 8.99 },
      ],
      bicycle: { color: 'red', price: 399 },
    },
    expensive: 10,
  };

  import { query } from '../../../lib/jsonpath';

  function run() {
    hideStatus('jpStatus');
    byId<HTMLTextAreaElement>('jpOutput').value = '';
    const json = byId<HTMLTextAreaElement>('jpJson').value.trim();
    const expr = byId<HTMLInputElement>('jpExpr').value.trim();
    if (!json || !expr) {
      showStatus('jpStatus', 'error', '请填写 JSON 数据与表达式');
      return;
    }
    let data: unknown;
    try {
      data = JSON.parse(json);
    } catch (e) {
      showStatus('jpStatus', 'error', `JSON 解析失败：${(e as Error).message}`);
      return;
    }
    try {
      const matches = query(data, expr);
      byId<HTMLTextAreaElement>('jpOutput').value = matches.length
        ? matches.map((m) => JSON.stringify(m, null, 2)).join('\n---\n')
        : '（无匹配结果）';
      showStatus('jpStatus', 'success', `匹配 ${matches.length} 个结果`);
    } catch (e) {
      byId<HTMLTextAreaElement>('jpOutput').value = '';
      showStatus('jpStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('jpBtn').addEventListener('click', run);
  bindSample('jpSample', 'jpJson', JSON.stringify(SAMPLE, null, 2));
  bindCopyBtn('jpCopy', () => byId<HTMLTextAreaElement>('jpOutput').value);
</script>
