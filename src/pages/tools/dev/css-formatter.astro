---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'css-formatter')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="输入 CSS" icon="bi-filetype-css" headingId="tool-input-heading">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="cssSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="cssClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="cssInput" spellcheck="false" placeholder="粘贴 CSS 代码" aria-labelledby="tool-input-heading"></textarea>
    <div class="row">
      <div class="field">
        <label class="field-label" for="cssIndent">缩进</label>
        <select class="select" id="cssIndent">
          <option value="2" selected>2 空格</option>
          <option value="4">4 空格</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="cssSort"><input type="checkbox" id="cssSort" /> 属性排序</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="cssFmt" type="button"><i class="bi bi-braces"></i> 格式化</button>
      <button class="btn btn-secondary" id="cssMin" type="button"><i class="bi bi-arrows-collapse"></i> 压缩</button>
    </div>
    <div class="status-msg" id="cssStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="输出结果" icon="bi-box-arrow-in-down" headingId="tool-output-heading">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="cssCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="cssOutput" readonly spellcheck="false" placeholder="结果将显示在这里" aria-labelledby="tool-output-heading"></textarea>
    <div class="input-stats"><span id="cssStats">0 字符</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear, bindCtrlEnter } from '../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('cssInput');
  const output = byId<HTMLTextAreaElement>('cssOutput');

  function tokenize(css: string): string[] {
    const tokens: string[] = [];
    let cur = '';
    let inString = false;
    let quote = '';
    let depth = 0;
    for (let i = 0; i < css.length; i++) {
      const ch = css[i];
      if (inString) {
        cur += ch;
        if (ch === '\\') { cur += css[++i] || ''; continue; }
        if (ch === quote) inString = false;
        continue;
      }
      if (ch === '"' || ch === "'") {
        inString = true;
        quote = ch;
        cur += ch;
        continue;
      }
      if (ch === '/' && css[i + 1] === '*') {
        const end = css.indexOf('*/', i + 2);
        i = end === -1 ? css.length : end + 1;
        continue;
      }
      if (ch === '(' || ch === '[') depth++;
      if (ch === ')' || ch === ']') depth = Math.max(0, depth - 1);
      if (depth === 0 && (ch === '{' || ch === '}' || ch === ';')) {
        if (cur.trim()) tokens.push(cur.trim());
        tokens.push(ch);
        cur = '';
        continue;
      }
      cur += ch;
    }
    if (cur.trim()) tokens.push(cur.trim());
    return tokens;
  }

  function formatCss(css: string, indent: string, sort: boolean): string {
    const tokens = tokenize(css);
    const lines: string[] = [];
    let depth = 0;
    let pendingRule = '';
    for (const [index, token] of tokens.entries()) {
      if (token === '{') {
        lines.push(indent.repeat(depth) + pendingRule + ' {');
        pendingRule = '';
        depth++;
      } else if (token === '}') {
        if (pendingRule) {
          lines.push(indent.repeat(depth) + pendingRule + ';');
          pendingRule = '';
        }
        depth = Math.max(0, depth - 1);
        lines.push(indent.repeat(depth) + '}');
      } else if (token === ';') {
        if (pendingRule) {
          lines.push(indent.repeat(depth) + pendingRule + ';');
          pendingRule = '';
        }
      } else if (depth > 0 && token.includes(':') && tokens[index + 1] !== '{') {
        const [prop, ...rest] = token.split(':');
        const value = rest.join(':').trim();
        pendingRule = `${prop.trim()}: ${value}`;
      } else {
        pendingRule = (pendingRule ? pendingRule + ' ' : '') + token;
      }
    }
    if (pendingRule) lines.push(pendingRule);
    if (sort) {
      const sorted: string[] = [];
      let declarations: string[] = [];
      const flush = () => {
        // Stable property sorting preserves the order of repeated fallbacks.
        declarations.sort((a, b) => a.trim().split(':', 1)[0].localeCompare(b.trim().split(':', 1)[0]));
        sorted.push(...declarations);
        declarations = [];
      };
      for (const line of lines) {
        if (/^\s*[\w-]+:/.test(line) && line.endsWith(';')) declarations.push(line);
        else { flush(); sorted.push(line); }
      }
      flush();
      return sorted.join('\n');
    }
    return lines.join('\n');
  }

  function minifyCss(css: string): string {
    // Keep quoted values and calc() whitespace intact while compacting separators.
    return tokenize(css).join('')
      .replace(/("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|(;)(?=})|\s*([{};,])\s*|:\s+|\s+/g,
        (match, quoted, closing, separator) => quoted ?? (closing ? '' : separator ?? (match.startsWith(':') ? ':' : ' ')))
      .trim();
  }

  function runFormat() {
    hideStatus('cssStatus');
    if (!input.value.trim()) {
      showStatus('cssStatus', 'error', '请输入 CSS');
      return;
    }
    const indent = byId<HTMLSelectElement>('cssIndent').value === '2' ? '  ' : '    ';
    const sort = byId<HTMLInputElement>('cssSort').checked;
    output.value = formatCss(input.value, indent, sort);
    setStats('cssStats', `${output.value.length} 字符`);
    showStatus('cssStatus', 'success', '格式化完成');
  }

  function runMinify() {
    hideStatus('cssStatus');
    output.value = minifyCss(input.value);
    setStats('cssStats', `${output.value.length} 字符`);
    showStatus('cssStatus', 'success', '压缩完成');
  }

  byId<HTMLButtonElement>('cssFmt').addEventListener('click', runFormat);
  byId<HTMLButtonElement>('cssMin').addEventListener('click', runMinify);
  bindSample('cssSample', 'cssInput', '.card{margin:0 auto;padding:16px;border-radius:8px}.card h2{font-size:18px;color:#c9a96e}@media(max-width:640px){.card{padding:8px}}');
  bindClear('cssClear', ['cssInput'], ['cssOutput'], 'cssStatus');
  bindCopyBtn('cssCopy', () => output.value);
  setStats('cssStats', '0 字符');
  bindCtrlEnter('cssInput', () => byId<HTMLButtonElement>('cssFmt').click());
</script>
