---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'jwt-decoder')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="JWT Token" icon="bi-file-lock">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jwtSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="jwtClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="jwtInput" spellcheck="false" placeholder="粘贴 JWT（header.payload.signature）"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jwtSecret">签名密钥（可选，用于 HS256 验签）</label>
      <input class="input mono" id="jwtSecret" type="text" placeholder="仅本地校验，不离开浏览器" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jwtBtn" type="button"><i class="bi bi-file-lock"></i> 解码</button>
      <button class="btn btn-secondary" id="jwtVerify" type="button"><i class="bi bi-shield-check"></i> 校验 HS256 签名</button>
    </div>
    <div class="status-msg" id="jwtStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="解码结果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jwtCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="jwtOutput" readonly spellcheck="false" placeholder="Header 与 Payload 将显示在这里"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../scripts/toolkit';
  import CryptoJS from 'crypto-js';

  function b64urlToJson(s: string): unknown {
    let b64 = s.replace(/-/g, '+').replace(/_/g, '/');
    while (b64.length % 4 !== 0) b64 += '=';
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return JSON.parse(new TextDecoder().decode(bytes));
  }

  function parseToken(token: string): { header: unknown; payload: unknown; raw: string[] } | null {
    const parts = token.split('.');
    if (parts.length !== 3) return null;
    return { header: b64urlToJson(parts[0]), payload: b64urlToJson(parts[1]), raw: parts };
  }

  function describe(payload: Record<string, unknown>): string[] {
    const lines: string[] = [];
    if (payload.exp) {
      const exp = new Date(Number(payload.exp) * 1000);
      const diff = exp.getTime() - Date.now();
      lines.push(`过期时间：${exp.toLocaleString('zh-CN', { hour12: false })}（${diff > 0 ? `剩余 ${Math.floor(diff / 60000)} 分钟` : '已过期'}）`);
    }
    if (payload.iat) {
      lines.push(`签发时间：${new Date(Number(payload.iat) * 1000).toLocaleString('zh-CN', { hour12: false })}`);
    }
    if (payload.sub !== undefined) lines.push(`subject (sub)：${payload.sub}`);
    if (payload.iss !== undefined) lines.push(`issuer (iss)：${payload.iss}`);
    return lines;
  }

  function decode() {
    hideStatus('jwtStatus');
    const token = byId<HTMLTextAreaElement>('jwtInput').value.trim();
    if (!token) {
      showStatus('jwtStatus', 'error', '请输入 JWT');
      return;
    }
    try {
      const parsed = parseToken(token);
      if (!parsed) {
        showStatus('jwtStatus', 'error', 'JWT 格式不正确，应为 header.payload.signature 三段');
        return;
      }
      const payload = parsed.payload as Record<string, unknown>;
      const sections = [
        '═══ Header ═══',
        JSON.stringify(parsed.header, null, 2),
        '',
        '═══ Payload ═══',
        JSON.stringify(parsed.payload, null, 2),
      ];
      const extra = describe(payload);
      if (extra.length) sections.push('', '═══ 信息摘要 ═══', ...extra);
      byId<HTMLTextAreaElement>('jwtOutput').value = sections.join('\n');
      showStatus('jwtStatus', 'success', '解码成功');
    } catch (e) {
      byId<HTMLTextAreaElement>('jwtOutput').value = '';
      showStatus('jwtStatus', 'error', `解码失败：${(e as Error).message}`);
    }
  }

  function verify() {
    hideStatus('jwtStatus');
    const token = byId<HTMLTextAreaElement>('jwtInput').value.trim();
    const secret = byId<HTMLInputElement>('jwtSecret').value;
    if (!token || !secret) {
      showStatus('jwtStatus', 'error', '请填写 JWT 与签名密钥');
      return;
    }
    try {
      const parsed = parseToken(token);
      if (!parsed) throw new Error('JWT 格式不正确');
      const header = parsed.header as Record<string, string>;
      if ((header.alg || '').toUpperCase() !== 'HS256') {
        showStatus('jwtStatus', 'info', `当前工具仅支持 HS256 验签（该 Token 使用 ${header.alg}）`);
        return;
      }
      const signing = `${parsed.raw[0]}.${parsed.raw[1]}`;
      const expected = CryptoJS.HmacSHA256(signing, secret)
        .toString(CryptoJS.enc.Base64)
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=+$/, '');
      const ok = expected === parsed.raw[2];
      showStatus('jwtStatus', ok ? 'success' : 'error', ok ? '签名有效' : '签名无效：密钥不匹配或 Token 被篡改');
    } catch (e) {
      showStatus('jwtStatus', 'error', `校验失败：${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('jwtBtn').addEventListener('click', decode);
  byId<HTMLButtonElement>('jwtVerify').addEventListener('click', verify);
  bindSample('jwtSample', 'jwtInput', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbG92ZXIiLCJpYXQiOjE3ODUwMDAwMDAsImV4cCI6MTgxNjUzNjAwMH0.QW5FeGFtcGxlU2lnbmF0dXJl');
  bindClear('jwtClear', ['jwtInput'], ['jwtOutput'], 'jwtStatus');
  bindCopyBtn('jwtCopy', () => byId<HTMLTextAreaElement>('jwtOutput').value);
</script>
