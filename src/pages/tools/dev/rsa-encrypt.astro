---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'rsa-encrypt')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="密钥与操作" icon="bi-key">
    <div class="btn-row">
      <button class="btn btn-primary" id="rsaGen" type="button"><i class="bi bi-key"></i> 生成密钥对（2048）</button>
    </div>
    <div class="field mt-3">
      <label class="field-label" for="rsaPub">公钥（PEM）</label>
      <textarea class="textarea" id="rsaPub" spellcheck="false" placeholder="加密方使用"></textarea>
    </div>
    <div class="field">
      <label class="field-label" for="rsaPriv">私钥（PEM）</label>
      <textarea class="textarea" id="rsaPriv" spellcheck="false" placeholder="解密方使用，仅保存在本机"></textarea>
    </div>
    <div class="field">
      <label class="field-label" for="rsaInput">明文 / 密文（Base64）</label>
      <textarea class="textarea" id="rsaInput" spellcheck="false" placeholder="输入要加密的明文，或要解密的 Base64 密文"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-secondary" id="rsaEnc" type="button"><i class="bi bi-lock"></i> 加密</button>
      <button class="btn btn-secondary" id="rsaDec" type="button"><i class="bi bi-unlock"></i> 解密</button>
    </div>
    <div class="status-msg" id="rsaStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">基于 Web Crypto API（RSA-OAEP / SHA-256），密钥不出浏览器。单次加密内容长度受限于密钥长度。</p>
  </ToolPanel>

  <ToolPanel title="结果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rsaCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="rsaOutput" readonly spellcheck="false" placeholder="结果将显示在这里"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../scripts/toolkit';

  function ab2b64(buf: ArrayBuffer): string {
    const bytes = new Uint8Array(buf);
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  }

  function pem2buf(pem: string): ArrayBuffer {
    const b64 = pem.replace(/-----BEGIN [^-]+-----|-----END [^-]+-----/g, '').replace(/\s+/g, '');
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }

  function buf2pem(buf: ArrayBuffer, label: string): string {
    const b64 = ab2b64(buf).match(/.{1,64}/g)!.join('\n');
    return `-----BEGIN ${label}-----\n${b64}\n-----END ${label}-----`;
  }

  async function generate() {
    hideStatus('rsaStatus');
    try {
      const pair = await crypto.subtle.generateKey(
        { name: 'RSA-OAEP', modulusLength: 2048, publicExponent: new Uint8Array([1, 0, 1]), hash: 'SHA-256' },
        true,
        ['encrypt', 'decrypt'],
      );
      const pub = await crypto.subtle.exportKey('spki', pair.publicKey);
      const priv = await crypto.subtle.exportKey('pkcs8', pair.privateKey);
      byId<HTMLTextAreaElement>('rsaPub').value = buf2pem(pub, 'PUBLIC KEY');
      byId<HTMLTextAreaElement>('rsaPriv').value = buf2pem(priv, 'PRIVATE KEY');
      showStatus('rsaStatus', 'success', '密钥对已生成');
    } catch (e) {
      showStatus('rsaStatus', 'error', `生成失败：${(e as Error).message}`);
    }
  }

  async function encrypt() {
    hideStatus('rsaStatus');
    const pubPem = byId<HTMLTextAreaElement>('rsaPub').value.trim();
    const msg = byId<HTMLTextAreaElement>('rsaInput').value;
    if (!pubPem || !msg) {
      showStatus('rsaStatus', 'error', '请填写公钥与明文');
      return;
    }
    try {
      const key = await crypto.subtle.importKey('spki', pem2buf(pubPem), { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['encrypt']);
      const enc = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, key, new TextEncoder().encode(msg));
      byId<HTMLTextAreaElement>('rsaOutput').value = ab2b64(enc);
      showStatus('rsaStatus', 'success', '加密完成');
    } catch (e) {
      showStatus('rsaStatus', 'error', `加密失败：${(e as Error).message}`);
    }
  }

  async function decrypt() {
    hideStatus('rsaStatus');
    const privPem = byId<HTMLTextAreaElement>('rsaPriv').value.trim();
    const ct = byId<HTMLTextAreaElement>('rsaInput').value.trim();
    if (!privPem || !ct) {
      showStatus('rsaStatus', 'error', '请填写私钥与密文');
      return;
    }
    try {
      const key = await crypto.subtle.importKey('pkcs8', pem2buf(privPem), { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['decrypt']);
      const dec = await crypto.subtle.decrypt({ name: 'RSA-OAEP' }, key, pem2buf(`-----BEGIN CT-----\n${ct}\n-----END CT-----`));
      byId<HTMLTextAreaElement>('rsaOutput').value = new TextDecoder().decode(dec);
      showStatus('rsaStatus', 'success', '解密完成');
    } catch (e) {
      showStatus('rsaStatus', 'error', `解密失败：密钥不匹配或密文损坏`);
    }
  }

  byId<HTMLButtonElement>('rsaGen').addEventListener('click', generate);
  byId<HTMLButtonElement>('rsaEnc').addEventListener('click', encrypt);
  byId<HTMLButtonElement>('rsaDec').addEventListener('click', decrypt);
  bindCopyBtn('rsaCopy', () => byId<HTMLTextAreaElement>('rsaOutput').value);
</script>
