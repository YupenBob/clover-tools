---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'xml-formatter')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="输入 XML" icon="bi-filetype-xml">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="xmlSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="xmlClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="xmlInput" spellcheck="false" placeholder="粘贴 XML 数据"></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" id="xmlFmt" type="button"><i class="bi bi-braces"></i> 格式化</button>
      <button class="btn btn-secondary" id="xmlMin" type="button"><i class="bi bi-arrows-collapse"></i> 压缩</button>
      <button class="btn btn-ghost" id="xmlCheck" type="button"><i class="bi bi-check2-circle"></i> 校验</button>
    </div>
    <div class="status-msg" id="xmlStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="输出结果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="xmlCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="xmlOutput" readonly spellcheck="false" placeholder="结果将显示在这里"></textarea>
    <div class="input-stats"><span id="xmlStats">0 字符</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('xmlInput');
  const output = byId<HTMLTextAreaElement>('xmlOutput');

  function parse(): Document | null {
    const doc = new DOMParser().parseFromString(input.value, 'application/xml');
    const err = doc.querySelector('parsererror');
    if (err) {
      showStatus('xmlStatus', 'error', 'XML 不合法：' + (err.textContent || '').slice(0, 100));
      return null;
    }
    return doc;
  }

  function pretty(node: Node, depth: number, out: string[]): void {
    if (node.nodeType === Node.TEXT_NODE) {
      const text = (node.textContent || '').trim();
      if (text) out.push('  '.repeat(depth) + text + '\n');
      return;
    }
    if (node.nodeType !== Node.ELEMENT_NODE) return;
    const el = node as Element;
    const tag = el.tagName;
    const attrs = Array.from(el.attributes).map((a) => ` ${a.name}="${a.value}"`).join('');
    const indent = '  '.repeat(depth);
    const children = Array.from(el.childNodes);
    const onlyText = children.length > 0 && children.every((c) => c.nodeType === Node.TEXT_NODE);
    if (children.length === 0) {
      out.push(`${indent}<${tag}${attrs}/>\n`);
      return;
    }
    out.push(`${indent}<${tag}${attrs}>\n`);
    if (onlyText) {
      out.push('  '.repeat(depth + 1) + (el.textContent || '').trim() + '\n');
    } else {
      for (const child of children) pretty(child, depth + 1, out);
    }
    out.push(`${indent}</${tag}>\n`);
  }

  function format() {
    hideStatus('xmlStatus');
    const doc = parse();
    if (!doc) return;
    const lines: string[] = ['<?xml version="1.0" encoding="UTF-8"?>'];
    pretty(doc.documentElement, 0, lines);
    output.value = lines.join('').trim();
    setStats('xmlStats', `${output.value.length} 字符`);
    showStatus('xmlStatus', 'success', '格式化完成');
  }

  function minify() {
    hideStatus('xmlStatus');
    const doc = parse();
    if (!doc) return;
    const result: string[] = [];
    function walk(node: Node): void {
      if (node.nodeType === Node.TEXT_NODE) {
        const t = (node.textContent || '').trim();
        if (t) result.push(t);
        return;
      }
      if (node.nodeType === Node.ELEMENT_NODE) {
        const el = node as Element;
        const attrs = Array.from(el.attributes).map((a) => ` ${a.name}="${a.value}"`).join('');
        result.push(`<${el.tagName}${attrs}>`);
        for (const child of Array.from(el.childNodes)) walk(child);
        result.push(`</${el.tagName}>`);
      }
    }
    walk(doc.documentElement);
    output.value = result.join('').trim();
    setStats('xmlStats', `${output.value.length} 字符`);
    showStatus('xmlStatus', 'success', '压缩完成');
  }

  byId<HTMLButtonElement>('xmlFmt').addEventListener('click', format);
  byId<HTMLButtonElement>('xmlMin').addEventListener('click', minify);
  byId<HTMLButtonElement>('xmlCheck').addEventListener('click', () => {
    hideStatus('xmlStatus');
    if (!input.value.trim()) {
      showStatus('xmlStatus', 'error', '请输入 XML');
      return;
    }
    if (parse()) showStatus('xmlStatus', 'success', 'XML 合法');
  });
  bindSample('xmlSample', 'xmlInput', '<note date="2026-08-02"><to>Clover</to><from>Tools</from><body>XML 格式化示例</body></note>');
  bindClear('xmlClear', ['xmlInput'], ['xmlOutput'], 'xmlStatus');
  bindCopyBtn('xmlCopy', () => output.value);
  setStats('xmlStats', '0 字符');
</script>
