---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'dev' as const;
const tool = TOOLS.dev.find((t) => t.slug === 'password-strength')!;
const related = TOOLS.dev.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="开发实用">
  <ToolPanel title="输入密码" icon="bi-shield-exclamation">
    <div class="field">
      <label class="field-label" for="psInput">密码</label>
      <input class="input" id="psInput" type="password" placeholder="输入要检测的密码" autocomplete="off" />
    </div>
    <div class="strength-bars" id="psBars">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </div>
    <div class="strength-label" id="psLabel">等待输入</div>
    <div class="status-msg" id="psStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="检测明细" icon="bi-list-check">
    <ul class="check-list" id="psChecks"></ul>
    <div class="input-stats"><span id="psDetail">长度、字符组合与常见弱口令综合评估</span></div>
  </ToolPanel>
</ToolLayout>

<style>
  .strength-bars {
    display: flex;
    gap: 6px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--bg-tertiary);
    transition: background-color 0.2s ease;
  }

  .bar.filled {
    background: var(--bar-color, var(--warning));
  }

  .strength-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .check-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .check-list li.ok {
    color: var(--success);
  }

  .check-list li.bad {
    color: var(--error);
  }
</style>

<script>
  import { byId } from '../../../scripts/toolkit';

  const input = byId<HTMLInputElement>('psInput');
  const bars = byId<HTMLElement>('psBars').children;
  const label = byId<HTMLElement>('psLabel');
  const checks = byId<HTMLUListElement>('psChecks');
  const detail = byId<HTMLElement>('psDetail');

  const COMMON = ['123456', 'password', '12345678', 'qwerty', 'abc123', '111111', '123123', 'admin', 'letmein', '000000', '666666', '88888888', 'iloveyou'];

  function analyze(pw: string) {
    const len = pw.length;
    const hasLower = /[a-z]/.test(pw);
    const hasUpper = /[A-Z]/.test(pw);
    const hasDigit = /\d/.test(pw);
    const hasSymbol = /[^A-Za-z0-9]/.test(pw);
    const isCommon = COMMON.includes(pw.toLowerCase());
    const sequential = /(012|123|234|345|456|567|678|789|890|abc|bcd|cde|def|efg|fgh|ghi|hij|ijk|jkl|klm|lmn|mno|nop|opq|pqr|qrs|rst|stu|tuv|uvw|vwx|wxy|xyz)/i.test(pw);

    const results = [
      { ok: len >= 8, text: len >= 8 ? '长度不少于 8 位' : `长度不足（当前 ${len} 位）` },
      { ok: hasLower && hasUpper, text: hasLower && hasUpper ? '包含大小写字母' : '缺少大小写字母组合' },
      { ok: hasDigit, text: hasDigit ? '包含数字' : '缺少数字' },
      { ok: hasSymbol, text: hasSymbol ? '包含特殊符号' : '缺少特殊符号' },
      { ok: !isCommon, text: isCommon ? '命中常见弱口令，强烈建议更换' : '未命中常见弱口令' },
      { ok: !sequential, text: sequential ? '包含连续/顺序字符' : '无连续顺序字符' },
    ];

    let score = 0;
    score += Math.min(len / 4, 2);
    if (hasLower && hasUpper) score += 1;
    if (hasDigit) score += 0.5;
    if (hasSymbol) score += 1;
    if (isCommon) score -= 2;
    if (sequential) score -= 0.5;
    score = Math.max(0, Math.min(4, Math.round(score)));
    return { score, results };
  }

  function update() {
    const pw = input.value;
    if (!pw) {
      label.textContent = '等待输入';
      detail.textContent = '长度、字符组合与常见弱口令综合评估';
      checks.innerHTML = '';
      Array.from(bars).forEach((b) => b.classList.remove('filled'));
      return;
    }
    const { score, results } = analyze(pw);
    const meta = [
      { color: 'var(--error)', text: '非常弱' },
      { color: 'var(--error)', text: '较弱' },
      { color: 'var(--warning)', text: '中等' },
      { color: 'var(--success)', text: '较强' },
      { color: 'var(--success)', text: '非常强' },
    ][score];
    Array.from(bars).forEach((bar, i) => {
      bar.classList.toggle('filled', i < score);
      (bar as HTMLElement).style.setProperty('--bar-color', meta.color);
    });
    label.textContent = `${meta.text}（${score}/4）`;
    label.style.color = meta.color;
    checks.innerHTML = results.map((r) => `<li class="${r.ok ? 'ok' : 'bad'}"><i class="bi ${r.ok ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>${r.text}</li>`).join('');
    const entropy = pw.length * Math.log2(94);
    detail.textContent = `估算熵值约 ${entropy.toFixed(0)} bit，理想环境离线破解时间约 ${entropy > 60 ? '极长（超过数百年）' : entropy > 40 ? '数天到数月' : '数秒到数小时'}`;
  }

  input.addEventListener('input', update);
  update();
</script>
