---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'schulte-trainer')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="舒尔特训练专区" icon="bi-bullseye">
    <!-- 模式选择 -->
    <div class="st-modes" id="stModes" role="tablist" aria-label="训练模式"></div>
    <p class="muted st-modes-hint">
      <i class="bi bi-plus-circle" aria-hidden="true"></i>
      模式持续扩充中：已有 7 种，后续将加入跟随圆点、联机对战等进阶玩法。
    </p>

    <!-- 设置 -->
    <div class="st-controls">
      <div class="st-control">
        <label for="stSize">难度 N：<b id="stSizeLabel">5</b></label>
        <input id="stSize" type="range" min="3" max="9" step="1" value="5" />
        <span class="muted" id="stSizeHint">25 个数字</span>
      </div>
      <div class="st-control" id="stIntervalWrap" hidden>
        <label for="stInterval">变换间隔：<b id="stIntervalLabel">6</b> 秒</label>
        <input id="stInterval" type="range" min="3" max="12" step="1" value="6" />
      </div>
      <div class="st-control" id="stSpeedWrap" hidden>
        <label for="stSpeed">旋转速度：<b id="stSpeedLabel">中</b></label>
        <input id="stSpeed" type="range" min="1" max="3" step="1" value="2" />
      </div>
      <div class="st-control" id="stTimeWrap" hidden>
        <label for="stTime">挑战时长：<b id="stTimeLabel">60</b> 秒</label>
        <input id="stTime" type="range" min="30" max="180" step="30" value="60" />
      </div>
      <div class="st-control" id="stPeekWrap" hidden>
        <label for="stPeek">记忆时间：<b id="stPeekLabel">5</b> 秒</label>
        <input id="stPeek" type="range" min="3" max="10" step="1" value="5" />
      </div>
      <div class="st-control">
        <label class="st-check" for="stRounds">
          <input id="stRounds" type="checkbox" />
          连续挑战
        </label>
        <span class="muted">完成后自动进入下一轮</span>
      </div>
      <div class="st-control st-actions">
        <button class="btn btn-primary" id="stStart" type="button"><i class="bi bi-play-fill" aria-hidden="true"></i> 开始</button>
        <button class="btn" id="stReset" type="button"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> 重置</button>
        <button class="btn" id="stFull" type="button" title="专注模式（全屏）"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
        <button class="btn" id="stMute" type="button" title="音效开关" aria-pressed="false"><i class="bi bi-volume-up" aria-hidden="true"></i></button>
      </div>
    </div>

    <!-- 目标与进度 -->
    <div class="st-target" id="stTargetWrap">
      <svg class="st-progress" viewBox="0 0 92 92" aria-hidden="true">
        <circle class="st-progress-track" cx="46" cy="46" r="40" />
        <circle class="st-progress-bar" id="stProgressBar" cx="46" cy="46" r="40" />
      </svg>
      <span class="st-target-label">下一个</span>
      <span class="st-target-num" id="stTarget">1</span>
      <span class="st-target-side" id="stTargetSide" hidden></span>
      <span class="st-target-count" id="stCount"></span>
    </div>
    <div class="st-timer" id="stTimer" hidden></div>
    <div class="status-msg" id="stStatus" role="status" aria-live="polite"></div>

    <!-- 游戏舞台 -->
    <div class="st-stage" id="stStage">
      <div class="st-grid" id="stGrid" role="grid" aria-label="舒尔特方格"></div>
      <div class="st-discs" id="stDiscs" hidden>
        <div class="st-disc-wrap">
          <div class="st-disc" id="stDiscA" aria-label="圆盘 A"></div>
          <span class="st-disc-tag" id="stTagA">A</span>
        </div>
        <div class="st-disc-wrap">
          <div class="st-disc" id="stDiscB" aria-label="圆盘 B"></div>
          <span class="st-disc-tag" id="stTagB">B</span>
        </div>
      </div>
    </div>

    <!-- 遮罩层：记忆隐藏 / 双任务弹题 / 休息倒计时 / 完成反馈 -->
    <div class="st-veil" id="stVeil" hidden>
      <div class="st-veil-inner" id="stVeilInner"></div>
    </div>
    <div class="st-toast" id="stToast" hidden aria-live="polite"></div>

    <!-- 报告 -->
    <div class="st-report" id="stReport" hidden>
      <div class="st-report-head">
        <h3><i class="bi bi-graph-up" aria-hidden="true"></i> 训练报告</h3>
        <button class="btn" id="stClearHistory" type="button" title="清空历史记录">
          <i class="bi bi-trash" aria-hidden="true"></i> 清空历史
        </button>
      </div>
      <div class="st-report-metrics" id="stMetrics"></div>
      <div class="st-report-note" id="stNote"></div>
      <div class="st-trend" id="stTrend" aria-label="历史用时趋势"></div>
    </div>
  </ToolPanel>

  <ToolPanel title="训练目的：修复前额叶，对抗注意力碎片化" icon="bi-bullseye">
    <div class="st-purpose">
      <p>
        舒尔特训练通过<b>主动、持续的目标导向搜索</b>，反复激活<b>背外侧前额叶</b>——大脑负责注意分配、
        抑制冲动与工作记忆的指挥中枢。刷短视频时，大脑处于被动接收状态，多巴胺被高频、低成本的刺激快速消耗，
        前额叶的主动抑制与延迟满足能力随之弱化；舒尔特训练则要求你持续抑制干扰、锁定单一任务，
        相当于给前额叶做「力量训练」，逐步重建注意力稳定性与抗干扰能力。
      </p>
      <div class="st-purpose-grid">
        <div class="st-purpose-item">
          <i class="bi bi-eye" aria-hidden="true"></i>
          <b>训练视觉搜索</b>
          <span>扩大视野利用范围，练习一眼扫过整片区域找到目标，而非逐格死盯。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-bullseye" aria-hidden="true"></i>
          <b>强化前额叶抑制</b>
          <span>错点与干扰项都在训练「忍住不点错」的冲动控制，这正是前额叶的核心功能。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-shuffle" aria-hidden="true"></i>
          <b>对抗信息碎片化</b>
          <span>长期训练可提升专注时长与抗干扰能力，缓解短视频带来的注意涣散。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-clock-history" aria-hidden="true"></i>
          <b>动态追踪进阶</b>
          <span>变换与旋转模式让目标持续移动，进一步锻炼动态视觉与手眼协调。</span>
        </div>
      </div>

      <h4>模式与认知功能对照</h4>
      <div class="st-table-scroll">
        <table class="st-bench">
          <thead>
            <tr><th>模式</th><th>训练侧重</th><th>对应认知能力</th></tr>
          </thead>
          <tbody>
            <tr><td>经典方格</td><td>基础入门</td><td>视觉搜索、注意分配</td></tr>
            <tr><td>间隔变换</td><td>目标持续移动</td><td>持续注意、抗干扰</td></tr>
            <tr><td>旋转圆盘</td><td>动态追踪</td><td>动态视觉、空间注意</td></tr>
            <tr><td>双圆盘</td><td>双区扫描</td><td>注意转移、双区监控</td></tr>
            <tr><td>记忆方格</td><td>先记后找</td><td>工作记忆、前额叶记忆回路</td></tr>
            <tr><td>倒计时挑战</td><td>限时冲刺</td><td>抗压、持续专注</td></tr>
            <tr><td>双任务干扰</td><td>边点边答</td><td>认知控制、任务切换</td></tr>
          </tbody>
        </table>
      </div>

      <h4>成绩参考（经典方格）</h4>
      <div class="st-table-scroll">
        <table class="st-bench">
          <thead>
            <tr><th>难度</th><th>优秀</th><th>良好</th><th>一般</th></tr>
          </thead>
          <tbody>
            <tr><td>3×3（9 个）</td><td>&lt; 4 秒</td><td>&lt; 7 秒</td><td>&lt; 11 秒</td></tr>
            <tr><td>4×4（16 个）</td><td>&lt; 10 秒</td><td>&lt; 15 秒</td><td>&lt; 22 秒</td></tr>
            <tr><td>5×5（25 个）</td><td>&lt; 16 秒</td><td>&lt; 25 秒</td><td>&lt; 36 秒</td></tr>
            <tr><td>6×6（36 个）</td><td>&lt; 28 秒</td><td>&lt; 42 秒</td><td>&lt; 60 秒</td></tr>
            <tr><td>7×7（49 个）</td><td>&lt; 45 秒</td><td>&lt; 65 秒</td><td>&lt; 90 秒</td></tr>
            <tr><td>8×8（64 个）</td><td>&lt; 65 秒</td><td>&lt; 95 秒</td><td>&lt; 130 秒</td></tr>
            <tr><td>9×9（81 个）</td><td>&lt; 95 秒</td><td>&lt; 135 秒</td><td>&lt; 185 秒</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted st-tip">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        建议每天 3–5 组、每组间休息 30 秒；圆盘、记忆与双任务模式适合已能稳定完成经典方格的进阶者。
        训练效果看长期趋势而非单次成绩，坚持两周以上更明显。开启专注模式可减少干扰，获得更沉浸的训练体验。
      </p>
    </div>
  </ToolPanel>
</ToolLayout>

<style>
  .st-modes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 8px;
  }

  .st-modes-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    margin-bottom: var(--space-5);
  }

  .st-mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 6px;
    min-height: 76px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease,
      transform 0.15s ease, box-shadow 0.15s ease;
  }

  .st-mode i {
    font-size: 22px;
    color: var(--text-tertiary);
    transition: color 0.15s ease;
  }

  .st-mode:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .st-mode.active {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary-dark);
    box-shadow: var(--ring);
  }

  .st-mode.active i {
    color: var(--primary-dark);
  }

  .st-controls {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px 20px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    margin-bottom: var(--space-5);
  }

  .st-control {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .st-control label {
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .st-control input[type='range'] {
    accent-color: var(--primary);
    width: 100%;
  }

  .st-check {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .st-check input {
    accent-color: var(--primary);
    width: 16px;
    height: 16px;
  }

  .st-actions {
    flex-direction: row;
    align-items: flex-end;
    gap: 8px;
    grid-column: 1 / -1;
  }

  .st-actions .btn {
    min-height: 44px;
  }

  /* ── 目标 / 进度 ── */
  .st-target {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: var(--space-4);
  }

  .st-progress {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 108px;
    height: 108px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .st-progress-track,
  .st-progress-bar {
    fill: none;
    stroke-width: 5;
  }

  .st-progress-track {
    stroke: var(--border);
  }

  .st-progress-bar {
    stroke: var(--primary);
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    transition: stroke-dashoffset 0.2s ease;
  }

  .st-target-label {
    position: absolute;
    top: calc(50% - 46px);
    font-size: 11.5px;
    color: var(--text-tertiary);
  }

  .st-target-num {
    min-width: 52px;
    padding: 14px 18px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--primary-dark);
    background: var(--bg-elevated);
    border: 2px solid var(--primary);
    border-radius: 50%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    z-index: 1;
  }

  .st-target-num.bump {
    transform: scale(1.12);
    box-shadow: var(--ring);
  }

  .st-target-side {
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    background: var(--primary-dark);
    border-radius: var(--radius-full);
    z-index: 1;
  }

  .st-target-count {
    position: absolute;
    bottom: calc(50% - 52px);
    font-size: 12.5px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    z-index: 1;
  }

  .st-timer {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--primary-dark);
    margin-bottom: var(--space-3);
  }

  .st-timer.urgent {
    color: var(--error);
    animation: st-pulse 1s ease infinite;
  }

  @keyframes st-pulse {
    50% { opacity: 0.5; }
  }

  /* ── 舞台 ── */
  .st-stage {
    display: flex;
    justify-content: center;
    margin: var(--space-5) 0;
  }

  .st-grid {
    display: grid;
    width: min(100%, 520px);
    aspect-ratio: 1;
    gap: 8px;
    touch-action: manipulation;
  }

  .st-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(14px, 2.6vw, 24px);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease,
      transform 0.1s ease, opacity 0.2s ease;
  }

  .st-cell:hover:not(.done):not(.wrong):not(.hidden) {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .st-cell:active:not(.done) {
    transform: scale(0.96);
  }

  .st-cell.done {
    background: transparent;
    border-color: transparent;
    color: var(--text-tertiary);
    cursor: default;
    transform: scale(0.7);
    opacity: 0.55;
  }

  .st-cell.wrong {
    border-color: var(--error);
    color: var(--error);
    animation: st-shake 0.25s ease;
  }

  .st-cell.hidden {
    color: transparent;
    background: var(--bg-tertiary);
    cursor: default;
  }

  .st-cell.hint {
    border-color: var(--primary);
    box-shadow: var(--ring);
    animation: st-hint 0.7s ease;
  }

  .st-cell.flash {
    border-color: var(--primary);
    box-shadow: var(--ring);
  }

  @keyframes st-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  @keyframes st-hint {
    0%, 100% { box-shadow: none; }
    50% { box-shadow: var(--ring); }
  }

  .st-discs {
    display: flex;
    justify-content: center;
    gap: clamp(20px, 5vw, 60px);
    width: 100%;
    flex-wrap: wrap;
  }

  .st-disc-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .st-disc {
    position: relative;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: radial-gradient(circle at 50% 42%, var(--bg-elevated), var(--bg-secondary));
    box-shadow: inset 0 0 24px rgba(var(--primary-rgb), 0.08);
  }

  .st-ring {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .st-dnum {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease,
      opacity 0.2s ease, transform 0.1s ease;
  }

  .st-dnum:hover:not(.done):not(.wrong) {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .st-dnum.done {
    opacity: 0.15;
    border-color: transparent;
    cursor: default;
    transform: scale(0.78);
  }

  .st-dnum.wrong {
    border-color: var(--error);
    color: var(--error);
    animation: st-shake 0.25s ease;
  }

  .st-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--primary-light), var(--primary-dark));
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow: var(--shadow-sm);
  }

  .st-disc-tag {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 2px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: var(--primary-dark);
    border-radius: var(--radius-full);
    z-index: 2;
  }

  /* ── 遮罩 ── */
  .st-veil {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
  }

  .st-veil[hidden],
  .st-toast[hidden] {
    display: none !important;
  }

  .st-veil-inner {
    text-align: center;
    padding: var(--space-5);
  }

  .st-veil-inner .big {
    font-size: clamp(28px, 6vw, 48px);
    font-weight: 800;
    color: var(--primary-dark);
    margin-bottom: var(--space-3);
  }

  .st-veil-inner .sub {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .st-question {
    font-size: clamp(30px, 7vw, 56px);
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: var(--space-4);
  }

  .st-answers {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .st-answer {
    min-width: 92px;
    min-height: 56px;
    font-size: 18px;
    font-weight: 700;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
  }

  .st-answer:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--ring);
  }

  .st-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 90;
    padding: 12px 22px;
    border-radius: var(--radius-full);
    background: var(--primary-dark);
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    box-shadow: var(--shadow-lg);
    animation: st-toast-in 0.25s ease;
  }

  @keyframes st-toast-in {
    from { opacity: 0; transform: translate(-50%, -12px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  /* ── 报告 ── */
  .st-report {
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .st-report-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: var(--space-4);
  }

  .st-report-head h3 {
    margin: 0;
    font-size: 17px;
  }

  .st-report-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: var(--space-4);
  }

  .st-metric {
    padding: 12px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }

  .st-metric b {
    display: block;
    font-size: 21px;
    color: var(--primary-dark);
