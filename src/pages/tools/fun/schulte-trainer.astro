---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'schulte-trainer')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="舒尔特训练" icon="bi-bullseye">
    <div class="st-panel">
      <!-- 面板背景光晕 -->
      <div class="st-bg" aria-hidden="true">
        <span class="st-glow st-glow-1"></span>
        <span class="st-glow st-glow-2"></span>
        <span class="st-glow st-glow-3"></span>
      </div>

    <!-- 第一幕：开始 -->
    <section id="actStart" class="st-act">
      <header class="st-hero">
        <span class="st-hero-badge"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
        <div class="st-hero-title">舒尔特训练</div>
        <p class="st-lead">
          从 1 开始，按顺序点击目标。每一次点击都是一次注意力的锚定，
          训练过程全屏沉浸，完成后生成专属训练报告。
        </p>
      </header>

      <div class="st-section-title"><span>选择模式</span></div>
      <div class="st-modes" id="stModes" role="tablist" aria-label="训练模式"></div>

      <div class="st-section-title"><span>训练设置</span></div>
      <div class="st-settings" id="stSettings">
        <div class="st-setting-row">
          <label for="stSize">难度 N</label>
          <div class="st-setting-control">
            <input id="stSize" type="range" min="3" max="9" step="1" value="5" />
            <span class="st-setting-value" id="stSizeLabel">5</span>
          </div>
          <span class="muted" id="stSizeHint">25 个数字</span>
        </div>
        <div class="st-setting-row" id="stIntervalWrap" hidden>
          <label for="stInterval">变换间隔</label>
          <div class="st-setting-control">
            <input id="stInterval" type="range" min="3" max="12" step="1" value="6" />
            <span class="st-setting-value" id="stIntervalLabel">6s</span>
          </div>
        </div>
        <div class="st-setting-row" id="stSpeedWrap" hidden>
          <label for="stSpeed">旋转速度</label>
          <div class="st-setting-control">
            <input id="stSpeed" type="range" min="1" max="3" step="1" value="2" />
            <span class="st-setting-value" id="stSpeedLabel">中</span>
          </div>
        </div>
        <div class="st-setting-row" id="stTimeWrap" hidden>
          <label for="stTime">挑战时长</label>
          <div class="st-setting-control">
            <input id="stTime" type="range" min="30" max="180" step="30" value="60" />
            <span class="st-setting-value" id="stTimeLabel">60s</span>
          </div>
        </div>
        <div class="st-setting-row" id="stPeekWrap" hidden>
          <label for="stPeek">记忆时间</label>
          <div class="st-setting-control">
            <input id="stPeek" type="range" min="3" max="10" step="1" value="5" />
            <span class="st-setting-value" id="stPeekLabel">5s</span>
          </div>
        </div>
      </div>

      <div class="st-options">
        <label class="st-check" for="stRounds">
          <input id="stRounds" type="checkbox" />
          连续挑战 <span class="muted">完成后休息 5 秒自动下一轮</span>
        </label>
        <div class="st-option-btns">
          <button class="st-icon-btn" id="stFull" type="button" title="专注模式（全屏）"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
          <button class="st-icon-btn" id="stMute" type="button" title="音效开关" aria-pressed="false"><i class="bi bi-volume-up" aria-hidden="true"></i></button>
          <button class="st-icon-btn" id="stClearHistory" type="button" title="清空历史记录"><i class="bi bi-trash" aria-hidden="true"></i></button>
        </div>
      </div>

      <button class="st-start-btn" id="stStart" type="button">
        <i class="bi bi-play-fill" aria-hidden="true"></i> 开始训练
      </button>
      <div class="status-msg" id="stStartStatus" role="status" aria-live="polite"></div>
    </section>

    <!-- 第二幕：训练（全屏沉浸） -->
    <section class="st-train" id="actTrain" hidden aria-label="训练进行中">
      <div class="st-train-bg" aria-hidden="true">
        <span class="st-glow st-glow-1"></span>
        <span class="st-glow st-glow-2"></span>
        <div class="st-dust" aria-hidden="true">
          <span class="st-dust-p" style="--x: 12%; --d: 9s; --dl: 0s; --s: 5px;"></span>
          <span class="st-dust-p" style="--x: 27%; --d: 11s; --dl: 1.6s; --s: 4px;"></span>
          <span class="st-dust-p" style="--x: 41%; --d: 10s; --dl: 3.2s; --s: 6px;"></span>
          <span class="st-dust-p" style="--x: 58%; --d: 12s; --dl: 0.8s; --s: 5px;"></span>
          <span class="st-dust-p" style="--x: 72%; --d: 9.5s; --dl: 2.4s; --s: 4px;"></span>
          <span class="st-dust-p" style="--x: 86%; --d: 10.5s; --dl: 4s; --s: 6px;"></span>
          <span class="st-dust-p" style="--x: 20%; --d: 13s; --dl: 5.2s; --s: 3px;"></span>
          <span class="st-dust-p" style="--x: 64%; --d: 11.5s; --dl: 6.4s; --s: 5px;"></span>
          <span class="st-dust-p" style="--x: 48%; --d: 9s; --dl: 7.6s; --s: 4px;"></span>
          <span class="st-dust-p" style="--x: 92%; --d: 12.5s; --dl: 8.8s; --s: 5px;"></span>
        </div>
      </div>
      <div class="st-train-head st-glass">
        <button class="st-exit" id="stExit" type="button" title="退出训练"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        <div class="st-train-meta">
          <span class="st-train-mode" id="stModeLabel">经典方格</span>
          <span class="st-train-size" id="stSizeLabel2">N=5</span>
        </div>
        <div class="st-train-right">
          <span class="st-train-count" id="stCount">0 / 25</span>
          <svg class="st-train-ring" viewBox="0 0 44 44" aria-hidden="true">
            <defs>
              <linearGradient id="stRingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" />
                <stop offset="100%" />
              </linearGradient>
            </defs>
            <circle class="ring-track" cx="22" cy="22" r="19" />
            <circle class="ring-bar" id="stProgressBar" cx="22" cy="22" r="19" stroke="url(#stRingGrad)" />
          </svg>
          <span class="st-train-timer" id="stTimer" hidden></span>
        </div>
      </div>

      <div class="st-train-body">
        <div class="st-target-big">
          <span class="st-target-num" id="stTarget">1</span>
          <span class="st-target-side" id="stTargetSide" hidden></span>
        </div>
        <div class="st-stage" id="stStage">
          <div class="st-grid" id="stGrid" role="grid" aria-label="舒尔特方格"></div>
          <div class="st-discs" id="stDiscs" hidden>
            <div class="st-disc-wrap">
              <div class="st-disc" id="stDiscA" aria-label="圆盘 A"></div>
              <span class="st-disc-tag" id="stTagA">A</span>
            </div>
            <div class="st-disc-wrap">
              <div class="st-disc" id="stDiscB" aria-label="圆盘 B"></div>
              <span class="st-disc-tag" id="stTagB">B</span>
            </div>
          </div>
        </div>
        <div class="st-train-status" id="stTrainStatus" role="status" aria-live="polite"></div>
      </div>
    </section>

    <!-- 第三幕：结果 -->
    <section class="st-result" id="actResult" hidden aria-label="训练结果">
      <div class="st-train-bg" aria-hidden="true">
        <span class="st-glow st-glow-1"></span>
        <span class="st-glow st-glow-3"></span>
      </div>
      <div class="st-result-inner st-glass">
        <div class="st-result-grade" id="stGrade"></div>
        <div class="st-result-metrics" id="stMetrics"></div>
        <div class="st-result-note" id="stNote"></div>
        <div class="st-result-trend" id="stTrend" aria-label="历史用时趋势"></div>
        <div class="st-result-actions">
          <button class="btn btn-primary" id="stAgain" type="button"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> 再来一组</button>
          <button class="btn" id="stBack" type="button"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> 返回选择</button>
        </div>
      </div>
    </section>

    <!-- 训练中遮罩：记忆 / Stroop / 休息倒计时 -->
    <div class="st-veil" id="stVeil" hidden>
      <div class="st-veil-inner" id="stVeilInner"></div>
    </div>
      <div class="st-toast" id="stToast" hidden aria-live="polite"></div>
    </div>
  </ToolPanel>

  <ToolPanel title="训练目的：修复前额叶，对抗注意力碎片化" icon="bi-bullseye">
    <div class="st-purpose">
      <p>
        舒尔特训练通过<b>主动、持续的目标导向搜索</b>，反复激活<b>背外侧前额叶</b>——大脑负责注意分配、
        抑制冲动与工作记忆的指挥中枢。刷短视频时，大脑处于被动接收状态，多巴胺被高频、低成本的刺激快速消耗，
        前额叶的主动抑制与延迟满足能力随之弱化；舒尔特训练要求你持续抑制干扰、锁定单一任务，
        相当于给前额叶做力量训练，逐步重建注意力稳定性与抗干扰能力。
      </p>
      <div class="st-purpose-grid">
        <div class="st-purpose-item">
          <i class="bi bi-eye" aria-hidden="true"></i>
          <b>训练视觉搜索</b>
          <span>扩大视野利用范围，练习一眼扫过整片区域找到目标，而非逐格死盯。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-bullseye" aria-hidden="true"></i>
          <b>强化前额叶抑制</b>
          <span>错点与干扰项都在训练忍住不点错的冲动控制，这正是前额叶的核心功能。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-shuffle" aria-hidden="true"></i>
          <b>对抗信息碎片化</b>
          <span>长期训练可提升专注时长与抗干扰能力，缓解短视频带来的注意涣散。</span>
        </div>
        <div class="st-purpose-item">
          <i class="bi bi-clock-history" aria-hidden="true"></i>
          <b>动态追踪进阶</b>
          <span>变换与旋转模式让目标持续移动，进一步锻炼动态视觉与手眼协调。</span>
        </div>
      </div>

      <h4>模式与认知功能对照</h4>
      <div class="st-table-scroll">
        <table class="st-bench">
          <thead>
            <tr><th>模式</th><th>训练侧重</th><th>对应认知能力</th></tr>
          </thead>
          <tbody>
            <tr><td>经典方格</td><td>基础入门</td><td>视觉搜索、注意分配</td></tr>
            <tr><td>间隔变换</td><td>目标持续移动</td><td>持续注意、抗干扰</td></tr>
            <tr><td>旋转圆盘</td><td>动态追踪</td><td>动态视觉、空间注意</td></tr>
            <tr><td>双圆盘</td><td>双区扫描</td><td>注意转移、双区监控</td></tr>
            <tr><td>记忆方格</td><td>先记后找</td><td>工作记忆、前额叶记忆回路</td></tr>
            <tr><td>倒计时挑战</td><td>限时冲刺</td><td>抗压、持续专注</td></tr>
            <tr><td>双任务干扰</td><td>边点边答</td><td>认知控制、任务切换</td></tr>
          </tbody>
        </table>
      </div>

      <h4>成绩参考（经典方格）</h4>
      <div class="st-table-scroll">
        <table class="st-bench">
          <thead>
            <tr><th>难度</th><th>优秀</th><th>良好</th><th>一般</th></tr>
          </thead>
          <tbody>
            <tr><td>3×3（9 个）</td><td>&lt; 4 秒</td><td>&lt; 7 秒</td><td>&lt; 11 秒</td></tr>
            <tr><td>4×4（16 个）</td><td>&lt; 10 秒</td><td>&lt; 15 秒</td><td>&lt; 22 秒</td></tr>
            <tr><td>5×5（25 个）</td><td>&lt; 16 秒</td><td>&lt; 25 秒</td><td>&lt; 36 秒</td></tr>
            <tr><td>6×6（36 个）</td><td>&lt; 28 秒</td><td>&lt; 42 秒</td><td>&lt; 60 秒</td></tr>
            <tr><td>7×7（49 个）</td><td>&lt; 45 秒</td><td>&lt; 65 秒</td><td>&lt; 90 秒</td></tr>
            <tr><td>8×8（64 个）</td><td>&lt; 65 秒</td><td>&lt; 95 秒</td><td>&lt; 130 秒</td></tr>
            <tr><td>9×9（81 个）</td><td>&lt; 95 秒</td><td>&lt; 135 秒</td><td>&lt; 185 秒</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted st-tip">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        建议每天 3–5 组、每组间休息 30 秒；圆盘、记忆与双任务模式适合已能稳定完成经典方格的进阶者。
        训练效果看长期趋势而非单次成绩，坚持两周以上更明显。
      </p>
    </div>
  </ToolPanel>
</ToolLayout>

<style is:global>
  /* ── 第一幕：开始 ── */
  .st-lead {
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-secondary);
    margin: 0 0 var(--space-5);
  }

  .st-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .st-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .st-modes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: var(--space-5);
  }

  .st-mode {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 8px 14px;
    min-height: 108px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease,
      transform 0.18s ease, box-shadow 0.18s ease;
  }

  .st-mode .st-mode-ico {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 24px;
    color: var(--text-tertiary);
    transition: all 0.18s ease;
  }

  .st-mode .st-mode-desc {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--text-tertiary);
    text-align: center;
    line-height: 1.5;
  }

  .st-mode:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
  }

  .st-mode.active {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary-dark);
    box-shadow: var(--ring);
  }

  .st-mode.active .st-mode-ico {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .st-mode.active .st-mode-desc {
    color: var(--text-secondary);
  }

  .st-settings {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    margin-bottom: var(--space-4);
  }

  .st-setting-row {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 4px 0;
  }

  .st-setting-row label {
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .st-setting-control {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .st-setting-control input[type='range'] {
    flex: 1;
    accent-color: var(--primary);
    min-width: 120px;
  }

  .st-setting-value {
    min-width: 38px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    color: var(--primary-dark);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
  }

  .st-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .st-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    cursor: pointer;
    color: var(--text);
  }

  .st-check input {
    accent-color: var(--primary);
    width: 17px;
    height: 17px;
  }

  .st-option-btns {
    display: flex;
    gap: 8px;
  }

  .st-icon-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .st-icon-btn:hover {
    border-color: var(--primary);
    color: var(--primary-dark);
  }

  .st-start-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 60px;
    border: none;
    border-radius: var(--radius-md);
    background: linear-gradient(120deg, var(--primary-dark), var(--primary));
    color: #fff;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 4px;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }

  .st-start-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    filter: brightness(1.05);
  }

  .st-start-btn:active {
    transform: translateY(0);
  }

  /* ── 第二幕：训练 ── */
  .st-train {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    animation: st-fade-in 0.25s ease;
  }

  @keyframes st-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .st-train-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px clamp(16px, 4vw, 40px);
    border-bottom: 1px solid var(--border);
  }

  .st-exit {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .st-exit:hover {
    border-color: var(--error);
    color: var(--error);
  }

  .st-train-meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .st-train-mode {
    font-size: 17px;
    font-weight: 700;
  }

  .st-train-size {
    font-size: 13px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .st-train-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .st-train-count {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .st-train-ring {
    width: 44px;
    height: 44px;
  }

  .st-train-ring .ring-track {
    fill: none;
    stroke: var(--border);
    stroke-width: 4;
  }

  .st-train-ring .ring-bar {
    fill: none;
    stroke: var(--primary);
    stroke-width: 4;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    transition: stroke-dashoffset 0.2s ease;
  }

  .st-train-timer {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--primary-dark);
  }

  .st-train-timer.urgent {
    color: var(--error);
    animation: st-pulse 1s ease infinite;
  }

  @keyframes st-pulse {
    50% { opacity: 0.45; }
  }

  .st-train-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 4vh, 36px);
    padding: clamp(16px, 4vw, 40px);
    overflow: auto;
  }

  .st-target-big {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .st-target-num {
    min-width: clamp(72px, 12vw, 104px);
    min-height: clamp(72px, 12vw, 104px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 60px);
    font-weight: 800;
    color: var(--primary-dark);
    background: radial-gradient(circle at 35% 28%, var(--primary-light), var(--primary-soft));
    border: 2px solid var(--primary);
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }

  .st-target-num.bump {
    transform: scale(1.08);
    box-shadow: var(--ring);
  }

  .st-target-side {
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: var(--primary-dark);
    border-radius: var(--radius-full);
  }

  .st-stage {
    width: 100%;
    max-width: min(96vw, 1080px);
  }

  .st-grid {
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    gap: clamp(5px, 1vw, 10px);
    touch-action: manipulation;
  }

  .st-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(15px, 3.4vw, 28px);
    font-weight: 700;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    box-shadow: var(--shadow-xs);
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease,
      transform 0.1s ease, opacity 0.22s ease, box-shadow 0.12s ease;
  }

  .st-cell:hover:not(.done):not(.wrong):not(.hidden) {
    border-color: var(--primary);
    background: var(--primary-soft);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .st-cell:active:not(.done) {
    transform: scale(0.95);
  }

  .st-cell.done {
    background: transparent;
    border-color: transparent;
    color: var(--text-tertiary);
    cursor: default;
    transform: scale(0.55);
    opacity: 0.3;
    box-shadow: none;
  }

  .st-cell.wrong {
    border-color: var(--error);
    color: var(--error);
    animation: st-shake 0.25s ease;
  }

  .st-cell.hidden {
    color: transparent;
    background: var(--bg-tertiary);
    cursor: default;
  }

  .st-cell.hint {
    border-color: var(--primary);
    box-shadow: var(--ring);
  }

  .st-cell.flash {
    border-color: var(--primary);
    box-shadow: var(--ring);
  }

  @keyframes st-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }

  .st-discs {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    width: 100%;
    flex-wrap: wrap;
  }

  .st-disc-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .st-disc-wrap.st-scaled {
    width: var(--dw, 396px);
    height: var(--dw, 396px);
  }

  .st-disc-wrap.st-scaled .st-disc {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(var(--s, 1));
  }

  .st-disc {
    position: relative;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: radial-gradient(circle at 50% 42%, var(--bg-elevated), var(--bg-secondary));
    box-shadow: inset 0 0 28px rgba(var(--primary-rgb), 0.08);
  }

  .st-ring {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .st-dnum {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(38px, 6.5vw, 48px);
    height: clamp(38px, 6.5vw, 48px);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(14px, 2.4vw, 18px);
    font-weight: 700;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    box-shadow: var(--shadow-xs);
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease,
      opacity 0.2s ease, transform 0.1s ease;
  }

  .st-dnum:hover:not(.done):not(.wrong) {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .st-dnum.done {
    opacity: 0.13;
    border-color: transparent;
    cursor: default;
    transform: scale(0.7);
  }

  .st-dnum.wrong {
    border-color: var(--error);
    color: var(--error);
    animation: st-shake 0.25s ease;
  }

  .st-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--primary-light), var(--primary-dark));
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow: var(--shadow-sm);
    z-index: 1;
  }

  .st-disc-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 3px 14px;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    background: var(--primary-dark);
    border-radius: var(--radius-full);
    z-index: 2;
  }

  .st-train-status {
    min-height: 28px;
    text-align: center;
    font-size: 14.5px;
    color: var(--text-secondary);
  }

  .st-train-status.error {
    color: var(--error);
    font-weight: 600;
  }

  /* ── 第三幕：结果 ── */
  .st-result {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 48px);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    animation: st-fade-in 0.3s ease;
  }

  .st-result-inner {
    width: min(100%, 620px);
    max-height: 92vh;
    overflow: auto;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
  }

  .st-result-grade {
    font-size: clamp(40px, 8vw, 64px);
    font-weight: 800;
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .st-result-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: var(--space-4);
  }

  .st-metric {
    padding: 14px 10px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .st-metric b {
    display: block;
    font-size: 24px;
    color: var(--primary-dark);
    font-family: var(--font-mono);
  }

  .st-metric b small {
    font-size: 13px;
    margin-left: 2px;
  }

  .st-metric span {
    font-size: 12.5px;
    color: var(--text-tertiary);
  }

  .st-result-note {
    margin-bottom: var(--space-4);
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--primary-soft);
    font-size: 14px;
    line-height: 1.7;
  }

  .st-result-trend {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 120px;
    padding: 12px 10px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    margin-bottom: var(--space-5);
  }

  .st-bar {
    flex: 1;
    min-width: 12px;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, var(--primary), var(--primary-dark));
    opacity: 0.72;
    transition: opacity 0.15s ease;
    position: relative;
  }

  .st-bar:last-child {
    opacity: 1;
    box-shadow: var(--ring);
  }

  .st-bar:hover {
    opacity: 1;
  }

  .st-bar::after {
    content: attr(data-label);
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10.5px;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .st-trend-empty {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .st-result-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .st-result-actions .btn {
    min-height: 48px;
    padding: 0 26px;
    font-size: 15px;
  }

  /* ── 遮罩与提示 ── */
  .st-veil {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .st-veil[hidden],
  .st-toast[hidden],
  .st-train[hidden],
  .st-result[hidden] {
    display: none !important;
  }

  .st-veil-inner {
    text-align: center;
    padding: var(--space-5);
  }

  .st-veil-inner .big {
    font-size: clamp(30px, 6vw, 52px);
    font-weight: 800;
    color: var(--primary-dark);
    margin-bottom: var(--space-3);
  }

  .st-veil-inner .sub {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .st-question {
    font-size: clamp(32px, 8vw, 60px);
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: var(--space-4);
  }

  .st-answers {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .st-answer {
    min-width: 96px;
    min-height: 60px;
    font-size: 19px;
    font-weight: 700;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
  }

  .st-answer:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--ring);
  }

  .st-toast {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 95;
    padding: 12px 24px;
    border-radius: var(--radius-full);
    background: var(--primary-dark);
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    box-shadow: var(--shadow-lg);
    animation: st-toast-in 0.25s ease;
  }

  @keyframes st-toast-in {
    from { opacity: 0; transform: translate(-50%, -12px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  /* ── 训练目的 ── */
  .st-purpose p {
    line-height: 1.9;
    margin-bottom: var(--space-4);
  }

  .st-purpose-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin-bottom: var(--space-5);
  }

  .st-purpose-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .st-purpose-item i {
    font-size: 20px;
    color: var(--primary-dark);
    margin-bottom: 2px;
  }

  .st-purpose-item span {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .st-purpose h4 {
    margin: 0 0 10px;
    font-size: 15px;
  }

  .st-table-scroll {
    overflow-x: auto;
    margin-bottom: var(--space-5);
  }

  .st-bench {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    min-width: 420px;
  }

  .st-bench th,
  .st-bench td {
    padding: 8px 10px;
    border: 1px solid var(--border);
    text-align: left;
  }

  .st-bench th {
    background: var(--bg-tertiary);
    font-weight: 600;
  }

  .st-tip {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.7;
  }

  .st-tip i {
    margin-top: 2px;
    color: var(--primary-dark);
  }

  @media (max-width: 640px) {
    .st-modes {
      grid-template-columns: repeat(2, 1fr);
    }

    .st-setting-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .st-options {
      flex-direction: column;
      align-items: flex-start;
    }

    .st-train-head {
      padding: 10px 14px;
    }

    .st-train-meta {
      flex-direction: column;
      gap: 2px;
    }

    .st-train-count {
      display: none;
    }

    .st-grid {
      gap: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-cell.wrong,
    .st-dnum.wrong,
    .st-train-timer.urgent {
      animation: none;
    }
  }

  /* ═══ 视觉升级：金色光晕沉浸版 ═══ */
  .st-panel {
    position: relative;
  }

  .st-act {
    position: relative;
    z-index: 1;
  }

  /* ── 背景光晕 ── */
  .st-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .st-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    pointer-events: none;
  }

  .st-glow-1 {
    width: 520px;
    height: 520px;
    top: -150px;
    left: -130px;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.30), transparent 66%);
    animation: st-breathe 9s ease-in-out infinite;
  }

  .st-glow-2 {
    width: 460px;
    height: 460px;
    top: 32%;
    right: -170px;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.20), transparent 66%);
    animation: st-breathe 12s ease-in-out infinite reverse;
  }

  .st-glow-3 {
    width: 380px;
    height: 380px;
    bottom: -130px;
    left: 28%;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.15), transparent 66%);
    animation: st-breathe 10s ease-in-out infinite 1.5s;
  }

  @keyframes st-breathe {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.07); }
  }

  /* ── 玻璃拟态 ── */
  .st-glass {
    background: color-mix(in srgb, var(--bg-elevated) 66%, transparent) !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent) !important;
    box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
  }

  /* ── 训练幕背景与尘埃粒子 ── */
  .st-train-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 50% 0%, color-mix(in srgb, var(--bg-elevated) 55%, transparent), transparent 62%),
      radial-gradient(90% 70% at 50% 110%, rgba(var(--primary-rgb), 0.10), transparent 60%);
  }

  .st-train-bg .st-glow-1 {
    width: 640px;
    height: 640px;
    top: -220px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.26), transparent 66%);
  }

  .st-train-bg .st-glow-3 {
    width: 460px;
    height: 460px;
    bottom: -180px;
    left: -140px;
  }

  .st-dust {
    position: absolute;
    inset: 0;
  }

  .st-dust-p {
    position: absolute;
    left: var(--x);
    top: 58%;
    width: var(--s, 5px);
    height: var(--s, 5px);
    border-radius: 50%;
    background: rgba(var(--primary-rgb), 0.55);
    box-shadow: 0 0 10px rgba(var(--primary-rgb), 0.65);
    opacity: 0;
    animation: st-float var(--d, 10s) ease-in-out infinite;
    animation-delay: var(--dl, 0s);
  }

  @keyframes st-float {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    12% { opacity: 0.7; }
    50% { transform: translateY(-36vh) translateX(16px); opacity: 0.5; }
    85% { opacity: 0.35; }
    100% { transform: translateY(-70vh) translateX(-10px); opacity: 0; }
  }

  .st-train-head,
  .st-train-body,
  .st-result-inner {
    position: relative;
    z-index: 1;
  }

  /* ── 开始幕 Hero ── */
  .st-hero {
    position: relative;
    text-align: center;
    padding: 6px 0 var(--space-5);
  }

  .st-hero-badge {
    width: 66px;
    height: 66px;
    margin: 0 auto var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: #fff;
    background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(var(--primary-rgb), 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.55);
    animation: st-hero-in 0.5s ease both;
  }

  @keyframes st-hero-in {
    from { opacity: 0; transform: translateY(-12px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .st-hero-title {
    font-size: clamp(32px, 5.5vw, 46px);
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.25;
    background: linear-gradient(120deg, var(--primary-dark), var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 12px rgba(var(--primary-rgb), 0.28));
    margin-bottom: var(--space-3);
  }

  .st-lead {
    max-width: 560px;
    margin: 0 auto;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  /* ── 模式卡片：玻璃 + 发光 ── */
  .st-mode {
    position: relative;
    background: color-mix(in srgb, var(--bg-elevated) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    overflow: hidden;
    animation: st-fade-up 0.5s ease both;
  }

  .st-mode:nth-child(1) { animation-delay: 0.04s; }
  .st-mode:nth-child(2) { animation-delay: 0.09s; }
  .st-mode:nth-child(3) { animation-delay: 0.14s; }
  .st-mode:nth-child(4) { animation-delay: 0.19s; }
  .st-mode:nth-child(5) { animation-delay: 0.24s; }
  .st-mode:nth-child(6) { animation-delay: 0.29s; }
  .st-mode:nth-child(7) { animation-delay: 0.34s; }

  @keyframes st-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .st-mode:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
    box-shadow: 0 10px 26px rgba(var(--primary-rgb), 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .st-mode.active {
    border-color: var(--primary);
    background: linear-gradient(160deg, color-mix(in srgb, var(--primary-soft) 70%, var(--bg-elevated)), var(--primary-soft));
    box-shadow: 0 10px 30px rgba(var(--primary-rgb), 0.28), var(--ring);
  }

  .st-mode .st-mode-ico {
    background: linear-gradient(145deg, var(--bg-elevated), color-mix(in srgb, var(--bg-elevated) 80%, var(--primary-light)));
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    box-shadow: 0 4px 12px rgba(60, 50, 20, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .st-mode.active .st-mode-ico {
    background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 6px 18px rgba(var(--primary-rgb), 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* ── 设置区玻璃化 ── */
  .st-settings {
    background: color-mix(in srgb, var(--bg-elevated) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .st-setting-value {
