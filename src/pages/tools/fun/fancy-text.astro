---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'fancy-text')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="输入文本" icon="bi-stars">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ftSample" type="button"><i class="bi bi-magic"></i> 示例</button>
      <button class="btn btn-ghost btn-sm" id="ftClear" type="button"><i class="bi bi-x-circle"></i> 清空</button>
    </div>
    <textarea class="textarea" id="ftInput" spellcheck="false" placeholder="输入文字，生成个性花字"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="ftStyle">风格</label>
        <select class="select" id="ftStyle">
          <option value="huoxing" selected>火星文</option>
          <option value="sup">上标数字</option>
          <option value="sub">下标数字</option>
          <option value="fullwidth">全角字符</option>
          <option value="mirror">水平翻转</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="ftBtn" type="button"><i class="bi bi-stars"></i> 生成花字</button>
    </div>
    <div class="status-msg" id="ftStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="生成结果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ftCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="ftOutput" readonly spellcheck="false" placeholder="结果将显示在这里"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../scripts/toolkit';

  const L33T: Record<string, string> = {
    a: '@', b: '8', c: '(', e: '3', g: '9', i: '1', l: '1', o: '0', s: '$', t: '7', z: '2',
  };
  const SUP: Record<string, string> = {
    '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹',
    a: 'ᵃ', b: 'ᵇ', c: 'ᶜ', d: 'ᵈ', e: 'ᵉ', f: 'ᶠ', g: 'ᵍ', h: 'ʰ', i: 'ⁱ', j: 'ʲ', k: 'ᵏ', l: 'ˡ', m: 'ᵐ', n: 'ⁿ', o: 'ᵒ', p: 'ᵖ', r: 'ʳ', s: 'ˢ', t: 'ᵗ', u: 'ᵘ', v: 'ᵛ', w: 'ʷ', x: 'ˣ', y: 'ʸ', z: 'ᶻ',
  };
  const SUB: Record<string, string> = {
    '0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄', '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉',
    a: 'ₐ', e: 'ₑ', h: 'ₕ', i: 'ᵢ', j: 'ⱼ', k: 'ₖ', l: 'ₗ', m: 'ₘ', n: 'ₙ', o: 'ₒ', p: 'ₚ', r: 'ᵣ', s: 'ₛ', t: 'ₜ', u: 'ᵤ', v: 'ᵥ', x: 'ₓ',
  };

  function convert() {
    hideStatus('ftStatus');
    const src = byId<HTMLTextAreaElement>('ftInput').value;
    const style = byId<HTMLSelectElement>('ftStyle').value;
    if (!src) {
      showStatus('ftStatus', 'error', '请输入文本');
      return;
    }
    let out = '';
    switch (style) {
      case 'huoxing':
        out = Array.from(src).map((ch) => {
          const lower = ch.toLowerCase();
          return L33T[lower] && Math.random() > 0.3 ? L33T[lower] : ch;
        }).join('');
        break;
      case 'sup':
        out = Array.from(src.toLowerCase()).map((ch) => SUP[ch] || ch).join('');
        break;
      case 'sub':
        out = Array.from(src.toLowerCase()).map((ch) => SUB[ch] || ch).join('');
        break;
      case 'fullwidth':
        out = src.replace(/[!-~]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0xfee0));
        break;
      case 'mirror':
        out = Array.from(src).reverse().join('');
        break;
    }
    byId<HTMLTextAreaElement>('ftOutput').value = out;
    showStatus('ftStatus', 'success', '生成完成');
  }

  byId<HTMLButtonElement>('ftBtn').addEventListener('click', convert);
  bindSample('ftSample', 'ftInput', 'CloverTools 幸运草');
  bindClear('ftClear', ['ftInput'], ['ftOutput'], 'ftStatus');
  bindCopyBtn('ftCopy', () => byId<HTMLTextAreaElement>('ftOutput').value);
</script>
