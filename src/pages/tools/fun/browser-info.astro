---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'browser-info')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="浏览器与设备信息" icon="bi-browser-chrome">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="biRefresh" type="button"><i class="bi bi-arrow-clockwise"></i> 刷新</button>
    </div>
    <table class="bi-table" id="biTable"></table>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .bi-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .bi-table th,
  .bi-table td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    word-break: break-all;
  }

  .bi-table th {
    width: 180px;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .bi-table td {
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>

<script>
  import { byId } from '../../../scripts/toolkit';

  function collect(): [string, string][] {
    const nav = navigator;
    const conn = (nav as unknown as { connection?: { effectiveType?: string; type?: string; downlink?: number; rtt?: number } }).connection;
    const screen = window.screen;
    const rows: [string, string][] = [
      ['浏览器', `${nav.userAgentData?.brands?.map((b: { brand: string; version: string }) => `${b.brand} ${b.version}`).join(' / ') || '—'}`],
      ['User-Agent', nav.userAgent],
      ['平台', `${nav.platform}${nav.userAgentData?.mobile ? '（移动端）' : ''}`],
      ['语言', `${nav.language}（${nav.languages?.join(', ') || '—'}）`],
      ['在线状态', nav.onLine ? '在线' : '离线'],
      ['Cookie 可用', nav.cookieEnabled ? '是' : '否'],
      ['屏幕分辨率', `${screen.width} × ${screen.height}`],
      ['可用屏幕', `${screen.availWidth} × ${screen.availHeight}`],
      ['窗口视口', `${window.innerWidth} × ${window.innerHeight}`],
      ['像素比', String(window.devicePixelRatio || 1)],
      ['CPU 核心数', String(nav.hardwareConcurrency || '未知')],
      ['设备内存', nav.deviceMemory ? `${nav.deviceMemory} GB` : '未知'],
      ['网络类型', conn ? `${conn.effectiveType || '未知'}（${conn.type || '未知'}）` : '未知'],
      ['网络带宽', conn?.downlink ? `${conn.downlink} Mbps` : '未知'],
      ['网络延迟', conn?.rtt ? `${conn.rtt} ms` : '未知'],
      ['时区', Intl.DateTimeFormat().resolvedOptions().timeZone],
      ['深色模式', window.matchMedia('(prefers-color-scheme: dark)').matches ? '启用' : '未启用'],
      ['减少动效', window.matchMedia('(prefers-reduced-motion: reduce)').matches ? '启用' : '未启用'],
      ['触摸支持', 'ontouchstart' in window ? '支持' : '不支持'],
    ];
    return rows;
  }

  function render() {
    byId<HTMLElement>('biTable').innerHTML = collect()
      .map(([k, v]) => `<tr><th>${k}</th><td>${v.replace(/</g, '&lt;')}</td></tr>`)
      .join('');
  }

  byId<HTMLButtonElement>('biRefresh').addEventListener('click', render);
  window.addEventListener('resize', render);
  render();
</script>
