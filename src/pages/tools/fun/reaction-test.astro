---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'reaction-test')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="反应力测试" icon="bi-lightning-charge">
    <div class="rt-stage" id="rtStage">
      <div class="rt-toolbar">
        <button class="btn btn-secondary btn-sm rt-fullscreen" id="rtFullscreen" type="button" aria-pressed="false">
          <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i><span id="rtFullscreenText">全屏</span>
        </button>
      </div>
      <button class="rt-area" id="rtArea" type="button">
        <span id="rtText">点击开始，屏幕变绿后尽快点击</span>
      </button>
      <div class="status-msg" id="rtStatus" role="status" aria-live="polite"></div>
      <div class="lc-result mt-4" id="rtResult"></div>
    </div>
  </ToolPanel>
</ToolLayout>

<style>
  .rt-stage {
    display: grid;
    gap: 14px;
  }

  .rt-toolbar {
    display: flex;
    justify-content: flex-end;
  }

  .rt-fullscreen {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .rt-area {
    width: 100%;
    min-height: 260px;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    color: var(--text);
    font-size: 19px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.1s ease, color 0.1s ease;
  }

  .rt-area.waiting {
    background: var(--error);
    color: #fff;
  }

  .rt-area.go {
    background: var(--success);
    color: #fff;
  }

  .rt-stage:fullscreen,
  .rt-stage:-webkit-full-screen {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    background: var(--bg);
  }

  .rt-stage:fullscreen .rt-area,
  .rt-stage:-webkit-full-screen .rt-area {
    flex: 1 1 auto;
    min-height: 0;
    border-radius: var(--radius-md);
    font-size: 32px;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../scripts/toolkit';

  const area = byId<HTMLButtonElement>('rtArea');
  const text = byId<HTMLElement>('rtText');
  const result = byId<HTMLElement>('rtResult');
  let state: 'idle' | 'waiting' | 'go' = 'idle';
  let goAt = 0;
  let timer: ReturnType<typeof setTimeout> | null = null;
  const history: number[] = [];

  function renderHistory() {
    if (history.length === 0) {
      result.innerHTML = '<div class="muted">完成一次挑战后显示成绩</div>';
      return;
    }
    const avg = history.reduce((a, b) => a + b, 0) / history.length;
    const best = Math.min(...history);
    result.innerHTML =
      `<div>本次反应：<b>${history[history.length - 1]}</b> ms</div>` +
      `<div>平均：${avg.toFixed(0)} ms · 最佳：${best} ms · 共 ${history.length} 次</div>`;
  }

  function startWait() {
    state = 'waiting';
    area.classList.add('waiting');
    text.textContent = '等待变绿……';
    const delay = 1500 + Math.random() * 2500;
    timer = setTimeout(() => {
      state = 'go';
      area.classList.remove('waiting');
      area.classList.add('go');
      text.textContent = '点击！';
      goAt = performance.now();
    }, delay);
  }

  area.addEventListener('click', () => {
    if (state === 'idle') {
      hideStatus('rtStatus');
      startWait();
      return;
    }
    if (state === 'waiting') {
      if (timer) clearTimeout(timer);
      state = 'idle';
      area.classList.remove('waiting');
      text.textContent = '太早了！等变绿再点，点击重试';
      showStatus('rtStatus', 'error', '提前点击，本次无效');
      return;
    }
    if (state === 'go') {
      const ms = Math.round(performance.now() - goAt);
      state = 'idle';
      area.classList.remove('go');
      text.textContent = `反应时间 ${ms} ms，点击再来一次`;
      history.push(ms);
      if (history.length > 5) history.shift();
      renderHistory();
      const grade = ms < 200 ? '极速反应' : ms < 280 ? '反应敏捷' : ms < 350 ? '正常水平' : ms < 450 ? '偏慢' : '该补觉了';
      showStatus('rtStatus', 'success', `${ms} ms · ${grade}`);
    }
  });

  const stage = byId<HTMLElement>('rtStage');
  const fullscreenBtn = byId<HTMLButtonElement>('rtFullscreen');
  const fullscreenText = byId<HTMLElement>('rtFullscreenText');
  const fullscreenIcon = fullscreenBtn.querySelector('i');

  function syncFullscreen() {
    const active = document.fullscreenElement === stage;
    fullscreenBtn.setAttribute('aria-pressed', String(active));
    fullscreenText.textContent = active ? '退出全屏' : '全屏';
    if (fullscreenIcon) {
      fullscreenIcon.className = active ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
    }
  }

  fullscreenBtn.addEventListener('click', () => {
    // 必须在点击的用户激活内发起，前面不能有 await。
    if (document.fullscreenElement) void document.exitFullscreen().catch(() => undefined);
    else void stage.requestFullscreen?.().catch(() => undefined);
  });

  document.addEventListener('fullscreenchange', syncFullscreen);

  renderHistory();
</script>
