---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'random-number')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="随机数配置" icon="bi-shuffle">
    <div class="row">
      <div class="field">
        <label class="field-label" for="rnMin">最小值</label>
        <input class="input" id="rnMin" type="number" value="1" />
      </div>
      <div class="field">
        <label class="field-label" for="rnMax">最大值</label>
        <input class="input" id="rnMax" type="number" value="100" />
      </div>
      <div class="field">
        <label class="field-label" for="rnCount">数量</label>
        <input class="input" id="rnCount" type="number" value="5" min="1" max="1000" />
      </div>
    </div>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="rnUnique"><input type="checkbox" id="rnUnique" checked /> 不重复（需范围足够）</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="rnBtn" type="button"><i class="bi bi-shuffle"></i> 生成随机数</button>
    </div>
    <div class="status-msg" id="rnStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="生成结果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rnCopy" type="button"><i class="bi bi-clipboard"></i> 复制</button>
    </div>
    <textarea class="textarea" id="rnOutput" readonly spellcheck="false" placeholder="结果将显示在这里"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../scripts/toolkit';

  import { generateRandomIntegers } from '../../../lib/random-integers';

  function generate() {
    hideStatus('rnStatus');
    const min = Number(byId<HTMLInputElement>('rnMin').value);
    const max = Number(byId<HTMLInputElement>('rnMax').value);
    const count = Number(byId<HTMLInputElement>('rnCount').value);
    const unique = byId<HTMLInputElement>('rnUnique').checked;
    let values: number[];
    try { values = generateRandomIntegers(min, max, count, unique); }
    catch {
      byId<HTMLTextAreaElement>('rnOutput').value = '';
      showStatus('rnStatus', 'error', '请输入安全整数；范围最多 4294967296 个值，数量 1–1000，不重复数量不能超过范围。');
      return;
    }
    byId<HTMLTextAreaElement>('rnOutput').value = values.join('\n');
    showStatus('rnStatus', 'success', `已生成 ${count} 个随机数`);
  }

  byId<HTMLButtonElement>('rnBtn').addEventListener('click', generate);
  bindCopyBtn('rnCopy', () => byId<HTMLTextAreaElement>('rnOutput').value);
</script>
