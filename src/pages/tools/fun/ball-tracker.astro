---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'fun' as const;
const tool = TOOLS.fun.find((t) => t.slug === 'ball-tracker')!;
const related = TOOLS.fun.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="趣味工具">
  <ToolPanel title="目标球追踪训练" icon="bi-crosshair">
    <div class="bt-panel">
      <!-- 面板背景光晕 -->
      <div class="bt-bg" aria-hidden="true">
        <span class="bt-glow bt-glow-1"></span>
        <span class="bt-glow bt-glow-2"></span>
        <span class="bt-glow bt-glow-3"></span>
      </div>

      <!-- 第一幕：开始 -->
      <section id="btStart" class="bt-act">
        <header class="bt-hero">
          <span class="bt-hero-badge"><i class="bi bi-crosshair" aria-hidden="true"></i></span>
          <div class="bt-hero-title">目标球追踪</div>
          <p class="bt-lead">
            在移动球群中锁定目标，抵御诱惑与陷阱，克制提前出手的急躁。
            每一次正确点击都是前额叶抑制控制的训练。
          </p>
        </header>

        <div class="bt-section-title"><span>选择模式</span></div>
        <div class="bt-modes" id="btModes"></div>

        <div class="bt-section-title"><span>训练设置</span></div>
        <div class="bt-settings">
          <div class="bt-setting-row">
            <label for="btSize">球数量</label>
            <div class="bt-setting-control">
              <input id="btSize" type="range" min="8" max="20" step="1" value="12" />
              <span class="bt-setting-value" id="btSizeLabel">12</span>
            </div>
          </div>
          <div class="bt-setting-row" id="btTargetsWrap">
            <label for="btTargets">目标数</label>
            <div class="bt-setting-control">
              <input id="btTargets" type="range" min="1" max="3" step="1" value="2" />
              <span class="bt-setting-value" id="btTargetsLabel">2</span>
            </div>
          </div>
          <div class="bt-setting-row" id="btSpeedWrap">
            <label for="btSpeed">移动速度</label>
            <div class="bt-setting-control">
              <input id="btSpeed" type="range" min="40" max="300" step="1" value="150" />
              <span class="bt-setting-value" id="btSpeedLabel">150</span>
            </div>
          </div>
          <div class="bt-setting-row">
            <label for="btDur">训练时长</label>
            <div class="bt-setting-control">
              <input id="btDur" type="range" min="10" max="30" step="5" value="15" />
              <span class="bt-setting-value" id="btDurLabel">15s</span>
            </div>
          </div>
          <div class="bt-setting-row" id="btFluxWrap" hidden>
            <label for="btFlux">混入频率</label>
            <div class="bt-setting-control">
              <input id="btFlux" type="range" min="3" max="8" step="1" value="5" />
              <span class="bt-setting-value" id="btFluxLabel">5s</span>
            </div>
          </div>
          <div class="bt-setting-row" id="btRotateWrap" hidden>
            <label for="btRotate">旋转速度</label>
            <div class="bt-setting-control">
              <input id="btRotate" type="range" min="5" max="20" step="1" value="10" />
              <span class="bt-setting-value" id="btRotateLabel">10°/s</span>
            </div>
          </div>
        </div>

        <div class="bt-options">
          <span class="bt-hint muted">数量增减会不断混入新球，整体旋转考验空间定向</span>
          <div class="bt-option-btns">
            <button class="bt-icon-btn" id="btFull" type="button" title="专注模式（全屏）"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
            <button class="bt-icon-btn" id="btMute" type="button" title="音效开关" aria-pressed="false"><i class="bi bi-volume-up" aria-hidden="true"></i></button>
          </div>
        </div>

        <button class="bt-start-btn" id="btStartBtn" type="button">
          <i class="bi bi-play-fill" aria-hidden="true"></i> 开始训练
        </button>
      </section>

      <!-- 第二幕：训练 -->
      <section class="bt-train" id="btTrain" hidden aria-label="训练进行中">
        <div class="bt-train-bg" aria-hidden="true">
          <span class="bt-glow bt-glow-1"></span>
          <span class="bt-glow bt-glow-3"></span>
          <div class="bt-dust" aria-hidden="true">
            <span class="bt-dust-p" style="--x: 14%; --d: 9s; --dl: 0s; --s: 5px;"></span>
            <span class="bt-dust-p" style="--x: 32%; --d: 11s; --dl: 1.8s; --s: 4px;"></span>
            <span class="bt-dust-p" style="--x: 55%; --d: 10s; --dl: 3.4s; --s: 6px;"></span>
            <span class="bt-dust-p" style="--x: 74%; --d: 12s; --dl: 0.9s; --s: 5px;"></span>
            <span class="bt-dust-p" style="--x: 88%; --d: 9.5s; --dl: 4.2s; --s: 4px;"></span>
          </div>
        </div>
        <div class="bt-train-head bt-glass">
          <button class="bt-exit" id="btExit" type="button" title="退出训练"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
          <div class="bt-train-meta">
            <span class="bt-train-mode" id="btModeLabel">目标追踪</span>
            <span class="bt-train-phase" id="btPhaseText"></span>
          </div>
          <div class="bt-train-right">
            <span class="bt-train-count" id="btCount"></span>
            <span class="bt-train-timer" id="btTimer" hidden></span>
          </div>
        </div>
        <div class="bt-train-body">
          <div class="bt-stage" id="btStage">
            <canvas id="btCanvas"></canvas>
          </div>
          <div class="bt-train-status" id="btTrainStatus" role="status" aria-live="polite"></div>
        </div>
      </section>

      <!-- 第三幕：结果 -->
      <section class="bt-result" id="btResult" hidden aria-label="训练结果">
        <div class="bt-train-bg" aria-hidden="true">
          <span class="bt-glow bt-glow-1"></span>
          <span class="bt-glow bt-glow-3"></span>
        </div>
        <div class="bt-result-inner bt-glass">
          <div class="bt-result-grade" id="btGrade"></div>
          <div class="bt-result-metrics" id="btMetrics"></div>
          <div class="bt-result-note" id="btNote"></div>
          <div class="bt-result-trend" id="btTrend" aria-label="历史准确率趋势"></div>
          <div class="bt-result-actions">
            <button class="btn btn-primary" id="btAgain" type="button"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> 再来一组</button>
            <button class="btn" id="btBack" type="button"><i class="bi bi-crosshair" aria-hidden="true"></i> 返回选择</button>
          </div>
        </div>
      </section>

      <div class="bt-veil" id="btVeil" hidden>
        <div class="bt-veil-inner" id="btVeilInner"></div>
      </div>
      <div class="bt-toast" id="btToast" hidden aria-live="polite"></div>
    </div>
  </ToolPanel>

  <ToolPanel title="训练目的：前额叶抑制控制" icon="bi-crosshair">
    <div class="bt-purpose">
      <p>
        目标球追踪训练的核心是<b>抑制控制</b>——前额叶负责的一项高级认知功能：
        在动态场景中持续锁定目标（注意分配）、抵御干扰刺激（抗分心）、
        在旋转坐标系中保持空间定向（空间注意）。短视频与快节奏应用不断训练「看到就想点」的冲动回路，
        而这项训练反向要求你<b>看得准、锁得住、记得牢</b>，正是对前额叶的针对性锻炼。
      </p>
      <div class="bt-purpose-grid">
        <div class="bt-purpose-item">
          <i class="bi bi-crosshair" aria-hidden="true"></i>
          <b>动态视觉追踪</b>
          <span>在多个相同球中持续锁定目标，训练视觉工作记忆与注意分配。</span>
        </div>
        <div class="bt-purpose-item">
          <i class="bi bi-shield-x" aria-hidden="true"></i>
          <b>抗诱惑与干扰</b>
          <span>诱惑球与陷阱球模拟现实中的干扰刺激，锻炼「忍住不点」的抑制能力。</span>
        </div>
        <div class="bt-purpose-item">
          <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
          <b>空间定向与旋转追踪</b>
          <span>整体旋转要求适应运动坐标系，强化空间工作记忆与动态注意。</span>
        </div>
        <div class="bt-purpose-item">
          <i class="bi bi-graph-up" aria-hidden="true"></i>
          <b>量化进步</b>
          <span>准确率、冲动误触与趋势报告让你看到抑制控制的真实变化。</span>
        </div>
      </div>

      <h4>模式与认知功能对照</h4>
      <div class="bt-table-scroll">
        <table class="bt-bench">
          <thead>
            <tr><th>模式</th><th>训练侧重</th><th>对应认知能力</th></tr>
          </thead>
          <tbody>
            <tr><td>目标追踪</td><td>基础动态追踪</td><td>视觉工作记忆、注意分配</td></tr>
            <tr><td>数量增减</td><td>追踪中混入新球</td><td>注意维持、抗干扰</td></tr>
            <tr><td>整体旋转</td><td>旋转场景追踪</td><td>空间注意、工作记忆</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted bt-tip">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        建议每天 3–5 组；目标是标记消失后仍能锁定目标，重点是观察趋势而非单次成绩，坚持两周以上更明显。
      </p>
    </div>
  </ToolPanel>
</ToolLayout>

<style is:global>
  /* ═══ 目标球追踪：金色光晕沉浸 ═══ */
  .bt-panel {
    position: relative;
  }

  .bt-act {
    position: relative;
    z-index: 1;
  }

  .bt-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .bt-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    pointer-events: none;
  }

  .bt-glow-1 {
    width: 520px;
    height: 520px;
    top: -150px;
    left: -130px;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.3), transparent 66%);
    animation: bt-breathe 9s ease-in-out infinite;
  }

  .bt-glow-2 {
    width: 460px;
    height: 460px;
    top: 32%;
    right: -170px;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.2), transparent 66%);
    animation: bt-breathe 12s ease-in-out infinite reverse;
  }

  .bt-glow-3 {
    width: 380px;
    height: 380px;
    bottom: -130px;
    left: 28%;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.15), transparent 66%);
    animation: bt-breathe 10s ease-in-out infinite 1.5s;
  }

  @keyframes bt-breathe {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.07); }
  }

  .bt-glass {
    background: color-mix(in srgb, var(--bg-elevated) 66%, transparent) !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent) !important;
    box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
  }

  /* ── Hero ── */
  .bt-hero {
    text-align: center;
    padding: 6px 0 var(--space-5);
  }

  .bt-hero-badge {
    width: 66px;
    height: 66px;
    margin: 0 auto var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: #fff;
    background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(var(--primary-rgb), 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.55);
    animation: bt-hero-in 0.5s ease both;
  }

  @keyframes bt-hero-in {
    from { opacity: 0; transform: translateY(-12px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .bt-hero-title {
    font-size: clamp(32px, 5.5vw, 46px);
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.25;
    background: linear-gradient(120deg, var(--primary-dark), var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 12px rgba(var(--primary-rgb), 0.28));
    margin-bottom: var(--space-3);
  }

  .bt-lead {
    max-width: 560px;
    margin: 0 auto;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .bt-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .bt-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ── 模式卡片 ── */
  .bt-modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: var(--space-5);
  }

  .bt-mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 8px 14px;
    min-height: 108px;
    border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-elevated) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    animation: bt-fade-up 0.5s ease both;
  }

  .bt-mode:nth-child(1) { animation-delay: 0.05s; }
  .bt-mode:nth-child(2) { animation-delay: 0.12s; }
  .bt-mode:nth-child(3) { animation-delay: 0.19s; }

  @keyframes bt-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .bt-mode .bt-mode-ico {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--bg-elevated), color-mix(in srgb, var(--bg-elevated) 80%, var(--primary-light)));
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    box-shadow: 0 4px 12px rgba(60, 50, 20, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.7);
    font-size: 24px;
    color: var(--text-tertiary);
    transition: all 0.18s ease;
  }

  .bt-mode .bt-mode-desc {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--text-tertiary);
    text-align: center;
    line-height: 1.5;
  }

  .bt-mode:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
  }

  .bt-mode.active {
    border-color: var(--primary);
    background: linear-gradient(160deg, color-mix(in srgb, var(--primary-soft) 70%, var(--bg-elevated)), var(--primary-soft));
    box-shadow: 0 10px 30px rgba(var(--primary-rgb), 0.28), var(--ring);
    color: var(--primary-dark);
  }

  .bt-mode.active .bt-mode-ico {
    background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 6px 18px rgba(var(--primary-rgb), 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* ── 设置 ── */
  .bt-settings {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-elevated) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    margin-bottom: var(--space-4);
  }

  .bt-setting-row {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 4px 0;
  }

  .bt-setting-row[hidden] {
    display: none !important;
  }

  .bt-setting-row label {
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .bt-setting-control {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bt-setting-control input[type='range'] {
    flex: 1;
    accent-color: var(--primary);
    min-width: 120px;
    -webkit-appearance: none;
    appearance: none;
    height: 22px;
    background: transparent;
    cursor: pointer;
  }

  .bt-setting-control input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--primary-light), color-mix(in srgb, var(--primary) 35%, var(--border)));
  }

  .bt-setting-control input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -7px;
    border-radius: 50%;
    background: linear-gradient(145deg, #fff, var(--primary-light));
    border: 2px solid var(--primary);
    box-shadow: 0 2px 8px rgba(var(--primary-rgb), 0.45);
  }

  .bt-setting-value {
    min-width: 38px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    color: var(--primary-dark);
    background: linear-gradient(145deg, var(--primary-soft), var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--primary) 40%, var(--border));
    border-radius: var(--radius-sm);
    padding: 4px 8px;
  }

  .bt-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .bt-hint {
    font-size: 12.5px;
  }

  .bt-option-btns {
    display: flex;
    gap: 8px;
  }

  .bt-icon-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .bt-icon-btn:hover {
    border-color: var(--primary);
    color: var(--primary-dark);
  }

  .bt-start-btn {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 60px;
    border: none;
    border-radius: var(--radius-md);
    background: linear-gradient(120deg, var(--primary-dark), var(--primary));
    color: #fff;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 4px;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }

  .bt-start-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.38) 50%, transparent 70%);
    transform: translateX(-110%);
    transition: transform 0.65s ease;
    pointer-events: none;
  }

  .bt-start-btn:hover::before {
    transform: translateX(110%);
  }

  .bt-start-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    filter: brightness(1.05);
  }

  /* ── 训练幕 ── */
  .bt-train {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    animation: bt-fade 0.25s ease;
  }

  @keyframes bt-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .bt-train-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 50% 0%, color-mix(in srgb, var(--bg-elevated) 55%, transparent), transparent 62%),
      radial-gradient(90% 70% at 50% 110%, rgba(var(--primary-rgb), 0.1), transparent 60%);
  }

  .bt-train-bg .bt-glow-1 {
    width: 640px;
    height: 640px;
    top: -220px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.26), transparent 66%);
  }

  .bt-train-bg .bt-glow-3 {
    width: 460px;
    height: 460px;
    bottom: -180px;
    left: -140px;
  }

  .bt-dust {
    position: absolute;
    inset: 0;
  }

  .bt-dust-p {
    position: absolute;
    left: var(--x);
    top: 58%;
    width: var(--s, 5px);
    height: var(--s, 5px);
    border-radius: 50%;
    background: rgba(var(--primary-rgb), 0.55);
