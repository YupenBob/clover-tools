---
// @shared-tool-ui: localized routes share calculations while the tool owns its composition.
import ToolLayout from '../../../layouts/ToolLayout.astro';
import FinanceCalculator from '../../../components/FinanceCalculator.astro';
import { getToolMeta, getRelated } from '../../../lib/i18n';
const lang = 'zh' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'finance', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <FinanceCalculator lang={lang} />
</ToolLayout>
