---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'daily' as const;
const tool = TOOLS.daily.find((t) => t.slug === 'salary')!;
const related = TOOLS.daily.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="日常实用">
  <ToolPanel title="税前工资" icon="bi-cash-stack">
    <div class="row">
      <div class="field">
        <label class="field-label" for="salGross">税前月薪（元）</label>
        <input class="input" id="salGross" type="number" value="15000" min="0" step="500" />
      </div>
      <div class="field">
        <label class="field-label" for="salCity">城市</label>
        <select class="select" id="salCity">
          <option value="beijing" selected>北京</option>
          <option value="shanghai">上海</option>
          <option value="guangzhou">广州</option>
          <option value="shenzhen">深圳</option>
          <option value="hangzhou">杭州</option>
          <option value="chengdu">成都</option>
          <option value="wuhan">武汉</option>
          <option value="nanjing">南京</option>
          <option value="other">其他（默认比例）</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="salFund">公积金比例</label>
        <select class="select" id="salFund">
          <option value="0.05">5%</option>
          <option value="0.07" selected>7%</option>
          <option value="0.12">12%</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="salBtn" type="button"><i class="bi bi-calculator"></i> 计算税后工资</button>
    </div>
    <div class="status-msg" id="salStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">按每月工资薪金所得预扣率计算，五险一金比例采用常见简化参数（养老 8%、医疗 2%、失业 0.5%），仅供参考。</p>
  </ToolPanel>

  <ToolPanel title="明细结果" icon="bi-clipboard-data">
    <table class="sal-table" id="salTable"></table>
    <div class="sal-net" id="salNet"></div>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .sal-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: var(--space-4);
  }

  .sal-table th,
  .sal-table td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    text-align: right;
  }

  .sal-table th:first-child,
  .sal-table td:first-child {
    text-align: left;
  }

  .sal-table th {
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .sal-net {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    font-size: 17px;
    font-weight: 700;
    color: var(--primary-dark);
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../scripts/toolkit';

  const FUND_RATE: Record<string, number> = { beijing: 0.12, shanghai: 0.07, guangzhou: 0.05, shenzhen: 0.05, hangzhou: 0.12, chengdu: 0.05, wuhan: 0.08, nanjing: 0.08, other: 0.07 };

  function calc() {
    hideStatus('salStatus');
    const gross = Number(byId<HTMLInputElement>('salGross').value);
    if (isNaN(gross) || gross < 0) {
      showStatus('salStatus', 'error', '请输入有效的税前工资');
      return;
    }
    const city = byId<HTMLSelectElement>('salCity').value;
    const fundRate = Number(byId<HTMLSelectElement>('salFund').value);
    const pension = gross * 0.08;
    const medical = gross * 0.02;
    const unemployment = gross * 0.005;
    const housing = gross * fundRate;
    const insuranceTotal = pension + medical + unemployment + housing;
    const taxableBase = Math.max(0, gross - 5000 - insuranceTotal);
    const tax = taxableBase <= 0 ? 0 : (() => {
      const brackets: [number, number, number][] = [
        [3000, 0.03, 0], [12000, 0.1, 210], [25000, 0.2, 1410],
        [35000, 0.25, 2660], [55000, 0.3, 4410], [80000, 0.35, 7160], [Infinity, 0.45, 15160],
      ];
      const b = brackets.find(([limit]) => taxableBase <= limit)!;
      return taxableBase * b[1] - b[2];
    })();
    const net = gross - insuranceTotal - tax;
    const rows: [string, string][] = [
      ['税前月薪', gross.toFixed(2)],
      ['养老保险（8%）', pension.toFixed(2)],
      ['医疗保险（2%）', medical.toFixed(2)],
      ['失业保险（0.5%）', unemployment.toFixed(2)],
      [`公积金（${(fundRate * 100).toFixed(0)}%）`, housing.toFixed(2)],
      ['五险一金合计', insuranceTotal.toFixed(2)],
      ['应纳税所得额', taxableBase.toFixed(2)],
      ['个人所得税', tax.toFixed(2)],
      ['税后到手', net.toFixed(2)],
    ];
    byId<HTMLElement>('salTable').innerHTML = rows
      .map(([k, v]) => `<tr><th>${k}</th><td>${v}</td></tr>`)
      .join('');
    byId<HTMLElement>('salNet').textContent = `税后到手约 ${net.toFixed(2)} 元 / 月`;
    showStatus('salStatus', 'success', `五险一金占比 ${(insuranceTotal / gross * 100).toFixed(1)}%`);
  }

  byId<HTMLButtonElement>('salBtn').addEventListener('click', calc);
  byId<HTMLSelectElement>('salFund').addEventListener('change', () => {
    byId<HTMLSelectElement>('salFund').value = byId<HTMLSelectElement>('salFund').value;
    calc();
  });
  calc();
</script>
