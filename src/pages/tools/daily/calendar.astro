---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../components/ToolPanel.astro';
import { TOOLS } from '../../../lib/tools';

const category = 'daily' as const;
const tool = TOOLS.daily.find((t) => t.slug === 'calendar')!;
const related = TOOLS.daily.filter((t) => t.slug !== tool.slug).slice(0, 6);
---

<ToolLayout category={category} tool={tool} related={related} categoryName="日常实用">
  <ToolPanel title="在线万年历" icon="bi-calendar3">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="calToday" type="button"><i class="bi bi-calendar-check"></i> 今天</button>
      <button class="btn btn-ghost btn-sm" id="calPrev" type="button"><i class="bi bi-chevron-left"></i></button>
      <button class="btn btn-ghost btn-sm" id="calNext" type="button"><i class="bi bi-chevron-right"></i></button>
    </div>
    <h3 class="cal-title" id="calTitle">--</h3>
    <table class="cal-table">
      <thead>
        <tr>
          <th>一</th><th>二</th><th>三</th><th>四</th><th>五</th><th>六</th><th>日</th>
        </tr>
      </thead>
      <tbody id="calBody"></tbody>
    </table>
  </ToolPanel>

  <ToolPanel title="当日信息" icon="bi-info-circle" className="mt-4">
    <div class="cal-info" id="calInfo"></div>
  </ToolPanel>
</ToolLayout>

<style>
  .cal-title {
    margin-bottom: var(--space-3);
    font-size: 17px;
  }

  .cal-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .cal-table th {
    padding: 6px;
    color: var(--text-tertiary);
    font-size: 12.5px;
    font-weight: 500;
  }

  .cal-table td {
    height: 62px;
    padding: 5px;
    border: 1px solid var(--border);
    vertical-align: top;
    background: var(--bg-elevated);
    cursor: pointer;
  }

  .cal-table td:hover {
    background: var(--primary-soft);
  }

  .cal-table td.other-month {
    opacity: 0.35;
  }

  .cal-table td.today {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }

  .cal-solar {
    font-size: 14px;
    font-weight: 600;
  }

  .cal-lunar {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .cal-badge {
    display: block;
    margin-top: 2px;
    font-size: 10.5px;
    color: var(--primary-dark);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cal-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
  }

  .cal-info-item {
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .cal-info-item .label {
    display: block;
    color: var(--text-tertiary);
    font-size: 12px;
    margin-bottom: 4px;
  }

  .cal-info-item .value {
    font-size: 14.5px;
    font-weight: 600;
  }
</style>

<script>
  import { byId } from '../../../scripts/toolkit';
  import { Solar, Lunar, HolidayUtil } from 'lunar-javascript';

  const WEEKDAYS = ['一', '二', '三', '四', '五', '六', '日'];
  let viewYear = new Date().getFullYear();
  let viewMonth = new Date().getMonth() + 1;
  let selected = new Date();

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function ymd(d: Date): string {
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }

  function render() {
    byId<HTMLElement>('calTitle').textContent = `${viewYear} 年 ${viewMonth} 月`;
    const body = byId<HTMLElement>('calBody');
    const first = new Date(viewYear, viewMonth - 1, 1);
    const startOffset = (first.getDay() + 6) % 7;
    const daysInMonth = new Date(viewYear, viewMonth, 0).getDate();
    const prevDays = new Date(viewYear, viewMonth - 1, 0).getDate();
    let html = '<tr>';
    for (let i = 0; i < 42; i++) {
      const dayOffset = i - startOffset;
      const date = new Date(viewYear, viewMonth - 1, 1 + dayOffset);
      const isCurrent = dayOffset >= 0 && dayOffset < daysInMonth;
      const lunar = Solar.fromYmd(date.getFullYear(), date.getMonth() + 1, date.getDate()).getLunar();
      const holiday = HolidayUtil.getHoliday(ymd(date));
      const jieQi = lunar.getJieQi();
      const badge = holiday ? holiday.getName() : jieQi || '';
      const cls = [
        isCurrent ? '' : 'other-month',
        ymd(date) === ymd(new Date()) ? 'today' : '',
      ].join(' ');
      html += `<td class="${cls}" data-y="${date.getFullYear()}" data-m="${date.getMonth() + 1}" data-d="${date.getDate()}">` +
        `<span class="cal-solar">${date.getDate()}</span>` +
        `<span class="cal-lunar">${isCurrent ? lunar.getDayInChinese() : ''}</span>` +
        (badge ? `<span class="cal-badge">${badge}</span>` : '') +
        '</td>';
      if ((i + 1) % 7 === 0) html += '</tr><tr>';
    }
    body.innerHTML = html + '</tr>';
    renderInfo(selected);
  }

  function renderInfo(date: Date) {
    const lunar = Solar.fromYmd(date.getFullYear(), date.getMonth() + 1, date.getDate()).getLunar();
    const holiday = HolidayUtil.getHoliday(ymd(date));
    const items: [string, string][] = [
      ['公历', ymd(date)],
      ['农历', `${lunar.getYearInChinese()}年 ${lunar.getMonthInChinese()}月${lunar.getDayInChinese()}`],
      ['干支', `${lunar.getYearInGanZhi()} ${lunar.getMonthInGanZhi()}月 ${lunar.getDayInGanZhi()}日`],
      ['生肖', lunar.getYearShengXiao()],
      ['星座', Solar.fromYmd(date.getFullYear(), date.getMonth() + 1, date.getDate()).getXingZuo()],
      ['节气', lunar.getJieQi() || '无'],
      ['节日', holiday ? `${holiday.getName()}${holiday.isWork() ? '（调休上班）' : '（放假）'}` : '无'],
    ];
    byId<HTMLElement>('calInfo').innerHTML = items
      .map(([k, v]) => `<div class="cal-info-item"><span class="label">${k}</span><span class="value">${v}</span></div>`)
      .join('');
  }

  byId<HTMLElement>('calBody').addEventListener('click', (e) => {
    const td = (e.target as HTMLElement).closest('td');
    if (!td) return;
    selected = new Date(Number(td.dataset.y), Number(td.dataset.m) - 1, Number(td.dataset.d));
    render();
  });
  byId<HTMLButtonElement>('calPrev').addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 1) { viewMonth = 12; viewYear--; }
    render();
  });
  byId<HTMLButtonElement>('calNext').addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 12) { viewMonth = 1; viewYear++; }
    render();
  });
  byId<HTMLButtonElement>('calToday').addEventListener('click', () => {
    const now = new Date();
    viewYear = now.getFullYear();
    viewMonth = now.getMonth() + 1;
    selected = now;
    render();
  });

  render();
</script>
