---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import M3u8Downloader from '../../../components/M3u8Downloader.astro';
import { getToolMeta, getRelated } from '../../../lib/i18n';
const category = 'daily' as const;
const tool = getToolMeta(category, 'm3u8-downloader', 'zh');
const related = getRelated(category, tool.slug, 'zh', 6);
---
<ToolLayout category={category} tool={tool} related={related}><M3u8Downloader /></ToolLayout>
