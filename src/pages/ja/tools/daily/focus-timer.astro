---
// @shared-tool-ui: five routes share FocusTimer and its browser controller.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import FocusTimer from '../../../../components/FocusTimer.astro';
import { getToolMeta } from '../../../../lib/i18n';
const lang = 'ja' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'focus-timer', lang);
const related = ['timer', 'workday', 'exam-clock'].map(slug => getToolMeta(category, slug, lang));
---
<ToolLayout category={category} tool={tool} related={related} layout="wide" workspace="dashboard">
  <FocusTimer lang={lang} />
</ToolLayout>
