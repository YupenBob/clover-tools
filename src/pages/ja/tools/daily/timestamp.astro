---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'timestamp', 'ja')!;
const related = getRelated(category, 'timestamp', 'ja', 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <section class="tool-card-panel">
    <div class="panel-head">
      <h2 class="panel-title"><i class="bi bi-clock" aria-hidden="true"></i> 現在時刻</h2>
      <div class="panel-actions">
        <button class="btn btn-ghost btn-sm" id="copyNow" type="button">
          <i class="bi bi-clipboard" aria-hidden="true"></i> タイムスタンプをコピー
        </button>
      </div>
    </div>
    <div class="now-grid">
      <div class="now-item">
        <span class="now-label">ローカル時刻</span>
        <span class="now-value mono" id="nowClock">--:--:--</span>
      </div>
      <div class="now-item">
        <span class="now-label">秒タイムスタンプ</span>
        <span class="now-value mono" id="nowSeconds">--</span>
      </div>
      <div class="now-item">
        <span class="now-label">ミリ秒タイムスタンプ</span>
        <span class="now-value mono" id="nowMillis">--</span>
      </div>
    </div>
  </section>

  <section class="tool-card-panel mt-4">
    <div class="panel-head">
      <h2 class="panel-title"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i> タイムスタンプを日時に変換</h2>
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="tsInput">タイムスタンプ（秒またはミリ秒、自動判定）</label>
        <input class="input mono" id="tsInput" type="text" placeholder="例: 1785000000 または 1785000000123" spellcheck="false" />
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="tsToDateBtn" type="button">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> 変換
      </button>
      <button class="btn btn-ghost" id="tsUseNow" type="button">
        <i class="bi bi-clock-history" aria-hidden="true"></i> 現在のタイムスタンプを使用
      </button>
    </div>
    <div class="output-area">
      <textarea id="tsDateOutput" class="textarea" readonly spellcheck="false" placeholder="日時結果がここに表示されます"></textarea>
    </div>
    <div class="status-msg" id="tsStatus" role="status" aria-live="polite"></div>
  </section>

  <section class="tool-card-panel mt-4">
    <div class="panel-head">
      <h2 class="panel-title"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> 日時をタイムスタンプに変換</h2>
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="dateInput">ローカル日時</label>
        <input class="input" id="dateInput" type="datetime-local" />
      </div>
      <div class="field">
        <label class="field-label" for="nowBtn">&nbsp;</label>
        <button class="btn btn-ghost" id="dateNowBtn" type="button">
          <i class="bi bi-clock" aria-hidden="true"></i> 現在日時を取得
        </button>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="dateToTsBtn" type="button">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> 変換
      </button>
    </div>
    <div class="output-area">
      <textarea id="dateTsOutput" class="textarea" readonly spellcheck="false" placeholder="秒・ミリ秒のタイムスタンプがここに表示されます"></textarea>
    </div>
    <div class="status-msg" id="dateStatus" role="status" aria-live="polite"></div>
  </section>
</ToolLayout>

<style>
  .now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
  }

  .now-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4);
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
  }

  .now-label {
    color: var(--text-tertiary);
    font-size: 12.5px;
  }

  .now-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    word-break: break-all;
  }
</style>

<script>
  const nowClock = document.getElementById('nowClock') as HTMLElement;
  const nowSeconds = document.getElementById('nowSeconds') as HTMLElement;
  const nowMillis = document.getElementById('nowMillis') as HTMLElement;
  const tsInput = document.getElementById('tsInput') as HTMLInputElement;
  const tsDateOutput = document.getElementById('tsDateOutput') as HTMLTextAreaElement;
  const tsStatus = document.getElementById('tsStatus') as HTMLElement;
  const dateInput = document.getElementById('dateInput') as HTMLInputElement;
  const dateTsOutput = document.getElementById('dateTsOutput') as HTMLTextAreaElement;
  const dateStatus = document.getElementById('dateStatus') as HTMLElement;

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function formatDate(d: Date): string {
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ` +
      `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())} ` +
      `(${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()]})`;
  }

  function tick() {
    const now = new Date();
    nowClock.textContent = formatDate(now);
    nowSeconds.textContent = String(Math.floor(now.getTime() / 1000));
    nowMillis.textContent = String(now.getTime());
  }

  tick();
  setInterval(tick, 1000);

  (document.getElementById('copyNow') as HTMLButtonElement).addEventListener('click', (e) => {
    window.CT.copy(nowSeconds.textContent || '', e.currentTarget as HTMLElement);
  });

  function showStatus(el: HTMLElement, type: 'success' | 'error', msg: string) {
    el.className = `status-msg show ${type}`;
    el.textContent = msg;
  }

  function parseTimestamp(text: string): { date: Date; unit: string } | null {
    if (!/^\d{10,13}$/.test(text.trim())) return null;
    const num = Number(text.trim());
    if (text.trim().length === 10) return { date: new Date(num * 1000), unit: '秒' };
    return { date: new Date(num), unit: 'ミリ秒' };
  }

  (document.getElementById('tsToDateBtn') as HTMLButtonElement).addEventListener('click', () => {
    const parsed = parseTimestamp(tsInput.value);
    if (!parsed || isNaN(parsed.date.getTime())) {
      showStatus(tsStatus, 'error', '10桁（秒）または13桁（ミリ秒）の数値タイムスタンプを入力してください');
      return;
    }
    tsDateOutput.value = [
      `ローカル時刻：${formatDate(parsed.date)}`,
      `ISO 時刻：${parsed.date.toISOString()}`,
      `単位：${parsed.unit}タイムスタンプ`,
    ].join('\n');
    showStatus(tsStatus, 'success', '変換しました');
  });

  (document.getElementById('tsUseNow') as HTMLButtonElement).addEventListener('click', () => {
    tsInput.value = String(Math.floor(Date.now() / 1000));
    (document.getElementById('tsToDateBtn') as HTMLButtonElement).click();
  });

  (document.getElementById('dateToTsBtn') as HTMLButtonElement).addEventListener('click', () => {
    if (!dateInput.value) {
      showStatus(dateStatus, 'error', '日時を選択してください');
      return;
    }
    const ms = new Date(dateInput.value).getTime();
    if (isNaN(ms)) {
      showStatus(dateStatus, 'error', '日時が無効です');
      return;
    }
    dateTsOutput.value = `秒：${Math.floor(ms / 1000)}\nミリ秒：${ms}`;
    showStatus(dateStatus, 'success', '変換しました');
  });

  (document.getElementById('dateNowBtn') as HTMLButtonElement).addEventListener('click', () => {
    const now = new Date();
    dateInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T` +
      `${pad(now.getHours())}:${pad(now.getMinutes())}`;
  });
</script>