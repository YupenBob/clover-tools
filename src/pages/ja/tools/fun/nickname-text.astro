---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'fun' as const;
const tool = getToolMeta(category, 'nickname-text', 'ja')!;
const related = getRelated(category, 'nickname-text', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="文字入力" icon="bi-input-cursor">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="nnSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="nnClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <textarea class="textarea" id="nnInput" spellcheck="false" placeholder="ニックネームや任意の文字を入力（例：Clover クローバー）"></textarea>
    <div class="status-msg" id="nnStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">入力後すぐに全スタイルを生成します。英語・数字・日本語に対応し、日本語の文字はそのまま保持されます。結果をクリックするだけでコピーできます。</p>
  </ToolPanel>

  <ToolPanel title="全スタイルプレビュー" icon="bi-grid">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="nnCopyAll" type="button"><i class="bi bi-clipboard"></i> すべてコピー</button>
    </div>
    <div class="nn-grid" id="nnGrid"></div>
  </ToolPanel>

  <ToolPanel title="スタイル説明" icon="bi-info-circle" className="mt-4">
    <p class="field-hint" style="line-height:1.9">
      このツールは20種類以上のUnicode文字スタイルに対応しています：太字、斜体、太字斜体、筆記体（Script）、太字筆記体、フラクトゥール（Fraktur）、太字フラクトゥール、中抜き文字（Double-Struck）、サンセリフ、サンセリフ太字、サンセリフ斜体、サンセリフ太字斜体、等幅（Monospace）、全角、囲み文字、括弧囲み、四角囲み、白抜き丸囲み、上付き文字、下付き文字、火星文字、鏡文字。ゲームのニックネーム、カップル向けハンドルネーム、QQ・WeChatのニックネーム、個性的なプロフィール文など、様々なクリエイティブな文字生成に最適です。すべてブラウザ内で完結し、データがアップロードされることはありません。
    </p>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .nn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-3);
  }

  .nn-card {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .nn-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .nn-card .name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    color: var(--text-tertiary);
    font-size: 12px;
    font-weight: 600;
  }

  .nn-card .name i {
    color: var(--primary-dark);
  }

  .nn-card .value {
    font-size: 17px;
    color: var(--text);
    word-break: break-all;
    line-height: 1.5;
  }

  .nn-card .value.empty {
    color: var(--text-tertiary);
    font-size: 13px;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('nnInput');
  const grid = byId<HTMLElement>('nnGrid');

  function mkMap(up: number, lo: number, dig: number | undefined, over: Record<string, string> = {}) {
    return (ch: string) => {
      const c = ch.codePointAt(0)!;
      if (c >= 65 && c <= 90) {
        const letter = String.fromCharCode(c);
        return over[letter] || String.fromCodePoint(up + (c - 65));
      }
      if (c >= 97 && c <= 122) {
        const letter = String.fromCharCode(c);
        return over[letter] || String.fromCodePoint(lo + (c - 97));
      }
      if (dig !== undefined && c >= 48 && c <= 57) return String.fromCodePoint(dig + (c - 48));
      return ch;
    };
  }

  function perChar(fn: (ch: string) => string) {
    return (s: string) => Array.from(s).map(fn).join('');
  }

  function mkUpperOnly(base: number) {
    return (ch: string) => {
      const c = ch.codePointAt(0)!;
      if (c >= 65 && c <= 90) return String.fromCodePoint(base + (c - 65));
      return ch;
    };
  }

  const SUP: Record<string, string> = {
    '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹',
    a: 'ᵃ', b: 'ᵇ', c: 'ᶜ', d: 'ᵈ', e: 'ᵉ', f: 'ᶠ', g: 'ᵍ', h: 'ʰ', i: 'ⁱ', j: 'ʲ', k: 'ᵏ', l: 'ˡ', m: 'ᵐ', n: 'ⁿ', o: 'ᵒ', p: 'ᵖ', r: 'ʳ', s: 'ˢ', t: 'ᵗ', u: 'ᵘ', v: 'ᵛ', w: 'ʷ', x: 'ˣ', y: 'ʸ', z: 'ᶻ',
  };
  const SUB: Record<string, string> = {
    '0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄', '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉',
    a: 'ₐ', e: 'ₑ', h: 'ₕ', i: 'ᵢ', j: 'ⱼ', k: 'ₖ', l: 'ₗ', m: 'ₘ', n: 'ₙ', o: 'ₒ', p: 'ₚ', r: 'ᵣ', s: 'ₛ', t: 'ₜ', u: 'ᵤ', v: 'ᵥ', x: 'ₓ',
  };
  const L33T: Record<string, string> = {
    a: '@', b: '8', c: '(', e: '3', g: '9', i: '1', l: '1', o: '0', s: '$', t: '7', z: '2',
  };

  type Style = { id: string; name: string; fn: (s: string) => string };

  const STYLES: Style[] = [
    { id: 'bold', name: '太字', fn: perChar(mkMap(0x1d400, 0x1d41a, 0x1d7ce)) },
    { id: 'italic', name: '斜体', fn: perChar(mkMap(0x1d434, 0x1d44e, undefined, { h: '\u210e' })) },
    { id: 'boldItalic', name: '太字斜体', fn: perChar(mkMap(0x1d468, 0x1d482, undefined)) },
    {
      id: 'script', name: '筆記体',
      fn: perChar(mkMap(0x1d49c, 0x1d4b6, undefined, {
        B: '\u212c', E: '\u2130', F: '\u2131', H: '\u210b', I: '\u2110', L: '\u2112', M: '\u2133', R: '\u211b',
        e: '\u212f', g: '\u210a', o: '\u2134',
      })),
    },
    { id: 'boldScript', name: '太字筆記体', fn: perChar(mkMap(0x1d4d0, 0x1d4ea, undefined)) },
    {
      id: 'fraktur', name: 'フラクトゥール',
      fn: perChar(mkMap(0x1d504, 0x1d51e, undefined, {
        C: '\u212d', H: '\u210c', I: '\u2111', R: '\u211c', Z: '\u2128',
      })),
    },
    { id: 'boldFraktur', name: '太字フラクトゥール', fn: perChar(mkMap(0x1d56c, 0x1d586, undefined)) },
    {
      id: 'doubleStruck', name: '中抜き文字',
      fn: perChar(mkMap(0x1d538, 0x1d552, 0x1d7d8, {
        C: '\u2102', H: '\u210d', N: '\u2115', P: '\u2119', Q: '\u211a', R: '\u211d', Z: '\u2124',
      })),
    },
    { id: 'sans', name: 'サンセリフ', fn: perChar(mkMap(0x1d5a0, 0x1d5ba, 0x1d7e2)) },
    { id: 'sansBold', name: 'サンセリフ太字', fn: perChar(mkMap(0x1d5d4, 0x1d5ee, 0x1d7ec)) },
    { id: 'sansItalic', name: 'サンセリフ斜体', fn: perChar(mkMap(0x1d608, 0x1d622, undefined)) },
    { id: 'sansBoldItalic', name: 'サンセリフ太字斜体', fn: perChar(mkMap(0x1d63c, 0x1d656, undefined)) },
    { id: 'mono', name: '等幅', fn: perChar(mkMap(0x1d670, 0x1d68a, 0x1d7f6)) },
    { id: 'fullwidth', name: '全角', fn: (s) => Array.from(s).map((ch) => {
      const c = ch.codePointAt(0)!;
      return c >= 33 && c <= 126 ? String.fromCharCode(c + 0xfee0) : ch;
    }).join('') },
    { id: 'circled', name: '囲み文字', fn: perChar(mkMap(0x24b6, 0x24d0, undefined)) },
    { id: 'paren', name: '括弧囲み', fn: perChar(mkUpperOnly(0x1f110)) },
    { id: 'squared', name: '四角囲み', fn: perChar(mkUpperOnly(0x1f130)) },
    { id: 'negCircled', name: '白抜き丸囲み', fn: perChar(mkUpperOnly(0x1f150)) },
    { id: 'sup', name: '上付き', fn: (s) => Array.from(s.toLowerCase()).map((ch) => SUP[ch] || ch).join('') },
    { id: 'sub', name: '下付き', fn: (s) => Array.from(s.toLowerCase()).map((ch) => SUB[ch] || ch).join('') },
    { id: 'mars', name: '火星文字', fn: (s) => Array.from(s).map((ch) => {
      const lower = ch.toLowerCase();
      return L33T[lower] && Math.random() > 0.3 ? L33T[lower] : ch;
    }).join('') },
    { id: 'mirror', name: '鏡文字', fn: (s) => Array.from(s).reverse().join('') },
  ];

  function render() {
    hideStatus('nnStatus');
    const text = input.value;
    if (!text.trim()) {
      grid.innerHTML = STYLES.map((s) =>
        `<div class="nn-card"><div class="name"><span>${s.name}</span><i class="bi bi-clipboard"></i></div><div class="value empty">文字を入力してください</div></div>`,
      ).join('');
      return;
    }
    grid.innerHTML = STYLES.map((s) => {
      const value = s.fn(text);
      return `<div class="nn-card" data-style="${s.name}"><div class="name"><span>${s.name}</span><i class="bi bi-clipboard"></i></div><div class="value">${value}</div></div>`;
    }).join('');
    showStatus('nnStatus', 'success', `全部で ${STYLES.length} 種類のスタイルを生成しました。カードをクリックしてコピー`);
  }

  grid.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.nn-card');
    if (card) {
      const value = card.querySelector('.value');
      if (value && value.textContent && !value.classList.contains('empty')) {
        window.CT.copy(value.textContent);
      }
    }
  });

  input.addEventListener('input', render);
  byId<HTMLButtonElement>('nnSample').addEventListener('click', () => {
    input.value = 'Clover クローバー';
    render();
  });
  byId<HTMLButtonElement>('nnClear').addEventListener('click', () => {
    input.value = '';
    render();
  });
  byId<HTMLButtonElement>('nnCopyAll').addEventListener('click', () => {
    const lines = STYLES.map((s) => {
      const value = s.fn(input.value);
      return `${s.name}：${value}`;
    }).filter((l) => !l.endsWith('：'));
    if (lines.length) window.CT.copy(lines.join('\n'));
    else showStatus('nnStatus', 'info', '先に文字を入力してください');
  });

  render();
</script>