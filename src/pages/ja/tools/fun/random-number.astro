---
import Icon from '../../../../components/Icon.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'fun' as const;
const tool = getToolMeta(category, 'random-number', 'ja')!;
const related = getRelated(category, 'random-number', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="乱数設定" icon="shuffle">
    <div class="row">
      <div class="field">
        <label class="field-label" for="rnMin">最小値</label>
        <input class="input" id="rnMin" type="number" value="1" />
      </div>
      <div class="field">
        <label class="field-label" for="rnMax">最大値</label>
        <input class="input" id="rnMax" type="number" value="100" />
      </div>
      <div class="field">
        <label class="field-label" for="rnCount">個数</label>
        <input class="input" id="rnCount" type="number" value="5" min="1" max="1000" />
      </div>
    </div>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="rnUnique"><input type="checkbox" id="rnUnique" checked /> 重複なし（範囲が十分必要）</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="rnBtn" type="button"><Icon name="shuffle" /> 乱数を生成</button>
    </div>
    <div class="status-msg" id="rnStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="生成結果" icon="box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rnCopy" type="button"><Icon name="clipboard" /> コピー</button>
    </div>
    <textarea class="textarea" id="rnOutput" readonly spellcheck="false" placeholder="結果がここに表示されます"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  import { generateRandomIntegers } from '../../../../lib/random-integers';

  function generate() {
    hideStatus('rnStatus');
    const min = Number(byId<HTMLInputElement>('rnMin').value);
    const max = Number(byId<HTMLInputElement>('rnMax').value);
    const count = Number(byId<HTMLInputElement>('rnCount').value);
    const unique = byId<HTMLInputElement>('rnUnique').checked;
    let values: number[];
    try { values = generateRandomIntegers(min, max, count, unique); }
    catch {
      byId<HTMLTextAreaElement>('rnOutput').value = '';
      showStatus('rnStatus', 'error', '安全な整数を入力してください。範囲は最大 4294967296 個、結果は 1–1000 個です。重複なしの個数は範囲内にしてください。');
      return;
    }
    byId<HTMLTextAreaElement>('rnOutput').value = values.join('\n');
    showStatus('rnStatus', 'success', `${count} 個の乱数を生成しました`);
  }

  byId<HTMLButtonElement>('rnBtn').addEventListener('click', generate);
  bindCopyBtn('rnCopy', () => byId<HTMLTextAreaElement>('rnOutput').value);
</script>