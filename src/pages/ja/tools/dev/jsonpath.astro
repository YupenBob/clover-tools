---
import Icon from '../../../../components/Icon.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jsonpath', 'ja')!;
const related = getRelated(category, 'jsonpath', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JSON データ" icon="braces">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpSample" type="button"><Icon name="magic" /> サンプル</button>
    </div>
    <textarea class="textarea" id="jpJson" spellcheck="false" placeholder="JSON データを貼り付け"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jpExpr">JSONPath 式</label>
      <input class="input mono" id="jpExpr" type="text" value="$..title" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jpBtn" type="button"><Icon name="signpost-split" /> 検索</button>
    </div>
    <div class="status-msg" id="jpStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">対応構文: $.key、['key']、[0]、[*]、..再帰、[?(@.key == value)] フィルター。</p>
  </ToolPanel>

  <ToolPanel title="検索結果" icon="box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpCopy" type="button"><Icon name="clipboard" /> コピー</button>
    </div>
    <textarea class="textarea" id="jpOutput" readonly spellcheck="false" placeholder="マッチした結果はここに表示されます"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample } from '../../../../scripts/toolkit';

  const SAMPLE = {
    store: {
      book: [
        { category: 'reference', author: 'Nigel Rees', title: 'Sayings', price: 8.95 },
        { category: 'fiction', author: 'Evelyn Waugh', title: 'Sword', price: 12.99 },
        { category: 'fiction', author: 'Herman Melville', title: 'Moby Dick', price: 8.99 },
      ],
      bicycle: { color: 'red', price: 399 },
    },
    expensive: 10,
  };

  import { query } from '../../../../lib/jsonpath';

  function run() {
    hideStatus('jpStatus');
    byId<HTMLTextAreaElement>('jpOutput').value = '';
    const json = byId<HTMLTextAreaElement>('jpJson').value.trim();
    const expr = byId<HTMLInputElement>('jpExpr').value.trim();
    if (!json || !expr) {
      showStatus('jpStatus', 'error', 'JSON データと式を入力してください');
      return;
    }
    let data: unknown;
    try {
      data = JSON.parse(json);
    } catch (e) {
      showStatus('jpStatus', 'error', `JSON の解析に失敗：${(e as Error).message}`);
      return;
    }
    try {
      const matches = query(data, expr);
      byId<HTMLTextAreaElement>('jpOutput').value = matches.length
        ? matches.map((m) => JSON.stringify(m, null, 2)).join('\n---\n')
        : '（一致する結果はありません）';
      showStatus('jpStatus', 'success', `${matches.length} 件の結果が一致しました`);
    } catch (e) {
      byId<HTMLTextAreaElement>('jpOutput').value = '';
      showStatus('jpStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('jpBtn').addEventListener('click', run);
  bindSample('jpSample', 'jpJson', JSON.stringify(SAMPLE, null, 2));
  bindCopyBtn('jpCopy', () => byId<HTMLTextAreaElement>('jpOutput').value);
</script>