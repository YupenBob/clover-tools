---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'password-strength', 'ja')!;
const related = getRelated(category, 'password-strength', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="パスワード入力" icon="bi-shield-exclamation">
    <div class="field">
      <label class="field-label" for="psInput">パスワード</label>
      <input class="input" id="psInput" type="password" placeholder="確認するパスワードを入力" autocomplete="off" />
    </div>
    <div class="strength-bars" id="psBars">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </div>
    <div class="strength-label" id="psLabel">入力待ち</div>
    <div class="status-msg" id="psStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="検査詳細" icon="bi-list-check">
    <ul class="check-list" id="psChecks"></ul>
    <div class="input-stats"><span id="psDetail">長さ・文字構成・一般的な弱いパスワードを総合評価</span></div>
  </ToolPanel>
</ToolLayout>

<style>
  .strength-bars {
    display: flex;
    gap: 6px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--bg-tertiary);
    transition: background-color 0.2s ease;
  }

  .bar.filled {
    background: var(--bar-color, var(--warning));
  }

  .strength-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .check-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .check-list li.ok {
    color: var(--success);
  }

  .check-list li.bad {
    color: var(--error);
  }
</style>

<script>
  import { byId } from '../../../../scripts/toolkit';

  const input = byId<HTMLInputElement>('psInput');
  const bars = byId<HTMLElement>('psBars').children;
  const label = byId<HTMLElement>('psLabel');
  const checks = byId<HTMLUListElement>('psChecks');
  const detail = byId<HTMLElement>('psDetail');

  const COMMON = ['123456', 'password', '12345678', 'qwerty', 'abc123', '111111', '123123', 'admin', 'letmein', '000000', '666666', '88888888', 'iloveyou'];

  function analyze(pw: string) {
    const len = pw.length;
    const hasLower = /[a-z]/.test(pw);
    const hasUpper = /[A-Z]/.test(pw);
    const hasDigit = /\d/.test(pw);
    const hasSymbol = /[^A-Za-z0-9]/.test(pw);
    const isCommon = COMMON.includes(pw.toLowerCase());
    const sequential = /(012|123|234|345|456|567|678|789|890|abc|bcd|cde|def|efg|fgh|ghi|hij|ijk|jkl|klm|lmn|mno|nop|opq|pqr|qrs|rst|stu|tuv|uvw|vwx|wxy|xyz)/i.test(pw);

    const results = [
      { ok: len >= 8, text: len >= 8 ? '8文字以上' : `長さが不足（現在 ${len} 文字）` },
      { ok: hasLower && hasUpper, text: hasLower && hasUpper ? '大文字と小文字を含む' : '大文字と小文字の組み合わせが不足' },
      { ok: hasDigit, text: hasDigit ? '数字を含む' : '数字が不足' },
      { ok: hasSymbol, text: hasSymbol ? '特殊記号を含む' : '特殊記号が不足' },
      { ok: !isCommon, text: isCommon ? '一般的な弱いパスワードに一致。変更を強く推奨' : '一般的な弱いパスワードには一致しない' },
      { ok: !sequential, text: sequential ? '連続・順序文字を含む' : '連続・順序文字なし' },
    ];

    let score = 0;
    score += Math.min(len / 4, 2);
    if (hasLower && hasUpper) score += 1;
    if (hasDigit) score += 0.5;
    if (hasSymbol) score += 1;
    if (isCommon) score -= 2;
    if (sequential) score -= 0.5;
    score = Math.max(0, Math.min(4, Math.round(score)));
    return { score, results };
  }

  function update() {
    const pw = input.value;
    if (!pw) {
      label.textContent = '入力待ち';
      detail.textContent = '長さ・文字構成・一般的な弱いパスワードを総合評価';
      checks.innerHTML = '';
      Array.from(bars).forEach((b) => b.classList.remove('filled'));
      return;
    }
    const { score, results } = analyze(pw);
    const meta = [
      { color: 'var(--error)', text: '非常に弱い' },
      { color: 'var(--error)', text: '弱い' },
      { color: 'var(--warning)', text: '中程度' },
      { color: 'var(--success)', text: '強い' },
      { color: 'var(--success)', text: '非常に強い' },
    ][score];
    Array.from(bars).forEach((bar, i) => {
      bar.classList.toggle('filled', i < score);
      (bar as HTMLElement).style.setProperty('--bar-color', meta.color);
    });
    label.textContent = `${meta.text}（${score}/4）`;
    label.style.color = meta.color;
    checks.innerHTML = results.map((r) => `<li class="${r.ok ? 'ok' : 'bad'}"><i class="bi ${r.ok ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>${r.text}</li>`).join('');
    const entropy = pw.length * Math.log2(94);
    detail.textContent = `推定エントロピー約 ${entropy.toFixed(0)} bit、理想環境でのオフライン解読時間は約 ${entropy > 60 ? '極めて長い（数百年以上）' : entropy > 40 ? '数日から数か月' : '数秒から数時間'}`;
  }

  input.addEventListener('input', update);
  update();
</script>