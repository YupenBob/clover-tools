---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jianfan', 'ja')!;
const related = getRelated(category, 'jianfan', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="テキスト入力" icon="bi-input-cursor">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="jfClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <textarea class="textarea" id="jfInput" spellcheck="false" placeholder="簡体字または繁体字の中国語を入力"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="jfMode">変換方向</label>
        <select class="select" id="jfMode">
          <option value="s2t">簡体字 → 繁体字</option>
          <option value="t2s">繁体字 → 簡体字</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jfBtn" type="button"><i class="bi bi-arrow-repeat"></i> 変換</button>
    </div>
    <div class="status-msg" id="jfStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="変換結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfCopy" type="button"><i class="bi bi-clipboard"></i> コピー</button>
    </div>
    <textarea class="textarea" id="jfOutput" readonly spellcheck="false" placeholder="結果がここに表示されます"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';
  import zh from 'chinese-s2t';

  const input = byId<HTMLTextAreaElement>('jfInput');
  const output = byId<HTMLTextAreaElement>('jfOutput');

  async function convert() {
    hideStatus('jfStatus');
    const src = input.value;
    if (!src) {
      showStatus('jfStatus', 'error', 'テキストを入力してください');
      return;
    }
    const mode = byId<HTMLSelectElement>('jfMode').value;
    output.value = mode === 's2t' ? zh.s2t(src) : zh.t2s(src);
    showStatus('jfStatus', 'success', '変換が完了しました（ローカル即時変換）');
  }

  byId<HTMLButtonElement>('jfBtn').addEventListener('click', convert);
  bindSample('jfSample', 'jfInput', '软件开发工具，时间戳转换，简体繁体互转');
  bindClear('jfClear', ['jfInput'], ['jfOutput'], 'jfStatus');
  bindCopyBtn('jfCopy', () => output.value);
</script>