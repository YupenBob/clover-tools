---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'url-parse', 'ja')!;
const related = getRelated(category, 'url-parse', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="URL を入力" icon="bi-diagram-3">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="upSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="upClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <input class="input mono" id="upInput" type="text" placeholder="https://user:pass@example.com:8080/path?q=1&lang=zh#section" spellcheck="false" />
    <div class="btn-row">
      <button class="btn btn-primary" id="upBtn" type="button"><i class="bi bi-diagram-3"></i> 解析</button>
    </div>
    <div class="status-msg" id="upStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="URL 構造" icon="bi-list-ol">
    <table class="up-table" id="upTable"></table>
  </ToolPanel>

  <ToolPanel title="クエリパラメータ" icon="bi-key" className="mt-4">
    <table class="up-table" id="upParams"></table>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .up-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .up-table th,
  .up-table td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    word-break: break-all;
  }

  .up-table th {
    width: 140px;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .up-table td {
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>

<script>
  import { byId, showStatus, hideStatus, bindSample, bindClear } from '../../../../scripts/toolkit';

  function esc(s: string): string {
    return s.replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function parse() {
    hideStatus('upStatus');
    const raw = byId<HTMLInputElement>('upInput').value.trim();
    if (!raw) {
      showStatus('upStatus', 'error', 'URL を入力してください');
      return;
    }
    let u: URL;
    try {
      u = new URL(raw);
    } catch {
      showStatus('upStatus', 'error', 'URL が不正です。形式を確認してください（プロトコルを含めてください。例: https://）');
      byId<HTMLElement>('upTable').innerHTML = '';
      byId<HTMLElement>('upParams').innerHTML = '';
      return;
    }
    const rows: [string, string][] = [
      ['プロトコル', u.protocol],
      ['ホスト名', u.hostname],
      ['ポート', u.port || '（デフォルト）'],
      ['パス', u.pathname],
      ['クエリ', u.search || '（なし）'],
      ['アンカー', u.hash || '（なし）'],
      ['ユーザー名', u.username || '（なし）'],
      ['パスワード', u.password || '（なし）'],
      ['完全なURL', u.href],
    ];
    byId<HTMLElement>('upTable').innerHTML = rows
      .map(([k, v]) => `<tr><th>${k}</th><td>${esc(v)}</td></tr>`)
      .join('');
    const params = Array.from(u.searchParams.entries());
    byId<HTMLElement>('upParams').innerHTML = params.length
      ? params.map(([k, v]) => `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join('')
      : '<tr><td colspan="2">クエリパラメータはありません</td></tr>';
    showStatus('upStatus', 'success', `解析が完了しました。クエリパラメータは ${params.length} 個です`);
  }

  byId<HTMLButtonElement>('upBtn').addEventListener('click', parse);
  bindSample('upSample', 'upInput', 'https://user:pass@example.com:8080/path/to/page?q=clover&lang=zh-CN&page=2#section-a');
  bindClear('upClear', ['upInput'], [], 'upStatus');
</script>