---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'json-convert', 'ja')!;
const related = getRelated(category, 'json-convert', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JSON 配列を入力" icon="bi-braces">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsonSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="jsonClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <textarea class="textarea" id="jsonInput" spellcheck="false" placeholder='JSON 配列を貼り付け、例: [{"name":"Clover","version":"3.0"}]'></textarea>
    <div class="input-stats"><span id="jsonStats">0 文字</span></div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="delimiter">区切り文字</label>
        <select class="select" id="delimiter">
          <option value="csv" selected>カンマ（CSV）</option>
          <option value="tsv">タブ（TSV）</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="withHeader">
          <input type="checkbox" id="withHeader" checked /> 先頭行に見出しを出力
        </label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="convertBtn" type="button"><i class="bi bi-table"></i> テーブル生成</button>
      <button class="btn btn-secondary" id="downloadBtn" type="button"><i class="bi bi-download"></i> ファイルをダウンロード</button>
    </div>
    <div class="status-msg" id="statusMsg" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="表の結果" icon="bi-box-arrow-in-down" className="mt-4">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="copyBtn" type="button"><i class="bi bi-clipboard"></i> コピー</button>
    </div>
    <textarea class="textarea" id="csvOutput" readonly spellcheck="false" placeholder="表の結果がここに表示されます"></textarea>
    <div class="input-stats"><span id="csvStats">0 文字</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import {
    byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear,
  } from '../../../../scripts/toolkit';

  const SAMPLE = [
    { name: 'CloverTools', category: 'ツールサイト', tools: 69, free: true },
    { name: 'Astro', category: 'フレームワーク', tools: 5, free: true },
    { name: 'Notion', category: 'オフィス', tools: 12, free: false },
  ];

  const input = byId<HTMLTextAreaElement>('jsonInput');
  const output = byId<HTMLTextAreaElement>('csvOutput');

  function csvEscape(value: string, delim: string): string {
    if (/[",\r\n]/.test(value) || (delim === '\t' && value.includes('\t'))) {
      return '"' + value.replace(/"/g, '""') + '"';
    }
    return value;
  }

  function convert(): boolean {
    hideStatus('statusMsg');
    const text = input.value.trim();
    if (!text) {
      showStatus('statusMsg', 'error', 'JSON 配列を入力してください');
      return false;
    }
    let data: unknown;
    try {
      data = JSON.parse(text);
    } catch (e) {
      showStatus('statusMsg', 'error', `JSON 解析に失敗しました：${(e as Error).message}`);
      return false;
    }
    if (!Array.isArray(data) || data.length === 0 || typeof data[0] !== 'object' || data[0] === null) {
      showStatus('statusMsg', 'error', '空でないオブジェクト配列を入力してください（例: [{ "a": 1 }]）');
      return false;
    }

    const delim = byId<HTMLSelectElement>('delimiter').value === 'csv' ? ',' : '\t';
    const withHeader = byId<HTMLInputElement>('withHeader').checked;
    const headerSet = new Set<string>();
    for (const row of data as Record<string, unknown>[]) {
      for (const key of Object.keys(row)) headerSet.add(key);
    }
    const headers = [...headerSet];
    const lines: string[] = [];
    if (withHeader) lines.push(headers.map((h) => csvEscape(h, delim)).join(delim));
    for (const row of data as Record<string, unknown>[]) {
      lines.push(
        headers.map((h) => {
          const v = row[h];
          if (v === null || v === undefined) return '';
          if (typeof v === 'object') return csvEscape(JSON.stringify(v), delim);
          return csvEscape(String(v), delim);
        }).join(delim),
      );
    }
    output.value = lines.join('\r\n');
    setStats('csvStats', `${output.value.length} 文字 · ${data.length} 行データ · ${headers.length} 列`);
    showStatus('statusMsg', 'success', `変換完了：${data.length} 行 × ${headers.length} 列`);
    return true;
  }

  byId<HTMLButtonElement>('convertBtn').addEventListener('click', convert);

  byId<HTMLButtonElement>('downloadBtn').addEventListener('click', () => {
    if (!convert()) return;
    const ext = byId<HTMLSelectElement>('delimiter').value === 'csv' ? 'csv' : 'tsv';
    const mime = ext === 'csv' ? 'text/csv;charset=utf-8' : 'text/tab-separated-values;charset=utf-8';
    const blob = new Blob(['\uFEFF' + output.value], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `json-to-${ext}.${ext}`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  bindSample('jsonSample', 'jsonInput', JSON.stringify(SAMPLE, null, 2));
  bindClear('jsonClear', ['jsonInput'], ['csvOutput'], 'statusMsg');
  bindCopyBtn('copyBtn', () => output.value);
  input.addEventListener('input', () => setStats('jsonStats', `${input.value.length} 文字`));
  setStats('jsonStats', `${input.value.length} 文字`);
</script>