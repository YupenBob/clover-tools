---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'js-formatter', 'ja')!;
const related = getRelated(category, 'js-formatter', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JavaScript を入力" icon="bi-filetype-js">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="jsClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <textarea class="textarea" id="jsInput" spellcheck="false" placeholder="JavaScript コードを貼り付け"></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" id="jsFmt" type="button"><i class="bi bi-braces"></i> フォーマット</button>
      <button class="btn btn-secondary" id="jsMin" type="button"><i class="bi bi-arrows-collapse"></i> 圧縮</button>
    </div>
    <div class="status-msg" id="jsStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="出力結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsCopy" type="button"><i class="bi bi-clipboard"></i> コピー</button>
    </div>
    <textarea class="textarea" id="jsOutput" readonly spellcheck="false" placeholder="結果がここに表示されます"></textarea>
    <div class="input-stats"><span id="jsStats">0 文字</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('jsInput');
  const output = byId<HTMLTextAreaElement>('jsOutput');

  async function runFormat() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'JavaScript コードを入力してください');
      return;
    }
    try {
      showStatus('jsStatus', 'info', 'フォーマットエンジンを読み込んでいます（初回は約 1MB）……');
      const prettier = await import('prettier/standalone');
      const babelPlugin = await import('prettier/plugins/babel');
      const estreePlugin = await import('prettier/plugins/estree');
      showStatus('jsStatus', 'info', 'フォーマット中……');
      output.value = await prettier.format(input.value, {
        parser: 'babel',
        plugins: [babelPlugin, estreePlugin] as never,
        semi: true,
        singleQuote: true,
        tabWidth: 2,
        printWidth: 100,
      });
      setStats('jsStats', `${output.value.length} 文字`);
      showStatus('jsStatus', 'success', 'フォーマットが完了しました');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `解析エラー：${(e as Error).message}`);
    }
  }

  async function runMinify() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'JavaScript コードを入力してください');
      return;
    }
    try {
      showStatus('jsStatus', 'info', '圧縮エンジンを読み込んでいます……');
      const { minify: terserMinify } = await import('terser');
      showStatus('jsStatus', 'info', '圧縮中……');
      const result = await terserMinify(input.value, { mangle: true, compress: true });
      output.value = result.code || '';
      setStats('jsStats', `${output.value.length} 文字`);
      showStatus('jsStatus', 'success', '圧縮が完了しました');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `圧縮エラー：${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('jsFmt').addEventListener('click', runFormat);
  byId<HTMLButtonElement>('jsMin').addEventListener('click', runMinify);
  bindSample('jsSample', 'jsInput', 'const tools=["json","base64"];function greet(name){return "Hello "+name} console.log(greet("Clover"));');
  bindClear('jsClear', ['jsInput'], ['jsOutput'], 'jsStatus');
  bindCopyBtn('jsCopy', () => output.value);
  setStats('jsStats', '0 文字');
</script>