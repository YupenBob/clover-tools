---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'text-toolbox', 'ja')!;
const related = getRelated(category, 'text-toolbox', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="テキスト入力" icon="bi-list-check">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ttbSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="ttbClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <textarea class="textarea" id="ttbInput" spellcheck="false" placeholder="1行に1件のデータを入力。重複削除・並べ替え・反転などの処理ができます"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="ttbOp">操作</label>
        <select class="select" id="ttbOp">
          <option value="dedupe" selected>重複を削除</option>
          <option value="sort">昇順に並べ替え</option>
          <option value="sortDesc">降順に並べ替え</option>
          <option value="reverse">行を反転</option>
          <option value="removeBlank">空行を削除</option>
          <option value="trim">前後の空白を削除</option>
          <option value="shuffle">ランダムに並べ替え</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="ttbBtn" type="button"><i class="bi bi-wrench"></i> 処理</button>
    </div>
    <div class="status-msg" id="ttbStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="処理結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ttbCopy" type="button"><i class="bi bi-clipboard"></i> コピー</button>
    </div>
    <textarea class="textarea" id="ttbOutput" readonly spellcheck="false" placeholder="結果がここに表示されます"></textarea>
    <div class="input-stats"><span id="ttbStats">0 行</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const SAMPLE = ['apple', 'banana', 'apple', '', 'cherry', 'apple', 'date', ''];

  function run() {
    hideStatus('ttbStatus');
    const op = byId<HTMLSelectElement>('ttbOp').value;
    let lines = byId<HTMLTextAreaElement>('ttbInput').value.split('\n');
    const before = lines.length;
    switch (op) {
      case 'dedupe': lines = [...new Set(lines)]; break;
      case 'sort': lines = lines.sort((a, b) => a.localeCompare(b, 'zh-CN')); break;
      case 'sortDesc': lines = lines.sort((a, b) => b.localeCompare(a, 'zh-CN')); break;
      case 'reverse': lines = lines.reverse(); break;
      case 'removeBlank': lines = lines.filter((l) => l.trim() !== ''); break;
      case 'trim': lines = lines.map((l) => l.trim()); break;
      case 'shuffle': {
        for (let i = lines.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [lines[i], lines[j]] = [lines[j], lines[i]];
        }
        break;
      }
    }
    byId<HTMLTextAreaElement>('ttbOutput').value = lines.join('\n');
    setStats('ttbStats', `${lines.length} 行（元 ${before} 行）`);
    showStatus('ttbStatus', 'success', '処理が完了しました');
  }

  byId<HTMLButtonElement>('ttbBtn').addEventListener('click', run);
  bindSample('ttbSample', 'ttbInput', SAMPLE.join('\n'));
  bindClear('ttbClear', ['ttbInput'], ['ttbOutput'], 'ttbStatus');
  bindCopyBtn('ttbCopy', () => byId<HTMLTextAreaElement>('ttbOutput').value);
  setStats('ttbStats', '0 行');
</script>