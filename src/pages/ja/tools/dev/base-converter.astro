---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'base-converter', 'ja')!;
const related = getRelated(category, 'base-converter', 'ja', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="数値変換" icon="bi-123">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="bcSample" type="button"><i class="bi bi-magic"></i> サンプル</button>
      <button class="btn btn-ghost btn-sm" id="bcClear" type="button"><i class="bi bi-x-circle"></i> クリア</button>
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="bcValue">数値</label>
        <input class="input mono" id="bcValue" type="text" placeholder="変換する数値を入力" spellcheck="false" />
      </div>
      <div class="field">
        <label class="field-label" for="bcFrom">元の基数</label>
        <select class="select" id="bcFrom">
          <option value="2">2進数</option>
          <option value="8">8進数</option>
          <option value="10" selected>10進数</option>
          <option value="16">16進数</option>
          <option value="32">32進数</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="bcTo">変換先の基数</label>
        <select class="select" id="bcTo">
          <option value="2">2進数</option>
          <option value="8">8進数</option>
          <option value="10">10進数</option>
          <option value="16" selected>16進数</option>
          <option value="32">32進数</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="bcBtn" type="button"><i class="bi bi-arrow-repeat"></i> 変換</button>
    </div>
    <div class="status-msg" id="bcStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="変換結果" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="bcCopy" type="button"><i class="bi bi-clipboard"></i> コピー</button>
    </div>
    <textarea class="textarea" id="bcOutput" readonly spellcheck="false" placeholder="結果はここに表示されます"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz';

  function convert() {
    hideStatus('bcStatus');
    const raw = byId<HTMLInputElement>('bcValue').value.trim();
    const from = Number(byId<HTMLSelectElement>('bcFrom').value);
    const to = Number(byId<HTMLSelectElement>('bcTo').value);
    if (!raw) {
      showStatus('bcStatus', 'error', '数値を入力してください');
      return;
    }
    const neg = raw.startsWith('-');
    const digits = (neg ? raw.slice(1) : raw).toLowerCase();
    try {
      let value = BigInt(0);
      for (const ch of digits) {
        const d = DIGITS.indexOf(ch);
        if (d === -1 || d >= from) throw new Error(`文字 ${ch} は ${from} 進数の数字ではありません`);
        value = value * BigInt(from) + BigInt(d);
      }
      if (value === BigInt(0)) {
        byId<HTMLTextAreaElement>('bcOutput').value = '0';
      } else {
        let out = '';
        let v = value;
        while (v > BigInt(0)) {
          out = DIGITS[Number(v % BigInt(to))] + out;
          v /= BigInt(to);
        }
        byId<HTMLTextAreaElement>('bcOutput').value = (neg ? '-' : '') + out;
      }
      showStatus('bcStatus', 'success', '変換完了（任意の大きな整数に対応）');
    } catch (e) {
      showStatus('bcStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('bcBtn').addEventListener('click', convert);
  bindSample('bcSample', 'bcValue', '255');
  bindClear('bcClear', ['bcValue'], ['bcOutput'], 'bcStatus');
  bindCopyBtn('bcCopy', () => byId<HTMLTextAreaElement>('bcOutput').value);
</script>