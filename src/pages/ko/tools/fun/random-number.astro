---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'fun' as const;
const tool = getToolMeta(category, 'random-number', 'ko')!;
const related = getRelated(category, 'random-number', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="랜덤 숫자 설정" icon="bi-shuffle">
    <div class="row">
      <div class="field">
        <label class="field-label" for="rnMin">최솟값</label>
        <input class="input" id="rnMin" type="number" value="1" />
      </div>
      <div class="field">
        <label class="field-label" for="rnMax">최댓값</label>
        <input class="input" id="rnMax" type="number" value="100" />
      </div>
      <div class="field">
        <label class="field-label" for="rnCount">개수</label>
        <input class="input" id="rnCount" type="number" value="5" min="1" max="1000" />
      </div>
    </div>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="rnUnique"><input type="checkbox" id="rnUnique" checked /> 중복 없음 (범위가 충분해야 함)</label>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="rnBtn" type="button"><i class="bi bi-shuffle"></i> 랜덤 숫자 생성</button>
    </div>
    <div class="status-msg" id="rnStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="생성 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="rnCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="rnOutput" readonly spellcheck="false" placeholder="결과가 여기에 표시됩니다"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn } from '../../../../scripts/toolkit';

  function randomInt(min: number, max: number): number {
    const range = max - min + 1;
    const buf = new Uint32Array(1);
    crypto.getRandomValues(buf);
    return min + (buf[0] % range);
  }

  function generate() {
    hideStatus('rnStatus');
    const min = Math.floor(Number(byId<HTMLInputElement>('rnMin').value));
    const max = Math.floor(Number(byId<HTMLInputElement>('rnMax').value));
    const count = Math.floor(Number(byId<HTMLInputElement>('rnCount').value));
    const unique = byId<HTMLInputElement>('rnUnique').checked;
    if (isNaN(min) || isNaN(max) || min >= max) {
      showStatus('rnStatus', 'error', '최댓값이 최솟값보다 커야 합니다');
      return;
    }
    if (isNaN(count) || count < 1) {
      showStatus('rnStatus', 'error', '개수는 최소 1 이상이어야 합니다');
      return;
    }
    if (unique && count > max - min + 1) {
      showStatus('rnStatus', 'error', `범위에는 ${max - min + 1}개의 숫자만 있으므로 ${count}개의 중복 없는 값을 생성할 수 없습니다`);
      return;
    }
    const values: number[] = [];
    if (unique) {
      const pool = new Set<number>();
      while (pool.size < count) pool.add(randomInt(min, max));
      values.push(...pool);
      values.sort((a, b) => a - b);
    } else {
      for (let i = 0; i < count; i++) values.push(randomInt(min, max));
    }
    byId<HTMLTextAreaElement>('rnOutput').value = values.join('\n');
    showStatus('rnStatus', 'success', `${count}개의 랜덤 숫자를 생성했습니다`);
  }

  byId<HTMLButtonElement>('rnBtn').addEventListener('click', generate);
  bindCopyBtn('rnCopy', () => byId<HTMLTextAreaElement>('rnOutput').value);
</script>