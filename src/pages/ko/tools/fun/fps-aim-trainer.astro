---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import FpsTrainer from '../../../../components/FpsTrainer.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';
const lang = 'ko' as const;
const category = 'fun' as const;
const tool = getToolMeta(category, 'fps-aim-trainer', lang);
const related = getRelated(category, 'fps-aim-trainer', lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <FpsTrainer lang={lang} />
</ToolLayout>
