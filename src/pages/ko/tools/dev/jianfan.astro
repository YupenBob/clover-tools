---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jianfan', 'ko')!;
const related = getRelated(category, 'jianfan', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="텍스트 입력" icon="bi-input-cursor">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfSample" type="button"><i class="bi bi-magic"></i> 예시</button>
      <button class="btn btn-ghost btn-sm" id="jfClear" type="button"><i class="bi bi-x-circle"></i> 지우기</button>
    </div>
    <textarea class="textarea" id="jfInput" spellcheck="false" placeholder="간체 또는 번체 중국어 입력"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="jfMode">변환 방향</label>
        <select class="select" id="jfMode">
          <option value="s2t">간체 → 번체</option>
          <option value="t2s">번체 → 간체</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jfBtn" type="button"><i class="bi bi-arrow-repeat"></i> 변환</button>
    </div>
    <div class="status-msg" id="jfStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="변환 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jfCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="jfOutput" readonly spellcheck="false" placeholder="결과가 여기에 표시됩니다"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';
  import zh from 'chinese-s2t';

  const input = byId<HTMLTextAreaElement>('jfInput');
  const output = byId<HTMLTextAreaElement>('jfOutput');

  async function convert() {
    hideStatus('jfStatus');
    const src = input.value;
    if (!src) {
      showStatus('jfStatus', 'error', '텍스트를 입력하세요');
      return;
    }
    const mode = byId<HTMLSelectElement>('jfMode').value;
    output.value = mode === 's2t' ? zh.s2t(src) : zh.t2s(src);
    showStatus('jfStatus', 'success', '변환 완료 (로컬 즉시 변환)');
  }

  byId<HTMLButtonElement>('jfBtn').addEventListener('click', convert);
  bindSample('jfSample', 'jfInput', '软件开发工具，时间戳转换，简体繁体互转');
  bindClear('jfClear', ['jfInput'], ['jfOutput'], 'jfStatus');
  bindCopyBtn('jfCopy', () => output.value);
</script>