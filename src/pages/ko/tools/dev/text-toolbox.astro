---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'text-toolbox', 'ko')!;
const related = getRelated(category, 'text-toolbox', 'ko', 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="텍스트 입력" icon="bi-list-check">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ttbSample" type="button"><i class="bi bi-magic"></i> 샘플</button>
      <button class="btn btn-ghost btn-sm" id="ttbClear" type="button"><i class="bi bi-x-circle"></i> 비우기</button>
    </div>
    <textarea class="textarea" id="ttbInput" spellcheck="false" placeholder="한 줄에 하나의 데이터를 입력하세요. 중복 제거, 정렬, 뒤집기 등을 지원합니다."></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="ttbOp">작업</label>
        <select class="select" id="ttbOp">
          <option value="dedupe" selected>중복 제거</option>
          <option value="sort">정렬 (오름차순)</option>
          <option value="sortDesc">정렬 (내림차순)</option>
          <option value="reverse">줄 순서 뒤집기</option>
          <option value="removeBlank">빈 줄 제거</option>
          <option value="trim">앞뒤 공백 제거</option>
          <option value="shuffle">무작위 섞기</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="ttbBtn" type="button"><i class="bi bi-wrench"></i> 처리</button>
    </div>
    <div class="status-msg" id="ttbStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="처리 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="ttbCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="ttbOutput" readonly spellcheck="false" placeholder="결과가 여기에 표시됩니다"></textarea>
    <div class="input-stats"><span id="ttbStats">0줄</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const SAMPLE = ['apple', 'banana', 'apple', '', 'cherry', 'apple', 'date', ''];

  function run() {
    hideStatus('ttbStatus');
    const op = byId<HTMLSelectElement>('ttbOp').value;
    let lines = byId<HTMLTextAreaElement>('ttbInput').value.split('\n');
    const before = lines.length;
    switch (op) {
      case 'dedupe': lines = [...new Set(lines)]; break;
      case 'sort': lines = lines.sort((a, b) => a.localeCompare(b, 'zh-CN')); break;
      case 'sortDesc': lines = lines.sort((a, b) => b.localeCompare(a, 'zh-CN')); break;
      case 'reverse': lines = lines.reverse(); break;
      case 'removeBlank': lines = lines.filter((l) => l.trim() !== ''); break;
      case 'trim': lines = lines.map((l) => l.trim()); break;
      case 'shuffle': {
        for (let i = lines.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [lines[i], lines[j]] = [lines[j], lines[i]];
        }
        break;
      }
    }
    byId<HTMLTextAreaElement>('ttbOutput').value = lines.join('\n');
    setStats('ttbStats', `${lines.length}줄 (원래 ${before}줄)`);
    showStatus('ttbStatus', 'success', '처리 완료');
  }

  byId<HTMLButtonElement>('ttbBtn').addEventListener('click', run);
  bindSample('ttbSample', 'ttbInput', SAMPLE.join('\n'));
  bindClear('ttbClear', ['ttbInput'], ['ttbOutput'], 'ttbStatus');
  bindCopyBtn('ttbCopy', () => byId<HTMLTextAreaElement>('ttbOutput').value);
  setStats('ttbStats', '0줄');
</script>