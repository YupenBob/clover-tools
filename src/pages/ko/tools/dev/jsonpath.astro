---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'jsonpath', 'ko')!;
const related = getRelated(category, 'jsonpath', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JSON 데이터" icon="bi-braces">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpSample" type="button"><i class="bi bi-magic"></i> 예시</button>
    </div>
    <textarea class="textarea" id="jpJson" spellcheck="false" placeholder="JSON 데이터 붙여넣기"></textarea>
    <div class="field mt-3">
      <label class="field-label" for="jpExpr">JSONPath 표현식</label>
      <input class="input mono" id="jpExpr" type="text" value="$..title" spellcheck="false" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="jpBtn" type="button"><i class="bi bi-signpost-split"></i> 조회</button>
    </div>
    <div class="status-msg" id="jpStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">$.key, ['key'], [0], [*], .. 재귀, [?(@.key == value)] 필터를 지원합니다.</p>
  </ToolPanel>

  <ToolPanel title="조회 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jpCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="jpOutput" readonly spellcheck="false" placeholder="일치 결과가 여기에 표시됩니다"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample } from '../../../../scripts/toolkit';

  const SAMPLE = {
    store: {
      book: [
        { category: 'reference', author: 'Nigel Rees', title: 'Sayings', price: 8.95 },
        { category: 'fiction', author: 'Evelyn Waugh', title: 'Sword', price: 12.99 },
        { category: 'fiction', author: 'Herman Melville', title: 'Moby Dick', price: 8.99 },
      ],
      bicycle: { color: 'red', price: 399 },
    },
    expensive: 10,
  };

  import { query } from '../../../../lib/jsonpath';

  function run() {
    hideStatus('jpStatus');
    byId<HTMLTextAreaElement>('jpOutput').value = '';
    const json = byId<HTMLTextAreaElement>('jpJson').value.trim();
    const expr = byId<HTMLInputElement>('jpExpr').value.trim();
    if (!json || !expr) {
      showStatus('jpStatus', 'error', 'JSON 데이터와 표현식을 입력하세요');
      return;
    }
    let data: unknown;
    try {
      data = JSON.parse(json);
    } catch (e) {
      showStatus('jpStatus', 'error', `JSON 파싱 실패: ${(e as Error).message}`);
      return;
    }
    try {
      const matches = query(data, expr);
      byId<HTMLTextAreaElement>('jpOutput').value = matches.length
        ? matches.map((m) => JSON.stringify(m, null, 2)).join('\n---\n')
        : '일치하는 결과가 없습니다';
      showStatus('jpStatus', 'success', `일치 결과 ${matches.length}개`);
    } catch (e) {
      byId<HTMLTextAreaElement>('jpOutput').value = '';
      showStatus('jpStatus', 'error', (e as Error).message);
    }
  }

  byId<HTMLButtonElement>('jpBtn').addEventListener('click', run);
  bindSample('jpSample', 'jpJson', JSON.stringify(SAMPLE, null, 2));
  bindCopyBtn('jpCopy', () => byId<HTMLTextAreaElement>('jpOutput').value);
</script>