---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'js-formatter', 'ko')!;
const related = getRelated(category, 'js-formatter', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="JavaScript 입력" icon="bi-filetype-js">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsSample" type="button"><i class="bi bi-magic"></i> 예시</button>
      <button class="btn btn-ghost btn-sm" id="jsClear" type="button"><i class="bi bi-x-circle"></i> 지우기</button>
    </div>
    <textarea class="textarea" id="jsInput" spellcheck="false" placeholder="JavaScript 코드를 붙여넣으세요"></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" id="jsFmt" type="button"><i class="bi bi-braces"></i> 포맷</button>
      <button class="btn btn-secondary" id="jsMin" type="button"><i class="bi bi-arrows-collapse"></i> 압축</button>
    </div>
    <div class="status-msg" id="jsStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="출력 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="jsCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="jsOutput" readonly spellcheck="false" placeholder="결과가 여기에 표시됩니다"></textarea>
    <div class="input-stats"><span id="jsStats">0자</span></div>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, setStats, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  const input = byId<HTMLTextAreaElement>('jsInput');
  const output = byId<HTMLTextAreaElement>('jsOutput');

  async function runFormat() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'JavaScript 코드를 입력하세요');
      return;
    }
    try {
      showStatus('jsStatus', 'info', '포맷 엔진을 불러오는 중입니다(최초 약 1MB)……');
      const prettier = await import('prettier/standalone');
      const babelPlugin = await import('prettier/plugins/babel');
      const estreePlugin = await import('prettier/plugins/estree');
      showStatus('jsStatus', 'info', '포맷 중……');
      output.value = await prettier.format(input.value, {
        parser: 'babel',
        plugins: [babelPlugin, estreePlugin] as never,
        semi: true,
        singleQuote: true,
        tabWidth: 2,
        printWidth: 100,
      });
      setStats('jsStats', `${output.value.length}자`);
      showStatus('jsStatus', 'success', '포맷 완료');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `파싱 실패: ${(e as Error).message}`);
    }
  }

  async function runMinify() {
    hideStatus('jsStatus');
    if (!input.value.trim()) {
      showStatus('jsStatus', 'error', 'JavaScript 코드를 입력하세요');
      return;
    }
    try {
      showStatus('jsStatus', 'info', '압축 엔진을 불러오는 중……');
      const { minify: terserMinify } = await import('terser');
      showStatus('jsStatus', 'info', '압축 중……');
      const result = await terserMinify(input.value, { mangle: true, compress: true });
      output.value = result.code || '';
      setStats('jsStats', `${output.value.length}자`);
      showStatus('jsStatus', 'success', '압축 완료');
    } catch (e) {
      output.value = '';
      showStatus('jsStatus', 'error', `압축 실패: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('jsFmt').addEventListener('click', runFormat);
  byId<HTMLButtonElement>('jsMin').addEventListener('click', runMinify);
  bindSample('jsSample', 'jsInput', 'const tools=["json","base64"];function greet(name){return "Hello "+name} console.log(greet("Clover"));');
  bindClear('jsClear', ['jsInput'], ['jsOutput'], 'jsStatus');
  bindCopyBtn('jsCopy', () => output.value);
  setStats('jsStats', '0자');
</script>