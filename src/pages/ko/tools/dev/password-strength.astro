---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'password-strength', 'ko')!;
const related = getRelated(category, 'password-strength', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="비밀번호 입력" icon="bi-shield-exclamation">
    <div class="field">
      <label class="field-label" for="psInput">비밀번호</label>
      <input class="input" id="psInput" type="password" placeholder="검사할 비밀번호 입력" autocomplete="off" />
    </div>
    <div class="strength-bars" id="psBars">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </div>
    <div class="strength-label" id="psLabel">입력 대기 중</div>
    <div class="status-msg" id="psStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="검사 세부 정보" icon="bi-list-check">
    <ul class="check-list" id="psChecks"></ul>
    <div class="input-stats"><span id="psDetail">길이, 문자 조합 및 일반적인 약한 비밀번호 종합 평가</span></div>
  </ToolPanel>
</ToolLayout>

<style>
  .strength-bars {
    display: flex;
    gap: 6px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--bg-tertiary);
    transition: background-color 0.2s ease;
  }

  .bar.filled {
    background: var(--bar-color, var(--warning));
  }

  .strength-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .check-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .check-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .check-list li.ok {
    color: var(--success);
  }

  .check-list li.bad {
    color: var(--error);
  }
</style>

<script>
  import { byId } from '../../../../scripts/toolkit';

  const input = byId<HTMLInputElement>('psInput');
  const bars = byId<HTMLElement>('psBars').children;
  const label = byId<HTMLElement>('psLabel');
  const checks = byId<HTMLUListElement>('psChecks');
  const detail = byId<HTMLElement>('psDetail');

  const COMMON = ['123456', 'password', '12345678', 'qwerty', 'abc123', '111111', '123123', 'admin', 'letmein', '000000', '666666', '88888888', 'iloveyou'];

  function analyze(pw: string) {
    const len = pw.length;
    const hasLower = /[a-z]/.test(pw);
    const hasUpper = /[A-Z]/.test(pw);
    const hasDigit = /\d/.test(pw);
    const hasSymbol = /[^A-Za-z0-9]/.test(pw);
    const isCommon = COMMON.includes(pw.toLowerCase());
    const sequential = /(012|123|234|345|456|567|678|789|890|abc|bcd|cde|def|efg|fgh|ghi|hij|ijk|jkl|klm|lmn|mno|nop|opq|pqr|qrs|rst|stu|tuv|uvw|vwx|wxy|xyz)/i.test(pw);

    const results = [
      { ok: len >= 8, text: len >= 8 ? '길이가 8자 이상' : `길이 부족 (현재 ${len}자)` },
      { ok: hasLower && hasUpper, text: hasLower && hasUpper ? '대문자/소문자 포함' : '대문자/소문자 조합 부족' },
      { ok: hasDigit, text: hasDigit ? '숫자 포함' : '숫자 부족' },
      { ok: hasSymbol, text: hasSymbol ? '특수 기호 포함' : '특수 기호 부족' },
      { ok: !isCommon, text: isCommon ? '일반적인 약한 비밀번호에 해당하므로 변경을 권장합니다' : '일반적인 약한 비밀번호에 해당하지 않음' },
      { ok: !sequential, text: sequential ? '연속/순차 문자 포함' : '연속/순차 문자 없음' },
    ];

    let score = 0;
    score += Math.min(len / 4, 2);
    if (hasLower && hasUpper) score += 1;
    if (hasDigit) score += 0.5;
    if (hasSymbol) score += 1;
    if (isCommon) score -= 2;
    if (sequential) score -= 0.5;
    score = Math.max(0, Math.min(4, Math.round(score)));
    return { score, results };
  }

  function update() {
    const pw = input.value;
    if (!pw) {
      label.textContent = '입력 대기 중';
      detail.textContent = '길이, 문자 조합 및 일반적인 약한 비밀번호 종합 평가';
      checks.innerHTML = '';
      Array.from(bars).forEach((b) => b.classList.remove('filled'));
      return;
    }
    const { score, results } = analyze(pw);
    const meta = [
      { color: 'var(--error)', text: '매우 약함' },
      { color: 'var(--error)', text: '약함' },
      { color: 'var(--warning)', text: '보통' },
      { color: 'var(--success)', text: '강함' },
      { color: 'var(--success)', text: '매우 강함' },
    ][score];
    Array.from(bars).forEach((bar, i) => {
      bar.classList.toggle('filled', i < score);
      (bar as HTMLElement).style.setProperty('--bar-color', meta.color);
    });
    label.textContent = `${meta.text}（${score}/4）`;
    label.style.color = meta.color;
    checks.innerHTML = results.map((r) => `<li class="${r.ok ? 'ok' : 'bad'}"><i class="bi ${r.ok ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>${r.text}</li>`).join('');
    const entropy = pw.length * Math.log2(94);
    detail.textContent = `추정 엔트로피 약 ${entropy.toFixed(0)} bit, 이상적 환경 오프라인 크랙 시간 약 ${entropy > 60 ? '매우 김 (수백 년 이상)' : entropy > 40 ? '수일~수개월' : '수초~수시간'}`;
  }

  input.addEventListener('input', update);
  update();
</script>