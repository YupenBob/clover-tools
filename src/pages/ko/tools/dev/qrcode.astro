---
// @shared-tool-ui: localized routes share task-specific presentation and interaction.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import CodeGenerator from '../../../../components/CodeGenerator.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';
const lang = 'ko' as const;
const category = 'dev' as const;
const tool = getToolMeta(category, 'qrcode', lang);
const related = getRelated(category, tool.slug, lang, 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <CodeGenerator lang={lang} />
</ToolLayout>
