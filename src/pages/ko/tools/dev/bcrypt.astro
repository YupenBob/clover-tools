---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'bcrypt', 'ko')!;
const related = getRelated(category, 'bcrypt', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="Bcrypt 해시 생성" icon="bi-shield-check">
    <div class="field">
      <label class="field-label" for="bcPwd">비밀번호</label>
      <input class="input" id="bcPwd" type="password" placeholder="해시할 비밀번호 입력" autocomplete="off" />
    </div>
    <div class="row">
      <div class="field">
        <label class="field-label" for="bcRounds">비용 계수(cost)</label>
        <select class="select" id="bcRounds">
          <option value="8">8（빠름）</option>
          <option value="10" selected>10（권장）</option>
          <option value="12">12（느림）</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="bcGen" type="button"><i class="bi bi-shield-check"></i> 해시 생성</button>
    </div>
    <div class="status-msg" id="bcGenStatus" role="status" aria-live="polite"></div>
    <div class="output-area mt-3">
      <textarea class="textarea" id="bcHash" readonly spellcheck="false" placeholder="생성된 해시가 여기에 표시됩니다"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-ghost btn-sm" id="bcCopy" type="button"><i class="bi bi-clipboard"></i> 해시 복사</button>
    </div>
  </ToolPanel>

  <ToolPanel title="비밀번호 검증" icon="bi-shield-lock">
    <div class="field">
      <label class="field-label" for="bcCheckPwd">검증할 비밀번호</label>
      <input class="input" id="bcCheckPwd" type="password" placeholder="비밀번호 입력" autocomplete="off" />
    </div>
    <div class="field">
      <label class="field-label" for="bcCheckHash">알려진 해시</label>
      <textarea class="textarea" id="bcCheckHash" spellcheck="false" placeholder="$2a$ / $2b$ / $2y$로 시작하는 Bcrypt 해시 붙여넣기"></textarea>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="bcVerify" type="button"><i class="bi bi-shield-lock"></i> 검증</button>
    </div>
    <div class="status-msg" id="bcVerifyStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="설명" icon="bi-info-circle" className="mt-4">
    <p class="field-hint" style="line-height:1.9">
      Bcrypt는 솔트 처리된 해시 알고리즘으로, 해시에 무작위 솔트와 비용 계수가 포함되어 있어 같은 비밀번호도 매번 생성 결과가 다릅니다($2b$10$...의 10이 비용 계수입니다).
      검증 시에는 생성할 때의 해시를 사용해야 하며, 비용 계수가 높을수록 계산이 느려지고 무차별 대입에 더 강하므로 10-12를 권장합니다. 모든 과정은 브라우저 로컬에서 계산되므로 비밀번호가 기기를 벗어나지 않습니다.
    </p>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';
  import bcrypt from 'bcryptjs';

  async function generate() {
    hideStatus('bcGenStatus');
    const pwd = byId<HTMLInputElement>('bcPwd').value;
    if (!pwd) {
      showStatus('bcGenStatus', 'error', '비밀번호를 입력하세요');
      return;
    }
    const rounds = Number(byId<HTMLSelectElement>('bcRounds').value);
    const btn = byId<HTMLButtonElement>('bcGen');
    btn.disabled = true;
    showStatus('bcGenStatus', 'info', '계산 중입니다(비용이 높을수록 시간이 오래 걸립니다)…');
    try {
      const hash = await bcrypt.hash(pwd, rounds);
      byId<HTMLTextAreaElement>('bcHash').value = hash;
      showStatus('bcGenStatus', 'success', `생성 완료(cost ${rounds})`);
    } catch (e) {
      showStatus('bcGenStatus', 'error', `생성 실패: ${(e as Error).message}`);
    } finally {
      btn.disabled = false;
    }
  }

  async function verify() {
    hideStatus('bcVerifyStatus');
    const pwd = byId<HTMLInputElement>('bcCheckPwd').value;
    const hash = byId<HTMLTextAreaElement>('bcCheckHash').value.trim();
    if (!pwd || !hash) {
      showStatus('bcVerifyStatus', 'error', '비밀번호와 해시를 입력하세요');
      return;
    }
    try {
      const ok = await bcrypt.compare(pwd, hash);
      const rounds = bcrypt.getRounds(hash);
      showStatus('bcVerifyStatus', ok ? 'success' : 'error', ok ? `비밀번호 일치(cost ${rounds})` : `비밀번호 불일치(해시 cost ${rounds})`);
    } catch {
      showStatus('bcVerifyStatus', 'error', '해시 형식이 유효하지 않습니다. $2a$ / $2b$ / $2y$로 시작하는지 확인하세요');
    }
  }

  byId<HTMLButtonElement>('bcGen').addEventListener('click', generate);
  byId<HTMLButtonElement>('bcVerify').addEventListener('click', verify);
  byId<HTMLButtonElement>('bcCopy').addEventListener('click', (e) => {
    window.CT.copy(byId<HTMLTextAreaElement>('bcHash').value, e.currentTarget as HTMLElement);
  });
</script>