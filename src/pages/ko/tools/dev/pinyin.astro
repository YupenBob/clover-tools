---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'dev' as const;
const tool = getToolMeta(category, 'pinyin', 'ko')!;
const related = getRelated(category, 'pinyin', 'ko', 6);
---
<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="중국어 입력" icon="bi-translate">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pySample" type="button"><i class="bi bi-magic"></i> 예시</button>
      <button class="btn btn-ghost btn-sm" id="pyClear" type="button"><i class="bi bi-x-circle"></i> 지우기</button>
    </div>
    <textarea class="textarea" id="pyInput" spellcheck="false" placeholder="중국어 입력(예: 开发者工具箱)"></textarea>
    <div class="row mt-3">
      <div class="field">
        <label class="field-label" for="pyMode">출력 모드</label>
        <select class="select" id="pyMode">
          <option value="tone" selected>전체 병음(성조 포함)</option>
          <option value="plain">전체 병음(성조 없음)</option>
          <option value="first">첫 글자</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="pySep">구분 기호</label>
        <select class="select" id="pySep">
          <option value="" selected>없음</option>
          <option value=" ">공백</option>
          <option value="-">하이픈</option>
          <option value="_">밑줄</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="pyBtn" type="button"><i class="bi bi-translate"></i> 변환</button>
    </div>
    <div class="status-msg" id="pyStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="변환 결과" icon="bi-box-arrow-in-down">
    <div slot="actions">
      <button class="btn btn-ghost btn-sm" id="pyCopy" type="button"><i class="bi bi-clipboard"></i> 복사</button>
    </div>
    <textarea class="textarea" id="pyOutput" readonly spellcheck="false" placeholder="병음 결과가 여기에 표시됩니다"></textarea>
  </ToolPanel>
</ToolLayout>

<script>
  import { byId, showStatus, hideStatus, bindCopyBtn, bindSample, bindClear } from '../../../../scripts/toolkit';

  async function convert() {
    hideStatus('pyStatus');
    const src = byId<HTMLTextAreaElement>('pyInput').value;
    const mode = byId<HTMLSelectElement>('pyMode').value;
    const sep = byId<HTMLSelectElement>('pySep').value;
    if (!src) {
      showStatus('pyStatus', 'error', '중국어를 입력해 주세요');
      return;
    }
    try {
      const { pinyin } = await import('pinyin-pro');
      const opts = mode === 'tone'
        ? { toneType: 'symbol' as const, type: 'array' as const }
        : mode === 'plain'
          ? { toneType: 'none' as const, type: 'array' as const }
          : { toneType: 'none' as const, pattern: 'first' as const, type: 'array' as const };
      const arr = pinyin(src, opts) as string[];
      byId<HTMLTextAreaElement>('pyOutput').value = arr.join(sep);
      showStatus('pyStatus', 'success', '변환 완료');
    } catch (e) {
      showStatus('pyStatus', 'error', `변환 실패: ${(e as Error).message}`);
    }
  }

  byId<HTMLButtonElement>('pyBtn').addEventListener('click', convert);
  bindSample('pySample', 'pyInput', '开发者工具箱，打开即用');
  bindClear('pyClear', ['pyInput'], ['pyOutput'], 'pyStatus');
  bindCopyBtn('pyCopy', () => byId<HTMLTextAreaElement>('pyOutput').value);
</script>