---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'workday', 'ko')!;
const related = getRelated(category, 'workday', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="날짜 구간" icon="bi-briefcase">
    <div class="row">
      <div class="field">
        <label class="field-label" for="wdStart">시작 날짜</label>
        <input class="input" id="wdStart" type="date" />
      </div>
      <div class="field">
        <label class="field-label" for="wdEnd">종료 날짜</label>
        <input class="input" id="wdEnd" type="date" />
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="wdBtn" type="button"><i class="bi bi-briefcase"></i> 근무일 계산</button>
    </div>
    <div class="status-msg" id="wdStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">주말을 자동으로 제외하고, 국무원 공휴일 일정에 따라 대체 근무일을 인식합니다（공휴일 근무는 근무일로 계산）.</p>
  </ToolPanel>

  <ToolPanel title="계산 결과" icon="bi-clipboard-data">
    <div class="lc-result" id="wdResult"></div>
  </ToolPanel>
</ToolLayout>

<style>
  .lc-result {
    min-height: 90px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    font-size: 15px;
    line-height: 1.9;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';
  import { HolidayUtil } from 'lunar-javascript';

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function calc() {
    hideStatus('wdStatus');
    const s = byId<HTMLInputElement>('wdStart').value;
    const e = byId<HTMLInputElement>('wdEnd').value;
    if (!s || !e) {
      showStatus('wdStatus', 'error', '날짜 구간을 선택하세요');
      return;
    }
    const start = new Date(s + 'T00:00:00');
    const end = new Date(e + 'T00:00:00');
    if (end < start) {
      showStatus('wdStatus', 'error', '종료 날짜가 시작 날짜보다 빠를 수 없습니다');
      return;
    }
    let workdays = 0;
    let holidays = 0;
    let makeups = 0;
    const cursor = new Date(start);
    while (cursor <= end) {
      const ymd = `${cursor.getFullYear()}-${pad(cursor.getMonth() + 1)}-${pad(cursor.getDate())}`;
      const h = HolidayUtil.getHoliday(ymd);
      const weekend = cursor.getDay() === 0 || cursor.getDay() === 6;
      if (h) {
        if (h.isWork()) { workdays++; makeups++; }
        else { holidays++; }
      } else if (!weekend) {
        workdays++;
      }
      cursor.setDate(cursor.getDate() + 1);
    }
    const totalDays = Math.round((end.getTime() - start.getTime()) / 86400000) + 1;
    byId<HTMLElement>('wdResult').innerHTML =
      `<div>근무일：<b>${workdays}</b>일（대체 근무 포함 ${makeups}일）</div>` +
      `<div>법정 공휴일（주말 포함）：${holidays}일</div>` +
      `<div>구간 총 일수：${totalDays}일</div>`;
    showStatus('wdStatus', 'success', '계산 완료');
  }

  byId<HTMLButtonElement>('wdBtn').addEventListener('click', calc);
  const now = new Date();
  byId<HTMLInputElement>('wdStart').value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const end = new Date(now);
  end.setMonth(end.getMonth() + 1);
  byId<HTMLInputElement>('wdEnd').value = `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}`;
</script>