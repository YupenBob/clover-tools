---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'calculator', 'ko')!;
const related = getRelated(category, 'calculator', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="다기능 계산기" icon="bi-calculator">
    <div class="calc-display">
      <div class="calc-expr" id="calcExpr"></div>
      <div class="calc-result" id="calcResult">0</div>
    </div>
    <div class="calc-grid">
      <button class="calc-btn fn" data-key="C">C</button>
      <button class="calc-btn fn" data-key="back">⌫</button>
      <button class="calc-btn fn" data-key="(">(</button>
      <button class="calc-btn fn" data-key=")">)</button>
      <button class="calc-btn fn" data-key="!">n!</button>
      <button class="calc-btn fn" data-key="sqrt">√</button>
      <button class="calc-btn fn" data-key="pow">xʸ</button>
      <button class="calc-btn op" data-key="/">÷</button>
      <button class="calc-btn num" data-key="7">7</button>
      <button class="calc-btn num" data-key="8">8</button>
      <button class="calc-btn num" data-key="9">9</button>
      <button class="calc-btn op" data-key="*">×</button>
      <button class="calc-btn num" data-key="4">4</button>
      <button class="calc-btn num" data-key="5">5</button>
      <button class="calc-btn num" data-key="6">6</button>
      <button class="calc-btn op" data-key="-">−</button>
      <button class="calc-btn num" data-key="1">1</button>
      <button class="calc-btn num" data-key="2">2</button>
      <button class="calc-btn num" data-key="3">3</button>
      <button class="calc-btn op" data-key="+">+</button>
      <button class="calc-btn fn" data-key="sign">±</button>
      <button class="calc-btn num" data-key="0">0</button>
      <button class="calc-btn num" data-key=".">.</button>
      <button class="calc-btn eq" data-key="=">=</button>
    </div>
    <div class="status-msg" id="calcStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">괄호, 사칙연산, 거듭제곱(xʸ), 제곱근, 팩토리얼(n!)을 지원하며 키보드로 직접 입력할 수 있습니다.</p>
  </ToolPanel>
</ToolLayout>

<style>
  .calc-display {
    margin-bottom: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    text-align: right;
    min-height: 92px;
  }

  .calc-expr {
    min-height: 22px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 15px;
    word-break: break-all;
  }

  .calc-result {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 700;
    word-break: break-all;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .calc-btn {
    min-height: 48px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.12s ease, transform 0.08s ease;
  }

  .calc-btn:hover {
    background: var(--bg-secondary);
  }

  .calc-btn:active {
    transform: scale(0.95);
  }

  .calc-btn.fn {
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 14px;
  }

  .calc-btn.op {
    color: var(--primary-dark);
    font-size: 20px;
  }

  .calc-btn.eq {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
  }
</style>

<script>
  import { byId, hideStatus } from '../../../../scripts/toolkit';

  const exprEl = byId<HTMLElement>('calcExpr');
  const resultEl = byId<HTMLElement>('calcResult');
  let expr = '';
  let lastResult = '';

  function sanitize(s: string): string {
    return s.replace(/[^0-9+\-*/().!√^%\s]/g, '');
  }

  function factorial(n: number): number {
    if (n < 0 || !Number.isInteger(n)) return NaN;
    let r = 1;
    for (let i = 2; i <= n; i++) r *= i;
    return r;
  }

  function evaluate(): number {
    let s = expr
      .replace(/×/g, '*')
      .replace(/÷/g, '/')
      .replace(/−/g, '-')
      .replace(/\^/g, '**');
    if (s.includes('!')) {
      s = s.replace(/(\d+(?:\.\d+)?)!/g, (_, n) => String(factorial(Number(n))));
    }
    if (s.includes('√')) {
      s = s.replace(/√(\d+(?:\.\d+)?)/g, (_, n) => String(Math.sqrt(Number(n))));
    }
    if (!/^[\d+\-*/().\s]+$/.test(s)) throw new Error('수식에 지원되지 않는 내용이 포함되어 있습니다');
    const fn = new Function(`"use strict"; return (${s});`);
    const value = fn();
    if (typeof value !== 'number' || !isFinite(value)) throw new Error('결과가 유효하지 않습니다');
    return value;
  }

  function render() {
    exprEl.textContent = expr || '0';
    if (expr) {
      try {
        const v = evaluate();
        lastResult = String(Number.isInteger(v) ? v : Math.round(v * 1e10) / 1e10);
        resultEl.textContent = lastResult;
      } catch {
        resultEl.textContent = '…';
      }
    } else {
      resultEl.textContent = '0';
    }
  }

  function press(key: string) {
    hideStatus('calcStatus');
    if (key === 'C') {
      expr = '';
    } else if (key === 'back') {
      expr = expr.slice(0, -1);
    } else if (key === 'sign') {
      if (/^\d+(\.\d+)?$/.test(expr)) expr = expr.startsWith('-') ? expr.slice(1) : '-' + expr;
    } else if (key === '=') {
      try {
        const v = evaluate();
        expr = String(Number.isInteger(v) ? v : Math.round(v * 1e10) / 1e10);
      } catch {
        resultEl.textContent = '오류';
      }
    } else {
      if (key === 'pow') {
        expr = expr ? `(${expr})^` : '';
      } else if (key === 'sqrt') {
        expr += '√';
      } else if (key === '!') {
        expr += '!';
      } else if ('0123456789.+-*/()'.includes(key)) {
        expr += key;
      }
    }
    render();
  }

  document.querySelectorAll<HTMLButtonElement>('.calc-btn').forEach((btn) => {
    btn.addEventListener('click', () => press(btn.dataset.key || ''));
  });

  window.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    const k = e.key;
    if (/^[0-9.+*/()\-]$/.test(k)) {
      e.preventDefault();
      press(k);
    } else if (k === 'Enter' || k === '=') {
      e.preventDefault();
      press('=');
    } else if (k === 'Backspace') {
      e.preventDefault();
      press('back');
    } else if (k === 'Escape') {
      e.preventDefault();
      press('C');
    }
  });

  render();
</script>