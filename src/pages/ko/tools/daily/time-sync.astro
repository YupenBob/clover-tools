---
// @shared-tool-ui: five thin routes share the HTTP time diagnostics dashboard.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import TimeSync from '../../../../components/TimeSync.astro';
import { getToolMeta } from '../../../../lib/i18n';
const lang = 'ko' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'time-sync', lang);
const related = ['exam-clock', 'world-clock', 'timestamp'].map(slug => getToolMeta(category, slug, lang));
---
<ToolLayout category={category} tool={tool} related={related} layout="wide" workspace="dashboard">
  <TimeSync lang={lang} related={related} />
</ToolLayout>
