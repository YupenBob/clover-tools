---
// @shared-tool-ui: five routes share the image conversion workspace.
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ImageConvert from '../../../../components/ImageConvert.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const lang = 'ko' as const;
const category = 'daily' as const;
const tool = getToolMeta(category, 'image-convert', lang);
const related = getRelated(category, tool.slug, lang);
---
<ToolLayout category={category} tool={tool} related={related} layout="wide" workspace="split">
  <ImageConvert lang={lang} />
</ToolLayout>
