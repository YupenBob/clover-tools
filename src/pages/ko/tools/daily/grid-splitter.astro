---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'grid-splitter', 'ko')!;
const related = getRelated(category, 'grid-splitter', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="이미지 업로드" icon="bi-image">
    <div class="field">
      <input class="input" id="gsFile" type="file" accept="image/*" />
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="gsBtn" type="button"><i class="bi bi-grid-3x3-gap"></i> 9분할로 나누기</button>
      <button class="btn btn-ghost" id="gsDownload" type="button"><i class="bi bi-download"></i> 전체 다운로드</button>
    </div>
    <div class="status-msg" id="gsStatus" role="status" aria-live="polite"></div>
    <p class="field-hint">정사각형 이미지를 올리면 가장 좋은 결과가 나옵니다. 이미지는 기기에서만 처리되며 업로드되지 않습니다.</p>
  </ToolPanel>

  <ToolPanel title="분할 미리보기" icon="bi-grid-3x3-gap">
    <div class="gs-grid" id="gsGrid"></div>
  </ToolPanel>
</ToolLayout>

<style is:global>
  .gs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .gs-cell {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .gs-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gs-cell .no {
    position: absolute;
    top: 4px;
    left: 4px;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 11px;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';

  let slices: HTMLCanvasElement[] = [];

  function split() {
    hideStatus('gsStatus');
    const file = byId<HTMLInputElement>('gsFile').files?.[0];
    if (!file) {
      showStatus('gsStatus', 'error', '이미지를 먼저 선택하세요.');
      return;
    }
    const img = new Image();
    img.onload = () => {
      const side = Math.min(img.width, img.height);
      const size = side / 3;
      const startX = (img.width - side) / 2;
      const startY = (img.height - side) / 2;
      slices = [];
      const grid = byId<HTMLElement>('gsGrid');
      grid.innerHTML = '';
      for (let r = 0; r < 3; r++) {
        for (let c = 0; c < 3; c++) {
          const canvas = document.createElement('canvas');
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d')!;
          ctx.drawImage(img, startX + c * size, startY + r * size, size, size, 0, 0, size, size);
          const cell = document.createElement('div');
          cell.className = 'gs-cell';
          cell.innerHTML = `<span class="no">${r * 3 + c + 1}</span>`;
          cell.appendChild(canvas);
          grid.appendChild(cell);
          slices.push(canvas);
        }
      }
      showStatus('gsStatus', 'success', `분할 완료 (원본 ${img.width}×${img.height}, 중앙 ${side}×${side} 기준)`);
    };
    img.onerror = () => showStatus('gsStatus', 'error', '이미지를 불러오지 못했습니다.');
    img.src = URL.createObjectURL(file);
  }

  byId<HTMLButtonElement>('gsBtn').addEventListener('click', split);
  byId<HTMLButtonElement>('gsDownload').addEventListener('click', () => {
    if (slices.length === 0) {
      showStatus('gsStatus', 'error', '이미지를 먼저 분할하세요.');
      return;
    }
    slices.forEach((canvas, i) => {
      const a = document.createElement('a');
      a.href = canvas.toDataURL('image/png');
      a.download = `9분할_${i + 1}.png`;
      a.click();
    });
    showStatus('gsStatus', 'success', '이미지 9장 다운로드를 시작했습니다.');
  });
</script>