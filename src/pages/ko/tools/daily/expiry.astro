---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ToolPanel from '../../../../components/ToolPanel.astro';
import { getToolMeta, getRelated } from '../../../../lib/i18n';

const category = 'daily' as const;
const tool = getToolMeta(category, 'expiry', 'ko')!;
const related = getRelated(category, 'expiry', 'ko', 6);
---

<ToolLayout category={category} tool={tool} related={related}>
  <ToolPanel title="유통기한 정보" icon="bi-calendar-x">
    <div class="row">
      <div class="field">
        <label class="field-label" for="expDate">제조일자</label>
        <input class="input" id="expDate" type="date" />
      </div>
      <div class="field">
        <label class="field-label" for="expDays">유통기한(일)</label>
        <input class="input" id="expDays" type="number" value="180" min="1" />
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="expBtn" type="button"><i class="bi bi-calendar-x"></i> 만료일 계산</button>
    </div>
    <div class="status-msg" id="expStatus" role="status" aria-live="polite"></div>
  </ToolPanel>

  <ToolPanel title="계산 결과" icon="bi-clipboard-data">
    <div class="lc-result" id="expResult"></div>
  </ToolPanel>
</ToolLayout>

<style>
  .lc-result {
    min-height: 90px;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    font-size: 15px;
    line-height: 2;
  }
</style>

<script>
  import { byId, showStatus, hideStatus } from '../../../../scripts/toolkit';

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  function calc() {
    hideStatus('expStatus');
    const date = byId<HTMLInputElement>('expDate').value;
    const days = Number(byId<HTMLInputElement>('expDays').value);
    if (!date || days <= 0) {
      showStatus('expStatus', 'error', '날짜를 선택하고 유통기한을 입력하세요.');
      return;
    }
    const start = new Date(date + 'T00:00:00');
    const expire = new Date(start);
    expire.setDate(expire.getDate() + days);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const remain = Math.round((expire.getTime() - today.getTime()) / 86400000);
    const status = remain > 30 ? '여유 있음' : remain > 0 ? '곧 만료됩니다. 빠른 시일 내에 섭취/사용하세요.' : '만료됨, 사용하지 마세요.';
    const cls = remain > 30 ? 'var(--success)' : remain > 0 ? 'var(--warning)' : 'var(--error)';
    byId<HTMLElement>('expResult').innerHTML =
      `<div>만료일: <b>${expire.getFullYear()}-${pad(expire.getMonth() + 1)}-${pad(expire.getDate())}</b></div>` +
      `<div>남은 기간: ${remain >= 0 ? remain + '일' : Math.abs(remain) + '일(만료됨)'}</div>` +
      `<div style="color:${cls}">상태: ${status}</div>`;
    showStatus('expStatus', 'success', '계산 완료');
  }

  byId<HTMLButtonElement>('expBtn').addEventListener('click', calc);
  const now = new Date();
  byId<HTMLInputElement>('expDate').value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
</script>