---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { pathForLang, DICT, type Lang } from '../lib/i18n';
import { getLegalContent } from '../lib/legal';

interface Props {
  kind: 'privacy' | 'terms' | 'contact';
  lang: Lang;
}

const { kind, lang } = Astro.props;
const { copy, labels } = getLegalContent(kind, lang);

const title = `${copy.title} - ${SITE.name}`;
const canonical = `${SITE.url}${pathForLang(`/${kind}/`, lang)}`;
---

<BaseLayout title={title} description={copy.desc} canonical={canonical} ads={false}>
  <nav class="legal-breadcrumb" aria-label={DICT[lang].breadcrumb}>
    <a href={pathForLang('/', lang)}><i class="bi bi-house-door" aria-hidden="true"></i> {labels.back}</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>{copy.title}</span>
  </nav>
  <article class="legal-page">
    <header class="legal-hero">
      <p class="legal-kicker">CloverTools · {labels.updated}</p>
      <h1>{copy.title}</h1>
      <p>{copy.lead}</p>
    </header>
    <div class="legal-body">
      {copy.sections.map(([heading, body]) => (
        <section>
          <h2>{heading}</h2>
          <p>{body}</p>
        </section>
      ))}
      {kind === 'contact' && (
        <section class="legal-contact-card">
          <h2>{labels.contact}</h2>
          <p>{labels.email}</p>
          <a class="legal-cta" href={`${SITE.github}/issues`} target="_blank" rel="noopener noreferrer">
            <i class="bi bi-github" aria-hidden="true"></i> {labels.github}
          </a>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .legal-breadcrumb { display: flex; align-items: center; gap: 9px; margin: 20px 0 28px; color: var(--text-tertiary); font-size: 13px; }
  .legal-breadcrumb a { color: var(--text-secondary); }
  .legal-page { max-width: 820px; margin: 0 auto var(--space-8); }
  .legal-hero { padding: clamp(26px, 5vw, 48px); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--primary-soft), transparent 58%), var(--bg-elevated); box-shadow: var(--shadow-sm); }
  .legal-kicker { margin: 0 0 10px; color: var(--primary-dark); font-size: 12px; letter-spacing: .06em; }
  .legal-hero h1 { margin: 0 0 14px; font-size: clamp(28px, 5vw, 42px); line-height: 1.2; }
  .legal-hero > p:last-child { max-width: 670px; margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.85; }
  .legal-body { padding: 0 clamp(8px, 3vw, 28px); }
  .legal-body section { padding: 30px 0 6px; border-bottom: 1px solid var(--border); }
  .legal-body h2 { margin: 0 0 10px; font-size: 19px; }
  .legal-body p { margin: 0 0 18px; color: var(--text-secondary); font-size: 15px; line-height: 1.9; }
  .legal-contact-card { margin-top: 14px; padding: 20px; border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: var(--bg-secondary); }
  .legal-cta { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: var(--radius-full); background: var(--brand-ink); color: var(--bg-elevated); font-size: 13px; }
</style>
