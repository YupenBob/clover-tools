---
/**
 * The official CloverTools mark: a geometric four-leaf clover on a 32-unit grid.
 * Inline SVG (not <img>) because focus-flight renders pure vector art.
 * Geometry mirrors public/clover-logo.svg — keep the two files in sync.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" role="img" aria-label="CloverTools">
  <defs>
    <linearGradient id="ct-mark-gold" x1="4.5" y1="3" x2="27.5" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#E3C68D" />
      <stop offset="1" stop-color="#B8935A" />
    </linearGradient>
  </defs>
  <g transform="translate(16 16) scale(1.045)" fill="url(#ct-mark-gold)">
    <g transform="rotate(0)"><path d="M 12.2 0 C 12.55 0 13.95 1.5 13.88 2.7 C 13.78 4.2 10.55 5.9 8.9 5.9 C 6.55 5.9 2.5 2.55 -1.7 0 C 2.5 -2.55 6.55 -5.9 8.9 -5.9 C 10.55 -5.9 13.78 -4.2 13.88 -2.7 C 13.95 -1.5 12.55 0 12.2 0 Z" /></g>
    <g transform="rotate(90)"><path d="M 12.2 0 C 12.55 0 13.95 1.5 13.88 2.7 C 13.78 4.2 10.55 5.9 8.9 5.9 C 6.55 5.9 2.5 2.55 -1.7 0 C 2.5 -2.55 6.55 -5.9 8.9 -5.9 C 10.55 -5.9 13.78 -4.2 13.88 -2.7 C 13.95 -1.5 12.55 0 12.2 0 Z" /></g>
    <g transform="rotate(180)"><path d="M 12.2 0 C 12.55 0 13.95 1.5 13.88 2.7 C 13.78 4.2 10.55 5.9 8.9 5.9 C 6.55 5.9 2.5 2.55 -1.7 0 C 2.5 -2.55 6.55 -5.9 8.9 -5.9 C 10.55 -5.9 13.78 -4.2 13.88 -2.7 C 13.95 -1.5 12.55 0 12.2 0 Z" /></g>
    <g transform="rotate(270)"><path d="M 12.2 0 C 12.55 0 13.95 1.5 13.88 2.7 C 13.78 4.2 10.55 5.9 8.9 5.9 C 6.55 5.9 2.5 2.55 -1.7 0 C 2.5 -2.55 6.55 -5.9 8.9 -5.9 C 10.55 -5.9 13.78 -4.2 13.88 -2.7 C 13.95 -1.5 12.55 0 12.2 0 Z" /></g>
  </g>
</svg>
