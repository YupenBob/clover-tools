---
import {ipReputationCopy} from '../lib/ip-reputation-i18n';
import type {Language} from '../lib/ip-reputation';
import {pathForLang} from '../lib/i18n';
import '../styles/ip-reputation.css';
interface Props {lang:Language}
const {lang}=Astro.props;
const {text:t,fields}=ipReputationCopy(lang);
---
<div id="ipReputation" class="ipr" data-lang={lang} data-state="idle">
  <p class="ipr-lead">{t.lead}</p>
  <form id="iprForm" class="ipr-input" novalidate>
    <label for="iprQuery">{t.input}</label>
    <div class="ipr-entry"><input id="iprQuery" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="iprHint iprStatus" /><button id="iprSubmit" class="btn btn-primary" type="submit" aria-keyshortcuts="Control+Enter Meta+Enter">{t.lookup}</button></div>
    <p id="iprHint" class="ipr-note">{t.hint}</p>
    <div class="ipr-actions"><span>{t.examples}</span>{['8.8.8.8','2606:4700:4700::1111','example.com'].map(value=><button class="btn btn-secondary btn-sm" type="button" data-example={value}>{value}</button>)}</div>
    <div class="ipr-actions"><button id="iprCancel" class="btn btn-secondary" type="button" disabled>{t.cancel}</button><button id="iprClear" class="btn btn-secondary" type="button">{t.clear}</button></div>
  </form>
  <p class="ipr-privacy">{t.privacy}</p>
  <p id="iprStatus" class="ipr-status" role="status" aria-live="polite">{t.idle}</p>
  <section id="iprResolution" class="ipr-resolution" aria-labelledby="iprCandidateTitle" hidden>
    <h2 id="iprCandidateTitle">{t.candidates}</h2>
    <p>{t.domainNote}</p><div id="iprDnsStatus"></div>
    <fieldset id="iprCandidates"><legend>{t.candidates}</legend></fieldset>
    <p id="iprDnsNote" class="ipr-note"></p>
    <button id="iprSelectedLookup" class="btn btn-primary" type="button">{t.selectedLookup}</button>
  </section>
  <div id="iprResults" aria-busy="false">
    <p id="iprSnapshotBanner" class="ipr-snapshot" hidden>{t.snapshot}</p>
    <section id="iprSummary" class="ipr-summary" aria-label={t.summary} hidden></section>
    <div class="ipr-workspace">
      <section class="ipr-comparison" aria-labelledby="iprComparisonTitle">
        <div class="ipr-section-head"><h2 id="iprComparisonTitle">{t.comparison}</h2><span>ipwho.is / ipapi.co / ipapi.is</span></div>
        <fieldset id="iprFilters" class="ipr-filters"><legend>{t.filter}</legend>{['all','differences','provided'].map((value,i)=><label><input type="radio" name="iprFilter" value={value} checked={i===0} />{t[value]}</label>)}</fieldset>
        <p id="iprEmpty" class="ipr-note">{t.idle}</p>
        <div id="iprSourceHeaders" class="ipr-source-headers" hidden></div>
        <div id="iprRows"></div>
      </section>
      <aside class="ipr-sidebar" aria-labelledby="iprSourcesTitle">
        <h2 id="iprSourcesTitle">{t.sources}</h2>
        <p class="ipr-note">{t.observation}</p>
        <div id="iprSources"><ul><li>ipwho.is</li><li>ipapi.co</li><li>ipapi.is — {t.enhancement}</li></ul></div>
        <div id="iprIndicators"></div>
        <section class="ipr-explanation" aria-labelledby="iprExplanationTitle"><h3 id="iprExplanationTitle">{t.fieldExplanation}</h3><p id="iprExplanationText">{t.explanationEmpty}</p></section>
        <details><summary>{t.sourceDocs}</summary><ul><li><a href="https://ipwhois.io/documentation" rel="noopener noreferrer" target="_blank">ipwho.is</a></li><li><a href="https://ipapi.co/api/" rel="noopener noreferrer" target="_blank">ipapi.co</a></li><li><a href="https://ipapi.is/developers.html" rel="noopener noreferrer" target="_blank">ipapi.is</a></li><li><a href="https://developers.cloudflare.com/1.1.1.1/encryption/dns-over-https/make-api-requests/dns-json/" rel="noopener noreferrer" target="_blank">Cloudflare DNS</a></li></ul></details>
        <details><summary>{t.enhancement}</summary>{Object.entries(fields).slice(6).map(([,f])=><p><strong>{f.label}</strong> — {f.explanation}</p>)}</details>
        <p class="ipr-note">{t.disclaimer}</p>
      </aside>
    </div>
    <section class="ipr-export" aria-labelledby="iprJsonTitle"><h2 id="iprJsonTitle">{t.json}</h2><div class="ipr-actions"><button id="iprCopy" class="btn btn-secondary" type="button" disabled>{t.copy}</button><button id="iprShare" class="btn btn-secondary" type="button" disabled>{t.share}</button></div><label for="iprJson">{t.json}</label><textarea id="iprJson" readonly rows="9" spellcheck="false"></textarea><p id="iprCopyStatus" role="status" aria-live="polite"></p><label id="iprManualLabel" for="iprManual" hidden>{t.manual}</label><textarea id="iprManual" readonly rows="3" hidden></textarea></section>
  </div>
  <section class="ipr-history" aria-labelledby="iprHistoryTitle"><div class="ipr-section-head"><h2 id="iprHistoryTitle">{t.history}</h2><button id="iprClearHistory" type="button" class="btn btn-secondary">{t.clearHistory}</button></div><p>{t.localNotice}</p><p id="iprStorageNotice" role="status" aria-live="polite"></p><div id="iprConfirm" hidden><p>{t.confirmText}</p><button id="iprConfirmClear" type="button" class="btn btn-primary">{t.confirm}</button><button id="iprKeep" type="button" class="btn btn-secondary">{t.cancel}</button></div><p id="iprHistoryEmpty">{t.emptyHistory}</p><ol id="iprHistory"></ol></section>
  <nav class="ipr-related" aria-label={t.related}><h2>{t.related}</h2><a href={pathForLang('/tools/dev/ip-lookup/',lang)}>{t.ipLookup}</a><a href={pathForLang('/tools/dev/http-tester/',lang)}>{t.httpTester}</a><a href={pathForLang('/tools/dev/ua-parser/',lang)}>{t.uaParser}</a></nav>
  <noscript><p>{t.noscript}</p></noscript>
</div>
<script>import '../scripts/ip-reputation';</script>
