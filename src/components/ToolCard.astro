---
import type { ToolCategory, ToolMeta } from '../lib/tools';
import { getToolHref } from '../lib/tools';
import { DICT, langFromUrl, pathForLang, type Lang } from '../lib/i18n';

interface Props {
  tool: ToolMeta;
  category: ToolCategory;
  searchText?: string;
  delay?: number;
}

const { tool, category, searchText, delay = 0 } = Astro.props;
const lang: Lang = langFromUrl(Astro.url.pathname);
const href = pathForLang(getToolHref(category, tool.slug), lang);
const tags = tool.keywords.slice(0, 2);
const dict = DICT[lang];
---

<a class="tool-card" href={href} data-search={searchText} data-slug={tool.slug} style={`--delay:${delay}ms`}>
  <div class="tool-card-head">
    <span class="tool-card-icon"><i class={`bi ${tool.icon}`} aria-hidden="true"></i></span>
    <h3 class="tool-card-title">{tool.name}</h3>
  </div>
  <p class="tool-card-desc">{tool.oneLiner}</p>
  <div class="tool-card-foot">
    <span class="tool-card-tags">
      {tags.map((tag) => <span class="tool-card-tag">{tag}</span>)}
    </span>
    <span class="tool-card-link">
      {dict.useNow} <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </span>
  </div>
</a>
