---
import DailyToolData from './DailyToolData.astro';
import { dailyText } from '../lib/daily-tool-i18n';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = dailyText(lang);
const standard = lang === 'zh' || lang === 'tw' ? 'cn' : 'who';
---
<DailyToolData lang={lang} />
<div class="daily-composition bmi-composition">
  <section class="daily-surface" aria-labelledby="bmiHeading">
    <div class="daily-section-head"><h2 id="bmiHeading">{t.parameters}</h2><span class="daily-live"><span aria-hidden="true"></span>{t.live}</span></div>
    <form id="bmiForm" novalidate>
      <div class="field"><label class="field-label" for="bmiUnits">{t.bmiUnits}</label><select class="select" id="bmiUnits"><option value="metric">{t.metric}</option><option value="imperial">{t.imperial}</option></select></div>
      <div class="bmi-measurement"><div class="bmi-field-head"><label class="field-label" for="bmiHeight">{t.height}</label><div class="number-with-unit"><input class="input mono" id="bmiHeight" type="number" min="100" max="250" step="any" value="175" /><span id="bmiHeightUnit">cm</span></div></div><label class="sr-only" for="bmiHeightRange">{t.height}</label><input class="bmi-range" id="bmiHeightRange" type="range" min="100" max="250" step="0.1" value="175" /></div>
      <div class="bmi-measurement"><div class="bmi-field-head"><label class="field-label" for="bmiWeight">{t.weight}</label><div class="number-with-unit"><input class="input mono" id="bmiWeight" type="number" min="20" max="350" step="any" value="70" /><span id="bmiWeightUnit">kg</span></div></div><label class="sr-only" for="bmiWeightRange">{t.weight}</label><input class="bmi-range" id="bmiWeightRange" type="range" min="20" max="350" step="0.1" value="70" /></div>
      <div class="field"><label class="field-label" for="bmiStandard">{t.bmiStandard}</label><select class="select" id="bmiStandard"><option value="cn" selected={standard === 'cn'}>{t.standardCn}</option><option value="who" selected={standard === 'who'}>{t.standardWho}</option></select></div>
      <div class="btn-row"><button class="btn btn-primary" type="submit" id="bmiBtn">{t.calculate}</button></div>
      <div class="status-msg" id="bmiStatus" role="status" aria-live="polite"></div>
    </form>
  </section>
  <section class="daily-result bmi-result" id="bmiResult" aria-labelledby="bmiResultHeading" data-category="1">
    <h2 class="daily-eyebrow" id="bmiResultHeading">BODY MASS INDEX</h2>
    <div class="bmi-number-row"><output class="daily-number" id="bmiNumber" for="bmiHeight bmiWeight bmiStandard">—</output><span class="bmi-category" id="bmiCategory"></span></div>
    <p class="daily-note">{t.bmiFormula}</p>
    <div class="bmi-scale-wrap"><div class="bmi-scale" id="bmiScale"><span></span><span></span><span></span><span></span><i id="bmiMarker" class="bmi-marker" role="img" aria-label="BMI"></i></div><div class="bmi-ticks" id="bmiTicks"><span>12</span><span>18.5</span><span>24</span><span>28</span><span>40</span></div></div>
    <div class="bmi-scale-key">{t.bmiCategories.map((category, i) => <span><i data-category={i} aria-hidden="true"></i>{category}</span>)}</div>
    <div class="daily-fact bmi-weight-reference"><span id="bmiReferenceLabel">{t.bmiReferenceWeight}</span><strong id="bmiReference">—</strong></div>
    <p class="daily-note">{t.bmiReferenceHint}</p>
    <div class="daily-result-actions"><button class="btn btn-secondary" type="button" id="bmiCopy" disabled><i class="bi bi-clipboard" aria-hidden="true"></i> {t.copy}</button></div>
  </section>
</div>
<script>
  import '../scripts/bmi-calculator';
</script>
