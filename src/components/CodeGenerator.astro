---
import ToolPanel from './ToolPanel.astro';
import { qrText } from '../lib/visual-tool-i18n';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = qrText(lang);
---
<ToolPanel title={t.settings} icon="bi-qr-code" headingId="qr-settings-heading">
  <div slot="actions"><button class="btn btn-ghost btn-sm" id="qrSample" type="button"><i class="bi bi-magic" aria-hidden="true"></i> {t.sample}</button></div>
  <script type="application/json" id="qrTextLabels" set:html={JSON.stringify(t).replace(/</g, '\\u003c')} />
  <div class="row code-settings">
    <div class="field"><label class="field-label" for="qrType">{t.type}</label><select class="select" id="qrType"><option value="qrcode">{t.qr}</option><option value="barcode">{t.barcode}</option></select></div>
    <div class="field"><label class="field-label" for="qrSize">{t.size}</label><select class="select" id="qrSize"><option value="256">256px</option><option value="384" selected>384px</option><option value="512">512px</option></select></div>
    <div class="field" id="qrLevelField"><label class="field-label" for="qrLevel">{t.level}</label><select class="select" id="qrLevel"><option value="L">L (7%)</option><option value="M" selected>M (15%)</option><option value="Q">Q (25%)</option><option value="H">H (30%)</option></select></div>
  </div>
  <div class="field mt-5"><label class="field-label" for="qrText">{t.content}</label><textarea class="textarea" id="qrText" spellcheck="false" placeholder={t.placeholder}></textarea></div>
  <div class="btn-row"><button class="btn btn-primary" id="qrBtn" type="button"><i class="bi bi-qr-code" aria-hidden="true"></i> {t.generate}</button></div>
  <div class="status-msg" id="qrStatus" role="status" aria-live="polite"></div>
</ToolPanel>
<ToolPanel title={t.preview} icon="bi-eye" surface="plain" headingId="qr-preview-heading">
  <div class="code-stage" id="qrPreview" data-ready="false" role="region" aria-labelledby="qr-preview-heading">
    <div class="code-empty" id="qrEmpty"><i class="bi bi-qr-code" aria-hidden="true"></i><strong>{t.empty}</strong><p>{t.hint}</p></div>
    <canvas id="qrCanvas" role="img" aria-label={t.qr} hidden></canvas><svg id="barcodeSvg" role="img" aria-label={t.barcode} hidden></svg>
  </div>
  <div slot="footer" class="code-export"><p>{t.exportHint}</p><button class="btn btn-secondary" id="qrDownload" type="button" disabled><i class="bi bi-download" aria-hidden="true"></i> {t.download}</button></div>
</ToolPanel>
<script>
  import '../scripts/code-generator';
</script>
