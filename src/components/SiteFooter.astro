---
import { SITE } from '../lib/site';
import { DICT, getCategoryMetas, langFromUrl, pathForLang, type Lang } from '../lib/i18n';

const lang: Lang = langFromUrl(Astro.url.pathname);
const dict = DICT[lang];
const categories = getCategoryMetas(lang);
const year = new Date().getFullYear();
const lastUpdated = new Date().toISOString().slice(0, 10);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {year} {SITE.name} · {dict.footerTagline}</span>
    <div class="footer-links">
      <span class="footer-updated"><i class="bi bi-calendar-check" aria-hidden="true"></i> {dict.updated} {lastUpdated}</span>
      {categories.map((cat) => (
        <a href={pathForLang(`/tools/${cat.id}/`, lang)}>{cat.name}</a>
      ))}
      <a href={pathForLang('/about/', lang)}>{dict.about}</a>
      <a href="/sitemap-index.xml">{dict.sitemap}</a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">
        <i class="bi bi-github" aria-hidden="true"></i> GitHub
      </a>
    </div>
  </div>
</footer>
