---
import HomeArtwork from './HomeArtwork.astro';
import { HOME_DATA } from '../lib/home-data';
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import { DICT, getCategoryMetas, langFromUrl, pathForLang, stripLang, type Lang } from '../lib/i18n';

interface Props { containerClass?: string; }
const { containerClass = '' } = Astro.props;

const lang: Lang = langFromUrl(Astro.url.pathname);
const dict = DICT[lang];
const homeFooter = stripLang(Astro.url.pathname) === '/';
const categories = getCategoryMetas(lang);
const year = new Date().getFullYear();
const lastUpdated = HOME_DATA.updated;
---

<footer class:list={['site-footer', { 'home-footer': homeFooter }]}>
  <div class:list={['container', 'footer-inner', containerClass]}>
    <div class="footer-project">{homeFooter && <HomeArtwork kind="seal" />}<span>© {year} {SITE.name} · {dict.footerTagline}</span><p>{dict.footerMaintainer}</p><div class="footer-project-links"><a href={SITE.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> {dict.footerRepo}</a><a href="https://github.com/YupenBob" target="_blank" rel="noopener noreferrer">{dict.footerDeveloper} · YupenBob</a></div></div>
    <div class="footer-links">
      <span class="footer-updated"><Icon name="calendar-check" /> {dict.updated} {lastUpdated}</span>
      {categories.map((cat) => (
        <a href={pathForLang(`/tools/${cat.id}/`, lang)}>{cat.name}</a>
      ))}
      <a href={pathForLang('/about/', lang)}>{dict.about}</a>
      <a href={pathForLang('/guides/', lang)}>{dict.guides}</a>
      <a href={pathForLang('/privacy/', lang)}>{dict.privacy}</a>
      <a href={pathForLang('/terms/', lang)}>{dict.terms}</a>
      <a href={pathForLang('/contact/', lang)}>{dict.contact}</a>
      <a href="/sitemap-index.xml">{dict.sitemap}</a>
    </div>
  </div>
</footer>

<style>
  .home-footer { background: var(--bg-secondary); }
  .home-footer .footer-project-links a { color: var(--text-secondary); text-decoration: underline; text-underline-offset: 4px; }
  .home-footer .footer-project-links a:hover { color: var(--text); }
  .home-footer .footer-project { position: relative; padding-left: 80px; }
  .home-footer .footer-project :global(.home-art-seal) { position: absolute; left: 0; top: 0; width: 60px; height: 60px; color: var(--primary-dark); }
  @media (max-width: 640px) {
    .home-footer .footer-project { padding: 0; }
    .home-footer .footer-project :global(.home-art-seal) { position: static; display: block; margin: 0 auto 16px; }
  }

  .footer-inner { align-items: start; gap: 24px; }
  .footer-project { flex: 1 1 360px; min-width: 0; }
  .footer-project p { max-width: 560px; margin: 10px 0; color: var(--text-secondary); font-size: 12px; line-height: 1.8; }
  .footer-project-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer-project-links a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 12px; }
  .footer-links { flex: 1 1 280px; justify-content: flex-end; }
  .footer-links a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 640px) {
    .footer-project, .footer-links { flex-basis: auto; }
    .footer-project-links, .footer-links { justify-content: center; }
  }
</style>
