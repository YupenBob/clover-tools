---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import { DICT, getCategoryMetas, langFromUrl, pathForLang, type Lang } from '../lib/i18n';

interface Props { containerClass?: string; }
const { containerClass = '' } = Astro.props;

const lang: Lang = langFromUrl(Astro.url.pathname);
const dict = DICT[lang];
const categories = getCategoryMetas(lang);
const year = new Date().getFullYear();
const lastUpdated = SITE.updated;
---

<footer class="site-footer">
  <div class:list={['container', 'footer-inner', containerClass]}>
    <span>© {year} {SITE.name} · {dict.footerTagline}</span>
    <div class="footer-links">
      <span class="footer-updated"><Icon name="calendar-check" /> {dict.updated} {lastUpdated}</span>
      {categories.map((cat) => (
        <a href={pathForLang(`/tools/${cat.id}/`, lang)}>{cat.name}</a>
      ))}
      <a href={pathForLang('/about/', lang)}>{dict.about}</a>
      <a href="/guides/">{dict.guides}</a>
      <a href={pathForLang('/privacy/', lang)}>{dict.privacy}</a>
      <a href={pathForLang('/terms/', lang)}>{dict.terms}</a>
      <a href={pathForLang('/contact/', lang)}>{dict.contact}</a>
      <a href="/sitemap-index.xml">{dict.sitemap}</a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">
        <Icon name="github" /> GitHub
      </a>
    </div>
  </div>
</footer>
