---
import { SITE } from '../lib/site';
import { DICT, LANGS, langFromUrl, pathForLang, stripLang, type Lang } from '../lib/i18n';

const lang: Lang = langFromUrl(Astro.url.pathname);
const homeHref = pathForLang('/', lang);
const currentPath = stripLang(Astro.url.pathname);
const switchBase = currentPath === '/404' || currentPath === '/404/' ? '/' : currentPath;
const dict = DICT[lang];
const LANG_LABELS: Record<Lang, string> = {
  zh: '简体',
  tw: '繁體',
  en: 'EN',
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="CloverTools {dict.home}">
      <img class="brand-logo" src="/clover-logo.svg" alt="CloverTools logo" width="30" height="30" />
      <span class="brand-name">CloverTools</span>
    </a>
    <div class="header-actions">
      <select class="lang-select" id="langSelect" aria-label={dict.switchLang} title={dict.switchLang}>
        {LANGS.map((l) => (
          <option value={pathForLang(switchBase, l)} data-lang={l} selected={l === lang}>
            {LANG_LABELS[l]}
          </option>
        ))}
      </select>
      <button class="icon-btn" id="themeToggle" type="button" aria-label={dict.switchTheme} title={dict.themeTitle}>
        <i class="bi bi-moon-stars" id="themeIcon" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<style>
  .lang-select {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .lang-select:hover {
    border-color: var(--primary);
    color: var(--primary-dark);
    transform: translateY(-1px);
  }
</style>

<script>
  const langSelect = document.getElementById('langSelect') as HTMLSelectElement;
  langSelect.addEventListener('change', () => {
    const opt = langSelect.selectedOptions[0];
    const target = opt?.dataset.lang || 'zh';
    try {
      localStorage.setItem('clover-lang', target);
    } catch {
      /* ignore */
    }
    if (opt?.value) window.location.href = opt.value;
  });
</script>

<script>
  const btn = document.getElementById('themeToggle') as HTMLButtonElement;
  const icon = document.getElementById('themeIcon') as HTMLElement;

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('clover-theme', theme);
    icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon-stars';
  }

  const current = document.documentElement.getAttribute('data-theme');
  applyTheme(current === 'dark' ? 'dark' : 'light');

  btn.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>
