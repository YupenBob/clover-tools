---
import ToolPanel from './ToolPanel.astro';
import { FPS_CONFIG, GAME_PROFILES, WEAPON_PROFILES, TRAINING_MODES } from '../../config/fps.mjs';
import { fpsText, type FpsText } from '../lib/fps-i18n';
import type { Lang } from '../lib/i18n';
import { normalizeSettings } from '../scripts/fps/storage';
const { lang } = Astro.props as { lang: Lang };
const t = fpsText(lang);
const settings = normalizeSettings();
const ranges = ['duration', 'distance', 'count', 'speed'] as const;
const numbers = ['dpi', 'sensitivity', 'fov', 'cm360'] as const;
const label = (key: string) => t[key as keyof FpsText];
const serialized = JSON.stringify(t).replace(/</g, '\\u003c');
const palette = FPS_CONFIG.scene.palette;
const reticle = FPS_CONFIG.feedback.crosshair;
const rangeStyle = `--fps-room:${palette.background};--fps-ink:${palette.ink};--fps-ball:${palette.ball};--fps-hit:${palette.hit};--fps-head:${palette.head};--fps-light:${palette.light};--fps-hud:${palette.ink}e6;--fps-reticle:${reticle.color};--fps-outline:${reticle.outline};--fps-reticle-size:${reticle.size}px;--fps-reticle-gap:${reticle.gap}px;--fps-reticle-stroke:${reticle.stroke}px;--fps-marker-size:${FPS_CONFIG.feedback.hitMarkerSize}px;`;
---
<ToolPanel title={t.title} icon="bi-crosshair">
  <div class="fps" id="fpsTrainer" data-lang={lang} style={rangeStyle}>
    <script type="application/json" id="fpsText" set:html={serialized} />
    <section id="fpsSetup">
      <div class="fps-intro"><div><span class="fps-tag">CS2 / VALORANT</span><h3>{t.lead}</h3><p>{t.rangeIntro}</p></div><svg class="fps-range-sketch" viewBox="0 0 280 150" aria-hidden="true"><path d="M18 120H262M48 142L116 72M232 142L164 72M80 105H200" /><circle cx="82" cy="68" r="17" /><circle cx="168" cy="36" r="12" /><circle cx="228" cy="77" r="15" /><path class="fps-sketch-aim" d="M132 62V72M132 86V96M115 79H125M139 79H149" /></svg></div>
      <form id="fpsSettings">
        <fieldset class="fps-quick"><legend>{t.quickStart}</legend><div class="fps-preset-row">{Object.entries(FPS_CONFIG.presets).map(([id, preset]) => <button type="button" class="btn btn-secondary fps-preset" data-fps-preset={id}><strong>{label(id)}</strong><small>{label(preset.mode + 'Desc')}</small></button>)}</div></fieldset>
        <div class="fps-start-row"><button type="submit" class="btn btn-primary" id="fpsStart"><i class="bi bi-crosshair" aria-hidden="true"></i>{t.start}</button><p class="fps-small">{t.controls}<br />{t.adsHint}</p></div>
        <div class="fps-workbench"><div class="fps-training-column">
        <div class="fps-row">
          <label>{t.game}<select name="game" id="fpsGame">{Object.entries(GAME_PROFILES).map(([id, game]) => <option value={id}>{game.name}</option>)}</select></label>
          <label>{t.weapon}<select name="weapon" id="fpsWeapon">{Object.entries(WEAPON_PROFILES).map(([id, weapon]) => <option value={id} data-game={weapon.values.game}>{weapon.name}</option>)}</select></label>
        </div>
        <div class="fps-turn"><label>{t.turnMultiplier}<span class="fps-slider"><input name="turnMultiplier" type="range" min={FPS_CONFIG.controls.turnMultiplier.min} max={FPS_CONFIG.controls.turnMultiplier.max} step={FPS_CONFIG.controls.turnMultiplier.step} value={settings.turnMultiplier} /><output data-output="turnMultiplier">{settings.turnMultiplier} ×</output></span></label><p class="fps-small">{t.turnHint}</p></div>
        <fieldset class="fps-modes"><legend>{t.mode}</legend>{Object.keys(TRAINING_MODES).map((id) => <label class="fps-mode"><input type="radio" name="mode" value={id} checked={id === settings.mode} /><span><strong>{label(id)}</strong><small>{label(id + 'Desc')}</small></span></label>)}</fieldset>
        <section id="fpsDrillBrief" class="fps-drill-brief" hidden aria-labelledby="fpsBriefName"><div class="fps-brief-diagram" aria-hidden="true"><svg viewBox="0 0 220 130"><path class="fps-diagram-lane" d="M26 103H194M110 90V113" /><path class="fps-diagram-cover" d="M75 55H145V83H75Z" /><circle class="fps-diagram-target" cx="164" cy="23" r="7" /><circle class="fps-diagram-player" cx="110" cy="102" r="8" /><path class="fps-diagram-peek" d="M110 102H174V44M167 51L174 44L181 51" /><path class="fps-diagram-strafe" d="M51 85L30 103L51 121M169 85L190 103L169 121M38 103H182M110 102V34" /></svg></div><div><span class="fps-tag">{t.drillBrief}</span><h4 id="fpsBriefName"></h4><div id="fpsBriefSteps" class="fps-drill-steps"></div><p id="fpsBriefGoal"></p></div></section>
        <fieldset id="fpsBotOptions" class="fps-details"><legend>{t.botOptions}</legend><label>{t.sector}<select name="sector">{Object.keys(FPS_CONFIG.sectors).map((id) => <option value={id}>{label(id)} ({FPS_CONFIG.sectors[id as keyof typeof FPS_CONFIG.sectors]}°)</option>)}</select></label><div class="fps-preset-row">{(['movingBots', 'infiniteAmmo', 'headOnlyBots'] as const).map((key) => <label class="fps-check"><input name={key} type="checkbox" checked={settings[key]} />{label(key)}</label>)}</div></fieldset>
        <fieldset class="fps-options"><legend>{t.settings}</legend>
          <div class="fps-row">{ranges.map((key) => { const limit = FPS_CONFIG.controls[key]; return <label>{label(key)}<span class="fps-slider"><input name={key} type="range" min={limit.min} max={limit.max} step={limit.step} value={settings[key]} /><output data-output={key}>{settings[key]} {limit.unit}</output></span></label>; })}</div>
          <div class="fps-row"><label>{t.difficulty}<select name="difficulty">{Object.keys(FPS_CONFIG.difficulties).map((id) => <option value={id} selected={id === settings.difficulty}>{label(id)}</option>)}</select></label><label>{t.quality}<select name="quality">{Object.keys(FPS_CONFIG.quality).map((id) => <option value={id}>{label(id)}</option>)}</select></label></div><p class="fps-small">{t.ballSizeHint}</p>
        </fieldset>
        </div><aside class="fps-session-column" aria-label={t.workbench}>
        <fieldset class="fps-audio-options fps-details"><legend>{t.viewAndSound}</legend>
          {(['volume', 'shotVolume', 'hitVolume'] as const).map((key) => { const limit = FPS_CONFIG.controls[key]; return <label>{label(key)}<span class="fps-slider"><input name={key} type="range" min={limit.min} max={limit.max} step={limit.step} value={settings[key]} /><output data-output={key}>{settings[key]} {limit.unit}</output></span></label>; })}
          <div class="fps-preset-row">{(['muted', 'showWeapon', 'weaponMotion'] as const).map((key) => <label class="fps-check"><input name={key} type="checkbox" checked={settings[key]} />{label(key)}</label>)}</div>
          <button type="button" class="btn btn-secondary" id="fpsTestAudio">{t.testAudio}</button><p id="fpsAudioStatus" class="fps-small" role="status" aria-live="polite"></p><p class="fps-small">{t.audioHint}</p>
        </fieldset>
        <details class="fps-details" id="fpsAdvanced"><summary>{t.advancedSettings}</summary>
          <div class="fps-row">{numbers.map((key) => { const limit = FPS_CONFIG.controls[key]; return <label>{label(key)}<input name={key} type="number" min={limit.min} max={limit.max} step={limit.step} value={settings[key]} required /></label>; })}</div>
          <label>{t.aspect}<select name="aspect">{FPS_CONFIG.aspects.map((id) => <option value={id}>{label(id)}</option>)}</select></label>
          <p class="fps-small">{t.cmHint}</p><p class="fps-small">{t.calibrateHint}</p>
          <button type="button" class="btn btn-secondary" id="fpsCalibrate">{t.calibration}</button><output id="fpsGain" class="fps-small"></output>
        </details>
        <button type="button" class="btn btn-secondary" id="fpsResetSettings">{t.resetSettings}</button>
        </aside></div>
      </form>
      <p id="fpsStatus" class="fps-message" role="status" aria-live="polite"></p>
      <p class="fps-small fps-fidelity">{t.fidelity}</p>
      <details class="fps-details"><summary>{t.sourceTitle}</summary><div id="fpsSources"></div></details>
      <div class="fps-history-head"><h3>{t.history}</h3><button type="button" class="btn btn-secondary" id="fpsClear">{t.clear}</button></div><p class="fps-small">{t.sameSetup}</p><div id="fpsHistory"></div><p class="fps-small">{t.privacy}</p>
    </section>
    <section id="fpsReport" hidden aria-labelledby="fpsReportTitle">
      <div class="fps-report-head"><h3 id="fpsReportTitle">{t.report}</h3><span id="fpsCompletion" class="fps-tag"></span></div>
      <div id="fpsMetrics" class="fps-metrics"></div>
      <section id="fpsRoundReport" class="fps-round-report" hidden><h4>{t.drillReport}</h4><p class="fps-small">{t.drillDefinition}</p><div id="fpsRoundTable" class="fps-table-wrap"></div></section>
      <figure><figcaption id="fpsImpactTitle">{t.impactTitle}</figcaption><svg id="fpsImpactChart" viewBox="0 0 400 240" role="img" aria-label={t.impactTitle}></svg><p id="fpsImpactHint" class="fps-small">{t.impactHint}</p></figure>
      <figure><figcaption>{t.timelineTitle}</figcaption><div class="fps-timeline-wrap"><svg id="fpsTimeline" viewBox="0 0 700 130" role="img" aria-label={t.timelineTitle}></svg></div><p class="fps-small">{t.timelineHint}</p></figure>
      <div class="fps-row"><button type="button" class="btn btn-primary" id="fpsAgain">{t.again}</button><button type="button" class="btn btn-secondary" id="fpsBack">{t.back}</button></div>
    </section>
    <section id="fpsStage" class="fps-stage" hidden aria-label={t.title}>
      <div class="fps-canvas-wrap"><canvas id="fpsCanvas" aria-label={t.title}></canvas><div id="fpsCrosshair" class="fps-crosshair" aria-hidden="true"></div><div id="fpsHitMarker" class="fps-hit-marker" hidden aria-hidden="true"></div><span id="fpsHitText" class="fps-hit-text" hidden aria-hidden="true"></span></div>
      <div class="fps-hud"><div class="fps-hud-mode"><strong id="fpsDrill"></strong><small id="fpsInputStatus"></small><small id="fpsAudioHud"></small></div><div class="fps-hud-stats"><div><small id="fpsTimeLabel">{t.time}</small><strong id="fpsTime">{settings.duration}</strong></div><div><small id="fpsKillsLabel">{t.kills}</small><strong id="fpsKills">0</strong></div><div><small>{t.accuracy}</small><strong id="fpsAccuracy"></strong></div></div></div>
      <div id="fpsDrillCoach" class="fps-drill-coach" hidden><div class="fps-coach-heading"><span id="fpsCoachRound"></span><strong id="fpsCoachSide"></strong></div><div id="fpsCoachSteps" class="fps-drill-steps"></div><progress id="fpsCoachProgress" max="1" value="0" aria-label={t.drillGoal}></progress><p id="fpsCoachHint"></p><strong id="fpsCoachFeedback" hidden></strong></div>
      <div class="fps-ammo"><small id="fpsGunLabel"></small><strong id="fpsAmmo"></strong><small>{t.ammo}</small><progress id="fpsReloadProgress" max="1" value="0" hidden aria-label={t.reload}></progress></div>
      <div id="fpsMovement" class="fps-movement"></div><div class="fps-key-help">{t.controls}</div>
      <div id="fpsVeil" class="fps-veil"><div class="fps-pause-card"><h3 id="fpsPauseTitle">{t.pause}</h3><p id="fpsPauseMessage"></p><button type="button" class="btn btn-primary" id="fpsResume">{t.resume}</button><div class="fps-pause-actions"><button type="button" class="btn btn-secondary" id="fpsFullscreen">{t.fullscreen}</button><button type="button" class="btn btn-secondary" id="fpsFinish">{t.finish}</button></div></div></div>
    </section>
  </div>
</ToolPanel>
<script>import '../scripts/fps/controller';</script>
<style>
  .fps-drill-brief { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding: 16px; margin-bottom: 24px; border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: linear-gradient(120deg,var(--primary-soft),var(--bg-elevated)); }
  .fps-drill-brief h4 { font-size: 1.15rem; margin: 8px 0 14px; }.fps-drill-brief p { font-size: .82rem; line-height: 1.7; margin: 14px 0 0; color: var(--text-secondary); }
  .fps-brief-diagram { display: grid; place-items: center; border-radius: var(--radius-sm); background: var(--bg-secondary); }.fps-brief-diagram svg { width: 100%; fill: none; stroke: var(--primary); stroke-width: 2; }
  .fps-diagram-cover { fill: var(--text-secondary); stroke: none; opacity: .5; }.fps-diagram-lane { stroke: var(--border-strong); }.fps-diagram-player { fill: var(--primary); }.fps-diagram-target { fill: var(--success); stroke: none; }
  [data-kind=strafe] .fps-diagram-cover, [data-kind=strafe] .fps-diagram-peek, [data-kind=peek] .fps-diagram-strafe { display: none; }
  .fps-drill-brief .fps-drill-steps { flex-wrap: wrap; }.fps-drill-steps { display: flex; align-items: center; gap: 14px; }.fps-drill-steps :global(span) { display: flex; align-items: center; gap: 7px; font-size: .72rem; white-space: nowrap; }.fps-drill-steps :global(b) { font: 600 .67rem var(--font-mono); opacity: .6; }
  .fps-drill-coach { position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%); width: min(420px,46%); padding: 16px 20px; color: var(--fps-light); background: var(--fps-hud); border: 1px solid color-mix(in srgb,var(--fps-head) 45%,transparent); border-radius: var(--radius-md); pointer-events: none; box-shadow: var(--shadow-lg); }
  .fps-coach-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; font: .78rem var(--font-mono); margin-bottom: 12px; }.fps-coach-heading span { opacity: .65; }.fps-coach-heading strong { color: var(--fps-head); }
  .fps-drill-coach .fps-drill-steps { justify-content: space-between; }.fps-drill-coach .fps-drill-steps :global(span) { color: color-mix(in srgb,var(--fps-light) 45%,transparent); }.fps-drill-coach .fps-drill-steps :global([data-active=true]) { color: var(--fps-head); }.fps-drill-coach .fps-drill-steps :global([data-done=true]) { color: var(--fps-hit); }
  .fps-drill-coach progress { width: 100%; height: 3px; accent-color: var(--fps-head); margin: 8px 0; }.fps-drill-coach p { font-size: .72rem; line-height: 1.6; margin: 0; }.fps-drill-coach > strong { display: block; padding-top: 8px; font-size: .76rem; color: var(--fps-head); }.fps-drill-coach > strong[data-result=success] { color: var(--fps-hit); }
  .fps-round-report { margin: 22px 0; padding: 18px; background: var(--bg-secondary); border-radius: var(--radius-md); }.fps-round-report h4 { margin: 0; }.fps-table-wrap { overflow-x: auto; }.fps-table-wrap :global(table) { width: 100%; white-space: nowrap; }
  @media(max-width:700px) { .fps-drill-brief { grid-template-columns: 1fr; padding: 16px; }.fps-brief-diagram { display: none; }.fps-drill-coach { bottom: 96px; width: 65%; padding: 12px; } }
  .fps { min-width: 0; }
  .fps-preset-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 14px 0 0; }
  .fps-turn { border-left: 3px solid var(--primary); padding: 10px 14px; margin-bottom: 22px; background: var(--bg-secondary); }
  .fps [hidden] { display: none !important; }
  .fps-intro { padding: 10px 0 22px; border-bottom: 1px solid var(--border); margin-bottom: 22px; }
  .fps-tag { color: var(--primary-dark); font: 700 .75rem var(--font-mono); letter-spacing: .08em; }
  .fps-intro h3 { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.3; margin: 12px 0; }
  .fps-intro p { color: var(--text-secondary); margin: 0; }
  .fps-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 16px; }
  label { display: flex; flex-direction: column; gap: 7px; font-size: .88rem; min-width: 0; }
  select, input[type=number] { width: 100%; min-width: 0; padding: 10px; border: 1px solid var(--border-strong); background: var(--bg-elevated); color: var(--text); border-radius: var(--radius-sm); font: inherit; }
  input[type=range] { width: 100%; accent-color: var(--primary); }
  fieldset { border: 0; padding: 0; margin: 0 0 22px; min-width: 0; }
  legend { font-weight: 700; margin-bottom: 12px; }
  .fps-modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .fps-modes legend { float: none; width: 100%; }
  .fps-mode { flex-direction: row; padding: 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; }
  .fps-mode:has(input:checked) { border-color: var(--primary); background: var(--primary-soft); }
  .fps-mode input { accent-color: var(--primary); margin-top: 4px; }
  .fps-mode strong { display: block; margin-bottom: 4px; }
  .fps-mode small { color: var(--text-secondary); font-size: .78rem; line-height: 1.5; display: block; }
  .fps-slider { display: flex; gap: 10px; align-items: center; }
  .fps-slider output { min-width: 62px; font: .8rem var(--font-mono); text-align: right; }
  .fps-small { font-size: .78rem; color: var(--text-secondary); line-height: 1.6; }
  .fps-details { margin-bottom: 22px; padding: 14px; background: var(--bg-secondary); border-radius: var(--radius-sm); }
  .fps-details summary { cursor: pointer; font-weight: 600; margin-bottom: 12px; }
  .fps-check { flex-direction: row; align-items: center; }
  .fps-check input { accent-color: var(--primary); }
  .fps-start-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .fps-start-row p { margin: 0; flex: 1; min-width: 200px; }
  .fps-message { color: var(--info); font-size: .85rem; margin: 14px 0; }
  .fps-fidelity { border-left: 3px solid var(--primary); padding-left: 12px; margin-top: 20px; }
  .fps-history-head, .fps-report-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 25px 0 12px; }
  .fps-history-head h3, .fps-report-head h3 { margin: 0; }
  .fps-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .fps-metrics :global(.fps-metric) { padding: 14px 12px; border-bottom: 2px solid var(--border); background: var(--bg-secondary); }
  .fps-metrics :global(strong) { display: block; font: 600 1.25rem var(--font-mono); margin-top: 8px; }
  .fps-metrics :global(small) { color: var(--text-secondary); font-size: .75rem; }
  figure { margin: 24px 0; }
  figcaption { font-weight: 600; margin-bottom: 12px; }
  #fpsImpactChart { width: 100%; max-height: 280px; background: var(--bg-secondary); border: 1px solid var(--border); }
  .fps-timeline-wrap { overflow-x: auto; }
  #fpsTimeline { width: 100%; min-width: 550px; background: var(--bg-secondary); }
  .fps :global(table) { font-size: .75rem; width: 100%; border-collapse: collapse; }
  .fps :global(th), .fps :global(td) { text-align: left; padding: 8px 5px; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
  #fpsSources, #fpsHistory { overflow-x: auto; }
  .fps-stage { position: fixed; inset: 0; z-index: 1000; background: #000; color: var(--text); }
  .fps-canvas-wrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  #fpsCanvas { display: block; }
  .fps-crosshair { position: absolute; left: 50%; top: 50%; width: 15px; height: 15px; transform: translate(-50%, -50%); pointer-events: none; }
  .fps-crosshair::before, .fps-crosshair::after { content: ''; position: absolute; background: var(--brand-ink); box-shadow: 0 0 2px #fff; }
  .fps-crosshair::before { height: 2px; width: 15px; top: 6px; }.fps-crosshair::after { width: 2px; height: 15px; left: 6px; }
  .fps-crosshair.hit { filter: drop-shadow(0 0 5px var(--success)); }
  .fps-hud { position: absolute; top: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; gap: 20px; padding: 12px 18px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); pointer-events: none; }
  .fps-hud strong { display: block; font: 600 1.1rem var(--font-mono); }.fps-hud small { display: block; font-size: .7rem; color: var(--text-secondary); }
  .fps-movement { position: absolute; bottom: 60px; left: 50%; transform: translateX(-50%); padding: 6px 14px; background: var(--bg-elevated); border-radius: var(--radius-full); font: .8rem var(--font-mono); pointer-events: none; }
  .fps-key-help { position: absolute; bottom: 16px; left: 16px; right: 16px; text-align: center; font-size: .75rem; padding: 8px; background: var(--bg-elevated); pointer-events: none; }
  .fps-veil { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0,0,0,.42); }
  .fps-pause-card { max-width: 520px; margin: 20px; background: var(--bg-elevated); border: 1px solid var(--border); padding: 28px; border-radius: var(--radius-lg); text-align: center; }
  .fps-pause-card p { font-size: .9rem; color: var(--text-secondary); }.fps-pause-actions { display: flex; gap: 12px; justify-content: center; margin-top: 16px; }
  .fps :is(button, input, select, summary):focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; }
  .fps-intro { display: grid; grid-template-columns: minmax(0, 1fr) 220px; align-items: center; gap: 24px; padding: 8px 0 24px; }
  .fps-range-sketch { width: 100%; height: auto; color: var(--fps-ball); }
  .fps-range-sketch path { fill: none; stroke: var(--border-strong); stroke-width: 1.5; }
  .fps-range-sketch circle { fill: currentColor; }
  .fps-range-sketch .fps-sketch-aim { stroke: var(--primary); stroke-width: 2; }
  .fps-quick .fps-preset-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 0; }
  .fps-preset { display: flex; flex-direction: column; align-items: flex-start; text-align: left; white-space: normal; padding: 18px; border-top: 3px solid var(--primary); min-height: 104px; }
  .fps-preset[data-active=true] { background: var(--primary-soft); border-color: var(--primary); }
  .fps-preset strong { font-size: .92rem; }
  .fps-preset small { font-size: .75rem; font-weight: 400; color: var(--text-secondary); line-height: 1.5; }
  .fps-workbench { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr); align-items: start; gap: 24px; }
  .fps-training-column, .fps-session-column { min-width: 0; }
  .fps-session-column { border-left: 1px solid var(--border); padding-left: 24px; }
  .fps-start-row { padding-bottom: 24px; margin-bottom: 28px; border-bottom: 1px solid var(--border); }
  .fps-start-row #fpsStart { min-width: 220px; justify-content: center; padding: 14px 24px; font-size: 1rem; }
  .fps-start-row p { min-width: 0; }
