---
import DailyToolData from './DailyToolData.astro';
import { dailyText } from '../lib/daily-tool-i18n';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = dailyText(lang);
---
<DailyToolData lang={lang} />
<div class="daily-composition age-composition">
  <section class="daily-surface" aria-labelledby="ageHeading">
    <div class="daily-section-head"><h2 id="ageHeading">{t.parameters}</h2><span class="daily-live"><span aria-hidden="true"></span>{t.live}</span></div><form id="ageForm" novalidate><div class="field"><label class="field-label" for="ageBirth">{t.birthDate}</label><input class="input" id="ageBirth" type="date" min="0001-01-01" max="9999-12-31" /></div><div class="field"><label class="field-label" for="ageAt">{t.ageAt}</label><input class="input" id="ageAt" type="date" min="0001-01-01" max="9999-12-31" /></div><div class="btn-row"><button class="btn btn-primary" id="ageBtn" type="submit">{t.calculate}</button></div><div class="status-msg" id="ageStatus" role="status" aria-live="polite"></div></form><p class="daily-note">{t.calendarPolicy}</p><p class="daily-note">{t.agePolicy}</p>
  </section>
  <section class="daily-result age-result" id="ageResult" aria-labelledby="ageResultHeading"><h2 class="daily-eyebrow" id="ageResultHeading">{t.ageYears}</h2><div class="age-number"><output class="daily-number" id="ageYears">—</output><span>{t.years}</span></div><p class="age-span" id="ageSpan"></p><dl class="age-facts"><div><dt>{t.livedDays}</dt><dd><strong id="ageLived">—</strong> {t.days}</dd></div><div><dt>{t.untilBirthday}</dt><dd><strong id="ageBirthdayDays">—</strong> {t.days}</dd></div><div><dt>{t.nominalAge}</dt><dd><strong id="ageNominal">—</strong> {t.years}</dd></div></dl><p class="daily-note">{t.nominalHint}</p><div class="birthday-timeline"><div class="daily-section-head"><span>{t.nextBirthday}</span><strong id="ageBirthdayLabel">—</strong></div><progress id="ageBirthdayProgress" max="1" value="0" aria-label={t.ageProgress}></progress><time id="ageBirthdayDate"></time></div><div class="daily-result-actions"><button class="btn btn-secondary" id="ageCopy" type="button" disabled><i class="bi bi-clipboard" aria-hidden="true"></i> {t.copy}</button></div></section>
</div>
<script>
  import '../scripts/age-calculator';
</script>
