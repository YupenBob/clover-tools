---
import chineseS2t from 'chinese-s2t';
import type { ToolDetail } from '../lib/tool-content';
import type { Guide } from '../lib/guides';
import type { Lang } from '../lib/i18n';

interface Props { detail: ToolDetail; guides: Guide[]; toolName: string; lang: Lang; }
const { detail, guides, toolName, lang } = Astro.props;
const copy = {
  "eyebrow": "CloverTools 实用指南",
  "title": "从问题到结果：",
  "suffix": "怎么用",
  "badge": "工具使用说明",
  "steps": "使用步骤",
  "privacy": "隐私说明",
  "examples": "输入与输出示例",
  "input": "输入",
  "result": "结果",
  "principles": "原理与边界",
  "pitfalls": "常见误区",
  "faq": "常见问题",
  "reading": "延伸阅读"
};
const labels = Object.fromEntries(Object.entries(copy).map(([key, value]) => [key,
  lang === 'tw' ? chineseS2t.s2t(value) : value,
])) as typeof copy;
---

    <section class="tool-guide" aria-labelledby="guide-heading">
      <div class="guide-heading-row">
        <div>
          <p class="guide-eyebrow">{labels.eyebrow}</p>
          <h2 id="guide-heading" class="guide-title">{labels.title}{toolName}{labels.suffix}</h2>
        </div>
        <span class="guide-badge"><i class="bi bi-shield-check" aria-hidden="true"></i> {labels.badge}</span>
      </div>
      <p class="guide-intro">{detail.intro}</p>

      <div class="guide-grid guide-grid-two">
        <div class="guide-block">
          <h3><span class="guide-index">01</span> {labels.steps}</h3>
          <ol class="guide-steps">
            {detail.steps.map((step) => <li>{step}</li>)}
          </ol>
        </div>
        <div class="guide-block guide-privacy">
          <h3><i class="bi bi-lock" aria-hidden="true"></i> {labels.privacy}</h3>
          <p>{detail.privacy}</p>
        </div>
      </div>

      <div class="guide-block">
        <h3><span class="guide-index">02</span> {labels.examples}</h3>
        <div class="example-grid">
          {detail.examples.map((example) => (
            <article class="example-card">
              <h4>{example.label}</h4>
              <div class="example-pane">
                <span>{labels.input}</span>
                <pre><code>{example.input}</code></pre>
              </div>
              <div class="example-pane example-output">
                <span>{labels.result}</span>
                {example.outputFormat === 'code'
                  ? <pre><code>{example.output}</code></pre>
                  : <p>{example.output}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="guide-grid guide-grid-two">
        <div class="guide-block">
          <h3><span class="guide-index">03</span> {labels.principles}</h3>
          <ul class="guide-list">
            {detail.principles.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="guide-block guide-pitfalls">
          <h3><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {labels.pitfalls}</h3>
          <ul class="guide-list">
            {detail.pitfalls.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="guide-block faq-block">
        <h3><span class="guide-index">04</span> {labels.faq}</h3>
        <div class="faq-list">
          {detail.faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      {guides.length > 0 && (
        <div class="related-guides">
          <h3><i class="bi bi-journal-text" aria-hidden="true"></i> {labels.reading}</h3>
          {guides.map((guide) => <a href={`/guides/${guide.slug}/`}>{guide.title}<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>)}
        </div>
      )}
    </section>

<style>
  .tool-guide {
    margin-top: var(--space-7);
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(var(--primary-rgb), 0.08), transparent 42%),
      var(--bg-elevated);
    box-shadow: var(--shadow-md);
  }

  .guide-heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .guide-eyebrow {
    margin: 0 0 6px;
    color: var(--primary-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guide-title {
    margin: 0;
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.3;
  }

  .guide-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border: 1px solid rgba(var(--primary-rgb), 0.32);
    border-radius: var(--radius-full);
    background: var(--primary-soft);
    color: var(--primary-dark);
    font-size: 12px;
    white-space: nowrap;
  }

  .guide-intro {
    max-width: 820px;
    margin: 0 0 var(--space-6);
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.9;
  }

  .guide-grid {
    display: grid;
    gap: var(--space-5);
  }

  .guide-grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .guide-block {
    margin-top: var(--space-5);
  }

  .guide-block h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-3);
    color: var(--text);
    font-size: 16px;
  }

  .guide-index {
    display: inline-grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 9px;
    background: var(--brand-ink);
    color: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .guide-steps,
  .guide-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 22px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .guide-steps li::marker {
    color: var(--primary-dark);
    font-weight: 700;
  }

  .guide-privacy,
  .guide-pitfalls {
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .guide-privacy p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .example-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .example-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  .example-card h4 {
    margin: 0;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  .example-pane {
    padding: 11px 14px;
  }

  .example-pane + .example-pane {
    border-top: 1px dashed var(--border);
  }

  .example-pane > span {
    display: block;
    margin-bottom: 6px;
    color: var(--text-tertiary);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .example-pane pre {
    overflow-x: auto;
    margin: 0;
    color: var(--text);
    font: 12px/1.6 var(--font-mono);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .example-output p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  .faq-list {
    display: grid;
    gap: 8px;
  }

  .faq-list details {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .faq-list summary {
    cursor: pointer;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
  }

  .faq-list details p {
    margin: 9px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.7;
  }

  .related-guides {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border-strong);
  }

  .related-guides h3 {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 4px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .related-guides a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--primary-dark);
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .guide-heading-row,
    .guide-grid-two,
    .example-grid {
      grid-template-columns: 1fr;
    }

    .guide-heading-row {
      display: grid;
    }

    .guide-badge {
      justify-self: start;
    }
  }

</style>
