---
import { pathForLang, type Lang } from '../lib/i18n';
import { examText } from '../lib/exam-clock-i18n';
import '../styles/exam-clock.css';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = examText(lang);
---
<div class="exam-clock" id="examClock" data-lang={lang} data-phase="normal" data-theme="site">
  <script type="application/json" id="examClockText" set:html={JSON.stringify(t).replaceAll('<', '\\u003c')} />
  <section class="ec-stage" aria-label={t.title}>
    <div class="ec-controls" id="ecControls">
      <span class="ec-zone">{t.zone}</span>
      <div class="ec-actions">
        <button type="button" class="btn btn-secondary" id="ecFullscreen" aria-keyshortcuts="F">{t.fullscreen}</button>
        <button type="button" class="btn btn-secondary" id="ecSettingsToggle" aria-controls="ecSettings" aria-expanded="true" aria-keyshortcuts="S">{t.settings}</button>
      </div>
    </div>
    <div class="ec-readout">
      <p class="ec-name" id="ecName">{t.title}</p>
      <div class="ec-clock" role="timer" aria-live="off"><time id="ecTime">—</time><span id="ecPeriod" class="ec-period"></span></div>
      <p class="ec-date" id="ecDate"></p>
      <p class="ec-exam-status" id="ecExamStatus">{t.empty}</p>
      <div id="ecCountdownArea" hidden>
        <p id="ecRemainingLabel"></p><output id="ecRemaining" class="ec-remaining" role="timer" aria-live="off">00:00:00</output>
        <p id="ecHumanRemaining"></p>
        <progress id="ecProgress" max="1" value="0" aria-label={t.progress}></progress>
        <p id="ecSchedule" class="ec-schedule"></p>
      </div>
    </div>
    <footer class="ec-footer">
      <div><strong id="ecSource">{t.local}</strong> <button type="button" class="btn btn-ghost" id="ecSync" aria-keyshortcuts="R">{t.sync}</button></div>
      <p id="ecSourceDetail">{t.localHint}</p>
      <p id="ecAdjustment"></p><p id="ecCompatibility"></p>
      <p id="ecWakeStatus">{t.wakeOff}</p>
      <p id="ecFullscreenNote"></p>
    </footer>
  </section>
  <aside class="ec-settings" id="ecSettings" aria-labelledby="ecSettingsHeading">
    <div class="ec-settings-head"><h2 id="ecSettingsHeading">{t.settings}</h2><button class="btn btn-ghost" type="button" id="ecCloseSettings">{t.close}</button></div>
    <form id="ecForm" novalidate>
      <p class="ec-note">{t.timeHint}</p>
      <div id="ecErrorSummary" role="alert" tabindex="-1" hidden></div>
      <fieldset id="ecExamFields">
        <div class="ec-field"><label for="ecInputName">{t.name}</label><input class="input" id="ecInputName" type="text" autocomplete="off" aria-describedby="ecErrorName" /><span class="ec-error" id="ecErrorName"></span></div>
        <div class="ec-field"><label for="ecStart">{t.start}</label><input class="input" id="ecStart" type="datetime-local" step="1" min="2000-01-01T00:00:00" max="2099-12-31T23:59:59" aria-describedby="ecErrorStart" /><span class="ec-error" id="ecErrorStart"></span></div>
        <div class="ec-field"><label for="ecMode">{t.editMode}</label><select class="input" id="ecMode"><option value="end">{t.byEnd}</option><option value="duration">{t.byDuration}</option></select></div>
        <div class="ec-field"><label for="ecEnd">{t.end}</label><input class="input" id="ecEnd" type="datetime-local" step="1" min="2000-01-01T00:00:00" max="2099-12-31T23:59:59" aria-describedby="ecErrorEnd" /><span class="ec-error" id="ecErrorEnd"></span></div>
        <div class="ec-field"><span id="ecDurationLabel">{t.duration}</span><div class="ec-duration" role="group" aria-labelledby="ecDurationLabel">{[['Hours',t.hours,23],['Minutes',t.minutes,59],['Seconds',t.seconds,59]].map(([id,label,max]) => <label for={`ec${id}`}>{label}<input class="input" type="number" id={`ec${id}`} min="0" max={max} step="1" aria-describedby="ecErrorDuration" /></label>)}</div><span class="ec-error" id="ecErrorDuration"></span></div>
        <fieldset class="ec-thresholds"><legend>{t.thresholds}</legend>{[30,15,5,1].map(m => <label><input type="checkbox" data-threshold={m} checked /> {m}</label>)}</fieldset>
        <div class="ec-actions"><button class="btn btn-primary" type="submit" id="ecEnable">{t.enable}</button><button class="btn btn-ghost" type="button" id="ecExample">{t.example}</button></div>
      </fieldset>
      <p id="ecLocked" hidden>{t.locked}</p>
      <div class="ec-actions"><button class="btn btn-secondary" type="button" id="ecReset" disabled>{t.reset}</button><button class="btn btn-ghost" type="button" id="ecCopy" disabled>{t.copy}</button></div>
      <div id="ecManualCopy" hidden><label for="ecCopyText">{t.manualCopy}</label><textarea class="input" id="ecCopyText" readonly rows="4"></textarea></div>
    </form>
    <details class="ec-presets" open><summary>{t.presets}</summary>
      <label for="ecPresets">{t.selectPreset}</label><select class="input" id="ecPresets"><option value="">{t.selectPreset}</option></select>
      <div class="ec-actions"><button type="button" class="btn btn-secondary" id="ecSaveNew">{t.saveNew}</button><button type="button" class="btn btn-ghost" id="ecUpdate" disabled>{t.update}</button><button type="button" class="btn btn-ghost" id="ecLoad" disabled>{t.load}</button><button type="button" class="btn btn-ghost" id="ecDelete" disabled>{t.delete}</button></div><p id="ecPresetLimit"></p>
    </details>
    <fieldset><legend>{t.display}</legend>
      <label class="ec-check"><input type="checkbox" id="ecHour12" /> {t.hour12}</label><label class="ec-check"><input type="checkbox" id="ecShowSeconds" checked /> {t.showSeconds}</label>
      <div class="ec-field"><label for="ecScale">{t.scale}</label><select class="input" id="ecScale">{[80,100,120,140].map(n => <option value={n} selected={n===100}>{n}%</option>)}</select></div>
      <div class="ec-field"><label for="ecTheme">{t.theme}</label><select class="input" id="ecTheme"><option value="site">{t.site}</option><option value="light">{t.light}</option><option value="dark">{t.dark}</option></select></div>
      <label class="ec-check"><input type="checkbox" id="ecContrast" /> {t.contrast}</label>
    </fieldset>
    <fieldset><legend>{t.sound}</legend><label class="ec-check"><input type="checkbox" id="ecSound" /> {t.sound}</label><p id="ecSoundStatus">{t.soundEnable}</p><button class="btn btn-secondary" type="button" id="ecEnableSound">{t.soundEnable}</button>
      <div class="ec-field"><label for="ecVolume">{t.volume}</label><input type="range" id="ecVolume" min="0" max="100" value="25" /></div>
      <div class="ec-actions"><button class="btn btn-secondary" type="button" id="ecTestSound">{t.testSound}</button><button class="btn btn-ghost" type="button" id="ecPauseSound" aria-pressed="false" aria-keyshortcuts="Space">{t.pauseSound}</button></div>
    </fieldset>
    <label class="ec-check"><input id="ecWake" type="checkbox" /> {t.wake}</label><button class="btn btn-ghost" type="button" id="ecRetryWake">{t.retryWake}</button>
    <button class="btn btn-ghost" type="button" id="ecClear">{t.clear}</button>
    <p class="ec-note">{t.shortcuts}</p>
  </aside>
  <div class="ec-messages" role="status" aria-live="polite" id="ecNotice"></div>
  <p class="ec-storage" id="ecStorageNotice" role="status"></p>
</div>
<p class="ec-privacy">{t.privacy}</p>
<nav class="ec-tool-links" aria-label={t.title}>{[['timer',t.timerLink],['world-clock',t.worldLink],['calendar',t.calendarLink]].map(([slug,label]) => <a href={pathForLang(`/tools/daily/${slug}/`,lang)}>{label}</a>)}</nav>
<noscript><p>{t.noScript}</p></noscript>
<script>import '../scripts/exam-clock';</script>
