---
import Icon from './Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabel, type GuideLabels } from '../lib/guide-labels';
import {
  GUIDE_LANG_PREFIX,
  guideDefaultHref,
  guideIndexPath,
  guidePath,
  type GuideLang,
} from '../lib/guides-i18n';
import type { Guide } from '../lib/guides';
import { HTML_LANG, type Lang } from '../lib/i18n';
import { SITE } from '../lib/site';

interface Props {
  guide: Guide;
  lang: Lang;
  toolHref: string;
  toolName: string;
  labels: GuideLabels;
  languageLinks: { locale: Lang; href: string }[];
  /** Absolute hreflang entries; derived from `languageLinks` when omitted. */
  alternates?: { locale: Lang; href: string }[];
  indexable?: boolean;
}

const {
  guide,
  lang,
  toolHref,
  toolName,
  labels,
  languageLinks,
  alternates,
  indexable = true,
} = Astro.props;

const guideLang = lang as GuideLang;
const homeHref = `${GUIDE_LANG_PREFIX[guideLang]}/`;
const canonical = `${SITE.url}${guidePath(guide.slug, guideLang)}`;

const absoluteAlternates = (alternates ?? languageLinks.map(({ locale, href }) => ({ locale, href: `${SITE.url}${href}` }))).slice();
// x-default 固定为简体原文。
if (!absoluteAlternates.some((entry) => entry.locale === 'zh')) {
  absoluteAlternates.push({ locale: 'zh', href: guideDefaultHref(guide.slug) });
}

const headings: { id: string; label: string }[] = [];
const content = guide.content.replace(/<h2>([\s\S]*?)<\/h2>/g, (_match, label: string) => {
  const id = `section-${headings.length + 1}`;
  headings.push({ id, label });
  return `<h2 id="${id}">${label}</h2>`;
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    dateModified: guide.updated,
    datePublished: guide.published,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: canonical,
    inLanguage: HTML_LANG[lang],
    ...(guide.image ? { image: `${SITE.url}${guide.image}` } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: labels.breadcrumbHome, item: `${SITE.url}${homeHref}` },
      { '@type': 'ListItem', position: 2, name: labels.breadcrumbGuides, item: `${SITE.url}${guideIndexPath(guideLang)}` },
      { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={`${guide.title} - ${SITE.name}`} description={guide.description} keywords={[guide.title, categoryLabel(guide.category, lang), 'CloverTools']} canonical={canonical} ogImage={guide.image ? `${SITE.url}${guide.image}` : undefined} jsonLd={jsonLd} indexable={indexable} alternates={absoluteAlternates} languageLinks={languageLinks}>
  <nav class="breadcrumb" aria-label={labels.breadcrumbAria}>
    <a href={homeHref}><Icon name="house-door" /> {labels.breadcrumbHome}</a>
    <Icon name="chevron-right" />
    <a href={guideIndexPath(guideLang)}>{labels.breadcrumbGuides}</a>
    <Icon name="chevron-right" />
    <span>{guide.title}</span>
  </nav>

  <article class="guide-article">
    <header class="article-hero">
      <div class="article-meta"><span>{categoryLabel(guide.category, lang)}</span><span>{guide.readingMinutes} {labels.minutesRead}</span><time datetime={guide.published}>{labels.published} {guide.published}</time>{guide.updated !== guide.published && <time datetime={guide.updated}>{labels.updated} {guide.updated}</time>}</div>
      <h1>{guide.title}</h1>
      <p>{guide.description}</p>
      <a class="article-tool-link" href={toolHref}><Icon name="play-circle" /> {labels.toolLinkPrefix} {toolName} <Icon name="arrow-up-right" /></a>
    </header>

    {lang !== 'zh' && (
      <p class="article-translation-note">{labels.translationNote} <a href={guidePath(guide.slug, 'zh')}>{labels.readOriginal}</a></p>
    )}

    <div class="article-layout">
      <div class="article-content" set:html={content}></div>
      <aside class="article-aside">
        {headings.length > 0 && <nav class="aside-card article-toc" aria-label={labels.toc}><p class="aside-label">{labels.toc}</p><ol>{headings.map(heading => <li><a href={`#${heading.id}`} set:html={heading.label}></a></li>)}</ol></nav>}
        <div class="aside-card">
          <p class="aside-label">{labels.focus}</p>
          <p>{guide.focus ?? labels.focusFallback}</p>
        </div>
        <div class="aside-card aside-verify">
          <p class="aside-label">{labels.verify}</p>
          <p set:html={labels.verifyText(guide.sources.length, guide.updated)}></p>
        </div>
        <div class="aside-card aside-local">
          <Icon name="shield-lock" />
          <p>{guide.notice ?? labels.local}</p>
        </div>
      </aside>
    </div>

    {guide.faqs.length > 0 && <section class="article-faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{labels.faq}</h2>
      {guide.faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </section>}

    <section class="article-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">{labels.sources}</h2>
      <ul>
        {guide.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></li>
        ))}
      </ul>
    </section>

    <footer class="article-footer">
      <a href={toolHref}><Icon name="arrow-left" /> {labels.backToTool}</a>
      <a href={guideIndexPath(guideLang)}>{labels.browseGuides} <Icon name="arrow-right" /></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-sources { margin-top: var(--space-6); padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); }
  .article-sources h2 { margin: 0 0 var(--space-3); font-size: 18px; }
  .article-sources ul { margin: 0; padding-left: 20px; line-height: 1.8; }
  .article-sources a { color: var(--primary-dark); overflow-wrap: anywhere; }
  .guide-article { max-width: 1000px; margin: 0 auto var(--space-8); }
  .article-hero { padding: clamp(28px, 6vw, 56px); border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--primary-soft), transparent 52%), var(--bg-elevated); box-shadow: var(--shadow-sm); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 13px; color: var(--text-tertiary); font-size: 12px; }
  .article-meta span:first-child { color: var(--primary-dark); font-weight: 700; }
  .article-hero h1 { max-width: 780px; margin: 18px 0 14px; font-size: clamp(30px, 5vw, 48px); letter-spacing: -.025em; line-height: 1.18; }
  .article-hero > p { max-width: 720px; margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.85; }
  .article-tool-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 25px; padding: 10px 14px; border-radius: var(--radius-full); background: var(--brand-ink); color: var(--bg-elevated); font-size: 13px; font-weight: 700; }
  .article-translation-note { margin: 20px 0 0; padding: 11px 15px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-secondary); color: var(--text-tertiary); font-size: 12px; line-height: 1.7; }
  .article-translation-note a { color: var(--primary-dark); }
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 36px; margin-top: 42px; }
  .article-content { min-width: 0; color: var(--text-secondary); font-size: 15px; line-height: 1.9; }
  .article-content :global(h2) { margin: 34px 0 10px; color: var(--text); font-size: 22px; line-height: 1.35; }
  .article-content :global(h2) { scroll-margin-top: 100px; }
  .article-content :global(p), .article-content :global(li), .article-hero h1 { overflow-wrap: anywhere; }
  .article-content :global(p) { margin: 0 0 16px; }
  .article-content :global(ol), .article-content :global(ul) { display: grid; gap: 8px; margin: 0 0 18px; padding-left: 24px; }
  .article-content :global(li)::marker { color: var(--primary-dark); font-weight: 700; }
  .article-content :global(code) { padding: 2px 5px; border-radius: 5px; background: var(--bg-secondary); color: var(--brand-ink); font: 0.9em var(--font-mono); }
  .article-content :global(h3) { margin: 26px 0 8px; color: var(--text); font-size: 18px; line-height: 1.5; }
  .article-content :global(a) { color: var(--primary-dark); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .article-content :global(pre) { max-width: 100%; overflow-x: auto; padding: 18px; margin: 20px 0; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-secondary); line-height: 1.65; tab-size: 2; }
  .article-content :global(pre code) { padding: 0; border-radius: 0; background: none; }
  .article-content :global(figure) { margin: 28px 0; }
  .article-content :global(figure a) { display: block; }
  .article-content :global(figure img) { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-secondary); }
  .article-content :global(figure figcaption) { margin-top: 9px; color: var(--text-tertiary); font-size: 12px; line-height: 1.75; }
  .article-content :global(.article-table) { max-width: 100%; overflow-x: auto; margin: 22px 0; }
  .article-content :global(table) { width: 100%; border-collapse: collapse; font-size: 13px; line-height: 1.7; }
  .article-content :global(th), .article-content :global(td) { min-width: 100px; padding: 10px; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  .article-content :global(th) { color: var(--text); background: var(--bg-secondary); }
  .article-content :global(.article-callout) { padding: 16px 18px; border-left: 3px solid var(--primary); background: var(--primary-soft); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .article-aside { display: grid; align-content: start; gap: 14px; }
  .aside-card { padding: 17px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated); }
  .aside-card p { margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
  .aside-card .aside-label { margin-bottom: 8px; color: var(--text); font-weight: 700; }
  .article-toc ol { display: grid; gap: 9px; margin: 0; padding-left: 17px; font-size: 12px; line-height: 1.65; }
  .article-toc a { color: var(--text-secondary); }
  .article-toc a:hover { color: var(--primary-dark); text-decoration: underline; }
  .aside-local { display: flex; gap: 9px; background: var(--bg-secondary); }
  .aside-local .icon { flex-shrink: 0; color: var(--primary-dark); }
  .aside-verify a { color: var(--primary-dark); }
  .article-faq { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--border-strong); }
  .article-faq h2 { margin: 0 0 14px; font-size: 22px; }
  .article-faq details { padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .article-faq summary { cursor: pointer; color: var(--text); font-weight: 600; }
  .article-faq details p { margin: 10px 0 0; color: var(--text-secondary); font-size: 14px; line-height: 1.75; }
  .article-footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px dashed var(--border-strong); font-size: 13px; }
  .article-footer a { color: var(--primary-dark); }
  @media (max-width: 780px) { .article-layout { display: flex; flex-direction: column; gap: 18px; margin-top: 30px; } .article-aside { display: contents; } .article-toc { order: -1; } .article-toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 25px; } }
  @media (max-width: 520px) { .article-toc ol { grid-template-columns: 1fr; } .article-footer { flex-direction: column; } .breadcrumb { flex-wrap: wrap; row-gap: 6px; } .breadcrumb > a { white-space: nowrap; flex-shrink: 0; } .breadcrumb > span { flex-basis: 100%; } .breadcrumb > .icon:last-of-type { display: none; } }
</style>
