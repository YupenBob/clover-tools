---
import { ADSENSE_CLIENT, canServeAds, getAdSlot, type AdSlotKey } from '../lib/ads';
import { langFromUrl } from '../lib/i18n';

interface Props {
  adSlot: AdSlotKey;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  className?: string;
}

const { adSlot, format = 'horizontal', className = '' } = Astro.props;
const slotId = canServeAds(Astro.url.pathname) ? getAdSlot(adSlot) : null;
const label = { zh: '广告', tw: '廣告', en: 'Advertisement', ko: '광고', ja: '広告' }[langFromUrl(Astro.url.pathname)];
const classNames = ['ad-slot', `ad-slot--${format}`, className].filter(Boolean).join(' ');
---

{slotId && (
  <div class={classNames}>
    <span class="ad-label">{label}</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (function () {
        var el = document.currentScript.parentElement;
        var done = false;
        function schedulePush() {
          var tries = 0;
          function attempt() {
            if (done) return;
            if (el.offsetParent === null || el.clientWidth <= 0) {
              if (tries++ < 30) requestAnimationFrame(attempt);
              return;
            }
            done = true;
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          }
          requestAnimationFrame(attempt);
        }
        schedulePush();
        window.addEventListener('load', schedulePush);
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  schedulePush();
                  io.disconnect();
                  break;
                }
              }
            },
            { rootMargin: '200px' },
          );
          io.observe(el);
        }
      })();
    </script>
  </div>
)}

<style>
  .ad-slot {
    min-height: 100px;
    display: block;
    align-items: center;
    justify-content: center;
    margin: var(--space-5) 0;
  }
  .ad-label { display: block; text-align: center; color: var(--text-tertiary); font-size: 11px; margin-bottom: 8px; }

  .ad-slot ins {
    display: block;
    width: 100%;
  }

  .ad-slot--rectangle {
    min-height: 250px;
  }

  .ad-slot--vertical {
    min-height: 600px;
  }
</style>
