---
import { ADSENSE_CLIENT, getAdSlot, type AdSlotKey } from '../lib/ads';

interface Props {
  adSlot: AdSlotKey;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  className?: string;
}

const { adSlot, format = 'horizontal', className = '' } = Astro.props;
const slotId = getAdSlot(adSlot);
const classNames = ['ad-slot', `ad-slot--${format}`, className].filter(Boolean).join(' ');
---

{slotId && (
  <div class={classNames}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (function () {
        var el = document.currentScript.parentElement;
        var done = false;
        function schedulePush() {
          var tries = 0;
          function attempt() {
            if (done) return;
            if (el.offsetParent === null || el.clientWidth <= 0) {
              if (tries++ < 30) requestAnimationFrame(attempt);
              return;
            }
            done = true;
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          }
          requestAnimationFrame(attempt);
        }
        schedulePush();
        window.addEventListener('load', schedulePush);
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  schedulePush();
                  io.disconnect();
                  break;
                }
              }
            },
            { rootMargin: '200px' },
          );
          io.observe(el);
        }
      })();
    </script>
  </div>
)}

<style>
  .ad-slot {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-5) 0;
    overflow: hidden;
  }

  .ad-slot ins {
    display: block;
    width: 100%;
  }

  .ad-slot--rectangle {
    min-height: 250px;
  }

  .ad-slot--vertical {
    min-height: 600px;
  }
</style>
