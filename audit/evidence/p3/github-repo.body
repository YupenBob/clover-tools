s.cn\u003c/strong\u003e\u003c/a\u003e ·\n  \u003ca href=\"https://github.com/YupenBob/clover-tools\"\u003e\u003cstrong\u003eGitHub 仓库\u003c/strong\u003e\u003c/a\u003e\n\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca href=\"https://clovertools.cn\" rel=\"nofollow\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/13908a04ac791c6d1734b15d8c6754a1235d8c7df6cf9b52daacc720bc5108bc/68747470733a2f2f696d672e736869656c64732e696f2f776562736974653f75726c3d6874747073253341253246253246636c6f766572746f6f6c732e636e266c6162656c3d7765627369746526636f6c6f723d676f6c64267374796c653d666c61742d737175617265\" alt=\"Website\" data-canonical-src=\"https://img.shields.io/website?url=https%3A%2F%2Fclovertools.cn\u0026amp;label=website\u0026amp;color=gold\u0026amp;style=flat-square\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n  \u003ca href=\"https://github.com/YupenBob/clover-tools\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/262eeb2be78192989bb649fec79850d8450308466d8e9e40a3f8a5c0f5cc8d1a/68747470733a2f2f696d672e736869656c64732e696f2f6769746875622f73746172732f597570656e426f622f636c6f7665722d746f6f6c733f6c6162656c3d737461727326636f6c6f723d676f6c64267374796c653d666c61742d737175617265\" alt=\"GitHub stars\" data-canonical-src=\"https://img.shields.io/github/stars/YupenBob/clover-tools?label=stars\u0026amp;color=gold\u0026amp;style=flat-square\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n  \u003ca href=\"https://github.com/YupenBob/clover-tools\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/6c5f2d8ed5564a4e614604f8efbb4f89333818a108bd68b367a9077b0b303433/68747470733a2f2f696d672e736869656c64732e696f2f6769746875622f6c6173742d636f6d6d69742f597570656e426f622f636c6f7665722d746f6f6c733f6c6162656c3d6c617374253230636f6d6d697426636f6c6f723d676f6c64267374796c653d666c61742d737175617265\" alt=\"Last commit\" data-canonical-src=\"https://img.shields.io/github/last-commit/YupenBob/clover-tools?label=last%20commit\u0026amp;color=gold\u0026amp;style=flat-square\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n  \u003ca href=\"https://astro.build\" rel=\"nofollow\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/dacac62ba6b60537a0fd9aaf3e45557ab22d275c79f4dc1ee96b0c2ed56e1c07/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f417374726f2d352d676f6c643f7374796c653d666c61742d737175617265266c6f676f3d617374726f266c6f676f436f6c6f723d7768697465\" alt=\"Astro 5\" data-canonical-src=\"https://img.shields.io/badge/Astro-5-gold?style=flat-square\u0026amp;logo=astro\u0026amp;logoColor=white\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n  \u003ca href=\"https://pages.cloudflare.com\" rel=\"nofollow\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/50862d7e94df48534aee10f914bcc374fd6e8aa7ef4d625a1890f7e3106f8cd5/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f436c6f7564666c61726525323050616765732d6465706c6f7965642d676f6c643f7374796c653d666c61742d737175617265266c6f676f3d636c6f7564666c617265266c6f676f436f6c6f723d7768697465\" alt=\"Cloudflare Pages\" data-canonical-src=\"https://img.shields.io/badge/Cloudflare%20Pages-deployed-gold?style=flat-square\u0026amp;logo=cloudflare\u0026amp;logoColor=white\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n  \u003ca href=\"https://clovertools.cn\" rel=\"nofollow\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/701377c0c703a2a762f3ed35bed3850c449e32bd28bb9194458648402f46262b/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f746f6f6c732d37372d676f6c643f7374796c653d666c61742d737175617265\" alt=\"77 tools\" data-canonical-src=\"https://img.shields.io/badge/tools-77-gold?style=flat-square\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eCloverTools 是一个精品在线工具箱，覆盖「开发实用 / 日常实用 / 趣味工具」三大类共 77 个逐一手写的工具页面。多数工具在浏览器本地处理；IP 查询、HTTP 测试等联网工具会发送网络请求，处理边界见对应页面与隐私说明。打开即用，无需下载、无需注册。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e新增「背单词速刷」：中考、高考、四级、六级、托福、雅思六本核心词书，共 360 个精选词。翻卡速刷，空格看释义、方向键快速判断，自动回收错词并保存本机进度；界面提供暖白与深色两套克制的阅读表面。词库整理方式、交互与边界见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/VOCAB-FLASH.md\"\u003e背单词速刷说明\u003c/a\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e新增 M3U8 视频下载器：自动跳过缺失分片，可选 MP4 / TS 普通导出，支持特大视频原格式 / MP4 边下载边保存、部分保存与刷新后缓存续传。实现、测试与限制见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/M3U8-DOWNLOADER.md\"\u003e下载器说明\u003c/a\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e新增三个趣味工具：拼豆图纸生成器、人格风格测试、创意头像生成器。五语界面、图片与答案本地处理，支持图纸用量清单、偏好分享卡片与 PNG/SVG 头像下载；需求依据和处理边界见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/FUN-TOOLS.md\"\u003e趣味工具说明\u003c/a\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e「专注航班」采用真实地理 SVG 航图、可操作的登机副票撕裂、持续掠过的分层云朵、原创 SVG 舷窗与三种光线，完整经历起飞、巡航和抵达。38 座机场可自由组合，航图提供全程、跟随和机头朝上的导航视角。登机前选择有声或安静；巡航自动隐去界面，轻触或键盘唤回。支持 1–180 分钟、暂停续航与刷新恢复、飞行日志和盖章 PNG 登机牌。实现与计时边界见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/FOCUS-FLIGHT.md\"\u003e专注航班说明\u003c/a\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e项目推进顺序与衡量方式见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/STRATEGY.md\"\u003e战略路线图\u003c/a\u003e，配置职责、内容维护和发布检查见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/QUALITY.md\"\u003e质量说明\u003c/a\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e数据面板\u003c/h2\u003e\u003ca id=\"user-content-数据面板\" class=\"anchor\" aria-label=\"Permalink: 数据面板\" href=\"#数据面板\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e指标\u003c/th\u003e\n\u003cth\u003e数值\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e工具总数\u003c/td\u003e\n\u003ctd\u003e77（开发实用 37 · 日常实用 22 · 趣味工具 18）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e工具 API\u003c/td\u003e\n\u003ctd\u003e1 个 Pages Function\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e内容生态\u003c/td\u003e\n\u003ctd\u003e36 篇站内指南、77 份工具深度说明；137 篇独立 CSDN 文章 + 品牌文 + 发布排期\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e数据处理\u003c/td\u003e\n\u003ctd\u003e多数工具本地处理；网络工具明确说明请求边界\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e使用门槛\u003c/td\u003e\n\u003ctd\u003e零注册、零安装、即开即用\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e特性\u003c/h2\u003e\u003ca id=\"user-content-特性\" class=\"anchor\" aria-label=\"Permalink: 特性\" href=\"#特性\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e即开即用\u003c/strong\u003e：无需注册、无需安装，打开页面直接使用\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e隐私说明\u003c/strong\u003e：多数工具本地处理，网络工具说明发送对象，五语隐私/条款/联系页公开可查\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e精品手写\u003c/strong\u003e：每个工具页逐一手写，内置输入校验、错误提示、复制 / 清空 / 示例与 Ctrl+Enter 快捷执行，拒绝模板化\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e三分类目录\u003c/strong\u003e：开发实用 / 日常实用 / 趣味工具，首页搜索直达\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e设计与体验\u003c/strong\u003e：金色主题 + 深色模式、移动端适配、全站内联 SVG 图标（Lucide + Morphicons 状态形变，禁止 emoji 字符）\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e发布检查\u003c/strong\u003e：Astro 5 静态构建、SEO meta + JSON-LD + sitemap 自动生成；build 自动检查内容关联、链接、SEO、收录一致性与图标，CI 补充浏览器回归\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e全球加速\u003c/strong\u003e：Cloudflare Pages + CDN 托管，R2 存储大文件 / 媒体，Pages Functions 提供工具 API\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e技术架构\u003c/h2\u003e\u003ca id=\"user-content-技术架构\" class=\"anchor\" aria-label=\"Permalink: 技术架构\" href=\"#技术架构\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003csection class=\"js-render-needs-enrichment render-needs-enrichment position-relative\" data-identity=\"4890caed-23eb-4820-908c-2afc6e81c572\" data-host=\"https://viewscreen.githubusercontent.com\" data-src=\"https://viewscreen.githubusercontent.com/markdown/mermaid?docs_host=https%3A%2F%2Fdocs.github.com\" data-type=\"mermaid\" aria-label=\"mermaid rendered output container\"\u003e\n  \u003cdiv class=\"js-render-enrichment-target\" data-json=\"{\u0026quot;data\u0026quot;:\u0026quot;flowchart LR\\n  U[用户浏览器] --\u0026gt; CF[Cloudflare 全球 CDN]\\n  CF --\u0026gt; P[Cloudflare Pages 静态站点]\\n  P --\u0026gt; T[77 个手写工具页]\\n  T --\u0026gt; F[Pages Functions 工具 API]\\n  F --\u0026gt; R2[(Cloudflare R2 媒体存储)]\\n\u0026quot;}\" data-plain=\"flowchart LR\n  U[用户浏览器] --\u0026gt; CF[Cloudflare 全球 CDN]\n  CF --\u0026gt; P[Cloudflare Pages 静态站点]\n  P --\u0026gt; T[77 个手写工具页]\n  T --\u0026gt; F[Pages Functions 工具 API]\n  F --\u0026gt; R2[(Cloudflare R2 媒体存储)]\n\" dir=\"auto\"\u003e\n    \u003cdiv class=\"render-plaintext-hidden\" dir=\"auto\"\u003e\n      \u003cpre lang=\"mermaid\" aria-label=\"Raw mermaid code\"\u003eflowchart LR\n  U[用户浏览器] --\u0026gt; CF[Cloudflare 全球 CDN]\n  CF --\u0026gt; P[Cloudflare Pages 静态站点]\n  P --\u0026gt; T[77 个手写工具页]\n  T --\u0026gt; F[Pages Functions 工具 API]\n  F --\u0026gt; R2[(Cloudflare R2 媒体存储)]\n\u003c/pre\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cspan class=\"js-render-enrichment-loader d-flex flex-justify-center flex-items-center width-full\" style=\"min-height:100px\" role=\"presentation\"\u003e\n    \u003cspan data-view-component=\"true\"\u003e\n  \u003csvg style=\"box-sizing: content-box; color: var(--color-icon-primary);\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\" data-view-component=\"true\" class=\"octospinner mx-auto tmp-mx-auto anim-rotate\"\u003e\n    \u003ccircle cx=\"8\" cy=\"8\" r=\"7\" stroke=\"currentColor\" stroke-opacity=\"0.25\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\" fill=\"none\"\u003e\u003c/circle\u003e\n    \u003cpath d=\"M15 8a7.002 7.002 0 00-7-7\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\"\u003e\u003c/path\u003e\n\u003c/svg\u003e    \u003cspan class=\"sr-only\"\u003eLoading\u003c/span\u003e\n\u003c/span\u003e\n  \u003c/span\u003e\n\u003c/section\u003e\n\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e界面预览\u003c/h2\u003e\u003ca id=\"user-content-界面预览\" class=\"anchor\" aria-label=\"Permalink: 界面预览\" href=\"#界面预览\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"/YupenBob/clover-tools/blob/main/docs/screenshots/home.png\"\u003e\u003cimg src=\"/YupenBob/clover-tools/raw/main/docs/screenshots/home.png\" alt=\"CloverTools 首页\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e多语言与国际化（i18n）\u003c/h2\u003e\u003ca id=\"user-content-多语言与国际化i18n\" class=\"anchor\" aria-label=\"Permalink: 多语言与国际化（i18n）\" href=\"#多语言与国际化i18n\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e简体中文（默认，根路径）、繁體中文（\u003ccode\u003e/zh-hant/\u003c/code\u003e）、English（\u003ccode\u003e/en/\u003c/code\u003e）、한국어（\u003ccode\u003e/ko/\u003c/code\u003e）与日本語（\u003ccode\u003e/ja/\u003c/code\u003e）五语全站支持\u003c/li\u003e\n\u003cli\u003e首次访问按浏览器语言自动切换到对应语言版本（localStorage 记住选择，页头可随时手动切换）\u003c/li\u003e\n\u003cli\u003e页头语言切换器按当前路径保持页面位置（404 页切换时回到对应语言首页）\u003c/li\u003e\n\u003cli\u003e页面输出语言专属 canonical 与 \u003ccode\u003eog:locale\u003c/code\u003e；\u003ccode\u003ehreflang\u003c/code\u003e 只指向真实存在且允许收录的版本。工具/分类页当前沿用简体优先收录，其他语言仍可访问，审核后通过 \u003ccode\u003econfig/routes.mjs\u003c/code\u003e 开放\u003c/li\u003e\n\u003cli\u003e指南当前仅简体：首次访问不会跳转到不存在的翻译，手动切换到其他语言会进入该语言首页；繁体政策页统一使用 \u003ccode\u003e/zh-hant/\u003c/code\u003e\u003c/li\u003e\n\u003cli\u003e英文文案集中在 \u003ccode\u003esrc/lib/i18n/en.json\u003c/code\u003e：站点文案、分类、76 个已翻译工具的名称/描述/关键词与「使用说明」\u003c/li\u003e\n\u003cli\u003e韩语/日语文案集中在 \u003ccode\u003esrc/lib/i18n/ko.json\u003c/code\u003e、\u003ccode\u003eja.json\u003c/code\u003e（由 \u003ccode\u003escripts/gen-ko-ja-data.mjs\u003c/code\u003e 基于英文数据翻译生成）\u003c/li\u003e\n\u003cli\u003e繁体页面由 \u003ccode\u003escripts/gen-zhhant.mjs\u003c/code\u003e 基于简体页用 \u003ccode\u003echinese-s2t\u003c/code\u003e 自动生成；标记 \u003ccode\u003e@shared-tool-ui\u003c/code\u003e 的 FPS 等共享界面维护薄路由，批量页面翻译会跳过，文案仍共用词典\u003c/li\u003e\n\u003cli\u003e五语言搜索索引：\u003ccode\u003epublic/search-index.json\u003c/code\u003e（简体）、\u003ccode\u003epublic/zh-hant/search-index.json\u003c/code\u003e（繁体）、\u003ccode\u003epublic/en/search-index.json\u003c/code\u003e（英文）、\u003ccode\u003epublic/ko/search-index.json\u003c/code\u003e（韩语）与 \u003ccode\u003epublic/ja/search-index.json\u003c/code\u003e（日语）\u003c/li\u003e\n\u003cli\u003e英文工具页由 \u003ccode\u003escripts/i18n-translate.mjs\u003c/code\u003e（DeepSeek API 批量翻译）与 \u003ccode\u003escripts/fix-big-pages.mjs\u003c/code\u003e（超长页分段翻译）生成；新增工具后补充 \u003ccode\u003een.json\u003c/code\u003e 英文元信息并重新构建即可\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e项目结构\u003c/h2\u003e\u003ca id=\"user-content-项目结构\" class=\"anchor\" aria-label=\"Permalink: 项目结构\" href=\"#项目结构\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"src/\n  pages/index.astro                  # 首页：三分类目录 + 搜索\n  pages/en/                          # 英文版（/en/ 路由）：首页、关于、404、分类页与全部工具页\n  pages/tools/{cat}/{slug}.astro     # 工具页（cat: dev | daily | fun）\n  pages/tools/[category]/index.astro # 分类页（动态路由）\n  pages/404.astro                    # 404 页\n  layouts/                           # BaseLayout / ToolLayout\n  components/                        # 页头、页脚、工具卡片\n  lib/tools.ts                       # 工具清单：驱动首页、sitemap、重定向\n  lib/i18n.ts                        # 多语言助手：语言推断、路径换算、文案字典\n  lib/guides.ts  lib/tool-details.ts  # 指南内容、工具深度说明与关联\n  lib/legal.ts                       # 五语政策/联系文案\n  pages/guides/                      # 站内指南目录与文章\n  pages/robots.txt.ts                 # 从站点配置生成 robots\n  lib/i18n/en.json                   # 英文数据字典（站点 / 分类 / 工具元信息 / 使用说明）\n  styles/global.css                  # 设计系统：金色主题 + 深色模式\nfunctions/api/                       # Pages Functions（工具 API，如 ip.ts）\npublic/\n  _headers  _redirects               # Pages 配置\n  clover-logo.svg  og-image.jpg      # 品牌资产\nlegacy/                              # 旧版 CloverTools 代码归档（仅参考）\nscripts/                             # 质检与生成脚本（链接、SEO、emoji、图标、sitemap、CSDN、内容流水线）\nscripts/editorial/                   # 定时内容流水线：选题队列、写作门禁、截图、发布与回滚\nconfig/                              # 站点、语言路由/收录策略、内容质量阈值\n.github/workflows/quality.yml        # 构建与浏览器回归\ndata/                                # 内容数据（articles.json / keywords.json）\ncsdn/                                # CSDN 发布包（137 篇文章 + 品牌文 + 排期表）\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003esrc/\n  pages/index.astro                  # 首页：三分类目录 + 搜索\n  pages/en/                          # 英文版（/en/ 路由）：首页、关于、404、分类页与全部工具页\n  pages/tools/{cat}/{slug}.astro     # 工具页（cat: dev | daily | fun）\n  pages/tools/[category]/index.astro # 分类页（动态路由）\n  pages/404.astro                    # 404 页\n  layouts/                           # BaseLayout / ToolLayout\n  components/                        # 页头、页脚、工具卡片\n  lib/tools.ts                       # 工具清单：驱动首页、sitemap、重定向\n  lib/i18n.ts                        # 多语言助手：语言推断、路径换算、文案字典\n  lib/guides.ts  lib/tool-details.ts  # 指南内容、工具深度说明与关联\n  lib/legal.ts                       # 五语政策/联系文案\n  pages/guides/                      # 站内指南目录与文章\n  pages/robots.txt.ts                 # 从站点配置生成 robots\n  lib/i18n/en.json                   # 英文数据字典（站点 / 分类 / 工具元信息 / 使用说明）\n  styles/global.css                  # 设计系统：金色主题 + 深色模式\nfunctions/api/                       # Pages Functions（工具 API，如 ip.ts）\npublic/\n  _headers  _redirects               # Pages 配置\n  clover-logo.svg  og-image.jpg      # 品牌资产\nlegacy/                              # 旧版 CloverTools 代码归档（仅参考）\nscripts/                             # 质检与生成脚本（链接、SEO、emoji、图标、sitemap、CSDN、内容流水线）\nscripts/editorial/                   # 定时内容流水线：选题队列、写作门禁、截图、发布与回滚\nconfig/                              # 站点、语言路由/收录策略、内容质量阈值\n.github/workflows/quality.yml        # 构建与浏览器回归\ndata/                                # 内容数据（articles.json / keywords.json）\ncsdn/                                # CSDN 发布包（137 篇文章 + 品牌文 + 排期表）\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e快速开始\u003c/h2\u003e\u003ca id=\"user-content-快速开始\" class=\"anchor\" aria-label=\"Permalink: 快速开始\" href=\"#快速开始\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"git clone git@github.com:YupenBob/clover-tools.git\ncd clover-tools\nnpm install\n\nnpm run dev        # 本地开发 http://localhost:4321\nnpm run build      # 测试、构建到 dist/，并自动检查\nnpm run preview    # 本地预览构建产物\nnpm run check      # 对现有 dist 检查内容、链接、SEO 与图标\nnpm run check:browser # 临时预览与真实浏览器回归\"\u003e\u003cpre\u003egit clone git@github.com:YupenBob/clover-tools.git\n\u003cspan class=\"pl-c1\"\u003ecd\u003c/span\u003e clover-tools\nnpm install\n\nnpm run dev        \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 本地开发 http://localhost:4321\u003c/span\u003e\nnpm run build      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 测试、构建到 dist/，并自动检查\u003c/span\u003e\nnpm run preview    \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 本地预览构建产物\u003c/span\u003e\nnpm run check      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 对现有 dist 检查内容、链接、SEO 与图标\u003c/span\u003e\nnpm run check:browser \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 临时预览与真实浏览器回归\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e建议 Node 24、npm \u0026gt;= 10.8.2。站点域名可用 \u003ccode\u003ePUBLIC_SITE_URL\u003c/code\u003e 覆盖；canonical、sitemap、robots 与检查同步读取配置，示例见 \u003ccode\u003e.env.example\u003c/code\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e分类导览\u003c/h2\u003e\u003ca id=\"user-content-分类导览\" class=\"anchor\" aria-label=\"Permalink: 分类导览\" href=\"#分类导览\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e分类\u003c/th\u003e\n\u003cth\u003e定位\u003c/th\u003e\n\u003cth\u003e代表工具\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e开发实用（37）\u003c/td\u003e\n\u003ctd\u003e编码、格式化、加解密与调试，开发日常高频刚需\u003c/td\u003e\n\u003ctd\u003eJSON 格式化与校验、JSON/XML/YAML 互转、正则测试、Base64、哈希与加解密、JWT 解码、二维码、HTTP 测试、IP 查询\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e日常实用（22）\u003c/td\u003e\n\u003ctd\u003e日期、理财、换算与效率小工具，生活工作两相宜\u003c/td\u003e\n\u003ctd\u003e背单词速刷、在线万年历、公历农历互转、世界时钟、时间戳转换、年龄计算、单位换算、人民币大写、键盘测试\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e趣味工具（18）\u003c/td\u003e\n\u003ctd\u003e减压、娱乐与创意小玩意，给忙碌的日常加点乐趣\u003c/td\u003e\n\u003ctd\u003e专注航班、拼豆图纸、人格风格测试、创意头像、FPS练枪、ASCII 艺术字、点击速度测试、反应力测试、舒尔特训练、目标球追踪、抽奖、摩斯密码\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e添加工具（精品制作规范）\u003c/h2\u003e\u003ca id=\"user-content-添加工具精品制作规范\" class=\"anchor\" aria-label=\"Permalink: 添加工具（精品制作规范）\" href=\"#添加工具精品制作规范\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eFPS练枪为 CS2 与瓦洛兰特玩家提供第一人称靶场、四把步枪、六项专项训练、环形 Bot 靶场和小球点击，支持可调浏览器转向倍率、灵敏度校准与本地成绩。急停采用左右交替的横移、停稳、首发回合；预瞄要求探头首发后回到中央安全区再换边，配有步骤指引、方向标线、失败原因和回合复盘。回掩体提示显示剩余距离及当前视角下的按键方向；慢走和蹲伏保持各自速度上限，CS2 蹲行可以实际完成返回。靶场使用分区 HUD、独立步枪造型与击发/换弹动作；小球也保留步枪与枪声。CC0 实录枪声和机械音在进入训练或试听时加载，主音量、枪声、命中音可分别调节；音效失败仍可训练。五语薄路由共用界面与训练模块，Three.js 仅在启动训练时加载。画面准备完成后需点击开始才锁定鼠标；Esc 或切出页面会释放，返回后需主动恢复。配置、参数和素材来源、近似模型边界与验证记录见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/FPS-AIM-TRAINER.md\"\u003eFPS-AIM-TRAINER.md\u003c/a\u003e。\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e在 \u003ccode\u003esrc/lib/tools.ts\u003c/code\u003e 的对应分类数组里登记工具元信息（slug、名称、一句话描述、icon 语义键、关键词、tier）\u003c/li\u003e\n\u003cli\u003e在 \u003ccode\u003esrc/lib/tool-seo/\u0026lt;分类\u0026gt;.ts\u003c/code\u003e 补充该工具简体中文页面的 SEO 标题（50–60 字符，含 \" - CloverTools\"）与 meta description（150–160 字符），\u003ccode\u003escripts/check-seo-metadata.mjs\u003c/code\u003e 会校验覆盖与长度\u003c/li\u003e\n\u003cli\u003e手写页面 \u003ccode\u003esrc/pages/tools/{cat}/{slug}.astro\u003c/code\u003e，使用 \u003ccode\u003eToolLayout\u003c/code\u003e\u003c/li\u003e\n\u003cli\u003e页面必须包含：输入校验与错误提示、复制 / 清空 / 示例、Ctrl+Enter 快捷执行、移动端适配、SEO meta（布局已内置 JSON-LD）\u003c/li\u003e\n\u003cli\u003e图标使用 \u003ccode\u003e\u0026lt;Icon name=\"…\" /\u0026gt;\u003c/code\u003e（语义键见 \u003ccode\u003esrc/lib/icons/registry.ts\u003c/code\u003e），禁止 emoji 字符\u003c/li\u003e\n\u003cli\u003e需要服务端能力的工具，在 \u003ccode\u003efunctions/api/\u003c/code\u003e 增加 Pages Function，前端 \u003ccode\u003efetch('/api/...')\u003c/code\u003e\u003c/li\u003e\n\u003cli\u003e若保留旧版同名工具，在 \u003ccode\u003epublic/_redirects\u003c/code\u003e 中补充旧路径 301 到新路径\u003c/li\u003e\n\u003cli\u003e提交前运行 \u003ccode\u003enpm run check\u003c/code\u003e 全部通过\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"auto\"\u003e每日自动工具流水线：每天 00:00（Asia/Shanghai）由 Codex 在独立 worktree 中按上述规范完成一个中大型工具，5 语言、单测、真实浏览器回归与独立复核全部通过后直接发布 \u003ccode\u003emain\u003c/code\u003e。触发、门禁、失败矩阵与首次上线步骤见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/TOOL-PIPELINE.md\"\u003e工具生产线\u003c/a\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e部署与运维\u003c/h2\u003e\u003ca id=\"user-content-部署与运维\" class=\"anchor\" aria-label=\"Permalink: 部署与运维\" href=\"#部署与运维\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCloudflare Pages\u003c/h3\u003e\u003ca id=\"user-content-cloudflare-pages\" class=\"anchor\" aria-label=\"Permalink: Cloudflare Pages\" href=\"#cloudflare-pages\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e当前 \u003ccode\u003eclovertools\u003c/code\u003e Pages 项目为直接上传模式，绑定 \u003ccode\u003eclovertools.cn\u003c/code\u003e，生产分支为 \u003ccode\u003emain\u003c/code\u003e。推送 main 后 GitHub Actions 自动完成构建、站点/FPS 浏览器和 HLS 媒体回归，再通过仓库 Cloudflare Secrets 上传生产版本并验收正式域名。也可在有凭据的环境使用 \u003ccode\u003ewrangler pages deploy dist --project-name clovertools --branch main --commit-hash \u0026lt;已推送提交\u0026gt;\u003c/code\u003e 手动发布；凭据不能提交到仓库。流程及验收记录见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/RELEASE.md\"\u003e发布说明\u003c/a\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCloudflare R2（媒体存储）\u003c/h3\u003e\u003ca id=\"user-content-cloudflare-r2媒体存储\" class=\"anchor\" aria-label=\"Permalink: Cloudflare R2（媒体存储）\" href=\"#cloudflare-r2媒体存储\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"wrangler r2 bucket create clovertools-media\nwrangler r2 object put clovertools-media/\u0026lt;key\u0026gt; --file \u0026lt;path\u0026gt;\"\u003e\u003cpre\u003ewrangler r2 bucket create clovertools-media\nwrangler r2 object put clovertools-media/\u003cspan class=\"pl-k\"\u003e\u0026lt;\u003c/span\u003ekey\u003cspan class=\"pl-k\"\u003e\u0026gt;\u003c/span\u003e --file \u003cspan class=\"pl-k\"\u003e\u0026lt;\u003c/span\u003epath\u003cspan class=\"pl-k\"\u003e\u0026gt;\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e在 Pages 项目设置中绑定同名 R2 桶（变量名 \u003ccode\u003eCLOVER_MEDIA\u003c/code\u003e），Functions 通过 \u003ccode\u003econtext.env.CLOVER_MEDIA\u003c/code\u003e 访问。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eWeb Analytics（可选）\u003c/h3\u003e\u003ca id=\"user-content-web-analytics可选\" class=\"anchor\" aria-label=\"Permalink: Web Analytics（可选）\" href=\"#web-analytics可选\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e创建 Cloudflare Web Analytics 后，将站点级发布 token 写入环境变量 \u003ccode\u003ePUBLIC_CF_BEACON_TOKEN\u003c/code\u003e，构建后自动注入 beacon 脚本。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e搜索收录与监控\u003c/h3\u003e\u003ca id=\"user-content-搜索收录与监控\" class=\"anchor\" aria-label=\"Permalink: 搜索收录与监控\" href=\"#搜索收录与监控\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003eGoogle Search Console / Bing Webmaster\u003c/strong\u003e：DNS TXT 验证 \u003ccode\u003eclovertools.cn\u003c/code\u003e，提交 \u003ccode\u003ehttps://clovertools.cn/sitemap-index.xml\u003c/code\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e主动推送\u003c/strong\u003e：GitHub Actions 在部署通过后、每天北京时间 09:00 自动读取线上 sitemap，向 Bing / IndexNow 提交 URL，并在配置 Google 服务账号后提交 Search Console sitemap。支持手动运行，结果保存在 Action Summary 和 artifact；IndexNow key 已随仓库生成。Google 设置与提交边界见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/SEARCH-SUBMISSION.md\"\u003e搜索提交工作流\u003c/a\u003e。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e百度站长平台\u003c/strong\u003e：文件验证后把 \u003ccode\u003ebaidu_verify_*.html\u003c/code\u003e 放入 \u003ccode\u003epublic/\u003c/code\u003e 并重新部署（参考 \u003ccode\u003epublic/baidu-verify.example.html\u003c/code\u003e）\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e数据闭环\u003c/strong\u003e：以 GSC「曝光 → 点击」排序工具页，Top 20 无收录页逐批排查，每周关注覆盖率与抓取统计\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e内容生态（CSDN）\u003c/h2\u003e\u003ca id=\"user-content-内容生态csdn\" class=\"anchor\" aria-label=\"Permalink: 内容生态（CSDN）\" href=\"#内容生态csdn\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eCSDN 发布包独立维护；运行 \u003ccode\u003enpm run csdn:build\u003c/code\u003e 生成到 \u003ccode\u003ecsdn/\u003c/code\u003e（137 篇文章 + 品牌文 + 发布排期表，详见 \u003ccode\u003ecsdn/README.md\u003c/code\u003e）。站内另维护 36 篇场景指南，与工具相互链接并展示参考来源；其中 20 篇配有实拍截图与流程图。\n自动内容流水线的选题、质量门禁与发布流程见 \u003ca href=\"https://clovertools.cn/editorial/\" rel=\"nofollow\"\u003e编辑与验证流程\u003c/a\u003e 与\n\u003ca href=\"/YupenBob/clover-tools/blob/main/docs/EDITORIAL-AUTOMATION.md\"\u003e自动化内容流水线\u003c/a\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e约定\u003c/h2\u003e\u003ca id=\"user-content-约定\" class=\"anchor\" aria-label=\"Permalink: 约定\" href=\"#约定\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e默认简体中文，另有繁体、英文、韩文与日文版本，无注册引导\u003c/li\u003e\n\u003cli\u003e旧版 Vercel 相关代码已整体归档在 \u003ccode\u003elegacy/\u003c/code\u003e，仅作参考\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eAdSense 与 SEO 整改、广告启用条件及爬虫验证见 \u003ca href=\"/YupenBob/clover-tools/blob/main/docs/ADSENSE-SEO-REMEDIATION.md\"\u003e整改记录\u003c/a\u003e。\u003c/p\u003e\n\u003c/article\u003e","loaded":true,"timedOut":false,"errorMessage":null,"headerInfo":{"toc":[{"level":1,"text":"CloverTools","anchor":"clovertools","htmlText":"CloverTools"},{"level":2,"text":"数据面板","anchor":"数据面板","htmlText":"数据面板"},{"level":2,"text":"特性","anchor":"特性","htmlText":"特性"},{"level":2,"text":"技术架构","anchor":"技术架构","htmlText":"技术架构"},{"level":2,"text":"界面预览","anchor":"界面预览","htmlText":"界面预览"},{"level":2,"text":"多语言与国际化（i18n）","anchor":"多语言与国际化i18n","htmlText":"多语言与国际化（i18n）"},{"level":2,"text":"项目结构","anchor":"项目结构","htmlText":"项目结构"},{"