{
  "name": "clovertools",
  "version": "3.0.0",
  "description": "CloverTools V3 - 精品在线工具箱（开发实用 / 日常实用 / 趣味工具）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/check-links.mjs && node scripts/check-emoji.mjs",
    "check:all": "npm run build && npm run check",
    "icons:slim": "node scripts/slim-icons.mjs",
    "redirects": "node scripts/gen-redirects.mjs",
    "deploy:media": "wrangler r2 object put"
  },
  "dependencies": {
