    "@types/crypto-js": "^4.2.2",
    "astro": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.11.3",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.7",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.28.2",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "terser": "^5.49.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
